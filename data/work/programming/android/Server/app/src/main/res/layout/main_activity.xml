<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#0A0A0A"
  android:fitsSystemWindows="true"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="#1A1A1A"
    android:orientation="horizontal">
    <ImageView
      android:id="@+id/onlineGifView"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:visibility="gone" />
    <TextView
      android:id="@+id/serverAddressText"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fontFamily="monospace"
      android:gravity="center"
      android:textColor="#00FF41"
      android:visibility="gone"
      tools:text=" 192.168.1.5:8080"
      tools:visibility="visible" />
    <TextView
      android:id="@+id/serverStatusText"
      android:textStyle="bold"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="monospace"
      android:text="OFFLINE"
      android:textColor="#FF003C" />
    <View
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_weight="1" />
    <View
      android:layout_width="8dp"
      android:layout_height="0dp" />
  </LinearLayout>

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="12dp"
      android:orientation="vertical">

      <Button
        android:id="@+id/ipConfigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SERVER IP" />

      <Button
        android:id="@+id/portConfigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SERVER PORT" />

      <Button
        android:id="@+id/selectFolderButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SHARE DIRECTORY" />

      <Button
        android:id="@+id/connectSoundButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="ENABLE CONNECT SOUND"
        android:textColor="@color/primary_dark" />

      <Button
        android:id="@+id/messengerButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="MESSENGER"
        android:textColor="@color/secondary_dark" />

      <Button
        android:id="@+id/cameraButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="STREAM CAMERA"
        android:textColor="@color/primary_dark" />

      <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

      <LinearLayout
        android:id="@+id/chatPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#121212"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <TextView
          android:id="@+id/chatTypingIndicator"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="monospace"
          android:textColor="#555555"
          android:textSize="11sp"
          android:visibility="invisible" />

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/chatRecyclerView"
          android:layout_width="match_parent"
          android:layout_height="220dp" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginTop="8dp">

          <EditText
            android:id="@+id/chatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:hint="ENTER_MESSAGE..."
            android:textColor="#FFFFFF"
            android:textColorHint="#444444" />

          <Button
            android:id="@+id/chatSendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="SEND" />
        </LinearLayout>
      </LinearLayout>

      <LinearLayout
        android:id="@+id/ipConfigLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <EditText
          android:id="@+id/ipAddressEditText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="IP"
          android:textColor="#FFFFFF" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/portConfigLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <EditText
          android:id="@+id/portEditText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="PORT"
          android:text="8080"
          android:textColor="#FFFFFF" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/basicAuthPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <EditText
          android:id="@+id/usernameEditText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="USER"
          android:textColor="#FFFFFF" />
        <EditText
          android:id="@+id/passwordEditText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="PASS"
          android:inputType="textPassword"
          android:textColor="#FFFFFF" />
      </LinearLayout>

      <SeekBar
        android:id="@+id/inactivitySeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginVertical="8dp">

        <ImageView
          android:id="@+id/servingDirectoryGif"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:layout_marginEnd="8dp"
          android:visibility="gone" />

        <TextView
          android:id="@+id/rootFolderText"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="monospace"
          android:gravity="center"
          android:text="NONE"
          android:textColor="#888888" />

      </LinearLayout>

      <View
        android:id="@+id/logHandle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

      <View
        android:id="@+id/fileListHandle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

      <View
        android:id="@+id/fileRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
      <View
        android:id="@+id/liveLogButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

      <View
        android:id="@+id/autoScrollCheckbox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
      <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/basicAuthSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BASIC AUTH" />
      <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/tlsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TLS/SSL" />
      <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/autostartSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AUTO START" />

      <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/autoShutdownSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AUTO SHUTDOWN" />
      <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/redirectIndexSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REDIRECT INDEX" />
      <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/renderFolderSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RENDER FOLDER" />

      <!-- Hidden for compatibility -->
      <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/allowUploadsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ALLOW UPLOADS" />
      <androidx.cardview.widget.CardView
        android:id="@+id/manageCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#222222">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="8dp">
          <Button
            android:id="@+id/startStopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="START SERVER" />
        </LinearLayout>
      </androidx.cardview.widget.CardView>
      <androidx.cardview.widget.CardView
        android:id="@+id/generalCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#000000">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">
          <Button
            android:id="@+id/autoScrollButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:text="AUTO_SCROLL: ON"
            android:textColor="#555555" />
          <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/logRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
          <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/trafficChart"
            android:layout_width="match_parent"
            android:layout_height="180dp" />
        </LinearLayout>
      </androidx.cardview.widget.CardView>
      <androidx.cardview.widget.CardView
        android:id="@+id/qrCodeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="8dp">
        <ImageView
          android:id="@+id/qrCodeImageView"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:adjustViewBounds="true" />
      </androidx.cardview.widget.CardView>
      <androidx.cardview.widget.CardView
        android:id="@+id/serverStatsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#1A1A1A">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="12dp"
          android:orientation="vertical">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
              android:layout_width="120dp"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="Uptime"
              android:textColor="#888888" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text=": "
              android:textColor="#888888" />
            <TextView
              android:id="@+id/uptimeText"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="00:00:00"
              android:textColor="#FFFFFF" />
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
              android:layout_width="120dp"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="Received"
              android:textColor="#888888" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text=": "
              android:textColor="#888888" />
            <TextView
              android:id="@+id/totalRxText"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="0 B"
              android:textColor="#00FF41" />
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
              android:layout_width="120dp"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="Transmitted"
              android:textColor="#888888" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text=": "
              android:textColor="#888888" />
            <TextView
              android:id="@+id/totalTxText"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="0 B"
              android:textColor="#00F3FF" />
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
              android:layout_width="120dp"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="Requests"
              android:textColor="#888888" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text=": "
              android:textColor="#888888" />
            <TextView
              android:id="@+id/totalRequestsText"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="0"
              android:textColor="#CCCCCC" />
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
              android:layout_width="120dp"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="Connections"
              android:textColor="#888888" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text=": "
              android:textColor="#888888" />
            <TextView
              android:id="@+id/totalConnectionsText"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="0"
              android:textColor="#CCCCCC" />
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
              android:layout_width="120dp"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="Bitrate"
              android:textColor="#888888" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text=": "
              android:textColor="#888888" />
            <TextView
              android:id="@+id/currentRateText"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="monospace"
              android:text="0 KB/s"
              android:textColor="#CCCCCC" />
          </LinearLayout>
        </LinearLayout>
      </androidx.cardview.widget.CardView>

    </LinearLayout>
  </ScrollView>
</LinearLayout>