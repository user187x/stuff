#!/usr/bin/env bash
# ==============================================================================
# FZF Power Tools Collection
# A consolidated interactive CLI built entirely on fzf.
# ==============================================================================

# Ensure fzf is installed
if ! command -v fzf &>/dev/null; then
 echo "❌ Error: 'fzf' could not be found. Please install it."
 exit 1
fi

# ==============================================================================
# 1. Interactive Tar Extractor (Adapted from your script)
# Highlights: Subshell previews and awk parsing
# ==============================================================================
tool_tar_extractor() {
 # Find local tar files
 TAR_FILE=$(find . -maxdepth 1 -type f \( -name "*.tar*" -o -name "*.tgz" \) | fzf \
  --prompt="📦 Select Tarball> " \
  --layout=reverse --border="rounded")

 [[ -z "$TAR_FILE" ]] && return 0
 export TAR_FILE

 # We pipe tar -tvf into fzf. [cite: 138]
 # The preview window uses a subshell to parse the filename on the fly, [cite: 138]
 # then uses `tar -xOf` to print the file's contents to standard output (head limits it to 100 lines). [cite: 138, 139]
 SELECTED_LINE=$(tar -tvf "$TAR_FILE" | fzf \
  --prompt="Extract> " \
  --header="Press Enter to extract to current directory (ESC to cancel)" \
  --layout=reverse \
  --border="rounded" \
  --preview="
            file=\$(echo {} | awk '{\$1=\$2=\$3=\$4=\$5=\"\"; sub(/^[ \t]+/, \"\"); print}');
            if [[ {} == d* ]]; then
                echo \"Directory: \$file\"
            else
                tar -xOf \"$TAR_FILE\" \"\$file\" 2>/dev/null | head -n 100 || echo \"Binary file or preview unavailable.\"
            fi
        " \
  --preview-window=right:60%:wrap) [cite: 139, 140]

 [[ -z "$SELECTED_LINE" ]] && return 0

 # Parse the Final File Path [cite: 141]
 FILE_PATH=$(echo "$SELECTED_LINE" | awk '{$1=$2=$3=$4=$5=""; sub(/^[ \t]+/, ""); print}') [cite: 141]

 if [[ "$SELECTED_LINE" == d* ]]; then
  [cite: 141]
  echo "Extracting directory: $FILE_PATH" [cite: 142]
 else
  echo "Extracting file: $FILE_PATH" [cite: 142]
 fi

 tar -xf "$TAR_FILE" "$FILE_PATH" [cite: 142]
 echo "✅ Extracted to $(pwd)"
 read -n 1 -s -r -p "Press any key to continue..."
}

# ==============================================================================
# 2. Interactive Process Killer
# Highlights: Multi-selection (-m) and column extraction
# ==============================================================================
tool_process_killer() {
 # Using -m allows selecting multiple processes using TAB
 SELECTED_PROCS=$(ps -ef | fzf \
  --prompt="💀 Kill Process> " \
  --header="TAB to multi-select | ENTER to kill | ESC to cancel" \
  --layout=reverse --border="rounded" \
  -m \
  --preview="echo {} | awk '{print \"User: \" \$1 \"\nPID: \" \$2 \"\nCPU: \" \$3 \"\nCommand:\n\" \$8 \" \" \$9}'" \
  --preview-window=down:30%:wrap)

 [[ -z "$SELECTED_PROCS" ]] && return 0

 # Extract PIDs (column 2) and kill them
 echo "$SELECTED_PROCS" | awk '{print $2}' | while read -r pid; do
  if [[ "$pid" != "$$" ]]; then # Don't kill the script itself!
   kill -9 "$pid" 2>/dev/null && echo "✅ Killed PID $pid" || echo "❌ Failed to kill PID $pid"
  fi
 done
 read -n 1 -s -r -p "Press any key to continue..."
}

# ==============================================================================
# 3. File Browser & Quick Editor
# Highlights: Key bindings (--bind) and TTY execution
# ==============================================================================
tool_file_browser() {
 # This uses bindings to open the file in nano dynamically WITHOUT exiting fzf
 # The </dev/tty >/dev/tty trick gives control back to the terminal temporarily
 fzf --prompt="📂 Browse> " \
  --header="ENTER to view | CTRL-E to edit in Nano | ESC to cancel" \
  --layout=reverse --border="rounded" \
  --preview="head -n 100 {}" \
  --preview-window=right:60%:wrap \
  --bind "ctrl-e:execute(nano {} </dev/tty >/dev/tty)" \
  --bind "enter:execute(cat {} | less </dev/tty >/dev/tty)"
}

# ==============================================================================
# 4. Git Commit Explorer
# Highlights: ANSI color rendering (--ansi)
# ==============================================================================
tool_git_log() {
 if ! git rev-parse --is-inside-work-tree &>/dev/null; then
  echo "❌ Error: Not in a git repository."
  read -n 1 -s -r -p "Press any key to continue..."
  return 0
 fi

 # Pass --color=always to git and --ansi to fzf to keep the beautiful terminal colors
 git log --color=always --oneline --decorate | fzf \
  --prompt="🌿 Git Log> " \
  --ansi \
  --layout=reverse --border="rounded" \
  --preview="echo {} | awk '{print \$1}' | xargs -I % git show --color=always %" \
  --preview-window=right:60%:wrap
}

# ==============================================================================
# 5. Multi-Select Archive Creator
# Highlights: Bulk file processing
# ==============================================================================
tool_create_archive() {
 SELECTED_FILES=$(find . -maxdepth 1 -type f | fzf \
  --prompt="🗜️ Add to Zip> " \
  --header="TAB to multi-select files | ENTER to zip | ESC to cancel" \
  --layout=reverse --border="rounded" \
  -m \
  --preview="head -n 30 {}" \
  --preview-window=right:50%:wrap)

 [[ -z "$SELECTED_FILES" ]] && return 0

 read -r -p "Enter name for zip file (without extension): " ZIP_NAME
 [[ -z "$ZIP_NAME" ]] && ZIP_NAME="archive_$(date +%s)"

 # Tr output translates newlines to spaces so zip reads them as arguments
 echo "$SELECTED_FILES" | tr '\n' '\0' | xargs -0 zip -q "${ZIP_NAME}.zip"

 echo "✅ Created ${ZIP_NAME}.zip successfully."
 read -n 1 -s -r -p "Press any key to continue..."
}

# ==============================================================================
# MAIN MENU
# Uses fzf itself as the menu router!
# ==============================================================================
while true; do
 CHOICE=$(printf "1. Interactive Tar Extractor\n2. Interactive Process Killer\n3. File Browser & Quick Editor\n4. Git Commit Explorer\n5. Multi-Select Archive Creator" |
  fzf --prompt="🛠️ FZF Toolbox> " \
   --header="Select a tool (ESC to exit)" \
   --layout=reverse \
   --border="rounded" \
   --margin=1,2 \
   --info=hidden)

 # Exit if user hits ESC or Cancel
 [[ -z "$CHOICE" ]] && break

 # Route based on the first character of the choice
 case "$CHOICE" in
  1*) tool_tar_extractor ;;
  2*) tool_process_killer ;;
  3*) tool_file_browser ;;
  4*) tool_git_log ;;
  5*) tool_create_archive ;;
 esac
done

clear
echo "Exited FZF Toolbox."
