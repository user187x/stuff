#!/bin/bash

ZIP_FILE="cluster-backup/cluster-backup-2026.08.07-03.26.zip"
EXTRACT_DIR="/tmp/velero-upload-temp"
BACKUP_NAME=$(basename "$ZIP_FILE" .zip)

NAMESPACE="minio"
POD_NAME="mc-uploader"
BUCKET_DESTINATION="myminio/cluster-backup/backups/$BACKUP_NAME/"
MINIO_USER="admin"
MINIO_PASS="changeIt!"

# 1. Verify the backup file exists
if [ ! -f "$ZIP_FILE" ]; then
  echo "Error: File '$ZIP_FILE' not found."
  exit 1
fi

# 2. Verify the local mc binary exists in the same directory
if [ ! -f "./bin/mc" ]; then
  echo "Error: Local 'mc' binary not found in the current directory."
  exit 1
fi

echo "Fetching MinIO ClusterIP to bypass internal DNS..."
# Query the cluster for the exact Service IP to bypass DNS resolution inside the pod
MINIO_IP=$(kubectl get svc minio -n $NAMESPACE -o jsonpath='{.spec.clusterIP}')
if [ -z "$MINIO_IP" ]; then
  echo "Error: Could not determine MinIO ClusterIP."
  exit 1
fi

# Construct the URL using the raw IP address
MINIO_URL="http://${MINIO_IP}:9000"
echo "Targeting MinIO at: $MINIO_URL"

echo "Extracting $ZIP_FILE locally..."
mkdir -p "$EXTRACT_DIR"
unzip -q -o "$ZIP_FILE" -d "$EXTRACT_DIR"

echo "Starting temporary Debian pod..."
kubectl run $POD_NAME --image=debian:bullseye-slim --restart=Never -n $NAMESPACE -- sleep 3600

echo "Waiting for pod to become ready..."
kubectl wait --for=condition=Ready pod/$POD_NAME -n $NAMESPACE --timeout=60s

echo "Transferring extracted data and mc binary to the cluster..."
kubectl cp "$EXTRACT_DIR" $NAMESPACE/$POD_NAME:/tmp/upload-data
kubectl cp ./bin/mc $NAMESPACE/$POD_NAME:/tmp/mc

echo "Configuring MinIO client and uploading payload..."
kubectl exec $POD_NAME -n $NAMESPACE -- /bin/sh -c "
  chmod +x /tmp/mc &&
  /tmp/mc alias set myminio $MINIO_URL $MINIO_USER $MINIO_PASS &&
  /tmp/mc cp --recursive /tmp/upload-data/ $BUCKET_DESTINATION
"

echo "Cleaning up local and cluster resources..."
kubectl delete pod $POD_NAME -n $NAMESPACE
rm -rf "$EXTRACT_DIR"

echo "Upload complete. Run 'velero backup get' to confirm Velero sees the backup."
