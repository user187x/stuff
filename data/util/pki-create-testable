#!/usr/bin/env bash
set -euo pipefail

DOMAIN="xxx.com"
EXPIRE=365
OUTPUT_DIR="${PWD}/certs"

# Create the folder if it doesn't exist
mkdir -p "$OUTPUT_DIR"

echo "Generating CA Key and Certificate..."
openssl req \
 -x509 \
 -sha256 \
 -nodes \
 -days "$EXPIRE" \
 -subj "/CN=Local Testing CA" \
 -keyout "${OUTPUT_DIR}/ca.key" \
 -out "${OUTPUT_DIR}/ca.crt"

echo "Generating Private Key for Domain..."
openssl genrsa \
 -out "${OUTPUT_DIR}/tls.key" 2048

echo "Generating CSR and Signing Certificate with SAN..."
openssl x509 \
 -req \
 -sha256 \
 -days "$EXPIRE" \
 -in <(openssl req -new -key "${OUTPUT_DIR}/tls.key" -subj "/CN=${DOMAIN}") \
 -CA "${OUTPUT_DIR}/ca.crt" \
 -CAkey "${OUTPUT_DIR}/ca.key" \
 -CAcreateserial \
 -extfile <(
  cat <<EOF
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth, clientAuth
subjectAltName = DNS:${DOMAIN}, DNS:*.${DOMAIN}
EOF
 ) \
 -out "${OUTPUT_DIR}/tls.crt"

# Clean up the serial file generated by OpenSSL inside the directory
rm -f "${OUTPUT_DIR}/ca.srl"

echo
echo "PKI Created Successfully"
echo "========================"
echo "Folder : ${OUTPUT_DIR}"
echo "CA     : ${OUTPUT_DIR}/ca.crt"
echo "Cert   : ${OUTPUT_DIR}/tls.crt"
echo "Key    : ${OUTPUT_DIR}/tls.key"
echo
echo "Command: kubectl create secret tls cluster-tls \
  --cert=tls.crt \
  --key=tls.key \
  --namespace <namespace>"
