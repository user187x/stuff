#!/usr/bin/env bash
set -e

# Ensure script is run as root
if [[ $EUID -ne 0 ]]; then
 echo "💥 This script must be run as root. Try: sudo $0"
 exit 1
fi

# TUI Confirmation
if ! whiptail --title "EFI Cleanup & Secure Boot Setup" --yesno \
 "This will permanently delete rEFInd, Shim, MokManager, and re-write your EFI boot variables to boot GRUB directly with your sbctl keys.\n\nCRITICAL: Are your sbctl custom keys ALREADY enrolled in your UEFI firmware?" 12 70; then
 echo "Aborted by user."
 exit 0
fi

echo "🚀 Starting zero-to-hero EFI cleanup..."

# 1. Migrate sbctl database (resolves the warning in your previous output)
echo "➔ Migrating sbctl database..."
sbctl setup --migrate

# 2. Backup the current EFI partition just in case
BACKUP_DIR="/root/efi_backup_$(date +%F_%H%M%S)"
echo "➔ Backing up /boot/efi to $BACKUP_DIR.tar.gz..."
tar -czf "${BACKUP_DIR}.tar.gz" -C /boot/efi .

# 3. Purge unused packages to prevent them from regenerating files
echo "➔ Purging rEFInd and Mokutil via apt..."
DEBIAN_FRONTEND=noninteractive apt-get purge -y refind mokutil || true

# 4. Erase redundant files in the EFI partition
echo "➔ Cleaning out unneeded EFI binaries (Shim, MokManager, rEFInd)..."
rm -rf /boot/efi/EFI/refind
rm -f /boot/efi/EFI/ubuntu/shimx64.efi
rm -f /boot/efi/EFI/ubuntu/mmx64.efi
rm -f /boot/efi/EFI/BOOT/mmx64.efi
rm -f /boot/efi/EFI/BOOT/fbx64.efi

# 5. Setup the Fallback Bootloader (Rename GRUB to BOOTX64.EFI)
echo "➔ Setting up GRUB as the UEFI fallback..."
mkdir -p /boot/efi/EFI/BOOT
cp /boot/efi/EFI/ubuntu/grubx64.efi /boot/efi/EFI/BOOT/BOOTX64.EFI

# 6. Sign GRUB and all current Kernels
echo "➔ Signing GRUB and Linux Kernels with custom sbctl keys..."
sbctl sign -s /boot/efi/EFI/ubuntu/grubx64.efi
sbctl sign -s /boot/efi/EFI/BOOT/BOOTX64.EFI

for kernel in /boot/vmlinuz-*; do
 if [ -f "$kernel" ]; then
  sbctl sign -s "$kernel"
 fi
done

# 7. Auto-Signing Hook for future apt updates
echo "➔ Installing dpkg hook to auto-sign future kernel/GRUB updates..."
cat <<'EOF' >/etc/apt/apt.conf.d/99sbctl-sign
DPkg::Post-Invoke {"if [ -x /usr/bin/sbctl ]; then /usr/bin/sbctl sign-all; fi";};
EOF
chmod 644 /etc/apt/apt.conf.d/99sbctl-sign

# 8. Rebuild EFI NVRAM Boot Entries
echo "➔ Rebuilding efibootmgr entries..."
# Remove old ubuntu (shim) and refind entries
for bootnum in $(efibootmgr | grep -E -i 'ubuntu|refind' | awk '{print $1}' | tr -d '*Boot'); do
 efibootmgr -b "$bootnum" -B -q
done

# Dynamically determine the EFI disk and partition
EFI_PART=$(findmnt -n -o SOURCE /boot/efi)
EFI_DISK="/dev/$(lsblk -no pkname "$EFI_PART")"
PART_NUM=$(lsblk -no partn "$EFI_PART")

echo "➔ Creating direct NVRAM entry for Custom GRUB on $EFI_DISK (Partition $PART_NUM)..."
efibootmgr -c -d "$EFI_DISK" -p "$PART_NUM" -L "Ubuntu GRUB (Custom SB)" -l '\EFI\ubuntu\grubx64.efi'

echo "✅ Success! Run 'sudo sbctl verify' to confirm everything is signed."
echo "You are now running a pure, direct-GRUB custom Secure Boot chain."
