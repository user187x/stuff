#!/bin/bash
#
# file-splitter.sh — split a file into ~500-line parts, or rejoin parts.
# Requires: fzf, tree (tree only used for the join preview), coreutils.

# Convert a byte count to MB with two decimals.
bytes_to_mb() {
 awk "BEGIN { printf \"%.2f\", ${1:-0} / 1048576 }"
}

function split-file {
 local file_path
 read -e -r -p "Enter file to split: " file_path

 # Resolve to an absolute path so it still works after we cd elsewhere.
 file_path=$(realpath -e "${file_path}") || {
  echo "Error: file not found." >&2
  return 1
 }

 local file_name
 file_name=$(basename "${file_path}")

 local parts_directory="${PWD}/${file_name}-parts"
 mkdir -p "${parts_directory}"

 local prefix="${file_name}-part_"

 (
  cd "${parts_directory}" || exit 1
  split --numeric-suffixes=1 -l 500 "${file_path}" "${prefix}"
 )

 # Gather stats on the parts we just created.
 local parts=()
 mapfile -t parts < <(find "${parts_directory}" -maxdepth 1 -type f -name "${prefix}*" | sort)
 local count=${#parts[@]}

 local total_bytes=0 part_bytes=0 sz
 for p in "${parts[@]}"; do
  sz=$(stat -c%s "${p}")
  ((total_bytes += sz))
 done
 ((count > 0)) && part_bytes=$(stat -c%s "${parts[0]}")

 echo
 echo "File split complete"
 echo "Directory  : ${parts_directory}"
 echo "Splits     : ${count}"
 echo "Prefix     : ${prefix}"
 echo "Size  (MB) : $(bytes_to_mb "${part_bytes}")   (per part, first part)"
 echo "Total (MB) : $(bytes_to_mb "${total_bytes}")"
 echo
}

function join-file {
 local search_path
 read -e -r -p "Enter path to file-parts: " search_path

 search_path=$(realpath -e "${search_path}") || {
  echo "Error: path not found." >&2
  return 1
 }

 # Pick the parts directory; the preview shows a one-level tree of the highlight.
 local selection
 selection=$(find "${search_path}" -maxdepth 1 -type d | sort |
  fzf --border=rounded --preview="tree -L 1 -C {}" --ansi)

 if [[ -z "${selection}" ]]; then
  echo "No directory selected."
  return 1
 fi

 # Collect the part files in order.
 local parts=()
 mapfile -t parts < <(find "${selection}" -maxdepth 1 -type f -name "*-part_*" | sort)

 if ((${#parts[@]} == 0)); then
  echo "No part files found in ${selection}."
  return 1
 fi

 # Reconstruct the original name from the prefix (strip the -part_NN suffix).
 local base
 base=$(basename "${parts[0]}")
 local restored="${PWD}/${base%-part_*}-restored"

 echo "Merging file back together..."
 cat "${parts[@]}" >"${restored}"

 echo "Merged: ${restored}"
}

# Wrap the main interactive logic into its own function
function file-splitter-menu {
 case $(echo -e "Split\nJoin\nQuit" | fzf --border=rounded --ansi) in
  "Split")
   split-file
   ;;
  "Join")
   join-file
   ;;
  "Quit")
   echo "Goodbye."
   # Safely exit: returns if sourced, exits if executed directly
   return 0 2>/dev/null || exit 0
   ;;
  *)
   echo "No option selected."
   ;;
 esac
}

# Automatically launch the menu when the script is run or sourced
file-splitter-menu
