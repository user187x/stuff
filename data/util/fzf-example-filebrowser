#!/bin/bash

function browse-files {

 # Store the original directory so we can return to it if we cancel
 local START_DIR="$PWD"

 while true; do
  # 1. Build the list of files and directories.
  # We manually add '..' at the top, followed by directories (📁), then files (📄)
  local LIST
  LIST=$( (
   echo "📁 .."
   find . -maxdepth 1 -mindepth 1 -type d | sed 's|^\./|📁 |' | sort
   find . -maxdepth 1 -mindepth 1 -type f | sed 's|^\./|📄 |' | sort
  ))

  # 2. Run fzf with --expect to capture which key was pressed
  local OUT
  OUT=$(echo "$LIST" | fzf \
   --prompt="📂 ${PWD##*/}> " \
   --header="ENTER to CD/Select | CTRL-E to edit file | ESC to cancel" \
   --expect=ctrl-e \
   --layout=reverse --border="rounded" \
   --ansi \
   --preview="
        item=\$(echo {} | sed 's/^[📁📄] //')
        if [[ \"\$item\" == \"..\" ]]; then
            # Force color output for ls
            ls -lhA --color=always .. | head -n 50
        elif [[ -d \"\$item\" ]]; then
            # Force color output for ls
            ls -lhA --color=always \"\$item\" | head -n 50
        elif [[ -f \"\$item\" ]]; then
            # Use bat for syntax-highlighted colored output if available, else fallback to head
            if command -v bat >/dev/null 2>&1; then
                bat --color=always --style=numbers --line-range :100 \"\$item\" 2>/dev/null
            elif command -v batcat >/dev/null 2>&1; then
                batcat --color=always --style=numbers --line-range :100 \"\$item\" 2>/dev/null
            else
                head -n 100 \"\$item\" 2>/dev/null || echo \"Binary file or preview unavailable.\"
            fi
        fi
    " \
   --preview-window=right:60%:wrap)

  # 3. Handle Cancellation (ESC)
  if [[ -z "$OUT" ]]; then
   cd "$START_DIR" || return
   break
  fi

  # 4. Parse the output.
  # --expect prints the key on line 1, and the selected item on line 2.
  local KEY=$(echo "$OUT" | head -n 1)
  local RAW_ITEM=$(echo "$OUT" | tail -n +2)
  local ITEM=$(echo "$RAW_ITEM" | sed 's/^[📁📄] //') # Strip our visual icons

  # 5. Route the action based on the key pressed and item type
  if [[ "$KEY" == "ctrl-e" ]]; then
   if [[ -f "$ITEM" ]]; then
    nano "$ITEM" </dev/tty >/dev/tty
   else
    echo "❌ Cannot edit a directory."
    sleep 1
   fi
  else
   # Default action (ENTER)
   if [[ "$ITEM" == ".." ]]; then
    cd ..
   elif [[ -d "$ITEM" ]]; then
    cd "$ITEM"
   elif [[ -f "$ITEM" ]]; then
    clear
    echo "✅ Selected File: $(pwd)/$ITEM"

    # --- ADD YOUR CUSTOM FILE LOGIC HERE ---
    # For now, it just prints the path and pauses.
    read -n 1 -s -r -p "Press any key to return to the menu..."
    break
   fi
  fi
 done
}

browse-files "$@"
