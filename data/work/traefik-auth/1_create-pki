#!/bin/bash
set -e

echo "==================================================="
echo " 🔒 Local PKI & Host DNS Provisioner"
echo "==================================================="

# 1. Gather Inputs
DEFAULT_DOMAIN="test.xxx"
read -e -p " (?) Enter the desired Domain [default: $DEFAULT_DOMAIN]: " -i "$DEFAULT_DOMAIN" DOMAIN
DOMAIN=${DOMAIN:-$DEFAULT_DOMAIN}

read -p " (?) Enter the target IP address (Press Enter for default: 127.0.0.1): " TARGET_IP
TARGET_IP=${TARGET_IP:-127.0.0.1}

# 2. PKI Generation
OUT_DIR="$PWD/certs"
mkdir -p "$OUT_DIR"
cd "$OUT_DIR"

echo -e "\n(i) Generating Root Certificate Authority (CA)..."
openssl genrsa -out ca.key 4096
ca_args=(-x509 -new -nodes -key ca.key -sha256 -days 365 -out ca-cert.pem -subj "/O=XXX Root CA/CN=${DOMAIN} Root CA")
openssl req "${ca_args[@]}"

echo -e "(i) Generating Server Certificate (${DOMAIN})..."
openssl genrsa -out server.key 4096
server_csr_args=(-new -key server.key -out server.csr -subj "/O=XXX Cert/CN=${DOMAIN}")
openssl req "${server_csr_args[@]}"

cat >server-ext.cnf <<EOF
authorityKeyIdentifier=keyid,issuer
basicConstraints=CA:FALSE
keyUsage = digitalSignature, nonRepudiation, keyEncipherment, dataEncipherment
subjectAltName = @alt_names
[alt_names]
DNS.1 = ${DOMAIN}
EOF

server_cert_args=(-req -in server.csr -CA ca-cert.pem -CAkey ca.key -CAcreateserial -out server.crt -days 365 -sha256 -extfile server-ext.cnf)
openssl x509 "${server_cert_args[@]}"

echo -e "(i) Generating Wildcard Server Certificate (*.${DOMAIN})..."
openssl genrsa -out server-wildcard.key 4096
wildcard_csr_args=(-new -key server-wildcard.key -out server-wildcard.csr -subj "/O=XXX Wildcard Cert/CN=*.${DOMAIN}")
openssl req "${wildcard_csr_args[@]}"

cat >wildcard-ext.cnf <<EOF
authorityKeyIdentifier=keyid,issuer
basicConstraints=CA:FALSE
keyUsage = digitalSignature, nonRepudiation, keyEncipherment, dataEncipherment
subjectAltName = @alt_names
[alt_names]
DNS.1 = *.${DOMAIN}
DNS.2 = ${DOMAIN}
EOF

wildcard_cert_args=(-req -in server-wildcard.csr -CA ca-cert.pem -CAkey ca.key -CAcreateserial -out server-wildcard.crt -days 365 -sha256 -extfile wildcard-ext.cnf)
openssl x509 "${wildcard_cert_args[@]}"

echo -e "(i) Generating Client Certificate (for mTLS)..."
openssl genrsa -out client.key 4096
client_csr_args=(-new -key client.key -out client.csr -subj "/O=XXX Client/CN=client.${DOMAIN}")
openssl req "${client_csr_args[@]}"
client_cert_args=(-req -in client.csr -CA ca-cert.pem -CAkey ca.key -CAcreateserial -out client.crt -days 365 -sha256)
openssl x509 "${client_cert_args[@]}"

echo -e "\n\e[90m(*) Verifying Certificates...\e[0m"
openssl verify -CAfile ca-cert.pem server.crt server-wildcard.crt client.crt

# 3. Local Host DNS Updater
echo -e "\n==================================================="
echo " 🌐 Updating /etc/hosts"
echo "==================================================="

MARKER="# Added by Local PKI Toolkit"
HOSTS_ENTRY="${TARGET_IP} ${DOMAIN} ${MARKER}"
HOSTS_FILE="/etc/hosts"

if grep -q "[[:space:]]${DOMAIN}\b" "$HOSTS_FILE"; then
 EXISTING_IP=$(awk -v dom="$DOMAIN" '$2 == dom {print $1; exit}' "$HOSTS_FILE")
 if [ "$EXISTING_IP" == "$TARGET_IP" ]; then
  echo "✅ Domain '${DOMAIN}' is already mapped to ${TARGET_IP}. No changes needed."
 else
  echo "⚠️  Domain '${DOMAIN}' is currently mapped to ${EXISTING_IP}. Manually edit ${HOSTS_FILE} to update."
 fi
else
 echo -e "Adding '${DOMAIN}' -> '${TARGET_IP}' to ${HOSTS_FILE}..."
 echo "You may be prompted for your administrator password to modify the hosts file."
 echo "$HOSTS_ENTRY" | sudo tee -a "$HOSTS_FILE" >/dev/null
 echo "✅ Hosts file updated successfully!"
fi

echo -e "\n✅ \e[92mHost Provisioning Complete! Traffic to https://${DOMAIN} is ready.\e[0m"
