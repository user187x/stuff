#!/bin/bash

# ==============================================================================
# Universal PEM Private Key Securer
# Encrypts any standard PKI private key using AES-256.
# ==============================================================================

# 1. Validate Input
if [ -z "$1" ]; then
 echo "Usage: $0 <path-to-pem-file>"
 exit 1
fi

INPUT_FILE="$1"
OUTPUT_FILE="${INPUT_FILE%.*}_secured.pem"

if [ ! -f "$INPUT_FILE" ]; then
 echo "Error: File '$INPUT_FILE' not found."
 exit 1
fi

# 2. Check for Private Key presence
# We check for "PRIVATE KEY" to cover "RSA PRIVATE KEY", "EC PRIVATE KEY", etc.
if ! grep -q "PRIVATE KEY" "$INPUT_FILE"; then
 echo "Error: No private key found in '$INPUT_FILE'."
 echo "Reminder: Certificates (public keys) do not get password protected."
 exit 1
fi

echo "Securing '$INPUT_FILE' with AES-256 encryption..."

# 3. Encrypt using openssl pkey
# 'pkey' is the modern command that handles all key types (RSA, EC, etc.) universally.
openssl pkey -in "$INPUT_FILE" -out "$OUTPUT_FILE" -aes256

# 4. Handle Output and Permissions
if [ $? -eq 0 ]; then
 # Lock down file permissions immediately
 chmod 600 "$OUTPUT_FILE"
 echo "---------------------------------------------------"
 echo "Success! Secured key saved to: $OUTPUT_FILE"
 echo "Permissions restricted to 600 (owner read/write only)."
 echo "---------------------------------------------------"

 # Check if the original file had both a cert and a key
 if grep -q "BEGIN CERTIFICATE" "$INPUT_FILE"; then
  echo "⚠️  NOTE: Your original file contained BOTH a key and a certificate."
  echo "The 'openssl pkey' command only extracts and encrypts the key."
  echo "To recreate a combined file, run: cat $OUTPUT_FILE public_cert.pem > new_combined.pem"
 fi
else
 echo "Error: Encryption process failed."
 # Clean up empty/corrupted output file if it was created
 rm -f "$OUTPUT_FILE"
 exit 1
fi
