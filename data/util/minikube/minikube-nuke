#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

echo "=================================================="
echo "⚠️  WARNING: This will completely wipe Minikube!"
echo "All clusters, containers, and data will be destroyed."
echo "=================================================="

read -p "Are you sure you want to proceed? (y/N) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
 echo "Operation cancelled."
 exit 1
fi

echo "🧹 Starting Minikube cleanup..."

# 1. Stop and delete the minikube cluster via CLI if possible
if command -v minikube &>/dev/null; then
 echo "-> Stopping minikube..."
 minikube stop --all || true
 echo "-> Deleting minikube profile/cluster..."
 minikube delete --all --purge || true
else
 echo "-> Minikube CLI not found, skipping CLI deletion steps."
fi

# 2. Kill any lingering minikube/docker/podman driver processes
echo "-> Terminating lingering VM or driver processes..."
pkill -f minikube || true

# 3. Remove Minikube configuration and state directories
echo "-> Removing local configuration files and directories..."
rm -rf ~/.minikube

# 4. Clean up Docker/Podman artifacts if applicable (optional but thorough)
if command -v docker &>/dev/null; then
 echo "-> Pruning dangling Docker containers, networks, and volumes related to minikube..."
 docker container prune -f || true
 docker volume ls -q --filter name=minikube | xargs -r docker volume rm || true
 docker network ls -q --filter name=minikube | xargs -r docker network rm || true
fi

# 5. Remove kubectl context entries for minikube if they persist
if command -v kubectl &>/dev/null; then
 echo "-> Cleaning up kubectl context..."
 kubectl config delete-context minikube || true
 kubectl config delete-cluster minikube || true
 kubectl config unset users.minikube || true
fi

echo "=================================================="
echo "✨ Minikube has been completely nuked and wiped clean!"
echo "=================================================="
