#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

# Terminal colors for readable output
CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

PROJECT_DIR="rust-hello-world"

echo -e "${CYAN}[*] Starting Rust educational workspace setup...${NC}"

# 1. Ensure System Dependencies (C Linker) are installed
# Rust requires a linker (like gcc) to compile executables.
if ! command -v cc &>/dev/null; then
 echo -e "${YELLOW}[!] C linker not found. Installing build-essential via apt (requires sudo)...${NC}"
 sudo apt-get update && sudo apt-get install -y build-essential curl
fi

# 2. Ensure the Rust toolchain is installed
if ! command -v cargo &>/dev/null; then
 echo -e "${YELLOW}[!] Rust/Cargo is not installed. Installing via rustup...${NC}"
 # The -y flag automatically accepts the default installation parameters
 curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

 # Source the environment so cargo is available in the current shell session
 echo -e "${CYAN}[*] Sourcing Cargo environment...${NC}"
 source "$HOME/.cargo/env"
else
 echo -e "${GREEN}[✔] Rust is already installed:${NC} $(rustc --version)"
fi

# 3. Setup the directory structure using Cargo
echo -e "${CYAN}[*] Scaffolding project via Cargo: ${PROJECT_DIR}${NC}"
# Cargo new automatically creates the directory, initializes git, creates a Cargo.toml, and a src/main.rs
if [ ! -d "${PROJECT_DIR}" ]; then
 cargo new "${PROJECT_DIR}"
else
 echo -e "${YELLOW}[!] Directory ${PROJECT_DIR} already exists. Skipping scaffolding.${NC}"
fi

cd "${PROJECT_DIR}"

# 4. Customize the Hello World source code
echo -e "${CYAN}[*] Customizing src/main.rs...${NC}"
cat <<'EOF' >src/main.rs
fn main() {
    // println! is a Rust macro (denoted by the !), not just a standard function.
    println!("🚀 Hello, World! Your Rust environment is successfully configured and compiled.");
}
EOF

# 5. Compile the project
# This reads the Cargo.toml and src/main.rs, compiles the code, and creates a debug binary.
echo -e "${CYAN}[*] Compiling the project...${NC}"
cargo build

# 6. Run the compiled binary
echo -e "${GREEN}[✔] Setup complete! Executing the compiled binary...${NC}"
echo "--------------------------------------------------------"
# Cargo puts compiled development binaries in the target/debug directory
./target/debug/${PROJECT_DIR}
echo "--------------------------------------------------------"

echo -e "${CYAN}[*] You can also run the project directly using 'cargo run' inside the directory.${NC}"
