#!/bin/bash

# Option 1
parse_arguments() {
 # Initialize default variables
 SOURCE=""
 DESTINATION=""

 # Loop through all arguments
 while [[ $# -gt 0 ]]; do
  case "$1" in
  -s | --source)
   SOURCE="$2"
   shift 2 # Move past the flag and its value
   ;;
  -d | --destination)
   DESTINATION="$2"
   shift 2 # Move past the flag and its value
   ;;
  -h | --help)
   echo "Usage: parse_arguments [-s|--source <path>] [-d|--destination <path>]"
   return 0
   ;;
  -*)
   echo "Error: Unknown option $1" >&2
   return 1
   ;;
  *)
   # Handle positional arguments if necessary, or just skip
   echo "Ignoring positional argument: $1"
   shift 1
   ;;
  esac
 done

 # Output for demonstration purposes
 echo "Source provided: $SOURCE"
 echo "Destination provided: $DESTINATION"
}

parse_arguments_getopt "$@"

#------------------------------------------------------------------------------------

# Option 2
parse_arguments_getopt() {
 # Initialize default variables
 SOURCE=""
 DESTINATION=""

 # Execute getopt to parse short (s:d:) and long (source:,destination:) options
 # The colon (:) means the option requires an argument
 PARSED_ARGS=$(getopt -o s:d: --long source:,destination: --name "$0" -- "$@")

 # Check if getopt failed
 if [[ $? -ne 0 ]]; then
  echo "Error: Failed to parse arguments." >&2
  return 1
 fi

 # Replace the current positional parameters with the parsed ones
 eval set -- "$PARSED_ARGS"

 # Extract the options
 while [[ $# -gt 0 ]]; do
  case "$1" in
  -s | --source)
   SOURCE="$2"
   shift 2
   ;;
  -d | --destination)
   DESTINATION="$2"
   shift 2
   ;;
  --)
   # End of options marker
   shift
   break
   ;;
  *)
   echo "Programming error: Unrecognized option $1" >&2
   return 1
   ;;
  esac
 done

 # Output for demonstration purposes
 echo "Source provided: $SOURCE"
 echo "Destination provided: $DESTINATION"
}

parse_arguments "$@"
