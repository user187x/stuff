#!/bin/bash

# Fail & Bail
set -e

# System designated directories
RESOURCE_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Specific resource being installed
RESOURCE="tmux"

# Specific resource paths
DESTINATION="${CONFIG_HOME}/tmux"
SOURCE_PATH="${RESOURCE_HOME}/${RESOURCE}"

function process-payload {

 local TPM_SCRIPT="${DESTINATION}/plugins/tpm/bin/install_plugins"

 # PATCH: Ensure the script is executable before the check
 if [[ -f "${TPM_SCRIPT}" ]]; then
  chmod +x "${TPM_SCRIPT}"
 fi

 if [[ -x "${TPM_SCRIPT}" ]]; then
  echo "Running Tmux Plugin-Manager installation..."
  # Running inside a subshell to avoid directory changing side-effects
  ("${TPM_SCRIPT}")
 else
  echo "Error: TPM installer not found or not executable at path: ${TPM_SCRIPT}"
  exit 1
 fi
}

function link-resource {

 local SRC="$1"
 local DST="$2"
 local DST_PATH=$(dirname "$DST")

 mkdir -p "$DST_PATH"

 if [[ -e "$DST" ||
  -L "$DST" ]]; then
  rm -rf "$DST"
 fi

 ln -s "$SRC" "$DST"
 echo "Linked: $DST -> $SRC"
}

function install-logic {

 echo "Installing ${RESOURCE}..."

 link-resource "${SOURCE_PATH}" "${DESTINATION}"
 process-payload

 echo "${RESOURCE} updated!"
 echo
}

function process-arguments {
 while [[ $# -gt 0 ]]; do
  case "$1" in
  -s | --source)
   SOURCE_PATH="$2"
   shift 2
   ;;
  -d | --destination)
   DESTINATION="$2"
   shift 2
   ;;
  -h | --help)
   echo "Usage: load-resources [-s|--source <path>] [-d|--destination <path>]"
   return 0
   ;;
  *)
   echo "Ignoring positional argument: $1"
   shift 1
   ;;
  esac
 done
}

function main {

 if [[ "$#" -gt 0 ]]; then
  process-arguments "$@"
 fi

 install-logic "$@"
}

main "$@"
