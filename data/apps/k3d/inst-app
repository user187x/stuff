#!/usr/bin/env bash

# Exit immediately if any command fails
set -euo pipefail

DOMAIN_SUFFIX="xxx.local"
GATEWAY_NAME="traefik-gateway"

TRAEFIK_NS="traefik"
PODINFO_NS="podinfo"

TLS_WILDCARD_SECRET="wildcard-tls-cert"

# FIX: the Gateway must terminate TLS with a certificate whose SANs cover
# *.xxx.local. The old pki/tls.crt only covered "xxx.local", which browsers
# reject for traefik.xxx.local / podinfo.xxx.local. We now use the wildcard
# pair produced by ./gen-certs.
TLS_CRT="pki/tls-wildcard.crt"
TLS_KEY="pki/tls-wildcard.key"
TLS_CA="pki/ca.crt"

# Optional vendored copy of the Gateway API CRDs. Leave empty (or delete the
# file) to download the pinned release instead.
CRD_FILE="lib/manifest.yaml"

# Gateway API release supported by current Traefik v3 (the version Traefik's
# own quickstart installs). Do not bump blindly — Traefik validates it.
GATEWAY_API_VERSION="1.5.1"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "=========================================================="
echo "🚀 Bootstrapping Gateway API (v${GATEWAY_API_VERSION}) with Traefik"
echo "=========================================================="

# -----------------------------------------------------------------------------
# Validate (and if possible, generate) the TLS assets
# -----------------------------------------------------------------------------
echo "Validating local TLS certificates..."

if [[ ! -f "${TLS_CRT}" || ! -f "${TLS_KEY}" ]]; then
 if [[ -x "${SCRIPT_DIR}/gen-certs" ]]; then
  echo "ℹ️  Wildcard cert not found — running ./gen-certs to create it..."
  DOMAIN_SUFFIX="${DOMAIN_SUFFIX}" "${SCRIPT_DIR}/gen-certs"
 else
  echo "❌ Error: '${TLS_CRT}' / '${TLS_KEY}' not found and ./gen-certs is missing."
  echo "Please generate the wildcard certs and try again."
  exit 1
 fi
fi

for file in "${TLS_CRT}" "${TLS_KEY}" "${TLS_CA}"; do
 if [[ ! -f "$file" ]]; then
  echo "❌ Error: Required file '$file' not found in current directory."
  exit 1
 fi
done

# FIX: fail fast if the cert does not actually cover *.${DOMAIN_SUFFIX} —
# this is exactly the mistake that made the browser reject the old setup.
if ! openssl x509 -in "${TLS_CRT}" -noout -ext subjectAltName 2>/dev/null \
   | grep -q "DNS:\*\.${DOMAIN_SUFFIX}"; then
 echo "❌ Error: '${TLS_CRT}' does not contain SAN 'DNS:*.${DOMAIN_SUFFIX}'."
 echo "Browsers will reject it for traefik.${DOMAIN_SUFFIX} / podinfo.${DOMAIN_SUFFIX}."
 echo "Run ./gen-certs to issue a proper wildcard certificate."
 exit 1
fi
echo "✅ Certificates found and SANs cover *.${DOMAIN_SUFFIX}."
echo ""

# -----------------------------------------------------------------------------
# Install Gateway API CRDs
# -----------------------------------------------------------------------------
# FIX: the original condition was inverted — CRD_FILE was always non-empty, so
# the script always tried the local file and crashed when it didn't exist.
# New behavior: use the vendored file only if it actually exists, otherwise
# download the pinned release.
# -----------------------------------------------------------------------------
DOWNLOAD_URL="https://github.com/kubernetes-sigs/gateway-api/releases/download/v${GATEWAY_API_VERSION}/standard-install.yaml"

echo "Installing Kubernetes Gateway API CRDs (v${GATEWAY_API_VERSION})..."

if [[ -n "${CRD_FILE}" && -f "${CRD_FILE}" ]]; then
 kubectl apply -f "${CRD_FILE}"
else
 kubectl apply -f "${DOWNLOAD_URL}"
fi

echo
echo "✅ Gateway API CRDs installed."
echo ""

# -----------------------------------------------------------------------------
# Namespaces + TLS Secret
# The TLS secret must live in the exact same namespace as the Gateway resource.
# -----------------------------------------------------------------------------
echo "Setting up namespaces and TLS Secret..."

kubectl create namespace "${TRAEFIK_NS}" --dry-run=client -o yaml | kubectl apply -f -
kubectl create namespace "${PODINFO_NS}" --dry-run=client -o yaml | kubectl apply -f -

kubectl create secret tls "${TLS_WILDCARD_SECRET}" \
 --namespace "${TRAEFIK_NS}" \
 --cert="${TLS_CRT}" \
 --key="${TLS_KEY}" \
 --dry-run=client -o yaml | kubectl apply -f -

echo
echo "✅ Secrets and Namespaces provisioned."
echo

# -----------------------------------------------------------------------------
# Install Traefik
# -----------------------------------------------------------------------------
# FIXES vs the original values:
#   • Removed "ports.websecure.port: 443". Traefik runs as non-root and cannot
#     bind ports <1024 — the pod crash-looped. The container keeps listening
#     on 8443; the Service still exposes it as 443 (chart default), and k3s
#     ServiceLB + the k3d "-p 443:443@loadbalancer" mapping carry it to the
#     host.
#   • Removed "ports.traefik.port: 9000" (that's already the default); kept
#     expose.default=true so the dashboard HTTPRoute can target Service:9000.
#   • gateway.enabled=false: the chart otherwise creates its OWN Gateway named
#     "traefik-gateway", which collides with the one we create below. The
#     chart still creates the GatewayClass "traefik" for us.
#   • Official chart repo URL.
# -----------------------------------------------------------------------------
echo "Installing Traefik Ingress Controller..."

helm repo add traefik https://traefik.github.io/charts --force-update >/dev/null
helm repo update >/dev/null

cat <<EOF >traefik-values.yaml
providers:
  kubernetesGateway:
    enabled: true
gateway:
  # We manage our own Gateway below (with TLS); disable the chart's default one.
  enabled: false
gatewayClass:
  enabled: true
ports:
  web:
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  traefik:
    expose:
      default: true
additionalArguments:
  - "--api.dashboard=true"
  - "--api.insecure=true"
EOF

helm upgrade --install traefik traefik/traefik \
 --namespace "${TRAEFIK_NS}" \
 --values traefik-values.yaml \
 --wait

echo
echo "✅ Traefik installed and configured."
echo

# -----------------------------------------------------------------------------
# Create the Gateway
# -----------------------------------------------------------------------------
# The Gateway represents the logical load balancer. We bind it to the chart-
# created 'traefik' GatewayClass and terminate TLS with our wildcard secret.
# We allow routes from 'All' namespaces so developers can define HTTPRoutes in
# their own application namespaces.
#
# FIX: listener port is 8443, NOT 443. Traefik requires the Gateway listener
# port to match one of its ENTRYPOINT ports (websecure listens on 8443 inside
# the container). The Kubernetes Service maps 443 → 8443, so the browser still
# uses standard https://... on 443.
# -----------------------------------------------------------------------------
GATEWAY_CLASS_NAME="traefik"

echo "Provisioning the Gateway resource..."

cat <<EOF | kubectl apply -f -
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: "${GATEWAY_NAME}"
  namespace: ${TRAEFIK_NS}
spec:
  gatewayClassName: ${GATEWAY_CLASS_NAME}
  listeners:
  - name: https
    port: 8443
    protocol: HTTPS
    hostname: "*.${DOMAIN_SUFFIX}"
    allowedRoutes:
      namespaces:
        from: All
    tls:
      mode: Terminate
      certificateRefs:
      - name: ${TLS_WILDCARD_SECRET}
        kind: Secret
EOF

kubectl wait --for=condition=Programmed "gateway/${GATEWAY_NAME}" \
 --namespace "${TRAEFIK_NS}" --timeout=120s

echo
echo "✅ Gateway resource provisioned and programmed."
echo

# -----------------------------------------------------------------------------
# Deploy Podinfo
# -----------------------------------------------------------------------------
echo "Deploying Podinfo application..."

helm repo add podinfo https://stefanprodan.github.io/podinfo --force-update >/dev/null
helm repo update >/dev/null

helm upgrade --install podinfo podinfo/podinfo \
 --namespace "${PODINFO_NS}" \
 --set ui.color="#81a1c1" \
 --wait

echo
echo "✅ Podinfo deployed."
echo

# -----------------------------------------------------------------------------
# Wire up the HTTPRoutes
# -----------------------------------------------------------------------------
# HTTPRoutes attach to a 'parentRef' (our Gateway). Traffic hitting the
# Gateway's https listener is matched against 'hostnames' and forwarded to the
# respective backend Services.
# -----------------------------------------------------------------------------
echo "Configuring HTTPRoutes for Dashboard and App..."

echo
echo "Creating HTTPRoute for Traefik Dashboard..."
echo

TRAEFIK_HTTPROUTE_NAME="traefik-route"
TRAEFIK_DASHBOARD_SVC_PORT="9000"
TRAEFIK_DASHBOARD_SVC_NAME="traefik"

cat <<EOF | kubectl apply -f -
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${TRAEFIK_HTTPROUTE_NAME}
  namespace: ${TRAEFIK_NS}
spec:
  parentRefs:
  - name: ${GATEWAY_NAME}
    namespace: ${TRAEFIK_NS}
  hostnames:
  - traefik.${DOMAIN_SUFFIX}
  rules:
  - backendRefs:
    - name: ${TRAEFIK_DASHBOARD_SVC_NAME}
      port: ${TRAEFIK_DASHBOARD_SVC_PORT}
EOF

echo
echo "Creating HTTPRoute for Podinfo..."
echo

PODINFO_HTTPROUTE_NAME="podinfo-route"
PODINFO_SVC_PORT="9898"
PODINFO_SVC_NAME="podinfo"

cat <<EOF | kubectl apply -f -
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${PODINFO_HTTPROUTE_NAME}
  namespace: ${PODINFO_NS}
spec:
  parentRefs:
  - name: ${GATEWAY_NAME}
    namespace: ${TRAEFIK_NS}
  hostnames:
  - podinfo.${DOMAIN_SUFFIX}
  rules:
  - backendRefs:
    - name: ${PODINFO_SVC_NAME}
      port: ${PODINFO_SVC_PORT}
EOF

echo "✅ HTTPRoutes mapped."

echo
echo "=========================================================="
echo "🎉 Setup Complete!"
echo "=========================================================="
echo "Your Gateway is terminating TLS for *.${DOMAIN_SUFFIX}."
echo
echo "Run ./cnct-web once to add the hostnames to /etc/hosts, then browse:"
echo "  👉 Traefik Dashboard : https://traefik.${DOMAIN_SUFFIX}/dashboard/"
echo "  👉 Podinfo UI        : https://podinfo.${DOMAIN_SUFFIX}/"
