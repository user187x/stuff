#!/usr/bin/env bash
# terraform-apply
#
# One-command Talos Kubernetes cluster on VirtualBox.
#
# What this script owns (imperative, can't be Terraform-ified cleanly):
#   * Creating / configuring the VirtualBox host-only network
#   * Creating / configuring the host-only DHCP server
#   * Registering per-MAC DHCP reservations so node IPs are deterministic
#     and known BEFORE Terraform plans
#   * Downloading the Talos metal ISO
#   * Rendering terraform.tfvars.json from the per-run inputs
#   * Running `terraform init && terraform apply`
#
# The .tf files (providers.tf, variables.tf, main.tf, talos.tf) are the
# source of truth for the cluster shape; this script only feeds them.
#
# Usage:
#   ./terraform-apply
#   CP_COUNT=3 WORKER_COUNT=3 ./terraform-apply
#
# Env vars (all optional):
#   CP_COUNT       number of control-plane nodes (default 1)
#   WORKER_COUNT   number of worker nodes        (default 2)
#   TALOS_VERSION  Talos release tag             (default v1.8.3)
#   CLUSTER_NAME   talos cluster name            (default talos-local)
#   VM_MEMORY      MiB per VM                    (default 2048)
#   VM_CPUS        vCPUs per VM                  (default 2)
#   VM_DISK_MB     disk size MiB                 (default 12288)
#   HOSTONLY_NET   host-only iface name          (default vboxnet0)

set -euo pipefail

# ---------- Configuration ----------
CP_COUNT="${CP_COUNT:-1}"
WORKER_COUNT="${WORKER_COUNT:-2}"
TALOS_VERSION="${TALOS_VERSION:-v1.8.3}"
CLUSTER_NAME="${CLUSTER_NAME:-talos-local}"
VM_MEMORY="${VM_MEMORY:-2048}"
VM_CPUS="${VM_CPUS:-2}"
VM_DISK_MB="${VM_DISK_MB:-12288}"

# Host-only network. 192.168.56.0/24 is inside the default
# VirtualBox-allowed range (192.168.56.0/21 on macOS), so no
# /etc/vbox/networks.conf edits are needed.
HOSTONLY_NET="${HOSTONLY_NET:-vboxnet0}"
HOSTONLY_HOST_IP="192.168.56.1"
HOSTONLY_NETMASK="255.255.255.0"
DHCP_LOWER="192.168.56.100"
DHCP_UPPER="192.168.56.250"
SUBNET_PREFIX="192.168.56"
CP_IP_BASE_OCTET=110     # cp nodes get .110, .111, ...
WORKER_IP_BASE_OCTET=130 # worker nodes get .130, .131, ...

GREEN='\033[0;32m'; BLUE='\033[0;34m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
log_info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
log_success() { echo -e "${GREEN}[OK]${NC}   $*"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error()   { echo -e "${RED}[ERR]${NC}  $*"; }

# Run from the directory the script lives in, so paths are predictable
# regardless of where the user invokes it from.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# ---------- 1. Validate counts ----------
if ! [[ "$CP_COUNT" =~ ^[0-9]+$ ]] || (( CP_COUNT < 1 )); then
  log_error "CP_COUNT must be a positive integer (got: $CP_COUNT)"; exit 1
fi
if ! [[ "$WORKER_COUNT" =~ ^[0-9]+$ ]] || (( WORKER_COUNT < 0 )); then
  log_error "WORKER_COUNT must be a non-negative integer (got: $WORKER_COUNT)"; exit 1
fi
if (( CP_COUNT > 19 )); then
  log_error "CP_COUNT too large; adjust IP base octets in this script."; exit 1
fi
if (( WORKER_COUNT > 119 )); then
  log_error "WORKER_COUNT too large; adjust IP base octets in this script."; exit 1
fi

log_info "Cluster plan: ${CP_COUNT} control-plane, ${WORKER_COUNT} worker (Talos ${TALOS_VERSION})"

# ---------- 2. Prerequisite checks ----------
log_info "Checking prerequisites..."
missing=0
for cmd in terraform VBoxManage talosctl kubectl curl jq; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    log_error "$cmd not found in PATH"
    missing=1
  fi
done
if (( missing != 0 )); then
  cat <<EOF >&2

Install hints:
  terraform   https://developer.hashicorp.com/terraform/install
  VBoxManage  ships with VirtualBox: https://www.virtualbox.org/
  talosctl    https://www.talos.dev/v1.8/introduction/getting-started/#talosctl
  kubectl     https://kubernetes.io/docs/tasks/tools/
  curl, jq    your OS package manager
EOF
  exit 1
fi
log_success "All prerequisites found."

# ---------- 3. Host-only network ----------
log_info "Configuring VirtualBox host-only network ${HOSTONLY_NET}..."
if ! VBoxManage list hostonlyifs | awk '/^Name:/{print $2}' | grep -qx "$HOSTONLY_NET"; then
  log_info "  ${HOSTONLY_NET} doesn't exist; creating..."
  # `hostonlyif create` always picks the next free vboxnetN; if the user
  # asked for a different name we use whatever VBox actually created.
  created=$(VBoxManage hostonlyif create 2>&1 | awk -F"'" '/successfully created/{print $2; exit}')
  if [[ -z "${created:-}" ]]; then
    log_error "Failed to create host-only interface."; exit 1
  fi
  if [[ "$created" != "$HOSTONLY_NET" ]]; then
    log_warn "  VirtualBox created '${created}' (you asked for '${HOSTONLY_NET}'); using '${created}'."
    HOSTONLY_NET="$created"
  fi
fi
VBoxManage hostonlyif ipconfig "$HOSTONLY_NET" \
  --ip "$HOSTONLY_HOST_IP" --netmask "$HOSTONLY_NETMASK" >/dev/null
log_success "Host-only ${HOSTONLY_NET} -> ${HOSTONLY_HOST_IP}/${HOSTONLY_NETMASK}"

# ---------- 4. DHCP server on the host-only network ----------
dhcp_net_name="HostInterfaceNetworking-${HOSTONLY_NET}"
if VBoxManage list dhcpservers | grep -q "^NetworkName: *${dhcp_net_name}$"; then
  log_info "Reconfiguring DHCP server on ${HOSTONLY_NET}..."
  VBoxManage dhcpserver modify --network="$dhcp_net_name" \
    --server-ip="$HOSTONLY_HOST_IP" --netmask="$HOSTONLY_NETMASK" \
    --lower-ip="$DHCP_LOWER" --upper-ip="$DHCP_UPPER" --enable >/dev/null
else
  log_info "Creating DHCP server on ${HOSTONLY_NET}..."
  VBoxManage dhcpserver add --network="$dhcp_net_name" \
    --server-ip="$HOSTONLY_HOST_IP" --netmask="$HOSTONLY_NETMASK" \
    --lower-ip="$DHCP_LOWER" --upper-ip="$DHCP_UPPER" --enable >/dev/null
fi
log_success "DHCP enabled (${DHCP_LOWER} - ${DHCP_UPPER})"

# ---------- 5. ISO ----------
ISO_FILE="talos-${TALOS_VERSION}-metal-amd64.iso"
ISO_URL="https://github.com/siderolabs/talos/releases/download/${TALOS_VERSION}/metal-amd64.iso"
if [[ ! -s "$ISO_FILE" ]]; then
  log_info "Downloading Talos ISO ${TALOS_VERSION}..."
  curl -fL --progress-bar -o "$ISO_FILE.tmp" "$ISO_URL"
  mv "$ISO_FILE.tmp" "$ISO_FILE"
  log_success "ISO saved: ${ISO_FILE}"
else
  log_success "ISO already present: ${ISO_FILE}"
fi
ISO_PATH="$(pwd)/${ISO_FILE}"

# VMs live under the project dir, not VirtualBox's global default folder
# (which has bitten users when it's owned by root from a prior sudo, or
# when it doesn't exist on a fresh install).
VMS_BASEFOLDER="$(pwd)/vms"
mkdir -p "$VMS_BASEFOLDER"

# ---------- 6. Build the node table (name, MAC, IP, role) ----------
declare -a NODES=()
for i in $(seq 0 $((CP_COUNT - 1))); do
  name="talos-cp-${i}"
  mac=$(printf "08:00:27:CC:%02X:00" "$i")
  ip="${SUBNET_PREFIX}.$((CP_IP_BASE_OCTET + i))"
  NODES+=("${name}|${mac}|${ip}|controlplane")
done
for i in $(seq 0 $((WORKER_COUNT - 1))); do
  name="talos-worker-${i}"
  mac=$(printf "08:00:27:77:%02X:00" "$i")
  ip="${SUBNET_PREFIX}.$((WORKER_IP_BASE_OCTET + i))"
  NODES+=("${name}|${mac}|${ip}|worker")
done

# ---------- 7. DHCP reservations ----------
log_info "Registering DHCP reservations..."
for node in "${NODES[@]}"; do
  IFS='|' read -r name mac ip role <<<"$node"
  # VBoxManage 7.0+ uses a selector form: `--mac-address=X` picks the
  # per-MAC config, then `--remove-config` deletes it or `--fixed-address`
  # (re)assigns it. The older `--add-fixed` / `--remove-fixed` flags from
  # 6.x are gone. Clear any stale per-MAC config first (best-effort), then
  # set the reservation.
  VBoxManage dhcpserver modify --network="$dhcp_net_name" \
    --mac-address="$mac" --remove-config >/dev/null 2>&1 || true
  VBoxManage dhcpserver modify --network="$dhcp_net_name" \
    --mac-address="$mac" --fixed-address="$ip" >/dev/null
  log_info "  ${ip}  ${mac}  ${name} (${role})"
done
log_success "Reservations in place."

# ---------- 8. Render terraform.tfvars.json ----------
cp_ips_json=$(printf '%s\n' "${NODES[@]}" \
  | awk -F'|' '$4=="controlplane"{print $3}' | jq -R . | jq -s .)
worker_ips_json=$(printf '%s\n' "${NODES[@]}" \
  | awk -F'|' '$4=="worker"{print $3}' | jq -R . | jq -s .)
nodes_json=$(printf '%s\n' "${NODES[@]}" \
  | awk -F'|' '{printf "{\"name\":\"%s\",\"mac\":\"%s\",\"ip\":\"%s\",\"role\":\"%s\"}\n",$1,$2,$3,$4}' \
  | jq -s .)

# First CP IP becomes the cluster endpoint. (For multi-CP HA you'd put a
# VIP here via machine config; out of scope for this local-dev setup.)
first_cp_ip=$(printf '%s\n' "${NODES[@]}" \
  | awk -F'|' '$4=="controlplane"{print $3; exit}')

cat > terraform.tfvars.json <<EOF
{
  "cluster_name":     "${CLUSTER_NAME}",
  "cluster_endpoint": "https://${first_cp_ip}:6443",
  "talos_version":    "${TALOS_VERSION}",
  "iso_path":         "${ISO_PATH}",
  "vms_basefolder":   "${VMS_BASEFOLDER}",
  "hostonly_iface":   "${HOSTONLY_NET}",
  "vm_memory_mb":     ${VM_MEMORY},
  "vm_cpus":          ${VM_CPUS},
  "vm_disk_mb":       ${VM_DISK_MB},
  "cp_ips":           ${cp_ips_json},
  "worker_ips":       ${worker_ips_json},
  "nodes":            ${nodes_json}
}
EOF
log_success "terraform.tfvars.json written."

# ---------- 9. Apply ----------
log_info "terraform init..."
terraform init -upgrade -input=false

log_info "terraform apply (this can take ~5-10 minutes the first time)..."
# Parallelism kept modest to be kind to VirtualBox during the boot wave.
terraform apply -auto-approve -input=false -parallelism=4

# ---------- 10. Validate ----------
KUBECONFIG_PATH="$(pwd)/kubeconfig"
TALOSCONFIG_PATH="$(pwd)/talosconfig"
export KUBECONFIG="$KUBECONFIG_PATH"

log_info "Cluster nodes:"
kubectl get nodes -o wide || log_warn "kubectl couldn't reach the cluster; check the IPs above."

log_success "Cluster '${CLUSTER_NAME}' is up."
echo
echo "  export KUBECONFIG=${KUBECONFIG_PATH}"
echo "  export TALOSCONFIG=${TALOSCONFIG_PATH}"
echo "  kubectl get nodes"
echo
echo "Tear down with:   ./terraform-destroy"
