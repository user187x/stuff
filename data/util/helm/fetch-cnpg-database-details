#!/usr/bin/env bash

NAMESPACE="coder"
# CNPG always appends '-app' to the cluster name for the application secret
SECRET_NAME="coder-db-app"

# Verify kubectl context and secret existence
if ! kubectl get secret "$SECRET_NAME" -n "$NAMESPACE" &>/dev/null; then
 echo "Error: Secret '$SECRET_NAME' not found in namespace '$NAMESPACE'."
 echo "Ensure the CloudNative-PG cluster 'coder-db' has finished provisioning."
 exit 1
fi

# Extract the individual password
DB_PASSWORD=$(kubectl get secret "$SECRET_NAME" -n "$NAMESPACE" -o jsonpath='{.data.password}' | base64 --decode)

# Extract the pre-formatted connection string
DB_URI=$(kubectl get secret "$SECRET_NAME" -n "$NAMESPACE" -o jsonpath='{.data.uri}' | base64 --decode)

echo "=== Coder Database Credentials ==="
echo "Raw Password : $DB_PASSWORD"
echo "Full PG URI  : $DB_URI"
echo "=================================="
echo ""
echo "To manually set this in a values file, use:"
echo "CODER_PG_CONNECTION_URL: \"$DB_URI\""
