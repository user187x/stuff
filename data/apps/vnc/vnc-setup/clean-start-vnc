#!/bin/bash
set -e

echo "Stopping VNC service cleanly..."
if sudo systemctl stop vncserver@1.service; then
 echo "Successfully stopped VNC service"
else
 echo "VNC service was not running or failed to stop"
fi

echo "Removing stubborn X11 lock files..."
sudo rm -rf /tmp/.X11-unix/X1
sudo rm -rf /tmp/.X1-lock
sleep 1

echo "Reloading Systemctl daemon..."
sudo systemctl daemon-reload

echo "Starting VNC service (this will auto-trigger XFCE)..."
sudo systemctl start vncserver@1.service

echo "Checking VNC service status..."
sudo systemctl status vncserver@1.service
