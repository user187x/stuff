<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/surface_variant_dark">

    <!-- Top separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/primary_dark"
        android:layout_marginBottom="8dp" />

    <!-- Header with type icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/logTypeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_server_notification"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/primary_dark"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Log entry details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <!-- Time row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Time :"
                android:textColor="@color/secondary_dark"
                android:fontFamily="monospace"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/logTimestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_dark"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:text="" />

        </LinearLayout>

        <!-- Path row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Path :"
                android:textColor="@color/secondary_dark"
                android:fontFamily="monospace"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/logPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_dark"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:text="/uploads" />

        </LinearLayout>

        <!-- IP row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="IP   :"
                android:textColor="@color/secondary_dark"
                android:fontFamily="monospace"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/logIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_dark"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:text="192.168.0.0" />

        </LinearLayout>

        <!-- Data row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Data :"
                android:textColor="@color/secondary_dark"
                android:fontFamily="monospace"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/logData"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_dark"
                android:fontFamily="monospace"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom separator -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/primary_dark"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />
</LinearLayout>