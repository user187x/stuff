#!/usr/bin/env bash
#
# install-monitoring-stack.sh
#
# Installs Prometheus + Grafana into a minikube cluster using the
# kube-prometheus-stack Helm chart (the standard, batteries-included setup
# from the Prometheus community).
#
# Usage:   ./install-monitoring-stack.sh
# Cleanup: ./install-monitoring-stack.sh --uninstall
#
set -euo pipefail

# ---------- Config (override via env vars) ------------------------------------
NAMESPACE="${NAMESPACE:-monitoring}"

RELEASE_NAME="${RELEASE_NAME:-kube-prom-stack}"
CHART_VERSION="${CHART_VERSION:-}" # empty = latest
GRAFANA_ADMIN_PASSWORD="${GRAFANA_ADMIN_PASSWORD:-admin}"

MINIKUBE_CPUS="${MINIKUBE_CPUS:-4}"
MINIKUBE_MEMORY="${MINIKUBE_MEMORY:-8192}" # MB
MINIKUBE_DRIVER="${MINIKUBE_DRIVER:-docker}"

# ---------- Pretty output -----------------------------------------------------
log() { printf '\033[1;34m[+]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*"; }
err() { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; }
die() {
 err "$*"
 exit 1
}

# ---------- Uninstall path ----------------------------------------------------
if [[ "${1:-}" == "--uninstall" ]]; then
 log "Uninstalling release '${RELEASE_NAME}' from namespace '${NAMESPACE}'..."
 helm uninstall "${RELEASE_NAME}" -n "${NAMESPACE}" || true
 kubectl delete namespace "${NAMESPACE}" --ignore-not-found
 # CRDs are intentionally left by the chart; remove them too:
 for crd in $(kubectl get crd -o name | grep 'monitoring.coreos.com' || true); do
  kubectl delete "${crd}" --ignore-not-found
 done
 log "Done."
 exit 0
fi

# ---------- Prereq checks -----------------------------------------------------
log "Checking required tools..."
for tool in minikube kubectl helm; do
 command -v "${tool}" >/dev/null 2>&1 || die "'${tool}' is not installed or not in PATH."
done

# ---------- Start minikube ----------------------------------------------------
if ! minikube status >/dev/null 2>&1; then
 log "Starting minikube (driver=${MINIKUBE_DRIVER}, cpus=${MINIKUBE_CPUS}, memory=${MINIKUBE_MEMORY}MB)..."
 minikube start \
  --driver="${MINIKUBE_DRIVER}" \
  --cpus="${MINIKUBE_CPUS}" \
  --memory="${MINIKUBE_MEMORY}"
else
 log "minikube is already running."
fi

# Make sure kubectl points at minikube
kubectl config use-context minikube >/dev/null

# Enable metrics-server addon (Grafana dashboards expect node/pod metrics)
log "Enabling metrics-server addon..."
minikube addons enable metrics-server >/dev/null

# ---------- Helm repo ---------------------------------------------------------
log "Adding/updating Helm repositories..."
helm repo add prometheus-community https://prometheus-community.github.io/helm-charts >/dev/null 2>&1 || true
helm repo update >/dev/null

# ---------- Namespace ---------------------------------------------------------
log "Ensuring namespace '${NAMESPACE}' exists..."
kubectl get namespace "${NAMESPACE}" >/dev/null 2>&1 || kubectl create namespace "${NAMESPACE}"

# ---------- Install / upgrade -------------------------------------------------
log "Installing/upgrading kube-prometheus-stack (this can take a few minutes)..."

VERSION_FLAG=()
[[ -n "${CHART_VERSION}" ]] && VERSION_FLAG=(--version "${CHART_VERSION}")

helm upgrade --install "${RELEASE_NAME}" prometheus-community/kube-prometheus-stack \
 --namespace "${NAMESPACE}" \
 "${VERSION_FLAG[@]}" \
 --set grafana.adminPassword="${GRAFANA_ADMIN_PASSWORD}" \
 --set grafana.service.type=NodePort \
 --set prometheus.service.type=NodePort \
 --set alertmanager.service.type=NodePort \
 --set prometheus.prometheusSpec.serviceMonitorSelectorNilUsesHelmValues=false \
 --set prometheus.prometheusSpec.podMonitorSelectorNilUsesHelmValues=false \
 --wait --timeout 10m

# ---------- Wait for pods -----------------------------------------------------
log "Waiting for all pods in '${NAMESPACE}' to be Ready..."
kubectl wait --for=condition=Ready pods --all -n "${NAMESPACE}" --timeout=10m ||
 warn "Some pods are not yet Ready. Check with: kubectl get pods -n ${NAMESPACE}"

# ---------- Output access info -----------------------------------------------
GRAFANA_SVC="${RELEASE_NAME}-grafana"
PROM_SVC="${RELEASE_NAME}-kube-prom-prometheus"
ALERT_SVC="${RELEASE_NAME}-kube-prom-alertmanager"

# Resolve actual service names (chart uses a slightly different prefix scheme)
GRAFANA_SVC=$(kubectl get svc -n "${NAMESPACE}" -o name | grep -E 'grafana$' | head -n1 | sed 's|service/||')
PROM_SVC=$(kubectl get svc -n "${NAMESPACE}" -o name | grep -E 'prometheus$' | head -n1 | sed 's|service/||')
ALERT_SVC=$(kubectl get svc -n "${NAMESPACE}" -o name | grep -E 'alertmanager$' | head -n1 | sed 's|service/||')

cat <<EOF

============================================================
  Prometheus + Grafana installed successfully
============================================================
Namespace : ${NAMESPACE}
Release   : ${RELEASE_NAME}

Grafana login:
  user     : admin
  password : ${GRAFANA_ADMIN_PASSWORD}

Open the UIs (each command opens a tunnel in your browser):

  Grafana       : minikube service ${GRAFANA_SVC} -n ${NAMESPACE}
  Prometheus    : minikube service ${PROM_SVC} -n ${NAMESPACE}
  Alertmanager  : minikube service ${ALERT_SVC} -n ${NAMESPACE}

Or use kubectl port-forward instead:

  kubectl -n ${NAMESPACE} port-forward svc/${GRAFANA_SVC} 3000:80
  kubectl -n ${NAMESPACE} port-forward svc/${PROM_SVC}    9090:9090

To uninstall everything:
  $0 --uninstall
============================================================
EOF
