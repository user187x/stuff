#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status,
# treat unset variables as an error, and catch pipe failures.
set -euo pipefail

# If the bash locale has another decimal separator as '.' there would be an error
export LC_ALL=C

# --- Configuration Paths ---
readonly SCRIPT_FILE="chain.script"
readonly IMG_DIR="images"
readonly ANIMATION_DIR="${IMG_DIR}/animation"

########## HELPERS ##########

usage() {
 cat <<EOF
Usage (CLI Mode): $0 <command> <value>
Usage (TUI Mode): $0 (Run without arguments to launch the Interactive Menu)

Commands for Colors (Requires a 6-digit hex code like "#ABC123"):
  background <color>     Set <color> as the background color
  main <color>           Set <color> as the main theme color
  secondary <color>      Set <color> as the secondary color

Commands for Assets:
  lock <path>            Replace the lock image with the PNG at <path>
  animation <dir_path>   Replace the animation frames with PNGs from <dir_path>

Examples:
  $0 main "#FF0000"
  $0 lock /path/to/my-new-lock.png
EOF
 exit 1
}

is_hexadecimal_color() {
 local color="$1"
 [[ "$color" =~ ^#[A-Fa-f0-9]{6}$ ]]
}

normalize_hex_to_rgb() {
 local hex="$1"
 local red green blue

 # Extract RGB integer values using bc
 red=$(echo "ibase=16; ${hex:1:2}" | bc)
 green=$(echo "ibase=16; ${hex:3:2}" | bc)
 blue=$(echo "ibase=16; ${hex:5:2}" | bc)

 # Normalize over 255 (FF) to 5 significant digits
 printf "%1.5f %1.5f %1.5f" \
  "$(echo "scale=5; $red / 255" | bc)" \
  "$(echo "scale=5; $green / 255" | bc)" \
  "$(echo "scale=5; $blue / 255" | bc)"
}

update_script_color() {
 local prefix="$1"
 local hex_color="${2^^}"

 if ! is_hexadecimal_color "$hex_color"; then
  echo "Error: Invalid color format '$hex_color'" >&2
  exit 1
 fi

 local norm_r norm_g norm_b
 read -r norm_r norm_g norm_b < <(normalize_hex_to_rgb "$hex_color")

 # Update chain script with new normalized RGB values
 sed -i "s/^${prefix}_COLOR.RED = .*;$/${prefix}_COLOR.RED = ${norm_r};/" "${SCRIPT_FILE}"
 sed -i "s/^${prefix}_COLOR.GREEN = .*;$/${prefix}_COLOR.GREEN = ${norm_g};/" "${SCRIPT_FILE}"
 sed -i "s/^${prefix}_COLOR.BLUE = .*;$/${prefix}_COLOR.BLUE = ${norm_b};/" "${SCRIPT_FILE}"
}

recolor_images() {
 local hex_color="${1^^}"
 shift
 local files=("$@")

 for file in "${files[@]}"; do
  if [[ -f "$file" ]]; then
   convert "$file" -channel RGB -fill "$hex_color" -colorize 100% "$file"
  fi
 done
}

########## CORE COMMAND FUNCTIONS ##########

set_background() {
 update_script_color "BG" "$1"
}

set_main() {
 local color="$1"
 update_script_color "MAIN" "$color"

 local images=("${IMG_DIR}/bar-progress.png" "${IMG_DIR}/lock.png")

 while IFS= read -r -d '' file; do
  images+=("$file")
 done < <(find "${ANIMATION_DIR}" -type f -name "*.png" -print0 2>/dev/null || true)

 recolor_images "$color" "${images[@]}"
}

set_secondary() {
 local color="$1"
 update_script_color "SECONDARY" "$color"

 local images=("${IMG_DIR}/bar-background.png" "${IMG_DIR}/input.png")
 recolor_images "$color" "${images[@]}"
}

replace_lock() {
 local source_path="$1"
 if [[ ! -f "$source_path" ]]; then
  echo "Error: New lock image '$source_path' does not exist." >&2
  return 1
 fi
 cp "$source_path" "${IMG_DIR}/lock.png"
}

replace_animation() {
 local source_dir="$1"
 if [[ ! -d "$source_dir" ]]; then
  echo "Error: Animation directory '$source_dir' does not exist." >&2
  return 1
 fi
 rm -f "${ANIMATION_DIR}"/*.png
 cp "${source_dir}"/*.png "${ANIMATION_DIR}/"
}

########## WHIPTAIL TUI LOGIC ##########

choose_color() {
 local component="$1"
 local color_choice

 # Build the menu dynamically
 local menu_options=()

 # If Termpicker is installed, insert it as the first option
 if command -v termpicker >/dev/null 2>&1; then
  menu_options+=("Termpicker" "Interactive Color Picker")
 fi

 menu_options+=(
  "Red" "#FF0000"
  "Green" "#00FF00"
  "Blue" "#0000FF"
  "Cyan" "#00FFFF"
  "Magenta" "#FF00FF"
  "Yellow" "#FFFF00"
  "Orange" "#FF8800"
  "Dark Gray" "#222222"
  "Black" "#000000"
  "White" "#FFFFFF"
  "Custom" "Enter Hex Code manually"
 )

 # 3>&1 1>&2 2>&3 swaps stderr and stdout so we can capture whiptail's output
 if ! color_choice=$(whiptail --title "Color Swatch" --menu "Choose a color for $component" 20 60 12 \
  "${menu_options[@]}" 3>&1 1>&2 2>&3); then
  return 1 # User pressed Cancel
 fi

 if [[ "$color_choice" == "Termpicker" ]]; then
  whiptail --title "Termpicker" --msgbox "Termpicker will now launch.\n\nUse the arrow keys/UI to design your color.\nWhen finished, copy the color AS A HEX CODE to return it to the script." 10 55

  # Clear the terminal so termpicker can draw properly
  clear

  # Launch termpicker in oneshot mode (-1) and force it to bind to the active tty
  local tp_color
  tp_color=$(termpicker -1 </dev/tty)

  if [[ -z "$tp_color" ]]; then
   whiptail --title "Cancelled" --msgbox "Termpicker exited without copying a color." 8 45
   return 1
  fi

  # Ensure the user actually copied a HEX format from termpicker (not rgb/cmyk)
  if ! is_hexadecimal_color "$tp_color"; then
   whiptail --title "Format Error" --msgbox "Termpicker returned '$tp_color'.\n\nEnsure you are copying the color in Hexadecimal format (e.g. #FF0000)." 10 50
   return 1
  fi

  echo "$tp_color"
  return 0
 fi

 if [[ "$color_choice" == "Custom" ]]; then
  if ! color_choice=$(whiptail --title "Custom Color" --inputbox "Enter a 6-digit hex code (e.g., #FF5733):" 8 50 "#" 3>&1 1>&2 2>&3); then
   return 1 # User pressed Cancel
  fi

  if ! is_hexadecimal_color "$color_choice"; then
   whiptail --title "Error" --msgbox "Invalid format. Must be a 6-digit hex code with a leading #." 8 45
   return 1
  fi
 fi

 # Echo the hex code back to the caller
 case "$color_choice" in
  Red) echo "#FF0000" ;;
  Green) echo "#00FF00" ;;
  Blue) echo "#0000FF" ;;
  Cyan) echo "#00FFFF" ;;
  Magenta) echo "#FF00FF" ;;
  Yellow) echo "#FFFF00" ;;
  Orange) echo "#FF8800" ;;
  "Dark Gray") echo "#222222" ;;
  White) echo "#FFFFFF" ;;
  *) echo "$color_choice" ;; # Return the custom hex
 esac
}

interactive_mode() {
 while true; do
  local choice
  if ! choice=$(whiptail --title "Plymouth Theme Editor" --menu "What would you like to modify?" 16 60 6 \
   "Background" "Set the background color" \
   "Main" "Set the main theme color" \
   "Secondary" "Set the secondary color" \
   "Lock" "Replace the lock image" \
   "Animation" "Replace animation frames" \
   "Exit" "Quit the editor" 3>&1 1>&2 2>&3); then
   break # Exit if Cancel is pressed
  fi

  if [[ "$choice" == "Exit" ]]; then
   break
  fi

  case "$choice" in
   Background | Main | Secondary)
    local color
    if color=$(choose_color "$choice"); then
     whiptail --title "Processing" --infobox "Applying $color to $choice elements...\nThis may take a moment." 8 50
     case "$choice" in
      Background) set_background "$color" ;;
      Main) set_main "$color" ;;
      Secondary) set_secondary "$color" ;;
     esac
     whiptail --title "Success" --msgbox "$choice color updated to $color successfully!" 8 45
    fi
    ;;
   Lock)
    local path
    if path=$(whiptail --title "Lock Icon" --inputbox "Enter the full path to the new lock.png:" 8 60 3>&1 1>&2 2>&3); then
     if replace_lock "$path"; then
      whiptail --title "Success" --msgbox "Lock image updated!" 8 45
     else
      whiptail --title "Error" --msgbox "Failed to find or copy the image." 8 45
     fi
    fi
    ;;
   Animation)
    local path
    if path=$(whiptail --title "Animation Frames" --inputbox "Enter the directory containing new PNG frames:" 8 60 3>&1 1>&2 2>&3); then
     if replace_animation "$path"; then
      whiptail --title "Success" --msgbox "Animation frames updated!" 8 45
     else
      whiptail --title "Error" --msgbox "Failed to find the directory." 8 45
     fi
    fi
    ;;
  esac
 done
 clear
}

########## MAIN ROUTINE ##########

main() {
 if [[ $# -eq 0 ]]; then
  # No arguments passed, attempt to launch interactive TUI
  if command -v whiptail >/dev/null 2>&1; then
   interactive_mode
  else
   echo "Error: 'whiptail' is not installed."
   echo "Please install it (e.g., 'sudo apt install whiptail') to use the interactive menu, or provide CLI arguments."
   echo
   usage
  fi
 else
  # CLI Mode
  [[ $# -ne 2 ]] && usage
  local command="$1"
  local value="$2"

  case "$command" in
   background) set_background "$value" ;;
   main) set_main "$value" ;;
   secondary) set_secondary "$value" ;;
   lock) replace_lock "$value" ;;
   animation) replace_animation "$value" ;;
   *) usage ;;
  esac
  echo "Successfully updated $command."
 fi
}

main "$@"
