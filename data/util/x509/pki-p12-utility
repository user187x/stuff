#!/bin/bash

# --- Configuration ---
DOMAIN="xxx.com"
PASSWORD="changeIt!"
OUTPUT_DIR="./certs"
OUTPUT_P12="xxx.p12"
OUTPUT_KEY="xxx.key"
OUTPUT_CRT="xxx.crt"
DAYS_VALID=365

read -e -i "${OUTPUT_DIR}" -p "Export Path: " OUTPUT_DIR
mkdir -p "${OUTPUT_DIR}" >/dev/null 2>&1

echo "🔒 Generating certificate and private key for $DOMAIN..."
openssl req -x509 -newkey rsa:2048 -nodes \
 -keyout "${OUTPUT_DIR}/${OUTPUT_KEY}" \
 -out "${OUTPUT_DIR}/${OUTPUT_CRT}" \
 -days "$DAYS_VALID" \
 -subj "/CN=$DOMAIN" \
 2>/dev/null

echo "📦 Packaging into PKCS#12 format ($OUTPUT_P12)..."
openssl pkcs12 -export \
 -out "${OUTPUT_DIR}/${OUTPUT_P12}" \
 -inkey "${OUTPUT_DIR}/${OUTPUT_KEY}" \
 -in "${OUTPUT_DIR}/${OUTPUT_CRT}" \
 -passout "pass:$PASSWORD" \
 -name "$DOMAIN"

echo "✅ Success! Created ${OUTPUT_DIR}/${OUTPUT_P12}"
echo "🔑 The keystore password is: $PASSWORD"
