# ==========================================
# GitHub-Released Applications (zip + launcher, or jar wrapper)
# ------------------------------------------
# These don't fit the single-binary mold. Installed via github_install_app
# into /opt/<binary>/ with a launcher in /usr/local/bin.
#
# Format: "binary|owner/repo|asset_regex|launcher"
#   launcher is the path relative to the extracted root (e.g. "ghidraRun",
#   "bin/jadx") OR the literal "@jar" to wrap a downloaded jar with a
#   shell script that calls `java -jar`.
# ==========================================
github_apps=(
 # Disassembly / decompilation suites
 "ghidra|NationalSecurityAgency/ghidra|^ghidra_.*_PUBLIC_.*\\.zip\$|ghidraRun"          # "NSA's flagship decompiler, gold standard for free RE"
 "jadx|skylot/jadx|^jadx-[0-9].*\\.zip\$|bin/jadx"                                       # "decompile DEX and JAR back to readable Java"
 "cfr|leibnitz27/cfr|^cfr-.*\\.jar\$|@jar"                                               # "single-jar Java decompiler that handles modern bytecode"
 "bytecode-viewer|Konloch/bytecode-viewer|[Bb]ytecode-?[Vv]iewer.*\\.jar\$|@jar"         # "GUI bundling CFR, Procyon, Krakatau, JADX"
 "recaf|Col-E/Recaf|^recaf.*\\.jar\$|@jar"                                               # "modern Java RE workbench, live bytecode editing"
)

# ==========================================
# Tracking arrays for run summary
# ==========================================
installed=()
failed=()

echo
echo "--- 📦 Starting APT Package Installation ---"

function install-packages {

 echo ""
 echo "--- 📦 Starting APT Package Installation ---"

 for item in "${packages[@]}"; do
  # Split the string by colon into an array called 'parts'
  IFS=':' read -r -a parts <<<"$item"

  # The first element is always the command/binary to check
  binary="${parts[0]}"

  # The remaining elements are the package names to try
  if [[ ${#parts[@]} -eq 1 ]]; then
   # If there are no colons, the binary name is also the package name
   pkg_variations=("$binary")
  else
   # Slice the array to get everything after the first element
   pkg_variations=("${parts[@]:1}")
  fi

  # 1. Check if binary already exists
  if ! command -v "$binary" >/dev/null 2>&1; then
   echo "Installing $binary..."
   success=false

   # 2. Loop through each package variation and try to install it
   for pkg in "${pkg_variations[@]}"; do
    if sudo apt install "$pkg" -y; then
     echo -e "Tool [\e[1;92m$binary\e[0m] Installed (via '$pkg')"
     installed+=("$binary")
     success=true
     break # Exit the inner loop on success
    else
     echo -e "⚠️ Attempt to install via [\e[1;93m$pkg\e[0m] failed. Trying next..."
    fi
   done

   # 3. If the loop finished and success is still false, it failed completely
   if [ "$success" = false ]; then
    echo -e "Tool [\e[1;91m$binary\e[0m] failed to install completely."
    failed+=("$binary")
   fi
  else
   echo -e "Tool [\e[1;92m$binary\e[0m] already installed"
   installed+=("$binary")
  fi
 done
}

function cache-packages {

 # Define the target cache directory
 local target_dir="${XDG_CACHE_DIR:-$HOME/.cache}/apt-package-backups"

 # 📁 Ensuring cache directory exists
 mkdir -p "$target_dir"

 # Change into the target directory so apt-get downloads the files directly here
 pushd "$target_dir" >/dev/null || {
  echo "Failed to access cache directory"
  return 1
 }

 echo
 echo "Caching packages..."

 for item in "${packages[@]}"; do
  # Split the string by colon to handle fallbacks
  IFS=':' read -r -a parts <<<"$item"

  if [[ ${#parts[@]} -eq 1 ]]; then
   pkg_variations=("${parts[0]}")
  else
   # If there are colons, skip the binary name (index 0) and use the package names
   pkg_variations=("${parts[@]:1}")
  fi

  local success=false

  # Try downloading the package (and any fallbacks)
  for pkg in "${pkg_variations[@]}"; do
   # 'apt-get download' fetches the .deb into the current working directory
   if apt-get download "$pkg" >/dev/null 2>&1; then
    echo -e "✅ Cached: [\e[1;92m$pkg\e[0m]"
    success=true
    break # Move on to the next item in the main packages array once successful
   else
    echo -e "⚠️ Attempt to cache [\e[1;93m$pkg\e[0m] failed."
   fi
  done

  if [ "$success" = false ]; then
   echo -e "❌ \e[1;91mFailed completely to cache:\e[0m $item"
  fi
 done

 # Return to the original directory
 popd >/dev/null
 echo "🏁 Caching Complete"
}

function install-cached {

 # Accept an argument for the path, or default to the standard cache location
 local cache_dir="${1:-${XDG_CACHE_DIR:-$HOME/.cache}/apt-package-backups}"

 echo "📂 Checking for cached packages in: $cache_dir"

 # 1. Verify the directory actually exists
 if [[ ! -d "$cache_dir" ]]; then
  echo -e "❌ \e[1;91mError:\e[0m Cache directory does not exist."
  return 1
 fi

 # We use nullglob so if no files match, the array is empty instead of containing a literal "*.deb" string
 shopt -s nullglob
 local deb_files=("$cache_dir"/*.deb)
 shopt -u nullglob # Turn nullglob back off to avoid messing with other script functions

 # 3. Check if we actually found anything
 if [[ ${#deb_files[@]} -eq 0 ]]; then
  echo -e "⚠️ \e[1;93mNo .deb files found in the cache directory.\e[0m"
  return 0
 fi

 echo "📦 Found ${#deb_files[@]} package(s). Starting bulk installation..."

 # apt will attempt to fetch any missing dependencies automatically.
 if sudo apt install -y "${deb_files[@]}"; then
  echo -e "✅ \e[1;92mSuccessfully installed cached packages!\e[0m"
  return 0
 else
  echo -e "❌ \e[1;91mErrors occurred during installation.\e[0m"
  echo "   (If offline, this usually means a required dependency wasn't cached)."
  return 1
 fi
}

# ==========================================
# pipx Installer
# ------------------------------------------
# Installs python tools in isolated venvs. pipx itself comes from apt.
# ==========================================
function install-pipx-tools {

 echo
 echo "--- 🐍 Starting pipx Tool Installation ---"

 if ! command -v pipx >/dev/null 2>&1; then
  echo -e "❌ \e[1;91mpipx not found.\e[0m Run install-packages first."
  return 1
 fi

 # Ensure pipx's bin dir is on PATH for the current shell
 pipx ensurepath >/dev/null 2>&1 || true
 export PATH="$HOME/.local/bin:$PATH"

 for item in "${pipx_tools[@]}"; do
  IFS=':' read -r -a parts <<<"$item"
  local binary="${parts[0]}"
  local pkg="${parts[1]:-$binary}"

  if command -v "$binary" >/dev/null 2>&1; then
   echo -e "Tool [\e[1;92m$binary\e[0m] already installed"
   installed+=("$binary")
   continue
  fi

  echo "Installing $binary (pipx: $pkg)..."
  if pipx install "$pkg" >/dev/null 2>&1; then
   echo -e "Tool [\e[1;92m$binary\e[0m] Installed (pipx '$pkg')"
   installed+=("$binary")
  else
   echo -e "Tool [\e[1;91m$binary\e[0m] failed to install via pipx"
   failed+=("$binary")
  fi
 done

 echo "🏁 pipx installations complete"
}

# ==========================================
# GitHub Release Installer (single binary)
# ------------------------------------------
# Queries https://api.github.com/repos/{owner}/{repo}/releases/latest and
# tries to install the right asset for this machine in three stages:
#   1. .deb matching the system architecture       → dpkg -i
#   2. Archive (tar/zip) matching arch             → extract binary to /usr/local/bin
#   3. Raw binary asset matching arch              → install to /usr/local/bin
#
# Usage: github_install "owner/repo" [binary_name]
#   binary_name defaults to the repo name. Override when they differ
#   (e.g. github_install "helix-editor/helix" "hx").
#
# Requires: curl, jq, tar, unzip, sudo. All are in the APT catalog above so
# they must be installed before this function runs.
#
# Note: the unauthenticated GitHub API allows 60 requests per hour per IP.
# Set GITHUB_TOKEN in your environment to bump that to 5000/hour.
# ==========================================
function github_install {

 local repo="$1"
 local binary_name="${2:-${repo##*/}}"

 # 0. Skip if the binary is already on PATH
 if command -v "$binary_name" >/dev/null 2>&1; then
  echo -e "Tool [\e[1;92m$binary_name\e[0m] already installed"
  installed+=("$binary_name")
  return 0
 fi

 # Map dpkg architecture → regex of names release assets might use
 local arch arch_pattern
 arch=$(dpkg --print-architecture 2>/dev/null || echo "amd64")
 case "$arch" in
  amd64) arch_pattern="amd64|x86_64|x64" ;;
  arm64) arch_pattern="arm64|aarch64" ;;
  armhf) arch_pattern="armv7|armhf" ;;
  *)     arch_pattern="$arch" ;;
 esac

 echo
 echo -e "🔍 Querying GitHub for latest release of \e[1;94m$repo\e[0m..."

 # Build auth header if GITHUB_TOKEN is set (raises rate limit to 5000/hr)
 local auth_header=()
 [[ -n "${GITHUB_TOKEN:-}" ]] && auth_header=(-H "Authorization: Bearer $GITHUB_TOKEN")

 local api_url="https://api.github.com/repos/${repo}/releases/latest"
 local release_json
 if ! release_json=$(curl -fsSL -H "Accept: application/vnd.github+json" "${auth_header[@]}" "$api_url"); then
  echo -e "❌ \e[1;91mFailed to query GitHub API\e[0m for $repo (rate limit? bad repo?)"
  failed+=("$binary_name")
  return 1
 fi

 local tag
 tag=$(echo "$release_json" | jq -r '.tag_name // "unknown"')
 echo -e "📌 Latest release: \e[1;95m$tag\e[0m"

 # -- Stage 1: prefer .deb -----------------------------------------------------
 local deb_url
 deb_url=$(echo "$release_json" | jq -r --arg arch "$arch_pattern" '
  [.assets[]
   | select(.name | test("\\.deb$"; "i"))
   | select(.name | test($arch; "i"))
   | .browser_download_url][0] // empty
 ')

 if [[ -n "$deb_url" ]]; then
  echo "📦 Found .deb: ${deb_url##*/}"
  local tmp_deb
  tmp_deb=$(mktemp --suffix=.deb)
  if curl -fsSL "$deb_url" -o "$tmp_deb"; then
   if sudo dpkg -i "$tmp_deb" >/dev/null 2>&1; then
    sudo apt install -fy >/dev/null 2>&1   # fix any missing deps
    rm -f "$tmp_deb"
    echo -e "Tool [\e[1;92m$binary_name\e[0m] Installed from $repo ($tag)"
    installed+=("$binary_name")
    return 0
   fi
  fi
  rm -f "$tmp_deb"
  echo -e "⚠️  .deb install failed for $binary_name, trying archive..."
 fi

 # -- Stage 2: archive (tarball or zip) ---------------------------------------
 local archive_url
 archive_url=$(echo "$release_json" | jq -r --arg arch "$arch_pattern" '
  [.assets[]
   | select(.name | test("linux"; "i"))
   | select(.name | test($arch; "i"))
   | select(.name | test("\\.(tar\\.(gz|xz|bz2)|tgz|zip)$"; "i"))
   | .browser_download_url][0] // empty
 ')

 if [[ -n "$archive_url" ]]; then
  local archive_name="${archive_url##*/}"
  echo "📦 Found archive: $archive_name"
  local tmp_dir
  tmp_dir=$(mktemp -d)
  local archive_path="${tmp_dir}/${archive_name}"
  local extracted=false

  if curl -fsSL "$archive_url" -o "$archive_path"; then
   case "$archive_name" in
    *.zip)   unzip -q "$archive_path" -d "$tmp_dir" 2>/dev/null && extracted=true ;;
    *.tar|*.tar.gz|*.tgz|*.tar.xz|*.tar.bz2) tar -xf "$archive_path" -C "$tmp_dir" 2>/dev/null && extracted=true ;;
   esac
  fi

  if $extracted; then
   # Find the binary by exact name, executable first
   local binary_path
   binary_path=$(find "$tmp_dir" -type f -name "$binary_name" -executable 2>/dev/null | head -1)
   [[ -z "$binary_path" ]] && binary_path=$(find "$tmp_dir" -type f -name "$binary_name" 2>/dev/null | head -1)

   if [[ -n "$binary_path" ]]; then
    sudo install -m 755 "$binary_path" "/usr/local/bin/$binary_name"
    rm -rf "$tmp_dir"
    echo -e "Tool [\e[1;92m$binary_name\e[0m] Installed from $repo ($tag) → /usr/local/bin"
    installed+=("$binary_name")
    return 0
   fi
   echo -e "⚠️  Binary '\e[1;93m$binary_name\e[0m' not found inside archive"
  fi
  rm -rf "$tmp_dir"
 fi

 # -- Stage 3: raw binary asset ------------------------------------------------
 local bin_url
 bin_url=$(echo "$release_json" | jq -r --arg bin "$binary_name" --arg arch "$arch_pattern" '
  [.assets[]
   | select(.name | test("linux"; "i"))
   | select(.name | test($arch; "i"))
   | select(.name | test($bin; "i"))
   | select(.name | test("\\.(tar|zip|deb|rpm|sig|asc|sha|sbom|txt|json|md)"; "i") | not)
   | .browser_download_url][0] // empty
 ')

 if [[ -n "$bin_url" ]]; then
  echo "📦 Found raw binary: ${bin_url##*/}"
  local tmp_bin
  tmp_bin=$(mktemp)
  if curl -fsSL "$bin_url" -o "$tmp_bin"; then
   sudo install -m 755 "$tmp_bin" "/usr/local/bin/$binary_name"
   rm -f "$tmp_bin"
   echo -e "Tool [\e[1;92m$binary_name\e[0m] Installed from $repo ($tag) → /usr/local/bin"
   installed+=("$binary_name")
   return 0
  fi
  rm -f "$tmp_bin"
 fi

 echo -e "Tool [\e[1;91m$binary_name\e[0m] failed — no compatible asset in $repo"
 failed+=("$binary_name")
 return 1
}

function install-github-tools {

 echo
 echo "--- 🐙 Starting GitHub Release Installations ---"

 # Verify dependencies are present (they should be — apt step ran first)
 local missing_deps=()
 for dep in curl jq tar unzip; do
  command -v "$dep" >/dev/null 2>&1 || missing_deps+=("$dep")
 done
 if (( ${#missing_deps[@]} > 0 )); then
  echo -e "❌ \e[1;91mMissing dependencies for GitHub installs:\e[0m ${missing_deps[*]}"
  echo "   Run install-packages first."
  return 1
 fi

 for binary in "${!github_tools[@]}"; do
  github_install "${github_tools[$binary]}" "$binary"
 done

 echo
 echo "🏁 GitHub installations complete"
}

# ==========================================
# GitHub Application Installer (zip + launcher, or jar wrapper)
# ------------------------------------------
# For multi-file applications that don't fit the single-binary mold.
# Installs into /opt/<binary>/ with a launcher symlink or shell wrapper in
# /usr/local/bin.
#
# Two install patterns are supported:
#
#   1. Archive with internal launcher (ghidra, jadx)
#      Asset is a .zip/.tar that contains a runnable script or binary at a
#      known relative path. Function extracts to /opt/<binary>/ and symlinks
#      that launcher into /usr/local/bin.
#
#   2. Standalone JAR (cfr, bytecode-viewer, recaf)
#      Asset is a .jar. Function copies it to /opt/<binary>/<binary>.jar
#      and writes a shell wrapper to /usr/local/bin/<binary> that calls
#      `java -jar`.
#
# Usage: github_install_app "binary" "owner/repo" "asset_regex" "launcher_or_@jar"
#   launcher: path relative to extracted root (e.g. "ghidraRun", "bin/jadx")
#             OR the literal "@jar" to use jar-wrapping mode
# ==========================================
function github_install_app {

 local binary="$1"
 local repo="$2"
 local asset_pattern="$3"
 local launcher="$4"

 # 0. Skip if the binary is already on PATH
 if command -v "$binary" >/dev/null 2>&1; then
  echo -e "Tool [\e[1;92m$binary\e[0m] already installed"
  installed+=("$binary")
  return 0
 fi

 echo
 echo -e "🔍 Querying GitHub for latest release of \e[1;94m$repo\e[0m..."

 local auth_header=()
 [[ -n "${GITHUB_TOKEN:-}" ]] && auth_header=(-H "Authorization: Bearer $GITHUB_TOKEN")

 local api_url="https://api.github.com/repos/${repo}/releases/latest"
 local release_json
 if ! release_json=$(curl -fsSL -H "Accept: application/vnd.github+json" "${auth_header[@]}" "$api_url"); then
  echo -e "❌ \e[1;91mFailed to query GitHub API\e[0m for $repo"
  failed+=("$binary")
  return 1
 fi

 local tag
 tag=$(echo "$release_json" | jq -r '.tag_name // "unknown"')
 echo -e "📌 Latest release: \e[1;95m$tag\e[0m"

 # Find the matching asset
 local asset_url asset_name
 asset_url=$(echo "$release_json" | jq -r --arg pattern "$asset_pattern" '
  [.assets[] | select(.name | test($pattern; "i")) | .browser_download_url][0] // empty
 ')

 if [[ -z "$asset_url" ]]; then
  echo -e "Tool [\e[1;91m$binary\e[0m] failed — no asset matched: $asset_pattern"
  failed+=("$binary")
  return 1
 fi

 asset_name="${asset_url##*/}"
 echo "📦 Found asset: $asset_name"

 local install_dir="/opt/$binary"
 local tmp_dir
 tmp_dir=$(mktemp -d)
 local downloaded="${tmp_dir}/${asset_name}"

 if ! curl -fsSL "$asset_url" -o "$downloaded"; then
  rm -rf "$tmp_dir"
  echo -e "Tool [\e[1;91m$binary\e[0m] failed — download error"
  failed+=("$binary")
  return 1
 fi

 # ---- Pattern A: standalone jar with shell wrapper --------------------------
 if [[ "$launcher" == "@jar" ]]; then
  if ! command -v java >/dev/null 2>&1; then
   echo -e "⚠️  java not found — install default-jdk first; $binary will not run"
  fi
  sudo mkdir -p "$install_dir"
  sudo install -m 644 "$downloaded" "$install_dir/$binary.jar"
  # Write a launcher; needs to expand $install_dir at write time but defer $@
  sudo tee "/usr/local/bin/$binary" >/dev/null << WRAPPER
#!/bin/sh
exec java -jar "${install_dir}/${binary}.jar" "\$@"
WRAPPER
  sudo chmod 755 "/usr/local/bin/$binary"
  rm -rf "$tmp_dir"
  echo -e "Tool [\e[1;92m$binary\e[0m] Installed from $repo ($tag) → $install_dir + /usr/local/bin/$binary"
  installed+=("$binary")
  return 0
 fi

 # ---- Pattern B: archive with internal launcher -----------------------------
 local stage="${tmp_dir}/stage"
 mkdir -p "$stage"
 case "$asset_name" in
  *.zip)
   unzip -q "$downloaded" -d "$stage" 2>/dev/null ;;
  *.tar.gz|*.tgz|*.tar.xz|*.tar.bz2|*.tar)
   tar -xf "$downloaded" -C "$stage" 2>/dev/null ;;
  *)
   echo -e "Tool [\e[1;91m$binary\e[0m] failed — unknown archive format: $asset_name"
   rm -rf "$tmp_dir"
   failed+=("$binary")
   return 1 ;;
 esac

 # Find the launcher anywhere inside the extracted tree
 local launcher_path
 launcher_path=$(find "$stage" -path "*/$launcher" -type f 2>/dev/null | head -1)
 [[ -z "$launcher_path" ]] && launcher_path=$(find "$stage" -name "$(basename "$launcher")" -type f 2>/dev/null | head -1)

 if [[ -z "$launcher_path" ]]; then
  echo -e "Tool [\e[1;91m$binary\e[0m] failed — launcher '$launcher' not found in archive"
  rm -rf "$tmp_dir"
  failed+=("$binary")
  return 1
 fi

 # Determine the real install root: the dir that contains $launcher_path at the
 # $launcher relative path. Strip the $launcher suffix from launcher_path.
 local real_root="${launcher_path%/$launcher}"
 [[ "$real_root" == "$launcher_path" ]] && real_root="$(dirname "$launcher_path")"

 # Wipe any prior install and move the staged tree into place
 sudo rm -rf "$install_dir"
 sudo mkdir -p "$(dirname "$install_dir")"
 sudo mv "$real_root" "$install_dir"
 sudo chmod +x "$install_dir/$launcher" 2>/dev/null || true

 # Create the /usr/local/bin symlink → install_dir/launcher
 sudo ln -sf "$install_dir/$launcher" "/usr/local/bin/$binary"

 rm -rf "$tmp_dir"
 echo -e "Tool [\e[1;92m$binary\e[0m] Installed from $repo ($tag) → $install_dir + /usr/local/bin/$binary"
 installed+=("$binary")
 return 0
}

function install-github-apps {

 echo
 echo "--- 📦 Starting GitHub Application Installations ---"

 # Verify dependencies are present
 local missing_deps=()
 for dep in curl jq tar unzip; do
  command -v "$dep" >/dev/null 2>&1 || missing_deps+=("$dep")
 done
 if (( ${#missing_deps[@]} > 0 )); then
  echo -e "❌ \e[1;91mMissing dependencies for GitHub apps:\e[0m ${missing_deps[*]}"
  echo "   Run install-packages first."
  return 1
 fi

 for entry in "${github_apps[@]}"; do
  IFS='|' read -r binary repo asset_pattern launcher <<<"$entry"
  github_install_app "$binary" "$repo" "$asset_pattern" "$launcher"
 done

 echo
 echo "🏁 GitHub app installations complete"
}

# ==========================================
# Run Summary
# ==========================================
function print-summary {
 echo
 echo "=========================================="
 echo "📊 Installation Summary"
 echo "=========================================="
 echo -e "✅ \e[1;92mInstalled / already present:\e[0m ${#installed[@]}"
 echo -e "❌ \e[1;91mFailed:\e[0m ${#failed[@]}"
 if (( ${#failed[@]} > 0 )); then
  echo
  echo "Failed tools:"
  printf '   - %s\n' "${failed[@]}"
 fi
}

# ==========================================
# Main Execution
# ==========================================

# 1. install apt packages to system (provides curl, jq, tar, unzip, pipx, java)
install-packages

# 2. install pipx-distributed python tools (needs pipx)
install-pipx-tools

# 3. install GitHub-released single-binary tools (needs curl/jq/tar/unzip)
install-github-tools

# 4. install GitHub-released applications (needs curl/jq/unzip + java for jars)
install-github-apps

# 5. cache apt packages locally for offline restore
cache-packages

# 6. final run summary
print-summary
