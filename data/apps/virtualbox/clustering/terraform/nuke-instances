#!/bin/bash

# 1. Kill and delete VMs
for vm in talos-cp-0 talos-worker-0 talos-worker-1; do
 VBoxManage controlvm "$vm" poweroff 2>/dev/null || true
 VBoxManage unregistervm "$vm" --delete 2>/dev/null || true
done

# 2. Destroy the network and DHCP server to clear the lease cache
VBoxManage dhcpserver remove --ifname vboxnet0 2>/dev/null || true
VBoxManage hostonlyif remove vboxnet0 2>/dev/null || true

# 3. Nuke old configs and the wrong ISO
rm -rf _out
rm -f ~/talos-vbox/talos-amd64.iso 2>/dev/null || true
