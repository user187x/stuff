#!/bin/bash
set -e

# Elevate privileges if necessary
if [ "$EUID" -ne 0 ]; then
 echo "Requesting administrative privileges..."
 exec sudo "$0" "$@"
fi

BASE_DIR="/usr/share/plymouth/themes"
THEMES_REPO="../plymouth-themes/themes"

# Select theme using fzf with a robust basename extraction
CUSTOM_THEME=$(find "${THEMES_REPO}" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; |
 sort |
 fzf \
  --ansi \
  --border=rounded \
  --prompt='Select Plymouth Theme: ')

# Exit cleanly if the user escapes the fzf prompt
if [[ -z "${CUSTOM_THEME}" ]]; then
 echo "No theme selected. Exiting..."
 exit 0
fi

echo -e "\nSelected: ${CUSTOM_THEME}\n"

SOURCE_THEME_DIR="${THEMES_REPO}/${CUSTOM_THEME}"
TARGET_THEME_DIR="${BASE_DIR}/${CUSTOM_THEME}"
THEME_FILE="${TARGET_THEME_DIR}/${CUSTOM_THEME}.plymouth"

# Validate the source directory exists
if [[ ! -d "${SOURCE_THEME_DIR}" ]]; then
 echo "Error: Source directory ${SOURCE_THEME_DIR} not found. Aborting..."
 exit 1
fi

echo "Installing theme files..."
# Recursively copy the theme directory into the system Plymouth themes directory
cp -r "${SOURCE_THEME_DIR}" "${BASE_DIR}/"

# Validate the .plymouth configuration file exists within the copied directory
if [[ ! -f "${THEME_FILE}" ]]; then
 echo "Error: Plymouth configuration file ${THEME_FILE} not found inside the theme directory."
 exit 1
fi

echo "Setting selected theme as default in update-alternatives..."
# Install and set the alternative automatically (bypassing the interactive --config prompt)
update-alternatives --install "${BASE_DIR}/default.plymouth" default.plymouth "${THEME_FILE}" 100
update-alternatives --set default.plymouth "${THEME_FILE}"

echo "Rebuilding initramfs (this may take a moment)..."
update-initramfs -u

echo -e "\nPlymouth theme successfully updated!"
