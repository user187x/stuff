#!/usr/bin/env bash

# Enforce better error handling
set -euo pipefail

tweak_enable_power_option_lid() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Shutdown on lid close (Battery)"
  return 0
 fi

 local CONFIG_FILE="/etc/systemd/logind.conf"
 local BACKUP_FILE="/etc/systemd/logind.conf.bak_$(date +%F_%T)"

 echo "--- Ubuntu 24.04 Lid Close Configuration ---"
 if [ -f "$CONFIG_FILE" ]; then
  sudo cp "$CONFIG_FILE" "$BACKUP_FILE"
  echo "Backup created at: $BACKUP_FILE"
 else
  echo "Error: $CONFIG_FILE not found!"
  return 1
 fi

 sudo sed -i 's/^#\?HandleLidSwitch=.*/HandleLidSwitch=poweroff/' "$CONFIG_FILE"
 sudo sed -i 's/^#\?HandleLidSwitchExternalPower=.*/HandleLidSwitchExternalPower=lock/' "$CONFIG_FILE"

 echo "Restarting systemd-logind service..."
 sudo systemctl restart systemd-logind
 echo "Configuration complete! (Reboot if changes don't apply immediately)"
}

tweak_enable_keyboard_expose() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Enable Keyboard Expose (Shift+Super)"
  return 0
 fi

 local KEY_PATH="/org/gnome/shell/keybindings/toggle-application-view"
 local TARGET_VAL="['<Shift>Super_L', '<Super>Shift_L', '<Super>Shift_R']"
 local CURRENT_VAL
 CURRENT_VAL=$(dconf read "$KEY_PATH" || echo "")

 if [[ "$CURRENT_VAL" == "$TARGET_VAL" ]]; then
  echo "The Shift+Super shortcut is ALREADY set."
 else
  echo "Setting Shift+Super shortcut..."
  dconf write "$KEY_PATH" "$TARGET_VAL"
  echo "✅ Shortcut applied!"
 fi
}

tweak_update_os_ulimits() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Increase OS File Descriptor limits"
  return 0
 fi

 local FILE="/etc/security/limits.conf"
 local SOFT_LIMIT="* soft nofile 10000"
 local HARD_LIMIT="* hard nofile 10000"

 echo "Updating file descriptor limits in $FILE..."
 if grep -qF "$SOFT_LIMIT" "$FILE"; then
  echo " -> Soft limit already exists."
 else
  echo "$SOFT_LIMIT" | sudo tee -a "$FILE" >/dev/null
 fi

 if grep -qF "$HARD_LIMIT" "$FILE"; then
  echo " -> Hard limit already exists."
 else
  echo "$HARD_LIMIT" | sudo tee -a "$FILE" >/dev/null
 fi
 echo "Done! You must log out and log back in."
}

tweak_update_os_notification_popup() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Disable Desktop popup notification"
  return 0
 fi

 echo "Disabling desktop notification popup..."
 gsettings set com.ubuntu.update-notifier no-show-notifications true
}

tweak_remove_os_recent_files() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Disable 'Recent' in File Explorer"
  return 0
 fi

 echo "Removing 'recent' from file explorer..."
 if gsettings set org.gnome.desktop.privacy remember-recent-files false >/dev/null 2>&1; then
  echo "Setting complete!"
 else
  echo "Failed updating setting..."
 fi
}

tweak_update_os_sudoers_timeout() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Adjust Sudo password timeout"
  return 0
 fi

 local TIMEOUT
 TIMEOUT=$(whiptail --title "Sudo Timeout" --inputbox "Enter desired timeout in minutes (0 = always prompt, 15 = default, 5256000 = never):" 10 60 15 3>&1 1>&2 2>&3) || return 0

 if ! [[ "$TIMEOUT" =~ ^[0-9]+$ ]]; then
  echo "Error: Input must be a valid positive number."
  return 1
 fi

 local SUDOERS_FILE="/etc/sudoers.d/99_custom_timeout"
 echo "Defaults timestamp_timeout=$TIMEOUT" | sudo tee "$SUDOERS_FILE" >/dev/null
 sudo chmod 0440 "$SUDOERS_FILE"

 if sudo visudo -c -q; then
  echo "Success! Timeout updated to $TIMEOUT minutes."
 else
  sudo rm -f "$SUDOERS_FILE"
  echo "Error: Reverting changes. Visudo syntax check failed."
  return 1
 fi
}

tweak_enable_inverse_fwd_search() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Enable inverse fwd search (Terminal)"
  return 0
 fi

 echo "Setting standard input mode: stty -ixon"
 stty -ixon 2>/dev/null || true

 local EXPORT_STR="export FZF_CTRL_R_OPTS=\"--header='⌨️ NAVIGATION: [Ctrl+R] = Backwards | [Ctrl+S] = Forward' --bind 'ctrl-r:up,ctrl-s:down'\""

 if ! grep -q "FZF_CTRL_R_OPTS" ~/.bashrc; then
  echo "$EXPORT_STR" >>~/.bashrc
  echo "Added to ~/.bashrc. Please restart terminal to take full effect."
 else
  echo "FZF options already configured in ~/.bashrc"
 fi
}

tweak_remove_os_bloatware() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Remove bloatware (LibreOffice, Snap, Thunderbird)"
  return 0
 fi

 echo "Purging unwanted apps via APT..."
 touch ~/.hushlogin
 grep -q "LESSHISTFILE" ~/.bashrc || echo "export LESSHISTFILE=/dev/null" >>~/.bashrc
 gsettings set org.gnome.desktop.privacy remember-recent-files false

 mkdir -p ~/Templates && touch ~/Templates/Text\ File.txt

 echo "Defaults !admin_flag" | sudo tee /etc/sudoers.d/disable_admin_file_in_home >/dev/null
 sudo chmod 440 /etc/sudoers.d/disable_admin_file_in_home

 sudo apt-get remove --purge -y libreoffice* uno-libs-private ure yelp libreoffice-help-* totem thunderbird*
 command -v snap >/dev/null 2>&1 && sudo snap remove thunderbird || true

 sudo rm -rf /etc/thunderbird /usr/lib/thunderbird /usr/share/thunderbird /usr/share/applications/thunderbird.desktop

 # Clean user dirs
 for user_home in /home/*; do
  sudo rm -rf "$user_home/.thunderbird" "$user_home/.cache/thunderbird" 2>/dev/null || true
 done
 sudo rm -rf "/root/.thunderbird" 2>/dev/null || true

 sudo apt-get autoremove --purge -y && sudo apt-get autoclean -y
 command -v update-desktop-database >/dev/null 2>&1 && sudo update-desktop-database /usr/share/applications || true
 echo "Unnecessary apps removed."
}

tweak_update_os_center_windows() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Center new windows in GNOME"
  return 0
 fi

 echo "Configuring GNOME Window settings..."
 command -v gsettings >/dev/null 2>&1 && gsettings set org.gnome.mutter center-new-windows true
 echo "Windows will now center on open."
}

tweak_update_os_clock_12H() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Set 12-Hour Clock Format"
  return 0
 fi

 echo "Setting interface to use 12 Hr format..."
 gsettings set org.gnome.desktop.interface clock-format '12h'
}

tweak_remove_boot_logo() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Remove Boot Logo"
  return 0
 fi

 local TARGET_FILE="/usr/share/plymouth/ubuntu-logo.png"
 local BACKUP_FILE="${TARGET_FILE}.bak"
 local TRANSPARENT_PNG_B64="iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="

 [ ! -f "$BACKUP_FILE" ] && sudo cp "$TARGET_FILE" "$BACKUP_FILE"
 echo "$TRANSPARENT_PNG_B64" | base64 --decode >/tmp/transparent_logo_temp.png
 sudo mv /tmp/transparent_logo_temp.png "$TARGET_FILE"
 sudo update-initramfs -u
 echo "Boot logo removed."
}

tweak_update_os_startup_sound() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Set Custom Startup Sound"
  return 0
 fi

 local AUDIO_FILE
 AUDIO_FILE=$(whiptail --title "Startup Sound" --inputbox "Enter full path to audio file:" 10 60 3>&1 1>&2 2>&3) || return 0
 AUDIO_FILE="${AUDIO_FILE/#\~/$HOME}"

 if [ ! -f "$AUDIO_FILE" ]; then
  echo "File not found: $AUDIO_FILE"
  return 1
 fi

 command -v ffmpeg >/dev/null 2>&1 || sudo apt-get install -y ffmpeg >/dev/null 2>&1
 local SOUND_DIR="$HOME/.local/share/sounds/Yaru/stereo"
 mkdir -p "$SOUND_DIR"

 local TARGET_FILE="$SOUND_DIR/desktop-login.ogg"
 ffmpeg -y -i "$AUDIO_FILE" -c:a libvorbis "$TARGET_FILE" >/dev/null 2>&1

 command -v paplay >/dev/null 2>&1 || sudo apt-get install -y pulseaudio-utils >/dev/null 2>&1
 local AUTOSTART_DIR="$HOME/.config/autostart"
 mkdir -p "$AUTOSTART_DIR"

 cat >"$AUTOSTART_DIR/startup-sound.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Startup Sound
Exec=paplay "$TARGET_FILE"
Terminal=false
X-GNOME-Autostart-enabled=true
EOF

 gsettings set org.gnome.desktop.sound event-sounds true
 echo "Startup sound set!"
}

tweak_enable_touchpad_twofinger() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Enable Touchpad Two-Finger Scroll"
  return 0
 fi

 sudo apt-get install xserver-xorg-input-synaptics -y
 synclient VertTwoFingerScroll=1 2>/dev/null || echo "Warning: synclient failed, might be on Wayland."
 gsettings set org.gnome.desktop.peripherals.touchpad two-finger-scrolling-enabled true
 echo "Two-finger scrolling enabled."
}

tweak_remove_os_power_mode_toggle() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Disable Power-Profiles Daemon"
  return 0
 fi

 sudo systemctl mask power-profiles-daemon.service
 echo "Power profiles disabled."
}

tweak_remove_boot_splash() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Hide GRUB boot splash screen"
  return 0
 fi

 local target="/etc/default/grub"
 local backup="/etc/default/grub.bak"
 sudo cp "$target" "$backup"

 sudo tee "$target" <<EOF >/dev/null
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=hidden
GRUB_TIMEOUT=0
GRUB_DISTRIBUTOR=\$(. /etc/os-release; echo \${NAME:-Ubuntu} 2>/dev/null || echo Ubuntu)
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_GFXMODE=1920x1080x32
GRUB_SAVEDEFAULT=true
GRUB_DISABLE_OS_PROBER=true
GRUB_DISABLE_RECOVERY=true
GRUB_RECORDFAIL_TIMEOUT=0
EOF
 sudo update-grub
 echo "GRUB splash hidden."
}

tweak_update_power_mode() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Set CPU Power Mode to Performance"
  return 0
 fi

 echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null
 echo "Power mode set to performance."
}

tweak_create_context_menu_filecreation() {
 if [[ "${1:-}" == "--desc" ]]; then
  echo "Create Right-Click Script Template"
  return 0
 fi

 local TEMPLATE_DIR
 TEMPLATE_DIR=$(xdg-user-dir TEMPLATES 2>/dev/null || echo "$HOME/Templates")
 mkdir -p "$TEMPLATE_DIR"

 cat <<'EOF' >"$TEMPLATE_DIR/Shell Script"
#!/usr/bin/env bash
set -euo pipefail
usage() {
    echo "Usage: $(basename "$0") [OPTIONS]"
    echo "Options:"
    echo "  --script    Create executable bash script"
    echo "  --text      Create text file and open in gedit"
    exit 0
}
if [[ "$#" -eq 0 ]]; then usage; fi

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --script)
            FILENAME="new_script_$(date +%s)"
            echo "#!/usr/bin/env bash" > "$FILENAME"
            chmod +x "$FILENAME"
            gedti "$FILENAME"
            shift
            ;;
        --text)
            FILENAME="text-$(date +%s).txt"
            touch "$FILENAME"
            gedit "$FILENAME" >/dev/null 2>&1 &
            shift
            ;;
        *)
            echo "Unknown parameter: $1" >&2
            exit 1
            ;;
    esac
done
EOF

 chmod +x "$TEMPLATE_DIR/Shell Script.sh"
 echo "Template updated. File saved to: $TEMPLATE_DIR/Shell Script.sh"
}

# ==============================================================================
# MAIN TUI EXECUTION
# ==============================================================================

execute_tui() {
 if [[ "$EUID" -eq 0 ]]; then
  echo "❌ Error: Please run this script as your standard user, NOT with sudo."
  echo "The script will prompt for sudo access automatically when required."
  exit 1
 fi

 if ! command -v whiptail &>/dev/null; then
  echo "Installing required dependency: whiptail..."
  sudo apt-get update && sudo apt-get install -y whiptail
 fi

 # Dynamically build the menu from all functions starting with 'tweak_'
 local menu_options=()
 local func_list

 # Grab all function names that start with tweak_
 func_list=$(compgen -A function | grep '^tweak_')

 for func in $func_list; do
  local desc
  # Call the function with --desc to get its sub-detail
  desc=$("$func" --desc)
  # Whiptail needs: ID, Description, Status (ON/OFF)
  menu_options+=("$func" "$desc" "OFF")
 done

 whiptail --title "Ubuntu Auto-Configuration" \
  --msgbox "System Configurator.\n\nUse [SPACE] to select and [ENTER] to execute them." 10 80

 # Calculate terminal dimensions with fallbacks
 local term_cols=$(tput cols 2>/dev/null || echo 120)
 local term_lines=$(tput lines 2>/dev/null || echo 25)

 # Set whiptail dimensions with padding
 local wt_width=$((term_cols > 140 ? 140 : term_cols - 10))
 local wt_height=$((term_lines > 30 ? 30 : term_lines - 4))
 local wt_list_height=$((wt_height - 8))

 # Dynamically build the menu from all functions starting with 'tweak_'
 local menu_options=()
 local func_list
 func_list=$(compgen -A function | grep '^tweak_')

 # 1. Find the length of the longest function name for accurate math
 local max_func_len=0
 for func in $func_list; do
  if ((${#func} > max_func_len)); then max_func_len=${#func}; fi
 done

 # 2. Calculate how much space to pad the description
 local desc_pad_len=$((wt_width - max_func_len - 15))
 ((desc_pad_len < 10)) && desc_pad_len=10 # Fallback for extremely small terminals

 # 3. Build the array with space-padded descriptions
 for func in $func_list; do
  local desc
  desc=$("$func" --desc)
  desc=$(printf "%-${desc_pad_len}s" "$desc")
  menu_options+=("$func" "$desc" "OFF")
 done

 # Display the dynamically generated list
 local choices
 choices=$(whiptail --title "System Tweaks & Configurations" \
  --checklist "Select the configurations to apply:" \
  "$wt_height" "$wt_width" "$wt_list_height" \
  "${menu_options[@]}" 3>&1 1>&2 2>&3) || true

 if [ -z "$choices" ]; then
  echo "No options selected or user cancelled. Exiting."
  exit 0
 fi

 clear
 echo "Processing system configurations..."

 # Remove quotes returned by whiptail
 choices=$(echo "$choices" | tr -d '"')

 for func in $choices; do
  echo -e "\n → \e[92mExecuting: $("$func" --desc)\e[0m"
  # Execute the function
  if "$func"; then
   echo -e " \e[90m[OK] Completed successfully\e[0m"
  else
   echo -e " \e[31m[FAILED] Error during execution\e[0m"
  fi
 done

 echo -e "\n🎉 All selected tasks have been processed!"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
 # Script is being executed (e.g., ./script.sh)
 execute_tui "$@"
else
 # Script is being sourced (e.g., source script.sh)
 execute_tui "$@"
fi
