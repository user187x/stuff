#!/bin/bash

# Ensure whiptail is installed
if ! command -v whiptail &>/dev/null; then
 echo "❌ Error: 'whiptail' could not be found. Please install it."
 exit 1
fi

# ==============================================================================
# 1. Basic Components Gallery (Sub-Menu)
# ==============================================================================
demo_basic_gallery() {
 while true; do
  ACTION=$(whiptail --title "Basic Components Gallery" \
   --menu "Select a basic component to test (Cancel to go back):" \
   20 70 8 \
   "1" "Message Box (--msgbox)" \
   "2" "Yes/No Box (--yesno)" \
   "3" "Input Box (--inputbox)" \
   "4" "Password Box (--passwordbox)" \
   "5" "Checklist (--checklist)" \
   "6" "Radio List (--radiolist)" \
   3>&1 1>&2 2>&3)

  [[ $? != 0 ]] && break

  case $ACTION in
  "1") whiptail --title "Message Box" --msgbox "This is a simple message box." 10 60 ;;
  "2")
   if whiptail --title "Yes/No" --yesno "Do you want to proceed?" 10 60; then
    whiptail --title "Result" --msgbox "You chose: YES" 8 40
   else
    whiptail --title "Result" --msgbox "You chose: NO" 8 40
   fi
   ;;
  "3")
   USER_INPUT=$(whiptail --title "Input Box" --inputbox "Enter text:" 10 60 "Default" 3>&1 1>&2 2>&3)
   [[ $? == 0 ]] && whiptail --title "Result" --msgbox "You entered: $USER_INPUT" 8 40
   ;;
  "4")
   PASSWORD=$(whiptail --title "Password Box" --passwordbox "Enter a password:" 10 60 3>&1 1>&2 2>&3)
   [[ $? == 0 ]] && whiptail --title "Result" --msgbox "Password captured! (Length: ${#PASSWORD})" 8 50
   ;;
  "5")
   SELECTED=$(whiptail --title "Checklist" --checklist "Select tools (Space to toggle):" 15 60 4 "Docker" "" ON "Git" "" OFF 3>&1 1>&2 2>&3)
   [[ $? == 0 ]] && whiptail --title "Result" --msgbox "Selected: $SELECTED" 8 60
   ;;
  "6")
   CHOICE=$(whiptail --title "Radio List" --radiolist "Select environment:" 15 60 4 "DEV" "" ON "PROD" "" OFF 3>&1 1>&2 2>&3)
   [[ $? == 0 ]] && whiptail --title "Result" --msgbox "Selected: $CHOICE" 8 40
   ;;
  esac
 done
}

# ==============================================================================
# 2. Color Styling & Buttons
# ==============================================================================
demo_color_styling() {
 local OLD_COLORS="$NEWT_COLORS"
 export NEWT_COLORS='
    window=black,lightgray
    border=black,lightgray
    title=black,lightgray
    button=white,black
    actbutton=black,cyan
    textbox=black,lightgray
  '

 whiptail --title "Button Test" --msgbox "Notice how the button pops out more against the gray background, and changes dramatically when you hit Tab to select it." 10 60

 # Restore original colors
 export NEWT_COLORS="$OLD_COLORS"
}

# ==============================================================================
# 3. Dynamic Dependent Menus
# ==============================================================================
demo_dynamic_menus() {
 PROVIDER=$(whiptail --title "Step 1: Cloud Provider" \
  --menu "Select your target deployment environment:" 15 60 3 \
  "AWS" "Amazon Web Services" \
  "GCP" "Google Cloud Platform" \
  "Azure" "Microsoft Azure" \
  3>&1 1>&2 2>&3)

 [[ $? -ne 0 ]] && return 0

 declare -a SERVICE_OPTIONS
 case $PROVIDER in
 "AWS") SERVICE_OPTIONS=("EC2" "Virtual Servers" "S3" "Object Storage" "RDS" "Relational Databases") ;;
 "GCP") SERVICE_OPTIONS=("GCE" "Compute Engine" "GCS" "Cloud Storage" "Spanner" "Global Relational Database") ;;
 "Azure") SERVICE_OPTIONS=("VMs" "Virtual Machines" "Blob" "Blob Storage" "CosmosDB" "Global NoSQL Database") ;;
 esac

 SERVICE=$(whiptail --title "Step 2: $PROVIDER Services" \
  --menu "Choose a specific $PROVIDER service to provision:" 15 65 4 "${SERVICE_OPTIONS[@]}" 3>&1 1>&2 2>&3)

 [[ $? -ne 0 ]] && return 0

 whiptail --title "Configuration Complete" \
  --msgbox "You have successfully configured the deployment.\n\nProvider: $PROVIDER\nService:  $SERVICE" 10 50
}

# ==============================================================================
# 4. API Fetch Progress Bar (Custom Colors)
# ==============================================================================
demo_api_progressbar() {
 local OLD_COLORS="$NEWT_COLORS"
 export NEWT_COLORS='
    root=white,cyan
    window=black,lightgray
    border=cyan,lightgray
    title=cyan,lightgray
    button=black,cyan
    actbutton=white,cyan
    emptyscale=black,lightgray
    fullscale=white,cyan
  '

 ENDPOINTS=(
  "https://jsonplaceholder.typicode.com/posts/1"
  "https://jsonplaceholder.typicode.com/comments/1"
  "https://jsonplaceholder.typicode.com/albums/1"
  "https://jsonplaceholder.typicode.com/photos/1"
  "https://jsonplaceholder.typicode.com/todos/1"
 )

 TOTAL_ENDPOINTS=${#ENDPOINTS[@]}
 CURRENT_STEP=0

 (
  for URL in "${ENDPOINTS[@]}"; do
   PERCENTAGE=$((CURRENT_STEP * 100 / TOTAL_ENDPOINTS))
   echo "XXX"
   echo "$PERCENTAGE"
   echo -e "Fetching: $URL\nProgress: $CURRENT_STEP of $TOTAL_ENDPOINTS completed."
   echo "XXX"

   curl -s "$URL" >/dev/null
   sleep 1
   ((CURRENT_STEP++))
  done

  echo "XXX"
  echo "100"
  echo "All endpoints fetched successfully!"
  echo "XXX"
  sleep 1
 ) | whiptail --title "API Data Fetcher" --gauge "Initializing..." 10 75 0

 export NEWT_COLORS="$OLD_COLORS"
 whiptail --title "Success" --msgbox "Successfully processed all $TOTAL_ENDPOINTS endpoints." 8 50
}

# ==============================================================================
# 5. Pure Bash Rainbow Progress Bar
# ==============================================================================
demo_rainbow_bar() {
 clear
 local COLORS=("\e[31m" "\e[33m" "\e[32m" "\e[36m" "\e[34m" "\e[35m")
 local RESET="\e[0m"
 local BLOCK="█"
 local BAR_WIDTH=50

 echo "Starting rainbow download..."

 for i in {1..100}; do
  local current_step=$((i * BAR_WIDTH / 100))
  local color_index=$((i / 17))
  [[ "$color_index" -ge "${#COLORS[@]}" ]] && color_index=$((${#COLORS[@]} - 1))

  local current_color="${COLORS[$color_index]}"

  local filled=""
  for ((j = 0; j < current_step; j++)); do filled="${filled}${BLOCK}"; done

  local empty=""
  for ((j = current_step; j < BAR_WIDTH; j++)); do empty="${empty} "; done

  printf "\rProgress: [${current_color}${filled}${RESET}${empty}] %3d%%" "$i"
  sleep 0.05
 done

 echo -e "\nDone!\n"
 read -n 1 -s -r -p "Press any key to return to the menu..."
}

# ==============================================================================
# 6. Kubernetes Ingress Wizard
# ==============================================================================
demo_k8s_ingress() {
 if KUBE_NS=$(kubectl get namespaces -o custom-columns=":metadata.name" --no-headers 2>/dev/null); then
  NS_OPTIONS=()
  for ns in $KUBE_NS; do NS_OPTIONS+=("$ns" ""); done
  NAMESPACE=$(whiptail --menu "☸️ Select Kubernetes Namespace:" 15 78 8 "${NS_OPTIONS[@]}" --title "Namespace" 3>&1 1>&2 2>&3)
  [[ $? -ne 0 ]] && return 0
 else
  NAMESPACE=$(whiptail --inputbox "⚠️ Enter Namespace manually:" 8 78 "default" --title "Namespace" 3>&1 1>&2 2>&3)
  [[ $? -ne 0 ]] && return 0
 fi
 [[ -z "$NAMESPACE" ]] && NAMESPACE="default"

 INGRESS_NAME=$(whiptail --inputbox "📛 Enter Ingress Name:" 8 78 --title "Ingress Name" 3>&1 1>&2 2>&3)
 [[ $? -ne 0 ]] && return 0
 if [[ -z "$INGRESS_NAME" ]]; then
  whiptail --msgbox "❌ Ingress name cannot be empty!" 8 78
  return 1
 fi

 INGRESS_CLASS=$(whiptail --inputbox "🚦 Enter Ingress Class Name (Leave blank for default):" 8 78 --title "Ingress Class" 3>&1 1>&2 2>&3)
 [[ $? -ne 0 ]] && return 0

 declare -a KUBECTL_CMD=(kubectl create ingress "$INGRESS_NAME" -n "$NAMESPACE")
 CMD_STR="kubectl create ingress $INGRESS_NAME -n $NAMESPACE"

 if [[ -n "$INGRESS_CLASS" ]]; then
  KUBECTL_CMD+=("--class=$INGRESS_CLASS")
  CMD_STR="$CMD_STR --class=$INGRESS_CLASS"
 fi

 RULE_COUNT=0
 while true; do
  whiptail --msgbox "🌐 Let's configure a routing rule." 8 78
  ING_HOST=$(whiptail --inputbox "🌍 Enter Host (Leave blank for *):" 8 78 --cancel-button "Cancel" --title "Host" 3>&1 1>&2 2>&3)
  [[ $? -ne 0 ]] && break

  ING_PATH=$(whiptail --inputbox "🛤️ Enter Path:" 8 78 "/" --cancel-button "Cancel" --title "Path" 3>&1 1>&2 2>&3)
  [[ $? -ne 0 ]] && continue
  [[ -z "$ING_PATH" ]] && ING_PATH="/"

  ING_SVC=$(whiptail --inputbox "⚙️ Enter Backend Service Name:" 8 78 --cancel-button "Cancel" --title "Service" 3>&1 1>&2 2>&3)
  [[ $? -ne 0 ]] && continue
  if [[ -z "$ING_SVC" ]]; then
   whiptail --msgbox "❌ Cannot be empty!" 8 78
   continue
  fi

  ING_PORT=$(whiptail --inputbox "🚪 Enter Service Port:" 8 78 --cancel-button "Cancel" --title "Port" 3>&1 1>&2 2>&3)
  [[ $? -ne 0 ]] && continue
  if [[ -z "$ING_PORT" ]]; then
   whiptail --msgbox "❌ Cannot be empty!" 8 78
   continue
  fi

  RULE_STR="${ING_HOST}${ING_PATH}=${ING_SVC}:${ING_PORT}"
  KUBECTL_CMD+=("--rule=$RULE_STR")
  CMD_STR="$CMD_STR --rule=\"$RULE_STR\""
  ((RULE_COUNT++))

  whiptail --yesno "➕ Rule added! Add another?" 8 78 3>&1 1>&2 2>&3
  [[ $? -ne 0 ]] && break
 done

 if [[ $RULE_COUNT -eq 0 ]]; then
  whiptail --msgbox "⚠️ No rules added. Exiting." 8 78
  return 1
 fi

 if whiptail --yesno "✅ Execute command?\n\n$CMD_STR" 12 78 --title "Confirm" 3>&1 1>&2 2>&3; then
  clear
  echo "🚀 Executing..."
  "${KUBECTL_CMD[@]}"
  echo ""
  read -n 1 -s -r -p "Press any key to return to the menu..."
 fi
}

# ==============================================================================
# 7. Kubernetes Secret Wizard
# ==============================================================================
demo_k8s_secret() {
 NAMESPACE=$(whiptail --inputbox "☸️ Enter Kubernetes Namespace:" 8 78 "default" --title "Namespace" 3>&1 1>&2 2>&3)
 [[ $? -ne 0 ]] && return 0

 SECRET_NAME=$(whiptail --inputbox "📛 Enter Secret Name:" 8 78 --title "Secret Name" 3>&1 1>&2 2>&3)
 [[ $? -ne 0 ]] && return 0

 while true; do
  SECRET_TYPE=$(whiptail --menu "⚙️ Select Secret Type:" 15 78 4 \
   "literal" "📝 Generic (from-literal key/value pairs)" \
   "file" "📄 Generic (from-file)" \
   --cancel-button "Exit" --title "Secret Type" 3>&1 1>&2 2>&3)

  [[ $? -ne 0 ]] && return 0
  declare -a KUBECTL_CMD=(kubectl create secret)
  CMD_STR="kubectl create secret"
  GO_BACK=0

  case "$SECRET_TYPE" in
  literal)
   KUBECTL_CMD+=(generic "$SECRET_NAME" -n "$NAMESPACE")
   CMD_STR="$CMD_STR generic $SECRET_NAME -n $NAMESPACE"
   while true; do
    KEY=$(whiptail --inputbox "🔑 Enter Key (Blank to finish):" 8 78 --cancel-button "Back" 3>&1 1>&2 2>&3)
    [[ $? -ne 0 ]] && {
     GO_BACK=1
     break
    }
    [[ -z "$KEY" ]] && break

    VAL=$(whiptail --passwordbox "🔒 Enter Value for '$KEY':" 8 78 --cancel-button "Back" 3>&1 1>&2 2>&3)
    [[ $? -ne 0 ]] && continue

    KUBECTL_CMD+=("--from-literal=$KEY=$VAL")
    CMD_STR="$CMD_STR --from-literal=$KEY='***'"
   done
   ;;
  file)
   KUBECTL_CMD+=(generic "$SECRET_NAME" -n "$NAMESPACE")
   CMD_STR="$CMD_STR generic $SECRET_NAME -n $NAMESPACE"
   while true; do
    FILE_PATH=$(whiptail --inputbox "📂 Enter full path to file:" 8 78 --cancel-button "Back" 3>&1 1>&2 2>&3)
    [[ $? -ne 0 ]] && {
     GO_BACK=1
     break
    }

    if [[ -f "$FILE_PATH" ]]; then
     KUBECTL_CMD+=("--from-file=$FILE_PATH")
     CMD_STR="$CMD_STR --from-file=$FILE_PATH"
     break
    else
     whiptail --msgbox "❌ File not found." 8 78
    fi
   done
   ;;
  esac

  [[ $GO_BACK -eq 0 ]] && break
 done

 if whiptail --yesno "✅ Execute command?\n\n$CMD_STR" 12 78 --title "Confirm" 3>&1 1>&2 2>&3; then
  clear
  echo "🚀 Executing..."
  "${KUBECTL_CMD[@]}"
  echo ""
  read -n 1 -s -r -p "Press any key to return to the menu..."
 fi
}

# ==============================================================================
# MAIN MENU LOOP
# ==============================================================================
while true; do
 SELECTION=$(whiptail --title "Ultimate Whiptail Collection" \
  --menu "Select an example to run (Cancel to exit):" \
  20 75 8 \
  "1" "Basic Components Gallery" \
  "2" "Color Styling & Buttons" \
  "3" "Dynamic Dependent Menus" \
  "4" "API Fetch Progress Bar (Custom Colors)" \
  "5" "Pure Bash Rainbow Progress Bar" \
  "6" "Kubernetes Ingress Wizard" \
  "7" "Kubernetes Secret Wizard" \
  3>&1 1>&2 2>&3)

 if [[ $? -ne 0 ]]; then
  clear
  echo "Exited Ultimate Whiptail Collection."
  break
 fi

 case $SELECTION in
 "1") demo_basic_gallery ;;
 "2") demo_color_styling ;;
 "3") demo_dynamic_menus ;;
 "4") demo_api_progressbar ;;
 "5") demo_rainbow_bar ;;
 "6") demo_k8s_ingress ;;
 "7") demo_k8s_secret ;;
 esac
done
