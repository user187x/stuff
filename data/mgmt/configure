#!/bin/bash

# Determine if the auto-approve flag is set
AUTO_APPROVE=0
for arg in "$@"; do
    if [[ "$arg" == "--approve" ]]; then
        AUTO_APPROVE=1
        break
    fi
done

# Helper function to prompt the user for each script
run_step() {
    local step_name="$1"
    local func_name="$2"

    if [[ $AUTO_APPROVE -eq 1 ]]; then
        echo -e "\n============================================="
        echo -e "[AUTO-APPROVE] Applying: $step_name"
        echo -e "============================================="
        $func_name
        return $?
    fi

    echo -e "\n------------------------------------------------------------"
    while true; do
        read -r -p "Apply update: $step_name? [y/N/skip]: " response
        case "$response" in
            [yY][eE][sS]|[yY])
                echo -e "\nApplying $step_name..."
                $func_name
                return $?
                ;;
            [nN][oO]|[nN]|[sS][kK][iI][pP]|"")
                echo "Skipping $step_name."
                return 0
                ;;
            *)
                echo "Invalid input. Please enter 'y', 'n', or 'skip'."
                ;;
        esac
    done
}

# ==============================================================================
# FUNCTION DEFINITIONS (Isolated in subshells to prevent `exit` from killing the master script)
# ==============================================================================

#
enable_power_option_lid() (
    # Define the config file path
    CONFIG_FILE="/etc/systemd/logind.conf"
    BACKUP_FILE="/etc/systemd/logind.conf.bak_$(date +%F_%T)"
    
    # Check if script is run as root
    if [ "$EUID" -ne 0 ]; then
     echo "Please run as root (use sudo)."
     exit 1
    fi
    
    echo "--- Ubuntu 24.04 Lid Close Configuration ---"
    
    # 1. Create a backup of the original file
    if [ -f "$CONFIG_FILE" ]; then
     cp "$CONFIG_FILE" "$BACKUP_FILE"
     echo "Backup created at: $BACKUP_FILE"
    else
     echo "Error: $CONFIG_FILE not found!"
     exit 1
    fi
    
    # 2. Configure 'HandleLidSwitch' to 'poweroff'
    sed -i 's/^#\?HandleLidSwitch=.*/HandleLidSwitch=poweroff/' "$CONFIG_FILE"
    echo "Set: HandleLidSwitch=poweroff (Shutdown on Battery)"
    
    # 3. Configure 'HandleLidSwitchExternalPower' to 'lock'
    sed -i 's/^#\?HandleLidSwitchExternalPower=.*/HandleLidSwitchExternalPower=lock/' "$CONFIG_FILE"
    echo "Set: HandleLidSwitchExternalPower=lock (Lock on AC Power)"
    
    # 4. Restart the service to apply changes
    echo "Restarting systemd-logind service..."
    systemctl restart systemd-logind
    
    echo "----------------------------------------------"
    echo "Configuration complete!"
    echo "Note: If the changes do not take effect immediately, please reboot your system."
)

#
enable_keyboard_expose() (
    KEY_PATH="/org/gnome/shell/keybindings/toggle-application-view"
    TARGET_VAL="['<Shift>Super_L', '<Super>Shift_L', '<Super>Shift_R']"
    
    CURRENT_VAL=$(dconf read "$KEY_PATH")
    
    if [[ "$CURRENT_VAL" == "$TARGET_VAL" ]]; then
     echo "The Shift+Super shortcut is ALREADY set."
     read -p "Would you like to RESET it to the system default? (y/n): " choice
     if [[ "$choice" =~ ^[Yy]$ ]]; then
      dconf reset "$KEY_PATH"
      echo "✅ Shortcut reset to default."
     else
      echo "❌ No changes made."
     fi
    else
     echo "The Shift+Super shortcut is NOT currently active."
     echo "Setting it now..."
     dconf write "$KEY_PATH" "$TARGET_VAL"
     echo "✅ Shortcut applied! Try pressing Shift+Super or Super+Shift now."
    fi
)

#
update_os_ulimits() (
    if [ "$EUID" -ne 0 ]; then
     echo "Error: Please run this script with sudo."
     exit 1
    fi
    
    FILE="/etc/security/limits.conf"
    SOFT_LIMIT="* soft nofile 10000"
    HARD_LIMIT="* hard nofile 10000"
    
    echo "Updating file descriptor limits in $FILE..."
    
    if grep -qF "$SOFT_LIMIT" "$FILE"; then
     echo " -> Soft limit already exists. Skipping."
    else
     echo "$SOFT_LIMIT" >>"$FILE"
     echo " -> Added soft limit."
    fi
    
    if grep -qF "$HARD_LIMIT" "$FILE"; then
     echo " -> Hard limit already exists. Skipping."
    else
     echo "$HARD_LIMIT" >>"$FILE"
     echo " -> Added hard limit."
    fi
    
    echo "Done! You must completely log out and log back in (or reboot) for changes to take effect."
)

#
remove_os_recent_files() (
    echo
    echo "Removing 'recent' from file explorer"
    echo "----------------------------------------------"
    if gsettings set org.gnome.desktop.privacy remember-recent-files false >/dev/null 2>&1; then
     echo -e "Setting complete!"
     echo -e "To re-eanbled: \e[92mgsettings reset org.gnome.desktop.privacy remember-recent-files\e[0m"
    else
     echo -e "(\e[91m!\e[0m) Failed updating setting..."
    fi
    echo
)

#
update_os_sudoers_timeout() (
    if [[ $EUID -ne 0 ]]; then
     echo "This script must be run as root. Try: sudo $0"
     exit 1
    fi
    
    echo "=== Adjust Sudo Password Timeout ==="
    echo "Enter the desired timeout in minutes."
    echo "       0 : Always prompt for a password"
    echo "      15 : Standard Ubuntu default"
    echo " 5256000 : Effectively never prompt again (10 years)"
    read -p "Timeout value (minutes): " TIMEOUT
    
    if ! [[ "$TIMEOUT" =~ ^[0-9]+$ ]]; then
     echo "Error: Input must be a valid positive number or 0."
     exit 1
    fi
    
    SUDOERS_FILE="/etc/sudoers.d/99_custom_timeout"
    
    echo "Defaults timestamp_timeout=$TIMEOUT" >"$SUDOERS_FILE"
    chmod 0440 "$SUDOERS_FILE"
    
    if visudo -c -q; then
     echo "Success! Sudo timeout updated to $TIMEOUT minutes."
    else
     echo "Error: Invalid syntax detected by visudo. Reverting changes."
     rm "$SUDOERS_FILE"
     exit 1
    fi
)

#
enable_inverse_fwd_search() (
    echo
    echo -e "set standard input mode: \e[94mstty\e[0m \e[1;92m-ixon\e[0m"
    echo
    stty -ixon
    
    export FZF_CTRL_R_OPTS="
      --header='⌨️ NAVIGATION: [Ctrl+R] = Backwards | [Ctrl+S] = Forward'
      --bind 'ctrl-r:up,ctrl-s:down'
    "
)

#
remove_os_bloatware() (
    if [ "$EUID" -eq 0 ]; then
     echo "Error: Please run this script as your standard user, NOT with sudo."
     echo "The script will prompt you for your password when it needs root privileges."
     exit 1
    fi
    
    echo "=========================================="
    echo " Ubuntu 24 Debloat & Cleanup Script"
    echo "=========================================="
    
    echo -e "\n[1/5] Applying User-Specific Preferences..."
    touch ~/.hushlogin
    if ! grep -q "LESSHISTFILE" ~/.bashrc; then
     echo "export LESSHISTFILE=/dev/null" >>~/.bashrc
    fi
    
    gsettings set org.gnome.desktop.privacy remember-recent-files false
    mkdir -p ~/Templates
    touch ~/Templates/Text\ File.txt
    
    echo -e "\n[2/5] Requesting administrative privileges for system changes..."
    sudo -v
    
    echo "Defaults !admin_flag" | sudo tee /etc/sudoers.d/disable_admin_file_in_home >/dev/null
    sudo chmod 440 /etc/sudoers.d/disable_admin_file_in_home
    
    echo -e "\n[3/5] Purging unwanted applications via APT..."
    sudo apt-get remove --purge -y libreoffice* uno-libs-private ure
    sudo apt-get remove --purge -y yelp libreoffice-help-* totem
    sudo rm -f /usr/share/applications/yelp.desktop
    sudo apt-get remove --purge -y thunderbird*
    
    echo -e "\n[4/5] Checking for and removing Snap packages..."
    if command -v snap >/dev/null 2>&1; then
     echo "Snap installed. Removing Thunderbird snap..."
     sudo snap remove thunderbird || true
    else
     echo "Snap not installed, skipping..."
    fi
    
    echo -e "\n[5/5] Erasing system-wide and user configuration directories..."
    sudo rm -rf /etc/thunderbird
    sudo rm -rf /usr/lib/thunderbird
    sudo rm -rf /usr/share/thunderbird
    sudo rm -f /usr/share/applications/thunderbird.desktop
    
    for user_home in /home/*; do
     if [ -d "$user_home/.thunderbird" ]; then
      sudo rm -rf "$user_home/.thunderbird"
     fi
     if [ -d "$user_home/.cache/thunderbird" ]; then
      sudo rm -rf "$user_home/.cache/thunderbird"
     fi
    done
    
    if [ -d "/root/.thunderbird" ]; then
     sudo rm -rf "/root/.thunderbird"
    fi
    
    echo -e "\n[Cleaning Up] Removing orphaned dependencies and APT cache..."
    sudo apt-get autoremove --purge -y
    sudo apt-get autoclean -y
    
    if command -v update-desktop-database >/dev/null 2>&1; then
     sudo update-desktop-database /usr/share/applications
    fi
    
    echo "----------------------------------------"
    echo "Success: Unnecessary apps removed and Ubuntu 24 debloated."
)

#
update_os_center_windows() (
    echo "Configuring GNOME Window settings..."
    
    if command -v gsettings >/dev/null 2>&1; then
     centered=$(gsettings get org.gnome.mutter center-new-windows)
     if [[ "$centered" != "'true'" && "$centered" != "true" ]]; then
      echo "Setting all windows to be centered!"gsettings set org.gnome.mutter center-new-windows true
     else
      echo "Failed applying configuration setting"
     fi
    fi
    echo "Configuration settings for centering Gnome Windows complete"
)

