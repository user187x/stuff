<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission to read images/gifs from external storage -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wallpaper"
        tools:targetApi="31">

        <!-- The initial activity for picking a GIF file. -->
        <activity
            android:name=".LoadActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The main activity to preview the GIF and set wallpaper options. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!--
         The Live Wallpaper Service.
         This service is what the Android system interacts with to display the wallpaper.
         The BIND_WALLPAPER permission is required for a live wallpaper service.
        -->
        <service
            android:name=".GifWallpaperService"
            android:label="@string/wallpaper_service_label"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <!-- This intent-filter makes the service discoverable as a live wallpaper -->
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <!-- Metadata pointing to a dummy settings activity (can be expanded later) -->
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_settings" />
        </service>

    </application>

</manifest>
