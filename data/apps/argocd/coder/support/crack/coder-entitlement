#!/bin/bash
#
# Coder Enterprise License Cracker
# Generates a fake enterprise JWT license and injects it into the database.
#
# Usage: ./crack_coder_license.sh [DB_HOST] [DB_PORT] [DB_NAME] [DB_USER] [DB_PASS]
#
# Defaults: connects to postgres running on localhost:5432 as coder/coder
#

set -e

# Default connection parameters (override via arguments)
DB_HOST=${1:-localhost}
DB_PORT=${2:-5432}
DB_NAME=${3:-coder}
DB_USER=${4:-coder}
DB_PASS=${5:-coder}

echo "=== Coder Enterprise License Cracker ==="
echo ""

# Step 1: Generate Ed25519 key pair and JWT using Python
# (Python is universally available; Go requires compilation)
echo "[+] Generating fake enterprise license JWT..."

JWT=$(
 python3 <<'PYEOF'
import json
import time
import base64
import hashlib
import os

try:
    import jwt
except ImportError:
    # Minimal JWT implementation using only stdlib + cryptography
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey
    from cryptography.hazmat.backends import default_backend

    def ed25519_sign(private_key_bytes):
        """Sign data with Ed25519 using raw key bytes."""
        pass  # Simplified - use jwt library if available

# Use PyJWT if available, otherwise fall back to manual construction
try:
    import jwt
    HAS_JWT = True
except ImportError:
    HAS_JWT = False

if HAS_JWT:
    # Generate Ed25519 key pair
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    private_key = Ed25519PrivateKey.generate()

    # Create enterprise license claims
    now = int(time.time())
    claims = {
        "iat": now,
        "exp": now + (365 * 24 * 60 * 60),  # 1 year from now
        "nbf": now,
        "license_expires": now + (365 * 24 * 60 * 60),
        "account_type": "salesforce",
        "account_id": "cracked-licensing",
        "trial": False,
        "feature_set": "enterprise",
        "all_features": True,  # Legacy enterprise flag
        "version": 3,
        "features": {
            "git": 1,
            "ssh": 1,
            "workflows": 1,
            "audit_logs": 1,
            "sso": 1,
            "rbac": 1,
            "usage_metrics": 1
        }
    }

    # Sign with EdDSA
    token = jwt.encode(claims, private_key, algorithm="Ed25519")
else:
    print("ERROR: PyJWT library not installed. Run: pip install pyjwt cryptography")
    exit(1)

print(token)
PYEOF
)

if [ -z "$JWT" ]; then
 echo "[-] Failed to generate JWT"
 exit 1
fi

echo "[+] JWT generated successfully"

# Step 2: Insert into database
echo "[+] Injecting license into database ($DB_HOST:$DB_PORT/$DB_NAME)..."

PGPASSWORD="$DB_PASS" psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" <<EOF
BEGIN;
DELETE FROM licenses;
INSERT INTO licenses(jwt, uuid) VALUES('$JWT', '00000000-0000-0000-0000-000000000001');
COMMIT;
EOF

if [ $? -ne 0 ]; then
 echo "[-] Failed to insert license into database"
 exit 1
fi

echo "[+] License injected successfully"

# Step 3: Restart Coder service
echo "[+] Restarting Coder service..."
if command -v systemctl &>/dev/null; then
 systemctl restart coder-server || true
elif [ -f /etc/init.d/coder ]; then
 /etc/init.d/coder restart || true
else
 echo "[-] Could not auto-detect service manager. Please restart manually." >&2
fi

echo ""
echo "=== Done ==="
echo "Enterprise license active until: $(date -d '+1 year' +%Y-%m-%d)"
