#!/usr/bin/env bash
#
# build-graphite-appimage.sh — Zero-to-hero: source -> portable AppImage
#
# Downloads the latest Graphite source, installs all build prerequisites,
# compiles the native desktop binary, then uses linuxdeploy to package the
# binary TOGETHER WITH its CEF (Chromium) runtime and library dependencies
# into a single relocatable Graphite-x86_64.AppImage. Finally installs it
# to ~/.local/bin and creates a GNOME app-drawer launcher.
#
# The resulting AppImage can be copied to another directory or another
# Linux machine (with a same-or-newer glibc) and run directly.
#
# Target OS: Ubuntu 24.04+ (incl. Ubuntu 26.x), x86_64, GNOME
# Usage:     bash build-graphite-appimage.sh
# Re-run anytime to update: pulls latest code, rebuilds, repackages.
#
set -euo pipefail

# ----------------------------- Configuration --------------------------------
GRAPHITE_DIR="${GRAPHITE_DIR:-$HOME/Graphite}"        # source checkout
WORK_DIR="${WORK_DIR:-$HOME/graphite-appimage-build}" # AppDir + tools live here
REPO_URL="https://github.com/GraphiteEditor/Graphite.git"
BIN_DIR="$HOME/.local/bin"
APP_DIR_INSTALL="$HOME/.local/share/applications"
ICON_INSTALL_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
APP_ID="art.graphite.Graphite"
WASM_BINDGEN_VERSION="0.2.121"   # pinned by Graphite's build tool (July 2026)
CARGO_ABOUT_VERSION="0.8.4"      # 0.9.x changed config format; repo needs 0.8.x
LINUXDEPLOY_URL="https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage"

log()  { printf '\n\033[1;32m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m ⚠ %s\033[0m\n' "$*"; }
die()  { printf '\033[1;31m ✖ %s\033[0m\n' "$*" >&2; exit 1; }

[ "$(uname -m)" = "x86_64" ] || die "This script targets x86_64 (adjust LINUXDEPLOY_URL for other arches)."

# ----------------------- 1. System packages (apt) ---------------------------
log "Installing system packages (sudo required)"
sudo apt-get update -qq
sudo apt-get install -y \
  git curl wget ca-certificates file \
  build-essential pkg-config \
  cmake ninja-build \
  libssl-dev patchelf

# ----------------------------- 2. Rust toolchain ----------------------------
if ! command -v cargo >/dev/null 2>&1; then
  log "Installing Rust via rustup"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi
export PATH="$HOME/.cargo/bin:$PATH"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

log "Updating Rust and adding the WebAssembly target"
rustup update stable >/dev/null
rustup target add wasm32-unknown-unknown

# ------------------------------ 3. Node.js ----------------------------------
need_node=1
if command -v node >/dev/null 2>&1; then
  node_major="$(node --version | sed 's/^v\([0-9]*\).*/\1/')"
  [ "${node_major:-0}" -ge 22 ] && need_node=0
fi
if [ "$need_node" -eq 1 ]; then
  log "Installing Node.js 24 (NodeSource)"
  curl -fsSL https://deb.nodesource.com/setup_24.x | sudo -E bash -
  sudo apt-get install -y nodejs
else
  log "Node.js $(node --version) already present — OK"
fi

# ----------------- 4. Cargo helper tools (pinned versions) ------------------
log "Installing wasm-bindgen-cli $WASM_BINDGEN_VERSION"
cargo install -f --locked "wasm-bindgen-cli@$WASM_BINDGEN_VERSION"

log "Installing cargo-about $CARGO_ABOUT_VERSION (0.9.x is incompatible)"
cargo install -f --locked "cargo-about@$CARGO_ABOUT_VERSION"

# wasm-opt (Binaryen) is auto-downloaded by Graphite's own build tool.

# --------------------------- 5. Get the source ------------------------------
if [ -d "$GRAPHITE_DIR/.git" ]; then
  log "Updating existing checkout at $GRAPHITE_DIR"
  git -C "$GRAPHITE_DIR" pull --ff-only
else
  log "Cloning Graphite into $GRAPHITE_DIR"
  git clone --depth 1 "$REPO_URL" "$GRAPHITE_DIR"
fi
cd "$GRAPHITE_DIR"
GRAPHITE_VERSION="$(git rev-parse --short HEAD)"

# ------------------------------ 6. Build ------------------------------------
log "Building the Graphite desktop app (release) — first build takes a while"
cargo run build desktop

BINARY="$GRAPHITE_DIR/target/release/graphite"
[ -x "$BINARY" ] || die "Build finished but binary not found at $BINARY"
log "Binary built: $BINARY"

# --------------------- 7. Locate the CEF runtime ----------------------------
# The graphite binary dynamically links libcef.so with no rpath, and CEF
# also needs its resource files (*.pak, locales/, icudtl.dat, ...) at
# runtime. Find where the build downloaded the CEF distribution.
CEF_LIB_DIR="$(find "$GRAPHITE_DIR/target" -name 'libcef.so' -printf '%h\n' -quit)"
[ -n "$CEF_LIB_DIR" ] || die "Could not locate libcef.so under target/ — did the build succeed?"
log "CEF runtime found: $CEF_LIB_DIR"

# ------------------------ 8. Get linuxdeploy --------------------------------
mkdir -p "$WORK_DIR" && cd "$WORK_DIR"
if [ ! -x "$WORK_DIR/linuxdeploy-x86_64.AppImage" ]; then
  log "Downloading linuxdeploy"
  wget -q --show-progress -O linuxdeploy-x86_64.AppImage "$LINUXDEPLOY_URL"
  chmod +x linuxdeploy-x86_64.AppImage
fi
# --appimage-extract-and-run avoids needing FUSE installed
LINUXDEPLOY() { "$WORK_DIR/linuxdeploy-x86_64.AppImage" --appimage-extract-and-run "$@"; }

# --------------------- 9. Desktop file + icon for the bundle ----------------
log "Preparing desktop entry and icon"
DESKTOP_SRC="$WORK_DIR/$APP_ID.desktop"
cat > "$DESKTOP_SRC" <<EOF
[Desktop Entry]
Name=Graphite
GenericName=Vector & Raster Graphics Editor
Comment=Open-source vector & raster graphics editor with a node-based procedural workflow
Exec=graphite %F
Terminal=false
Type=Application
Icon=$APP_ID
Categories=Graphics;VectorGraphics;RasterGraphics;
Keywords=graphite;editor;vector;raster;procedural;design;
StartupWMClass=$APP_ID
X-AppImage-Version=$GRAPHITE_VERSION
EOF

# Icon: prefer a PNG from the branding assets downloaded during the build,
# else fall back to the official logo SVG from the project website.
ICON_SRC=""
CANDIDATE="$(find "$GRAPHITE_DIR/branding" -iname '*.png' 2>/dev/null | grep -iE 'icon|logo' | sort | head -n1 || true)"
if [ -n "$CANDIDATE" ]; then
  ICON_SRC="$WORK_DIR/$APP_ID.png"
  cp -f "$CANDIDATE" "$ICON_SRC"
else
  ICON_SRC="$WORK_DIR/$APP_ID.svg"
  curl -fsSL -o "$ICON_SRC" "https://static.graphite.art/logos/graphite-logo-solid.svg" \
    || die "No icon found in repo and download failed — place a PNG at $WORK_DIR/$APP_ID.png and re-run."
fi

# ------------------------ 10. Assemble the AppDir ---------------------------
log "Running linuxdeploy (bundles binary + shared library dependencies)"
APPDIR="$WORK_DIR/AppDir"
rm -rf "$APPDIR"

# LD_LIBRARY_PATH lets linuxdeploy's dependency walker resolve libcef.so;
# it will copy it into AppDir/usr/lib and patch the binary's rpath to \$ORIGIN.
# NO_STRIP: skip stripping the huge libcef.so (slow; remove to shrink output).
export LD_LIBRARY_PATH="$CEF_LIB_DIR:${LD_LIBRARY_PATH:-}"
NO_STRIP=1 LINUXDEPLOY \
  --appdir "$APPDIR" \
  --executable "$BINARY" \
  --desktop-file "$DESKTOP_SRC" \
  --icon-file "$ICON_SRC"

# ------------- 11. Add CEF's non-library runtime files ----------------------
# linuxdeploy only follows linked libraries; CEF additionally needs its
# resource files and dlopen'ed helpers placed NEXT TO libcef.so.
log "Copying CEF resources into the AppDir"
LIBDIR="$APPDIR/usr/lib"
cp -rn "$CEF_LIB_DIR"/. "$LIBDIR/" 2>/dev/null || true          # *.pak, *.bin, *.dat, libEGL, swiftshader, locales/ ...
if [ -d "$CEF_LIB_DIR/../Resources" ]; then                      # some CEF layouts split Release/ and Resources/
  cp -rn "$CEF_LIB_DIR/../Resources/." "$LIBDIR/" 2>/dev/null || true
fi
# Drop build-only artifacts that may live alongside the CEF libs
rm -f "$LIBDIR"/*.a "$LIBDIR"/cef_sandbox.a 2>/dev/null || true

# ------------------------- 12. Produce the AppImage -------------------------
log "Packing the AppImage"
cd "$WORK_DIR"
VERSION="$GRAPHITE_VERSION" NO_STRIP=1 LINUXDEPLOY --appdir "$APPDIR" --output appimage

APPIMAGE="$(ls -t "$WORK_DIR"/Graphite*.AppImage 2>/dev/null | head -n1)"
[ -n "$APPIMAGE" ] || die "linuxdeploy did not produce an AppImage."
chmod +x "$APPIMAGE"
log "AppImage created: $APPIMAGE ($(du -h "$APPIMAGE" | cut -f1))"

# --------------------- 13. Install locally + GNOME launcher -----------------
log "Installing to $BIN_DIR and creating the app-drawer launcher"
mkdir -p "$BIN_DIR" "$APP_DIR_INSTALL" "$ICON_INSTALL_DIR"

install -m 755 "$APPIMAGE" "$BIN_DIR/graphite"

if [ "${ICON_SRC##*.}" = "png" ]; then
  cp -f "$ICON_SRC" "$ICON_INSTALL_DIR/$APP_ID.png"
else
  mkdir -p "$HOME/.local/share/icons/hicolor/scalable/apps"
  cp -f "$ICON_SRC" "$HOME/.local/share/icons/hicolor/scalable/apps/$APP_ID.svg"
fi

sed "s|^Exec=.*|Exec=$BIN_DIR/graphite %F|" "$DESKTOP_SRC" \
  > "$APP_DIR_INSTALL/$APP_ID.desktop"
chmod +x "$APP_DIR_INSTALL/$APP_ID.desktop"
update-desktop-database "$APP_DIR_INSTALL" 2>/dev/null || true
gtk-update-icon-cache -q "$HOME/.local/share/icons/hicolor" 2>/dev/null || true

case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *) warn "$BIN_DIR is not in your PATH. Add to ~/.bashrc:  export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
esac

# ------------------------------- Done ----------------------------------------
log "All done!"
echo "  • Portable file:       $APPIMAGE  (copy this anywhere / to other machines)"
echo "  • Launch from GNOME:   press Super, type 'Graphite'"
echo "  • Launch from shell:   graphite"
echo "  • Update later:        re-run this script"
echo
echo "  Notes:"
echo "  - Runs on machines with the same-or-newer glibc than this build host."
echo "  - If the AppImage won't mount on a minimal system, run it with:"
echo "      ./Graphite-*.AppImage --appimage-extract-and-run"
