#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

echo "===================================================="
echo " Starting Tokyo Night Xfce4 Setup for Ubuntu 26.04 "
echo "===================================================="

# 1. Ensure Universe repository is enabled
echo "--> Enabling Ubuntu Universe repository..."
sudo add-apt-repository universe -y

# 2. Update package lists
echo "--> Updating package lists..."
sudo apt update

# 3. Install required dependencies
echo "--> Installing dependencies (Xfce plugins, Alacritty, Plank, etc.)..."
sudo apt install -y \
 xfce4-genmon-plugin \
 plank \
 alacritty \
 thunar \
 ncmpcpp \
 mpd \
 git \
 curl

# 4. Create a backup of existing configurations safely
echo "--> Creating a backup of your existing configurations..."
BACKUP_DIR="$HOME/Desktop/xfce_dots_backup_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$BACKUP_DIR"

[ -d "$HOME/.config" ] && cp -r "$HOME/.config" "$BACKUP_DIR/"
[ -d "$HOME/.themes" ] && cp -r "$HOME/.themes" "$BACKUP_DIR/"
echo "    Backup saved to: $BACKUP_DIR"

# 5. Clone the dotfiles repository to a temporary location
TEMP_DIR=$(mktemp -d)
echo "--> Cloning ahmadhabibi14/dotfile to temporary directory..."
git clone https://github.com/ahmadhabibi14/dotfile.git "$TEMP_DIR"

# 6. Deploy the configuration files
echo "--> Deploying dotfiles to your home directory..."

# Ensure target directories exist
mkdir -p "$HOME/.config"
mkdir -p "$HOME/.themes"
mkdir -p "$HOME/.local/share/plank/themes"

# Copy .config subfolders
cp -r "$TEMP_DIR/.config/"* "$HOME/.config/"

# Copy Genmon scripts
if [ -d "$TEMP_DIR/.genmon-plugin" ]; then
 cp -r "$TEMP_DIR/.genmon-plugin" "$HOME/"
 # Make sure scripts are executable
 chmod +x "$HOME/.genmon-plugin/"*.sh 2>/dev/null || true
fi

# Copy Plank themes
if [ -d "$TEMP_DIR/.local/share/plank/themes" ]; then
 cp -r "$TEMP_DIR/.local/share/plank/themes/"* "$HOME/.local/share/plank/themes/"
fi

# Copy Window/GTK themes
if [ -d "$TEMP_DIR/.themes" ]; then
 cp -r "$TEMP_DIR/.themes/"* "$HOME/.themes/"
fi

# Copy optional ncmpcpp profile
if [ -d "$TEMP_DIR/.ncmpcpp" ]; then
 cp -r "$TEMP_DIR/.ncmpcpp" "$HOME/"
fi

# 7. Clean up the temporary clone directory
rm -rf "$TEMP_DIR"

# 8. Set Plank to autostart on login
echo "--> Setting Plank to autostart..."
mkdir -p "$HOME/.config/autostart"
cat <<EOF >"$HOME/.config/autostart/plank.desktop"
[Desktop Entry]
Type=Application
Exec=plank
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
Name=Plank Dock
Comment=Stupidly simple dock
EOF

echo "--> Reloading Xfce Window Manager and Panel to apply configurations..."
# Safely attempt to refresh components if running in an active X session
if [ -n "$DISPLAY" ]; then
 xfwm4 --replace &
 xfce4-panel --restart &
fi

echo "===================================================="
echo " Setup Complete! "
echo "===================================================="
echo "Next Steps to finish the look:"
echo "1. Open Settings -> Appearance and select the Tokyo Night theme."
echo "2. Open Settings -> Window Manager and match the theme style."
echo "3. Launch Plank, Ctrl+Right-click it, go to Preferences, and set Theme to 'Habiboow'."
echo "4. Add a 'Generic Monitor' to your top panel and point it to a script in ~/.genmon-plugin/"
