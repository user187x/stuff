#!/usr/bin/env bash
#
# debug-pod — interactive Kubernetes pod debugger
#
# Pick a namespace + pod with fzf, spin up a co-located debug pod with a full
# triage toolkit (curl, wget, dig, tcpdump, nc, ss, strace, lsof, jq, htop, ...),
# mount the target pod's PVCs read-only at /pvc/<name>, drop into a shell, and
# clean everything up on exit.
#
# Requires: kubectl, fzf, jq
#
# Environment overrides:
#   DEBUG_POD_IMAGE     container image          (default: nicolaka/netshoot:latest)
#   DEBUG_POD_RO        mount PVCs read-only    (default: true)
#   DEBUG_POD_TIMEOUT   ready-wait timeout      (default: 120s)
#   DEBUG_POD_HOSTPID   share host PID ns       (default: false)
#

set -euo pipefail

# ─── config ──────────────────────────────────────────────────────────────────
DEBUG_IMAGE="${DEBUG_POD_IMAGE:-nicolaka/netshoot:latest}"
DEBUG_TIMEOUT="${DEBUG_POD_TIMEOUT:-120s}"
MOUNT_READONLY="${DEBUG_POD_RO:-true}"
HOST_PID="${DEBUG_POD_HOSTPID:-false}"

# ─── pretty logging ──────────────────────────────────────────────────────────
if [[ -t 2 ]]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
    BLUE=$'\033[0;34m'; DIM=$'\033[2m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; BLUE=""; DIM=""; NC=""
fi
info() { printf "${BLUE}┃${NC} %s\n" "$*" >&2; }
ok()   { printf "${GREEN}✓${NC} %s\n"  "$*" >&2; }
warn() { printf "${YELLOW}!${NC} %s\n" "$*" >&2; }
err()  { printf "${RED}✗${NC} %s\n"   "$*" >&2; }
die()  { err "$*"; exit 1; }

# ─── prerequisites ───────────────────────────────────────────────────────────
for cmd in kubectl fzf jq; do
    command -v "$cmd" >/dev/null 2>&1 || die "'$cmd' is required but not installed"
done
kubectl cluster-info >/dev/null 2>&1 || die "Cannot reach the Kubernetes cluster (check kubeconfig / context)"

CTX="$(kubectl config current-context 2>/dev/null || echo unknown)"
info "Context: ${DIM}${CTX}${NC}"

# ─── select namespace ────────────────────────────────────────────────────────
info "Loading namespaces..."
NS_LIST="$(kubectl get namespaces \
    -o custom-columns='NAME:.metadata.name,STATUS:.status.phase,AGE:.metadata.creationTimestamp' \
    --no-headers 2>/dev/null)" || die "Failed to list namespaces"
[[ -n "$NS_LIST" ]] || die "No namespaces visible to current user"

NAMESPACE="$(printf '%s\n' "$NS_LIST" \
    | fzf --height=60% --reverse --ansi \
          --prompt='namespace ❯ ' \
          --header=$'╭─ select namespace ──────────────────────────────╮\n│ enter: pick   esc: cancel                       │\n╰─────────────────────────────────────────────────╯' \
          --preview='kubectl describe namespace {1}' \
          --preview-window='right:55%:wrap' \
    | awk '{print $1}')"
[[ -n "$NAMESPACE" ]] || die "No namespace selected"
ok "Namespace: ${GREEN}${NAMESPACE}${NC}"

# ─── select pod ──────────────────────────────────────────────────────────────
info "Loading pods in $NAMESPACE..."
POD_LIST="$(kubectl get pods -n "$NAMESPACE" --no-headers 2>/dev/null || true)"
[[ -n "$POD_LIST" ]] || die "No pods in namespace '$NAMESPACE'"

POD="$(printf '%s\n' "$POD_LIST" \
    | fzf --height=60% --reverse --ansi \
          --prompt='pod ❯ ' \
          --header=$'╭─ select pod to debug ───────────────────────────╮\n│ enter: pick   esc: cancel                       │\n╰─────────────────────────────────────────────────╯' \
          --preview="kubectl describe pod -n $NAMESPACE {1}" \
          --preview-window='right:60%:wrap' \
    | awk '{print $1}')"
[[ -n "$POD" ]] || die "No pod selected"
ok "Pod: ${GREEN}${POD}${NC}"

# ─── inspect target pod ──────────────────────────────────────────────────────
info "Inspecting target pod..."
POD_JSON="$(kubectl get pod "$POD" -n "$NAMESPACE" -o json)" \
    || die "Could not fetch pod spec"

NODE_NAME="$(jq -r '.spec.nodeName // ""'           <<<"$POD_JSON")"
SERVICE_ACCOUNT="$(jq -r '.spec.serviceAccountName // "default"' <<<"$POD_JSON")"

# pull all PVC-backed volumes
VOLUMES_JSON="$(jq '
    [ .spec.volumes[]?
      | select(.persistentVolumeClaim != null)
      | {name, persistentVolumeClaim} ]
' <<<"$POD_JSON")"
PVC_COUNT="$(jq 'length' <<<"$VOLUMES_JSON")"

# build matching volumeMounts at /pvc/<volume-name>
VOLUME_MOUNTS_JSON="$(jq --argjson ro "$MOUNT_READONLY" '
    [ .[] | {name, mountPath: ("/pvc/" + .name), readOnly: $ro} ]
' <<<"$VOLUMES_JSON")"

if (( PVC_COUNT > 0 )); then
    info "PVCs to mount (readOnly=${MOUNT_READONLY}):"
    jq -r '.[] | "    • " + .name + " → claim: " + .persistentVolumeClaim.claimName' \
        <<<"$VOLUMES_JSON" >&2
    info "  (will appear under /pvc/<volume-name> in the debug shell)"
else
    info "No PVCs attached to target pod"
fi

# ─── build debug pod manifest ────────────────────────────────────────────────
SUFFIX="$(tr -dc 'a-z0-9' </dev/urandom | head -c 5 || echo $RANDOM)"
SAFE_POD="$(echo "$POD" | tr -c 'a-z0-9-' '-' | sed 's/--*/-/g; s/^-//; s/-$//')"
DEBUG_POD_NAME="debug-${SAFE_POD}-${SUFFIX}"
DEBUG_POD_NAME="${DEBUG_POD_NAME:0:63}"
DEBUG_POD_NAME="${DEBUG_POD_NAME%-}"

info "Debug pod: ${YELLOW}${DEBUG_POD_NAME}${NC}"
[[ -n "$NODE_NAME" ]] && info "Scheduling on node: ${DIM}${NODE_NAME}${NC}"

MANIFEST="$(jq -n \
    --arg name      "$DEBUG_POD_NAME" \
    --arg ns        "$NAMESPACE" \
    --arg target    "$POD" \
    --arg image     "$DEBUG_IMAGE" \
    --arg node      "$NODE_NAME" \
    --arg sa        "$SERVICE_ACCOUNT" \
    --argjson hpid  "$HOST_PID" \
    --argjson volumes "$VOLUMES_JSON" \
    --argjson mounts  "$VOLUME_MOUNTS_JSON" \
'{
    apiVersion: "v1",
    kind: "Pod",
    metadata: {
        name: $name,
        namespace: $ns,
        labels: {
            "app.kubernetes.io/name":       "debug-pod",
            "app.kubernetes.io/managed-by": "debug-pod-script",
            "debug-pod/target":             $target
        },
        annotations: {
            "debug-pod/target-pod": $target,
            "debug-pod/note":       "ephemeral debug pod; safe to delete"
        }
    },
    spec: ({
        restartPolicy: "Never",
        terminationGracePeriodSeconds: 0,
        serviceAccountName: $sa,
        hostPID: $hpid,
        containers: [{
            name: "debugger",
            image: $image,
            imagePullPolicy: "IfNotPresent",
            command: ["sleep", "infinity"],
            stdin: true,
            tty: true,
            env: [
                {name: "TARGET_POD", value: $target},
                {name: "TARGET_NS",  value: $ns}
            ],
            securityContext: {
                runAsUser: 0,
                capabilities: { add: ["NET_ADMIN", "NET_RAW", "SYS_PTRACE"] }
            },
            volumeMounts: $mounts
        }],
        volumes: $volumes
    } + (if $node != "" then {nodeName: $node} else {} end))
}')"

# ─── cleanup trap ────────────────────────────────────────────────────────────
DEBUG_POD_CREATED=0
cleanup() {
    local rc=$?
    echo >&2
    if (( DEBUG_POD_CREATED == 1 )); then
        info "Cleaning up ${DEBUG_POD_NAME}..."
        if kubectl get pod "$DEBUG_POD_NAME" -n "$NAMESPACE" >/dev/null 2>&1; then
            kubectl delete pod "$DEBUG_POD_NAME" -n "$NAMESPACE" \
                --grace-period=0 --force --wait=false >/dev/null 2>&1 || true
            for _ in {1..15}; do
                kubectl get pod "$DEBUG_POD_NAME" -n "$NAMESPACE" >/dev/null 2>&1 || break
                sleep 1
            done
            if kubectl get pod "$DEBUG_POD_NAME" -n "$NAMESPACE" >/dev/null 2>&1; then
                warn "Pod still terminating; should disappear shortly"
            else
                ok "Debug pod removed from cluster"
            fi
        else
            ok "Debug pod already gone"
        fi
    fi
    exit "$rc"
}
trap cleanup EXIT INT TERM

# ─── launch ──────────────────────────────────────────────────────────────────
info "Creating debug pod..."
if ! printf '%s\n' "$MANIFEST" | kubectl apply -f - >/dev/null 2>&1; then
    err "Failed to create debug pod. Common causes:"
    err "  • PodSecurity policy blocks privileged caps in namespace '$NAMESPACE'"
    err "  • ResourceQuota exhausted"
    err "  • Image cannot be pulled"
    printf '%s\n' "$MANIFEST" | kubectl apply -f - 2>&1 | sed 's/^/    /' >&2 || true
    exit 1
fi
DEBUG_POD_CREATED=1

info "Waiting for ready (timeout: ${DEBUG_TIMEOUT})..."
if ! kubectl wait --for=condition=Ready "pod/$DEBUG_POD_NAME" \
        -n "$NAMESPACE" --timeout="$DEBUG_TIMEOUT" >/dev/null 2>&1; then
    err "Debug pod did not become Ready. Recent events:"
    kubectl describe pod "$DEBUG_POD_NAME" -n "$NAMESPACE" 2>&1 \
        | sed -n '/^Events:/,$p' | sed 's/^/    /' >&2 || true
    die "aborting"
fi
ok "Debug pod is ready"

# ─── install helpme cheatsheet ───────────────────────────────────────────────
install_cheatsheet() {
    kubectl exec -i -n "$NAMESPACE" "$DEBUG_POD_NAME" -c debugger -- \
        sh -c 'cat > /usr/local/bin/helpme && chmod +x /usr/local/bin/helpme' \
        <<'HELPME_SCRIPT'
#!/bin/bash
# helpme — debug-pod cheatsheet (auto-installed)
if [[ -t 1 ]]; then
    B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0;31m'; G=$'\033[0;32m'
    Y=$'\033[1;33m'; BL=$'\033[0;34m'; C=$'\033[0;36m'; M=$'\033[0;35m'; N=$'\033[0m'
else
    B=""; D=""; R=""; G=""; Y=""; BL=""; C=""; M=""; N=""
fi
TARGET_POD="${TARGET_POD:-<target-pod>}"
TARGET_NS="${TARGET_NS:-<namespace>}"
H()   { printf "\n${B}${C}━━ %s ━━${N}\n" "$*"; }
S()   { printf "${Y}# %s${N}\n" "$*"; }
CMD() { printf "  ${G}%s${N}\n" "$*"; }
NOTE(){ printf "  ${D}%s${N}\n" "$*"; }

orient() {
    H "ORIENTATION — where am I, what do I have"
    S "current host & DNS config"
    CMD 'hostname && cat /etc/resolv.conf'
    S "PVCs mounted from $TARGET_POD"
    CMD 'ls -la /pvc/'
    S "service account info (you inherited target's SA)"
    CMD 'cat /var/run/secrets/kubernetes.io/serviceaccount/namespace'
    CMD 'TOKEN=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token); echo "${TOKEN:0:30}..."'
}

dns() {
    H "DNS — #1 cause of 'cannot reach X'"
    S "in-cluster service lookup"
    CMD 'dig +short <service-name>'
    CMD 'dig +short <service>.<namespace>.svc.cluster.local'
    S "external resolution"
    CMD 'dig +short github.com'
    CMD 'nslookup charts.bitnami.com'
    S "trace the resolution path"
    CMD 'dig <hostname> +trace'
    S "show resolver config"
    CMD 'cat /etc/resolv.conf'
    NOTE "# nameserver 10.96.0.10 ← that's CoreDNS / kube-dns"
    S "test resolver latency under load"
    CMD 'for i in 1 2 3 4 5; do time dig +short kubernetes.default.svc; done'
}

tcp() {
    H "TCP — can I actually connect?"
    S "single port (verbose)"
    CMD 'nc -zv <host> <port>'
    S "multiple ports"
    CMD 'for p in 80 443 8080 8443; do nc -zv <host> $p 2>&1; done'
    S "raw IP bypasses DNS"
    CMD 'nc -zv 140.82.112.3 22'
    S "with timing"
    CMD 'time nc -zv <host> <port>'
    S "scan a range"
    CMD 'nmap -p 1-1000 <host>'
}

http() {
    H "HTTP / gRPC — probe services"
    S "health checks"
    CMD 'curl -k https://<service>/healthz'
    CMD 'curl -k https://<service>/api/version'
    S "headers only — fast triage"
    CMD 'curl -kI https://<host>'
    S "full timing breakdown"
    cat <<'EOF'
  curl -w "@-" -o /dev/null -s https://<host> <<'TIMING'
     dns:      %{time_namelookup}s
     connect:  %{time_connect}s
     tls:      %{time_appconnect}s
     ttfb:     %{time_starttransfer}s
     total:    %{time_total}s
  TIMING
EOF
    S "gRPC handshake check"
    CMD 'curl -kv https://<grpc-service>:<port> 2>&1 | head -20'
    S "verbose with body"
    CMD 'curl -kv https://<host>'
    S "redis ping"
    CMD 'redis-cli -h <redis-host> ping'
    CMD 'redis-cli -h <redis-host> -a "$PASSWORD" ping'
}

pvc() {
    H "PVC — inspect persistent volume contents"
    S "list mounted PVCs"
    CMD 'ls -la /pvc/'
    CMD 'find /pvc -maxdepth 3 -type d'
    S "disk usage / pressure"
    CMD 'df -h /pvc/*'
    CMD 'du -sh /pvc/*/* 2>/dev/null | sort -rh | head -20'
    S "lock files (cause stuck operations)"
    CMD 'find /pvc -name "*.lock" -o -name "index.lock" 2>/dev/null'
    S "recent file changes"
    CMD 'find /pvc -type f -mmin -60 2>/dev/null | head -20'
    S "search for a pattern"
    CMD "grep -r 'pattern' /pvc/ 2>/dev/null | head"
}

cap() {
    H "TCPDUMP — packet captures"
    S "watch traffic to a host"
    CMD "tcpdump -i any -n 'host <host>' -c 50"
    S "watch a port (e.g. redis)"
    CMD "tcpdump -i any -n -A 'port 6379' -c 50"
    S "watch DNS queries"
    CMD "tcpdump -i any -n 'port 53' -c 20"
    S "save to pcap (then kubectl cp out)"
    CMD "tcpdump -i any -w /tmp/cap.pcap 'host <host>' -c 200"
    NOTE "# from your laptop:"
    CMD "kubectl cp ${TARGET_NS}/<debug-pod-name>:/tmp/cap.pcap ./cap.pcap"
    S "inspect packet contents"
    CMD "tcpdump -i any -n -A 'host <host> and port 80' -c 20"
}

tls() {
    H "TLS — certificate debugging"
    S "inspect serving cert"
    CMD 'echo | openssl s_client -connect <host>:443 -servername <host> 2>/dev/null \
      | openssl x509 -noout -subject -issuer -dates'
    S "verify chain via curl"
    CMD "curl -kvI https://<host> 2>&1 | grep -E '(SSL|subject|issuer|expire)'"
    S "show full cert chain"
    CMD 'openssl s_client -showcerts -connect <host>:443 </dev/null 2>/dev/null'
    S "test specific TLS version"
    CMD 'openssl s_client -tls1_2 -connect <host>:443 </dev/null'
    S "expiry only"
    CMD 'echo | openssl s_client -connect <host>:443 2>/dev/null \
      | openssl x509 -noout -enddate'
}

route() {
    H "ROUTING & MTU"
    S "routes & interfaces"
    CMD 'ip route'
    CMD 'ip -br addr'
    CMD 'ip link show'
    S "trace path"
    CMD 'traceroute -n <host>'
    CMD 'mtr -n <host>     # interactive'
    S "MTU test (-M do = don'\''t fragment)"
    CMD 'ping -M do -s 1472 <host>     # std MTU 1500 - 28'
    CMD 'ping -M do -s 1372 <host>     # fallback for VXLAN/IPsec'
}

api() {
    H "KUBERNETES API — using target's ServiceAccount"
    NOTE "you inherited ${TARGET_POD}'s SA"
    S "set up auth"
    cat <<'EOF'
  TOKEN=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)
  CACERT=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
  APISERVER=https://kubernetes.default.svc
EOF
    S "list pods in target namespace"
    CMD "curl -s --cacert \$CACERT -H \"Authorization: Bearer \$TOKEN\" \\
    \$APISERVER/api/v1/namespaces/${TARGET_NS}/pods | jq '.items[].metadata.name'"
    S "list any CRD"
    CMD "curl -s --cacert \$CACERT -H \"Authorization: Bearer \$TOKEN\" \\
    \$APISERVER/apis/<group>/<version>/namespaces/${TARGET_NS}/<plural> | jq"
    S "what CAN this SA do?"
    CMD "curl -s --cacert \$CACERT -H \"Authorization: Bearer \$TOKEN\" \\
    -X POST -H 'Content-Type: application/json' \\
    \$APISERVER/apis/authorization.k8s.io/v1/selfsubjectrulesreviews \\
    -d '{\"kind\":\"SelfSubjectRulesReview\",\"apiVersion\":\"authorization.k8s.io/v1\",\"spec\":{\"namespace\":\"${TARGET_NS}\"}}' | jq"
}

proc() {
    H "PROCESSES — only with DEBUG_POD_HOSTPID=true"
    S "all processes on the node"
    CMD 'ps -ef'
    S "find target processes"
    CMD 'ps -ef | grep <process-name>'
    S "syscall stats"
    CMD 'strace -p $(pgrep <name> | head -1) -c -f 2>&1 | head -30'
    S "open files & sockets"
    CMD 'lsof -p $(pgrep <name> | head -1) 2>/dev/null | head -20'
    S "live cpu/mem"
    CMD 'top -b -n 1 | head -30'
    CMD 'htop'
}

flow() {
    H "REAL-WORLD TRIAGE FLOW"
    NOTE "example: '$TARGET_POD UI is up but operations are stuck'"
    S "1. service dependencies reachable?"
    CMD 'for svc in <dep1> <dep2> <dep3>; do nc -zv $svc <port> 2>&1; done'
    S "2. cluster API reachable?"
    CMD "curl -ks --cacert /var/run/secrets/kubernetes.io/serviceaccount/ca.crt \\
    -H \"Authorization: Bearer \$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)\" \\
    https://kubernetes.default.svc/api/v1/namespaces | jq '.items | length'"
    S "3. external dependencies reachable?"
    CMD 'nc -zv github.com 443 && curl -kI https://github.com'
    S "4. backend latency? (e.g., redis)"
    CMD 'redis-cli -h <redis-host> --latency -i 1'
    NOTE "# Ctrl-C after 5s; >10ms avg = problem"
    S "5. PVC under pressure?"
    CMD 'df -h /pvc/* 2>/dev/null'
    S "6. DNS healthy?"
    CMD 'for i in 1 2 3 4 5; do time dig +short kubernetes.default.svc; done'
}

menu() {
cat <<EOF
${B}${C}debug-pod cheatsheet${N}  ${D}— target: ${Y}${TARGET_POD}${D} / ns: ${Y}${TARGET_NS}${N}

${B}USAGE${N}
  ${G}helpme${N}              show this menu
  ${G}helpme <topic>${N}      show examples for one topic
  ${G}helpme all${N}          show every topic
  ${G}helpme search <term>${N}  grep all examples for <term>

${B}TOPICS${N}
  ${Y}orient${N}    quick orientation: where am I, what do I have
  ${Y}dns${N}       DNS resolution (most common failure mode)
  ${Y}tcp${N}       TCP reachability & port checks
  ${Y}http${N}      HTTP/gRPC probes & timing
  ${Y}pvc${N}       inspect persistent volume contents under /pvc/
  ${Y}cap${N}       packet captures with tcpdump
  ${Y}tls${N}       certificate debugging
  ${Y}route${N}     routes, traceroute, MTU
  ${Y}api${N}       hitting kubernetes API as target's SA
  ${Y}proc${N}      process inspection (needs DEBUG_POD_HOSTPID=true)
  ${Y}flow${N}      end-to-end triage walkthrough

${B}TIPS${N}
  • PVCs from target are under ${Y}/pvc/${N}
  • \$TARGET_POD = ${Y}${TARGET_POD}${N}, \$TARGET_NS = ${Y}${TARGET_NS}${N}
  • copy commands verbatim — substitute ${D}<placeholders>${N}
EOF
}

all_topics() {
    orient; dns; tcp; http; pvc; cap; tls; route; api; proc; flow
}

case "${1:-menu}" in
    ""|menu|help|-h|--help) menu ;;
    all)                    all_topics ;;
    orient|where|info)      orient ;;
    dns)                    dns ;;
    tcp|nc|port)            tcp ;;
    http|curl|grpc)         http ;;
    pvc|volume|disk)        pvc ;;
    cap|tcpdump|pcap)       cap ;;
    tls|cert|ssl|openssl)   tls ;;
    route|routing|mtu|ip)   route ;;
    api|k8s|kube)           api ;;
    proc|ps|process)        proc ;;
    flow|triage)            flow ;;
    search|grep|find)
        shift
        [[ -z "${1:-}" ]] && { echo "usage: helpme search <term>"; exit 1; }
        all_topics | grep -i --color=always -B 1 -A 1 -- "$1" || echo "no match for '$1'"
        ;;
    *) printf "${R}unknown topic: $1${N}\n\n"; menu; exit 1 ;;
esac
HELPME_SCRIPT
}

info "Installing helpme cheatsheet..."
if install_cheatsheet 2>/dev/null; then
    ok "Cheatsheet installed (run ${YELLOW}helpme${NC} inside the shell)"
else
    warn "Could not install cheatsheet (continuing anyway)"
fi

# ─── attach shell ────────────────────────────────────────────────────────────
cat >&2 <<EOF

${DIM}─────────────────────────────────────────────────────────────${NC}
  attached to:  ${GREEN}${DEBUG_POD_NAME}${NC}
  target pod:   ${YELLOW}${POD}${NC}  (${DIM}${NAMESPACE}${NC})
  pvc mounts:   ${PVC_COUNT} under /pvc/
  cheatsheet:   type ${YELLOW}helpme${NC} for examples
  exit shell to clean up.
${DIM}─────────────────────────────────────────────────────────────${NC}

EOF

# Prefer bash, fall back to sh. Don't fail the whole script if exec returns non-zero.
set +e
kubectl exec -it "$DEBUG_POD_NAME" -n "$NAMESPACE" -c debugger -- /bin/bash 2>/dev/null
rc=$?
if (( rc != 0 )); then
    kubectl exec -it "$DEBUG_POD_NAME" -n "$NAMESPACE" -c debugger -- /bin/sh
fi
set -e

# trap handles cleanup
