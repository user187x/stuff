#!/bin/bash

UUID=$(dconf read /org/gnome/Ptyxis/default-profile-uuid | tr -d "'")

# 2. Check if a UUID was found
if [ -z "$UUID" ]; then
 echo "Error: Could not find a default Ptyxis profile."
 exit 1
fi

# 3. Set opacity (0.85 = 85% opacity, adjust as needed)
OPACITY=0.85
dconf write /org/gnome/Ptyxis/Profiles/"$UUID"/opacity $OPACITY

echo "Success! Ptyxis transparency set to $OPACITY for profile $UUID."
echo "You can now also adjust this via a slider in Ptyxis Preferences -> Appearance."
