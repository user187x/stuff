#!/bin/bash
# Reverts enable-plugin: renders Traefik from the release's own values (no plugin overlay), applies that
# Deployment, and removes the air-gapped plugin ConfigMap if there is one. Gateway and routes are untouched.
#   ./disable-plugin [--diff-only]
set -euo pipefail
# A relative TRAEFIK_CHART (e.g. ./traefik-41.4.0.tgz) is relative to where the caller is, not to this script.
[[ -n "${TRAEFIK_CHART:-}" && -e "${TRAEFIK_CHART}" ]] && TRAEFIK_CHART=$(realpath "${TRAEFIK_CHART}")
cd "$(dirname "$0")"
. ./plugin-lib.sh

[[ "${1:-}" == "--diff-only" ]] && diff_only=1 || diff_only=0
[[ -z "${1:-}" || "${1:-}" == "--diff-only" ]] || { echo "usage: $0 [--diff-only]" >&2; exit 2; }

# Nothing may still use the plugin when it is switched off, or Traefik will drop those routers.
users=$(kubectl get middlewares.traefik.io -A -o jsonpath='{range .items[?(@.spec.plugin)]}{.metadata.namespace}/{.metadata.name}{"\n"}{end}' 2>/dev/null || true)
if [[ -n "${users}" ]]; then
 echo "WARNING: these Traefik Middlewares still use a plugin (remove them first, e.g. ./uninstall-banner-chart):" >&2
 sed 's/^/  /' <<<"${users}" >&2
 [[ ${diff_only} -eq 1 ]] || exit 1
fi

render
show_changes
[[ ${diff_only} -eq 1 ]] && exit 0
apply_and_wait
for cm in $(kubectl -n "${NS}" get configmap -o name | grep -- '-local-plugin-' || true); do
 kubectl -n "${NS}" delete "${cm}"
done
echo "Traefik is back to the release's own configuration (plugin disabled)."
