#!/usr/bin/env bash
#
# concat_project.sh
# ------------------
# Concatenates every text file from a chosen project root into a single file,
# with each file preceded by a separator and its relative path. At the end of
# the output, the directory structure is appended via `tree` so that an LLM
# can understand the layout of the project.
#
# Usage:  ./concat_project.sh
#

set -euo pipefail

# -----------------------------
# Prompt user for the project root
# -----------------------------
read -e -rp "Enter the root directory of the project: " ROOT_DIR

# Expand a leading ~ to $HOME if the user typed one
ROOT_DIR="${ROOT_DIR/#\~/$HOME}"

# Strip any trailing slash for clean path printing
ROOT_DIR="${ROOT_DIR%/}"

if [[ -z "$ROOT_DIR" || ! -d "$ROOT_DIR" ]]; then
 echo "Error: '$ROOT_DIR' is not a valid directory." >&2
 exit 1
fi

# -----------------------------
# Output file (in the current working directory)
# -----------------------------
OUTPUT_FILE="$(pwd)/project_concat.txt"
: >"$OUTPUT_FILE" # truncate / create

# -----------------------------
# Directories we want to skip (build artifacts, deps, VCS metadata)
# -----------------------------
PRUNE_EXPR=(
 -name .git -o
 -name node_modules -o
 -name .venv -o
 -name venv -o
 -name __pycache__ -o
 -name .next -o
 -name .cache -o
 -name dist -o
 -name build -o
 -name target -o
 -name .idea -o
 -name .vscode
)

echo "Scanning '$ROOT_DIR' ..."

# -----------------------------
# Walk the tree and append each text file
# -----------------------------
# We use -print0 / read -d '' to handle filenames with spaces or newlines safely.
while IFS= read -r -d '' file; do
 # Don't include our own output file if the user runs the script from inside the project
 [[ "$file" -ef "$OUTPUT_FILE" ]] && continue

 # Skip binary files (images, executables, archives, etc.)
 if ! file --mime-encoding -- "$file" 2>/dev/null | grep -qv 'binary$'; then
  continue
 fi

 rel_path="${file#"$ROOT_DIR"/}"

 {
  echo ""
  echo "========================================================"
  echo "File: $rel_path"
  echo "========================================================"
  cat -- "$file"
 } >>"$OUTPUT_FILE"
done < <(find "$ROOT_DIR" \( "${PRUNE_EXPR[@]}" \) -prune -o -type f -print0)

# -----------------------------
# Append directory tree at the END
# -----------------------------
{
 echo ""
 echo "========================================================"
 echo "Project Directory Structure"
 echo "========================================================"
 if command -v tree >/dev/null 2>&1; then
  tree -a \
   -I '.git|node_modules|.venv|venv|__pycache__|.next|.cache|dist|build|target|.idea|.vscode' \
   "$ROOT_DIR"
 else
  echo "(the 'tree' command is not installed; falling back to 'find')"
  find "$ROOT_DIR" \( "${PRUNE_EXPR[@]}" \) -prune -o -print | sort
 fi
} >>"$OUTPUT_FILE"

echo "Done. Combined output written to: $OUTPUT_FILE"
