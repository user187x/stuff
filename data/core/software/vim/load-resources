#!/bin/bash

# Fail & Bail
set -e

# System designated directories
RESOURCE_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Specific resource being installed
RESOURCE="vim"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Specific resource paths
DESTINATION="${CONFIG_HOME}/${RESOURCE}"
PAYLOAD="${RESOURCE_HOME}/${RESOURCE}"

function process-payload {

 local payload="$1"
 echo "Payload : $payload"
 local destination="$2"

 local destination_path=$(dirname "$destination")

 # Make sure destination exitss
 mkdir -p "$destination_path"
 echo "Destination Path : $destination_path"

 if [[ -e "$destination" || -L "$destination" ]]; then
  rm -rf "$destination"
 fi
 
 echo "Destination: $destination"

 ln -s "$payload" "$destination"
 echo "Linked: $destination -> $payload"
}

function install-logic {

 echo "Installing ${RESOURCE}..."
 process-payload "${PAYLOAD}" "${DESTINATION}"
 echo "Payload: $PAYLOAD"
 echo "Destination: $DESTINATION"
 echo "${RESOURCE} updated!"
 echo
}

function process-arguments {
 while [[ $# -gt 0 ]]; do
  case "$1" in
  -s | --source)
   PAYLOAD="$2"
   shift 2
   ;;
  -d | --destination)
   DESTINATION="$2"
   shift 2
   ;;
  -h | --help)
   echo "Usage: load-resources [-s|--source <path>] [-d|--destination <path>]"
   return 0
   ;;
  -*)
   echo "Error: Unknown option $1" >&2
   return 1
   ;;
  *)
   echo "Ignoring positional argument: $1"
   shift 1
   ;;
  esac
 done
}

function main {
 if [[ "$#" -eq 0 ]]; then
  process-arguments "$@"
 fi 
 install-logic
}

main "$@"
