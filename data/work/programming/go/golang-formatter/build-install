#!/bin/bash

# 1. Compile the Go code into a standalone executable named 'prettygo'
go build -o prettygo main.go

# 2. Make sure it is executable (it usually is by default after a Go build)
chmod +x prettygo

# 3. Move it to a directory on your system's PATH (requires sudo)
mv prettygo ~/.local/bin

echo '
# Preview the formatting in your terminal
prettygo main.go

# Overwrite the file with the new 1-space formatting
prettygo -w main.go
'
