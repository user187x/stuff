#!/bin/bash

# ==========================================
# CONFIGURATION
# ==========================================
CERT_PATH="$HOME/my-cert.p12"     # Update this to the path of your .p12 certificate
CURL_TARGET="https://example.com" # Update this to your target URL
PASS_ENTRY="work/cert-password"
GPG_NAME="Work Cert Key"
GPG_EMAIL="work-cert-key@${USER}.local"
CACHE_TTL=28800 # 8 hours in seconds
UNLOCK_FILE="$HOME/.gnupg/.work-unlock-time"
TEST_ENC_FILE="$HOME/.gnupg/.pass-check.gpg"

function nuke-all {

 gpgconf --kill gpg-agent
 rm -rf ~/.password-store
 rm -rf ~/.gnupg
}

function reset-pass-entry {

 # 1. Kill the GPG agent to clear the 8-hour password cache from memory
 gpgconf --kill gpg-agent

 # 2. Delete the specific GPG secret and public keys created by the script
 gpg --batch --yes --delete-secret-keys "work-cert-key@${USER}.local" 2>/dev/null
 gpg --batch --yes --delete-keys "work-cert-key@${USER}.local" 2>/dev/null

 # 3. Remove the 'work' password entry and the pass initialization file
 rm -rf ~/.password-store/work
 rm -f ~/.password-store/.gpg-id

 # 4. Remove the script's hidden tracking and dummy encryption files
 rm -f ~/.gnupg/.work-unlock-time
 rm -f ~/.gnupg/.pass-check.gpg

 echo "Reset complete. Ready for a fresh run!"
}

# ==========================================
# 1. SEAMLESS DEPENDENCY INSTALLATION
# ==========================================
install_dependencies() {
 local missing_pkgs=()
 for pkg in pass gpg curl; do
  if ! command -v "$pkg" &>/dev/null; then
   [ "$pkg" == "gpg" ] && pkg_name="gnupg" || pkg_name="$pkg"
   missing_pkgs+=("$pkg_name")
  fi
 done

 if [ ${#missing_pkgs[@]} -ne 0 ]; then
  echo "Installing missing dependencies: ${missing_pkgs[*]}..."
  if command -v apt-get &>/dev/null; then
   sudo apt-get update -qq && sudo apt-get install -y -qq "${missing_pkgs[@]}"
  elif command -v yum &>/dev/null; then
   sudo yum install -y -q "${missing_pkgs[@]}"
  else
   echo "Error: Package manager not found. Install ${missing_pkgs[*]} manually."
   exit 1
  fi
 fi
}

# ==========================================
# 2. GPG AGENT CONFIGURATION (8-Hour Cache)
# ==========================================
setup_gpg_agent() {
 mkdir -p "$HOME/.gnupg"
 chmod 700 "$HOME/.gnupg"

 local agent_conf="$HOME/.gnupg/gpg-agent.conf"
 local needs_reload=false

 # Enforce 8-hour timeouts exactly
 for setting in "default-cache-ttl $CACHE_TTL" "max-cache-ttl $CACHE_TTL" "allow-loopback-pinentry"; do
  if ! grep -q "^$setting" "$agent_conf" 2>/dev/null; then
   echo "$setting" >>"$agent_conf"
   needs_reload=true
  fi
 done

 if $needs_reload; then
  if command -v gpgconf &>/dev/null; then
   gpgconf --kill gpg-agent
  else
   killall gpg-agent 2>/dev/null || true
  fi
 fi
}

# ==========================================
# 3. FIRST-TIME PASS & GPG SETUP
# ==========================================
setup_pass_if_needed() {
 if ! pass "$PASS_ENTRY" >/dev/null 2>&1; then
  echo "=================================================="
  echo " First-time setup: Secure Password Store"
  echo "=================================================="
  echo "Please enter your Certificate Password."
  echo "This will be securely stored and used to unlock your workday environment for 8 hours."

  read -s -p "Password: " USER_PASS
  echo
  read -s -p "Confirm Password: " USER_PASS_CONFIRM
  echo

  if [ "$USER_PASS" != "$USER_PASS_CONFIRM" ]; then
   echo "Error: Passwords do not match. Exiting."
   exit 1
  fi

  echo "Generating secure GPG key seamlessly (this may take a moment)..."

  # RSA generation to avoid elliptic curve failures on some systems
  if ! gpg --list-keys "$GPG_EMAIL" >/dev/null 2>&1; then
   local batch_file=$(mktemp)
   cat <<EOF >"$batch_file"
%echo Generating key
Key-Type: RSA
Key-Length: 3072
Subkey-Type: RSA
Subkey-Length: 3072
Name-Real: $GPG_NAME
Name-Email: $GPG_EMAIL
Expire-Date: 0
Passphrase: $USER_PASS
%commit
%echo done
EOF
   if ! gpg --batch --pinentry-mode loopback --passphrase "$USER_PASS" --generate-key "$batch_file" 2>/dev/null; then
    echo "Error: GPG key generation failed."
    rm -f "$batch_file"
    exit 1
   fi
   rm -f "$batch_file"
  fi

  pass init "$GPG_EMAIL" >/dev/null

  # Gather Metadata
  local filepath=$(dirname "$(realpath -m "$CERT_PATH")")
  local filename=$(basename "$CERT_PATH")
  local filesize=$(wc -c <"$CERT_PATH" 2>/dev/null | awk '{print $1}' || echo "Unknown")
  local created_time=$(date +"%Y-%m-%d %H:%M:%S %Z")

  # Format Multi-line Payload (Line 1 is password, rest is metadata)
  local payload
  payload=$(
   cat <<EOF
$USER_PASS
Filepath: $filepath
Filename: $filename
Size: $filesize bytes
Created: $created_time
EOF
  )
  # Store securely
  if ! echo "$payload" | pass insert -f -m "$PASS_ENTRY" >/dev/null; then
   echo "Error: Failed to store password in pass."
   exit 1
  fi

  echo "Setup complete! Your environment is secured."
  echo "--------------------------------------------------"
 fi
}

# ==========================================
# MAIN EXECUTION
# ==========================================
install_dependencies
setup_gpg_agent
setup_pass_if_needed
export GPG_TTY=$(tty)

if [[ "$1" == "--clean" ]]; then
 nuke-all
 echo "Pass has been nuked"
 exit 0
fi

# Ensure our dummy encrypted file exists to test the cache silently
if [ ! -f "$TEST_ENC_FILE" ]; then
 echo "cache check" | gpg --batch --yes --encrypt -r "$GPG_EMAIL" >"$TEST_ENC_FILE" 2>/dev/null
fi

# Silently test if the GPG agent already has our password cached
# (pinentry-mode error forces it to fail instantly instead of prompting if locked)
NEEDS_UNLOCK=false
if ! gpg --batch --pinentry-mode error --decrypt "$TEST_ENC_FILE" &>/dev/null; then
 NEEDS_UNLOCK=true
fi

# Retrieve the full payload from pass (will prompt user seamlessly ONLY if NEEDS_UNLOCK is true)
PASS_OUTPUT=$(pass "$PASS_ENTRY")

if [ -z "$PASS_OUTPUT" ]; then
 echo "Error: Failed to retrieve or unlock password manager vault."
 exit 1
fi

# If we just had to unlock it, record the exact timestamp
if [ "$NEEDS_UNLOCK" = true ]; then
 date +%s >"$UNLOCK_FILE"
fi

# Extract Password (Line 1) and Metadata (Lines 2+)
CERT_PASS=$(echo "$PASS_OUTPUT" | head -n 1)
METADATA=$(echo "$PASS_OUTPUT" | tail -n +2)

# Calculate Time Remaining
LAST_UNLOCK=$(cat "$UNLOCK_FILE" 2>/dev/null || echo 0)
NOW=$(date +%s)
ELAPSED=$((NOW - LAST_UNLOCK))
REMAINING=$((CACHE_TTL - ELAPSED))

if [ "$REMAINING" -lt 0 ]; then
 REMAINING=0 # Failsafe
fi

# Math for displaying friendly time formatting
HRS=$((REMAINING / 3600))
MINS=$(((REMAINING % 3600) / 60))
SECS=$((REMAINING % 60))

# Display the metadata visually
echo "=================================================="
echo " 🔒 Vault Unlocked "
echo "=================================================="
echo "$METADATA"
echo "--------------------------------------------------"
echo " Vault locks again in: ${HRS}h ${MINS}m ${SECS}s"
echo "=================================================="
echo -e "\nExecuting curl request..."

# Execute the curl command
curl --silent --cert-type P12 --cert "${CERT_PATH}:${CERT_PASS}" "$CURL_TARGET"

echo -e "\nWork invoked successfully!"
