#!/usr/bin/env bash
###############################################################################
# install-coder-minikube.sh
#
# Installs Coder (TLS-enabled) into an existing minikube cluster and pushes the
# rootless "minikube" workspace template.
#
# Prereqs on the admin workstation: kubectl, helm (v3), minikube, curl, openssl
#
# Usage:
#   ./install-coder-minikube.sh \
#       --domain     coder.example.internal \
#       --ca-bundle  ./ca-bundle.crt \
#       --tls-crt    ./wildcard.crt \
#       --tls-key    ./wildcard.key \
#       [--namespace coder] \
#       [--service-type NodePort|LoadBalancer] \
#       [--https-node-port 30443] \
#       [--admin-user admin --admin-email admin@example.com --admin-password '...'] \
#       [--coder-chart-version 2.x.y] \
#       [--add-hosts-entry]
#
# Re-running is safe: every step is an upsert.
###############################################################################
set -euo pipefail

# ----------------------------------------------------------------------------
# Defaults (override with flags or environment variables)
# ----------------------------------------------------------------------------
CODER_DOMAIN="${CODER_DOMAIN:-}"
CA_BUNDLE="${CA_BUNDLE:-}"
TLS_CRT="${TLS_CRT:-}"
TLS_KEY="${TLS_KEY:-}"
NAMESPACE="${NAMESPACE:-coder}"          # Coder + workspaces share this ns
SERVICE_TYPE="${SERVICE_TYPE:-NodePort}" # NodePort | LoadBalancer
HTTPS_NODE_PORT="${HTTPS_NODE_PORT:-30443}"
ADMIN_USER="${ADMIN_USER:-admin}"
ADMIN_EMAIL="${ADMIN_EMAIL:-admin@${CODER_DOMAIN:-example.com}}"
ADMIN_PASSWORD="${ADMIN_PASSWORD:-}"
CODER_CHART_VERSION="${CODER_CHART_VERSION:-}" # empty = latest
ADD_HOSTS_ENTRY="${ADD_HOSTS_ENTRY:-false}"
TEMPLATE_NAME="${TEMPLATE_NAME:-minikube-rootless}"
PG_PASSWORD="${PG_PASSWORD:-}"
WORKDIR="${WORKDIR:-$(mktemp -d /tmp/coder-install.XXXXXX)}"

# ----------------------------------------------------------------------------
# Arg parsing
# ----------------------------------------------------------------------------
usage() {
 sed -n '2,25p' "$0"
 exit 1
}

while [[ $# -gt 0 ]]; do
 case "$1" in
  --domain)
   CODER_DOMAIN="$2"
   shift 2
   ;;
  --ca-bundle)
   CA_BUNDLE="$2"
   shift 2
   ;;
  --tls-crt)
   TLS_CRT="$2"
   shift 2
   ;;
  --tls-key)
   TLS_KEY="$2"
   shift 2
   ;;
  --namespace)
   NAMESPACE="$2"
   shift 2
   ;;
  --service-type)
   SERVICE_TYPE="$2"
   shift 2
   ;;
  --https-node-port)
   HTTPS_NODE_PORT="$2"
   shift 2
   ;;
  --admin-user)
   ADMIN_USER="$2"
   shift 2
   ;;
  --admin-email)
   ADMIN_EMAIL="$2"
   shift 2
   ;;
  --admin-password)
   ADMIN_PASSWORD="$2"
   shift 2
   ;;
  --coder-chart-version)
   CODER_CHART_VERSION="$2"
   shift 2
   ;;
  --template-name)
   TEMPLATE_NAME="$2"
   shift 2
   ;;
  --add-hosts-entry)
   ADD_HOSTS_ENTRY=true
   shift
   ;;
  -h | --help) usage ;;
  *)
   echo "Unknown argument: $1" >&2
   usage
   ;;
 esac
done

# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------
log() { printf '\033[1;34m[%s]\033[0m %s\n' "$(date +%H:%M:%S)" "$*"; }
ok() { printf '\033[1;32m  ✔ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m  ! %s\033[0m\n' "$*" >&2; }
die() {
 printf '\033[1;31mERROR: %s\033[0m\n' "$*" >&2
 exit 1
}
need() { command -v "$1" >/dev/null 2>&1 || die "Required tool not found: $1"; }

# ----------------------------------------------------------------------------
# 0. Validate inputs and environment
# ----------------------------------------------------------------------------
log "Validating inputs"
[[ -n "$CODER_DOMAIN" ]] || die "--domain is required (e.g. coder.example.internal)"
[[ -f "$CA_BUNDLE" ]] || die "--ca-bundle file not found: $CA_BUNDLE"
[[ -f "$TLS_CRT" ]] || die "--tls-crt file not found: $TLS_CRT"
[[ -f "$TLS_KEY" ]] || die "--tls-key file not found: $TLS_KEY"
[[ "$SERVICE_TYPE" =~ ^(NodePort|LoadBalancer)$ ]] || die "--service-type must be NodePort or LoadBalancer"
[[ "$ADMIN_EMAIL" == *@* ]] || ADMIN_EMAIL="admin@${CODER_DOMAIN}"

for t in kubectl helm minikube curl openssl; do need "$t"; done
ok "tooling present"

# Cert sanity: key matches cert, cert covers domain and wildcard
CRT_MOD=$(openssl x509 -noout -modulus -in "$TLS_CRT" | openssl md5)
KEY_MOD=$(openssl rsa -noout -modulus -in "$TLS_KEY" 2>/dev/null | openssl md5 || openssl pkey -in "$TLS_KEY" -pubout 2>/dev/null | openssl md5)
if [[ "$CRT_MOD" != "$KEY_MOD" ]]; then
 # EC keys: compare public keys instead
 CRT_PUB=$(openssl x509 -in "$TLS_CRT" -noout -pubkey | openssl md5)
 KEY_PUB=$(openssl pkey -in "$TLS_KEY" -pubout 2>/dev/null | openssl md5)
 [[ "$CRT_PUB" == "$KEY_PUB" ]] || die "TLS certificate and key do not match"
fi
SANS=$(openssl x509 -in "$TLS_CRT" -noout -ext subjectAltName 2>/dev/null || true)
echo "$SANS" | grep -q "DNS:\*\.${CODER_DOMAIN}" || warn "Cert SAN does not list *.${CODER_DOMAIN} — wildcard apps may fail"
echo "$SANS" | grep -Eq "DNS:(\*\.)?${CODER_DOMAIN}\b|DNS:${CODER_DOMAIN}" || warn "Cert SAN does not appear to cover ${CODER_DOMAIN}"
openssl verify -CAfile "$CA_BUNDLE" "$TLS_CRT" >/dev/null 2>&1 && ok "certificate chains to provided CA bundle" ||
 warn "openssl verify failed against CA bundle — continuing, but browsers/agents may not trust Coder"

# minikube must be running and be the active kube context
MINIKUBE_RUNNING=$(minikube status --format='{{.Host}}' 2>/dev/null | grep -q "Running" && status=0 || status=1)

if ! ((MINIKUBE_RUNNING)); then
 minikube start \
  --driver=docker \
  --container-runtime=docker \
  --cpus=4 \
  --memory=9384 \
  --disk-size=40g \
  --kubernetes-version=stable \
  --addons=default-storageclass,storage-provisioner \
  --wait=apiserver,system_pods,default_sa,apps_running \
  --wait-timeout=6m
fi

minikube status --format '{{.Host}}' 2>/dev/null | grep -q Running || die "minikube is not running"
kubectl config use-context minikube >/dev/null
kubectl cluster-info >/dev/null 2>&1 || die "kubectl cannot reach minikube"
MINIKUBE_IP=$(minikube ip)
ok "minikube reachable at ${MINIKUBE_IP}"

# Generate secrets that weren't supplied
[[ -n "$PG_PASSWORD" ]] || PG_PASSWORD=$(openssl rand -hex 16)
[[ -n "$ADMIN_PASSWORD" ]] || ADMIN_PASSWORD="$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-20)!A1"

# Build a combined CA bundle (public roots + private CA) for workspace agents.
# SSL_CERT_FILE *replaces* system roots for Go and curl, so we must include
# the public roots or tool downloads (GitHub, dl.k8s.io) will fail in workspaces.
log "Building combined CA bundle"
COMBINED_CA="${WORKDIR}/combined-ca.crt"
SYSTEM_ROOTS=""
for c in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/cert.pem /usr/local/etc/openssl/cert.pem; do
 [[ -f "$c" ]] && {
  SYSTEM_ROOTS="$c"
  break
 }
done
if [[ -z "$SYSTEM_ROOTS" ]]; then
 warn "No system root bundle found; downloading Mozilla roots from curl.se"
 curl -fsSL https://curl.se/ca/cacert.pem -o "${WORKDIR}/mozilla-roots.pem"
 SYSTEM_ROOTS="${WORKDIR}/mozilla-roots.pem"
fi
cat "$SYSTEM_ROOTS" "$CA_BUNDLE" >"$COMBINED_CA"
ok "combined bundle: $(grep -c 'BEGIN CERTIFICATE' "$COMBINED_CA") certificates"

# ----------------------------------------------------------------------------
# 1. Namespace, TLS secret, CA secret/configmap
# ----------------------------------------------------------------------------
log "Creating namespace and secrets in '${NAMESPACE}'"
kubectl create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl apply -f - >/dev/null

kubectl -n "$NAMESPACE" create secret tls coder-tls \
 --cert="$TLS_CRT" --key="$TLS_KEY" \
 --dry-run=client -o yaml | kubectl apply -f - >/dev/null
ok "secret/coder-tls"

# Used by the Coder server pod (helm coder.certs) to trust its own access URL
kubectl -n "$NAMESPACE" create secret generic coder-ca \
 --from-file=ca.crt="$CA_BUNDLE" \
 --dry-run=client -o yaml | kubectl apply -f - >/dev/null
ok "secret/coder-ca"

# Used by workspace pods (mounted by the template)
kubectl -n "$NAMESPACE" create configmap coder-ca-bundle \
 --from-file=ca-bundle.crt="$COMBINED_CA" \
 --dry-run=client -o yaml | kubectl apply -f - >/dev/null
ok "configmap/coder-ca-bundle"

# ----------------------------------------------------------------------------
# 2. PostgreSQL (single-node StatefulSet with PVC — fine for minikube/dev)
# ----------------------------------------------------------------------------
log "Deploying PostgreSQL"
kubectl -n "$NAMESPACE" create secret generic coder-db \
 --from-literal=POSTGRES_USER=coder \
 --from-literal=POSTGRES_PASSWORD="$PG_PASSWORD" \
 --from-literal=POSTGRES_DB=coder \
 --from-literal=url="postgres://coder:${PG_PASSWORD}@coder-postgres.${NAMESPACE}.svc.cluster.local:5432/coder?sslmode=disable" \
 --dry-run=client -o yaml | kubectl apply -f - >/dev/null

kubectl apply -n "$NAMESPACE" -f - >/dev/null <<'EOF'
apiVersion: v1
kind: Service
metadata:
  name: coder-postgres
  labels: { app: coder-postgres }
spec:
  selector: { app: coder-postgres }
  ports:
    - name: postgres
      port: 5432
      targetPort: 5432
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: coder-postgres
spec:
  serviceName: coder-postgres
  replicas: 1
  selector:
    matchLabels: { app: coder-postgres }
  template:
    metadata:
      labels: { app: coder-postgres }
    spec:
      securityContext:
        fsGroup: 999
      containers:
        - name: postgres
          image: postgres:16-alpine
          ports: [{ containerPort: 5432 }]
          envFrom:
            - secretRef: { name: coder-db }
          env:
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          resources:
            requests: { cpu: 250m, memory: 256Mi }
            limits:   { cpu: "1",  memory: 1Gi }
          readinessProbe:
            exec: { command: ["sh","-c","pg_isready -U coder -d coder"] }
            initialDelaySeconds: 5
            periodSeconds: 5
          livenessProbe:
            exec: { command: ["sh","-c","pg_isready -U coder -d coder"] }
            initialDelaySeconds: 20
            periodSeconds: 20
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
  volumeClaimTemplates:
    - metadata: { name: data }
      spec:
        accessModes: ["ReadWriteOnce"]
        resources: { requests: { storage: 10Gi } }
EOF
kubectl -n "$NAMESPACE" rollout status statefulset/coder-postgres --timeout=180s >/dev/null
ok "postgres ready"

# ----------------------------------------------------------------------------
# 3. Coder via Helm
# ----------------------------------------------------------------------------
log "Installing Coder via Helm"
helm repo add coder-v2 https://helm.coder.com/v2 >/dev/null 2>&1 || true
helm repo update coder-v2 >/dev/null

if [[ "$SERVICE_TYPE" == "NodePort" ]]; then
 ACCESS_URL="https://${CODER_DOMAIN}:${HTTPS_NODE_PORT}"
 WILDCARD_URL="*.${CODER_DOMAIN}:${HTTPS_NODE_PORT}"
else
 ACCESS_URL="https://${CODER_DOMAIN}"
 WILDCARD_URL="*.${CODER_DOMAIN}"
fi

cat >"${WORKDIR}/coder-values.yaml" <<EOF
coder:
  replicaCount: 1
  env:
    - name: CODER_PG_CONNECTION_URL
      valueFrom:
        secretKeyRef:
          name: coder-db
          key: url
    - name: CODER_ACCESS_URL
      value: "${ACCESS_URL}"
    - name: CODER_WILDCARD_ACCESS_URL
      value: "${WILDCARD_URL}"
    - name: CODER_REDIRECT_TO_ACCESS_URL
      value: "true"
    - name: CODER_TELEMETRY_ENABLE
      value: "false"
  tls:
    secretNames:
      - coder-tls
  certs:
    secrets:
      - name: coder-ca
        key: ca.crt
  service:
    type: ${SERVICE_TYPE}
    httpsNodePort: ${HTTPS_NODE_PORT}
    httpNodePort: 30080
  resources:
    requests: { cpu: 500m, memory: 512Mi }
    limits:   { cpu: "2",  memory: 2Gi }
EOF

HELM_VER_ARGS=()
[[ -n "$CODER_CHART_VERSION" ]] && HELM_VER_ARGS=(--version "$CODER_CHART_VERSION")

helm upgrade --install coder coder-v2/coder \
 --namespace "$NAMESPACE" \
 -f "${WORKDIR}/coder-values.yaml" \
 "${HELM_VER_ARGS[@]}" \
 --wait --timeout 5m >/dev/null
ok "helm release 'coder' deployed (${ACCESS_URL})"

# ----------------------------------------------------------------------------
# 4. Reachability from this workstation (needed for `coder login`)
# ----------------------------------------------------------------------------
log "Verifying ${CODER_DOMAIN} reaches this Coder install"

RESOLVED_IP=$(getent ahostsv4 "$CODER_DOMAIN" 2>/dev/null | awk 'NR==1{print $1}' || true)
PF_PID=""

probe() { # probe <ip>  -> 0 if buildinfo answers at that IP with the right hostname
 curl -fsS --max-time 5 --cacert "$CA_BUNDLE" \
  --resolve "${CODER_DOMAIN}:${HTTPS_NODE_PORT}:$1" \
  "https://${CODER_DOMAIN}:${HTTPS_NODE_PORT}/api/v2/buildinfo" >/dev/null 2>&1
}

# Wait for Coder to answer at the minikube IP (bypasses DNS entirely)
REACHABLE_VIA=""
for i in $(seq 1 40); do
 if probe "$MINIKUBE_IP"; then
  REACHABLE_VIA="$MINIKUBE_IP"
  break
 fi
 sleep 3
done

if [[ -z "$REACHABLE_VIA" ]]; then
 warn "NodePort not reachable at ${MINIKUBE_IP}:${HTTPS_NODE_PORT} — minikube's network is not routable from this host"
 warn "Falling back to kubectl port-forward on 127.0.0.1:${HTTPS_NODE_PORT}"
 kubectl -n "$NAMESPACE" port-forward --address 127.0.0.1 svc/coder "${HTTPS_NODE_PORT}:443" >"${WORKDIR}/port-forward.log" 2>&1 &
 PF_PID=$!
 trap '[[ -n "$PF_PID" ]] && kill "$PF_PID" 2>/dev/null || true' EXIT
 for i in $(seq 1 20); do
  if probe 127.0.0.1; then
   REACHABLE_VIA="127.0.0.1"
   break
  fi
  sleep 2
 done
 [[ -n "$REACHABLE_VIA" ]] || die "Coder is running but unreachable even via port-forward. Check: kubectl -n ${NAMESPACE} logs deploy/coder"
fi
ok "Coder answers at ${REACHABLE_VIA}:${HTTPS_NODE_PORT}"

# Now make sure the *name* lands on that IP, since the CLI and browsers use the name
if [[ "$RESOLVED_IP" != "$REACHABLE_VIA" ]]; then
 warn "${CODER_DOMAIN} resolves to '${RESOLVED_IP:-nothing}' but Coder is at ${REACHABLE_VIA}"
 if [[ "$ADD_HOSTS_ENTRY" == "true" ]]; then
  sudo sed -i "/[[:space:]]${CODER_DOMAIN}\$/d" /etc/hosts
  echo "${REACHABLE_VIA} ${CODER_DOMAIN}" | sudo tee -a /etc/hosts >/dev/null
  ok "/etc/hosts now maps ${CODER_DOMAIN} -> ${REACHABLE_VIA}"
 else
  die "Fix DNS so ${CODER_DOMAIN} (and *.${CODER_DOMAIN}) -> ${REACHABLE_VIA}, or re-run with --add-hosts-entry"
 fi
fi
ok "${CODER_DOMAIN} -> ${REACHABLE_VIA}"

# ----------------------------------------------------------------------------
# 5. Coder CLI + first-user bootstrap
# ----------------------------------------------------------------------------
log "Ensuring Coder CLI is installed"
if ! command -v coder >/dev/null 2>&1; then
 curl -fsSL https://coder.com/install.sh | sh
fi
ok "coder CLI: $(coder version 2>/dev/null | head -n1)"

# Trust the private CA for CLI calls in this script only
export SSL_CERT_FILE="$COMBINED_CA"
export CODER_URL="$ACCESS_URL"
export CODER_CONFIG_DIR="${WORKDIR}/coder-cli"

log "Waiting for Coder API"
for i in $(seq 1 60); do
 if curl -fsS --cacert "$CA_BUNDLE" "${ACCESS_URL}/api/v2/buildinfo" >/dev/null 2>&1; then break; fi
 sleep 3
 [[ $i -eq 60 ]] && die "Coder API did not become reachable at ${ACCESS_URL}"
done
ok "Coder API reachable"

if curl -fsS --cacert "$CA_BUNDLE" "${ACCESS_URL}/api/v2/users/first" 2>/dev/null | grep -q '"message"'; then
 # /users/first returns 404-ish message when first user exists already
 log "First user already exists; logging in"
 [[ -n "${CODER_SESSION_TOKEN:-}" ]] || {
  echo "Enter the password for existing admin user '${ADMIN_USER}':"
  coder login "$ACCESS_URL" --use-token-as-session 2>/dev/null || coder login "$ACCESS_URL"
 }
else
 log "Creating first (admin) user '${ADMIN_USER}'"
 coder login "$ACCESS_URL" \
  --first-user-username "$ADMIN_USER" \
  --first-user-email "$ADMIN_EMAIL" \
  --first-user-password "$ADMIN_PASSWORD" \
  --first-user-trial=false >/dev/null
 ok "admin user created"
fi

# ----------------------------------------------------------------------------
# 6. Write and push the rootless minikube workspace template
# ----------------------------------------------------------------------------
log "Writing template '${TEMPLATE_NAME}'"
TEMPLATE_DIR="${WORKDIR}/template-${TEMPLATE_NAME}"
mkdir -p "$TEMPLATE_DIR"

cat >"${TEMPLATE_DIR}/main.tf" <<'TFEOF'
###############################################################################
# Coder Workspace Template — Rootless Kubernetes workspace with minikube
#
# - Workspace container runs as UID 1000, no capabilities, no privilege
#   escalation (no_new_privs) => sudo/su are impossible, by kernel guarantee.
# - kubectl, k9s, and minikube are installed into ~/.local/bin (user-owned).
# - A Docker-in-Docker sidecar provides the daemon minikube's docker driver
#   needs. The user has no shell access to the sidecar.
# - One app button, "minikube", opens a terminal with the kube context
#   already pointed at the minikube cluster and k9s on PATH.
###############################################################################

terraform {
  required_providers {
    coder = {
      source  = "coder/coder"
      version = "~> 2.0"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.30"
    }
  }
}

variable "namespace" {
  type        = string
  description = "Kubernetes namespace to provision workspaces into."
}

variable "use_kubeconfig" {
  type        = bool
  default     = false
  description = "Use host kubeconfig (true) or in-cluster service account (false)."
}

variable "workspace_image" {
  type        = string
  default     = "codercom/enterprise-base:ubuntu"
  description = "Workspace image. Must have curl/bash for the Coder agent. Must NOT require root."
}

variable "dind_image" {
  type        = string
  default     = "docker:27-dind"
  description = "Docker-in-Docker sidecar image used as minikube's container runtime."
}

variable "ca_bundle_configmap" {
  type        = string
  default     = ""
  description = "Optional ConfigMap (key: ca-bundle.crt) containing a full CA bundle incl. the private CA for the Coder access URL. Empty disables."
}

variable "kubectl_version" {
  type    = string
  default = "v1.31.1"
}

variable "k9s_version" {
  type    = string
  default = "v0.32.5"
}

variable "minikube_version" {
  type    = string
  default = "v1.34.0"
}

provider "kubernetes" {
  config_path = var.use_kubeconfig ? "~/.kube/config" : null
}

provider "coder" {}

data "coder_workspace" "me" {}
data "coder_workspace_owner" "me" {}

data "coder_parameter" "cpu" {
  name         = "cpu"
  display_name = "CPU"
  description  = "CPU cores for the workspace container."
  type         = "number"
  default      = "4"
  mutable      = true
  validation {
    min = 2
    max = 16
  }
}

data "coder_parameter" "memory" {
  name         = "memory"
  display_name = "Memory (GiB)"
  description  = "Memory for the workspace container."
  type         = "number"
  default      = "8"
  mutable      = true
  validation {
    min = 4
    max = 64
  }
}

data "coder_parameter" "home_disk_size" {
  name         = "home_disk_size"
  display_name = "Home disk size (GiB)"
  description  = "Persistent /home/coder volume."
  type         = "number"
  default      = "20"
  mutable      = false
  validation {
    min = 10
    max = 200
  }
}

data "coder_parameter" "minikube_cpus" {
  name         = "minikube_cpus"
  display_name = "minikube CPUs"
  type         = "number"
  default      = "2"
  mutable      = true
  validation {
    min = 2
    max = 8
  }
}

data "coder_parameter" "minikube_memory" {
  name         = "minikube_memory"
  display_name = "minikube memory (MiB)"
  type         = "number"
  default      = "4096"
  mutable      = true
  validation {
    min = 2048
    max = 32768
  }
}

locals {
  ca_enabled = var.ca_bundle_configmap != ""
  ca_path    = "/etc/coder-ca/ca-bundle.crt"
}

resource "coder_agent" "main" {
  os   = "linux"
  arch = "amd64"
  dir  = "/home/coder"

  env = merge(
    {
      DOCKER_HOST       = "tcp://127.0.0.1:2375"
      KUBECONFIG        = "/home/coder/.kube/config"
      MINIKUBE_HOME     = "/home/coder/.minikube"
      MINIKUBE_IN_STYLE = "false"
      PATH              = "/home/coder/.local/bin:/usr/local/bin:/usr/bin:/bin"
    },
    local.ca_enabled ? { SSL_CERT_FILE = local.ca_path, CURL_CA_BUNDLE = local.ca_path } : {}
  )

  startup_script_behavior = "blocking"

  startup_script = <<-EOT
    #!/usr/bin/env bash
    set -euo pipefail

    KUBECTL_VERSION="${var.kubectl_version}"
    K9S_VERSION="${var.k9s_version}"
    MINIKUBE_VERSION="${var.minikube_version}"

    BIN="$HOME/.local/bin"
    mkdir -p "$BIN" "$HOME/.kube" "$HOME/.minikube"
    export PATH="$BIN:$PATH"

    if [ ! -x "$BIN/kubectl" ] || [ "$(cat "$BIN/.kubectl_version" 2>/dev/null)" != "$KUBECTL_VERSION" ]; then
      echo "Installing kubectl $KUBECTL_VERSION..."
      curl -fsSL "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/amd64/kubectl" -o "$BIN/kubectl"
      chmod 0755 "$BIN/kubectl"
      echo "$KUBECTL_VERSION" > "$BIN/.kubectl_version"
    fi

    if [ ! -x "$BIN/k9s" ] || [ "$(cat "$BIN/.k9s_version" 2>/dev/null)" != "$K9S_VERSION" ]; then
      echo "Installing k9s $K9S_VERSION..."
      curl -fsSL "https://github.com/derailed/k9s/releases/download/$K9S_VERSION/k9s_Linux_amd64.tar.gz" \
        | tar -xz -C "$BIN" k9s
      chmod 0755 "$BIN/k9s"
      echo "$K9S_VERSION" > "$BIN/.k9s_version"
    fi

    if [ ! -x "$BIN/minikube" ] || [ "$(cat "$BIN/.minikube_version" 2>/dev/null)" != "$MINIKUBE_VERSION" ]; then
      echo "Installing minikube $MINIKUBE_VERSION..."
      curl -fsSL "https://github.com/kubernetes/minikube/releases/download/$MINIKUBE_VERSION/minikube-linux-amd64" \
        -o "$BIN/minikube"
      chmod 0755 "$BIN/minikube"
      echo "$MINIKUBE_VERSION" > "$BIN/.minikube_version"
    fi

    if ! grep -q "# coder-minikube-env" "$HOME/.bashrc" 2>/dev/null; then
      cat >> "$HOME/.bashrc" <<'RC'
    # coder-minikube-env
    export PATH="$HOME/.local/bin:$PATH"
    export DOCKER_HOST="tcp://127.0.0.1:2375"
    export KUBECONFIG="$HOME/.kube/config"
    export MINIKUBE_HOME="$HOME/.minikube"
    export MINIKUBE_IN_STYLE=false
    source <(kubectl completion bash 2>/dev/null) || true
    alias k=kubectl
    complete -o default -F __start_kubectl k 2>/dev/null || true
    RC
    fi

    cat > "$BIN/minikube-shell" <<'SH'
    #!/usr/bin/env bash
    export PATH="$HOME/.local/bin:$PATH"
    export DOCKER_HOST="tcp://127.0.0.1:2375"
    export KUBECONFIG="$HOME/.kube/config"
    export MINIKUBE_HOME="$HOME/.minikube"
    export MINIKUBE_IN_STYLE=false

    if ! minikube status --profile minikube >/dev/null 2>&1; then
      echo "minikube is not running — starting it (this can take a minute)..."
      minikube start --profile minikube --driver=docker --force 2>&1 | tail -n 5
    fi
    kubectl config use-context minikube >/dev/null 2>&1 || true

    echo "=================================================================="
    echo "  minikube terminal"
    echo "  context : $(kubectl config current-context 2>/dev/null || echo 'n/a')"
    echo "  kubectl : $(kubectl version --client -o json 2>/dev/null | sed -n 's/.*"gitVersion": *"\([^"]*\)".*/\1/p' | head -n1)"
    echo "  k9s     : $(k9s version -s 2>/dev/null | awk '/Version/{print $2}')"
    echo "  tip     : run 'k9s' for the TUI, 'kubectl get nodes' to verify"
    echo "=================================================================="
    exec bash -l
    SH
    chmod 0755 "$BIN/minikube-shell"

    echo "Waiting for Docker daemon sidecar..."
    for i in $(seq 1 60); do
      if curl -fsS "http://127.0.0.1:2375/_ping" >/dev/null 2>&1; then
        echo "Docker daemon ready."
        break
      fi
      sleep 2
      if [ "$i" -eq 60 ]; then
        echo "ERROR: Docker daemon did not become ready." >&2
        exit 1
      fi
    done

    echo "Starting minikube..."
    minikube start \
      --profile minikube \
      --driver=docker \
      --cpus=${data.coder_parameter.minikube_cpus.value} \
      --memory=${data.coder_parameter.minikube_memory.value} \
      --kubernetes-version="$KUBECTL_VERSION" \
      --force

    kubectl config use-context minikube
    kubectl wait --for=condition=Ready nodes --all --timeout=180s
    echo "minikube is ready. Context set to 'minikube'."
  EOT

  metadata {
    display_name = "CPU"
    key          = "cpu"
    script       = "coder stat cpu"
    interval     = 10
    timeout      = 1
  }

  metadata {
    display_name = "Memory"
    key          = "mem"
    script       = "coder stat mem"
    interval     = 10
    timeout      = 1
  }

  metadata {
    display_name = "Home disk"
    key          = "home_disk"
    script       = "coder stat disk --path /home/coder"
    interval     = 60
    timeout      = 1
  }

  metadata {
    display_name = "minikube"
    key          = "minikube"
    script       = "DOCKER_HOST=tcp://127.0.0.1:2375 MINIKUBE_HOME=$HOME/.minikube $HOME/.local/bin/minikube status -f '{{.Host}}/{{.APIServer}}' 2>/dev/null || echo 'stopped'"
    interval     = 30
    timeout      = 10
  }
}

resource "coder_app" "minikube" {
  agent_id     = coder_agent.main.id
  slug         = "minikube"
  display_name = "minikube"
  icon         = "/icon/k8s.png"
  command      = "/home/coder/.local/bin/minikube-shell"
  share        = "owner"
  order        = 1
}

resource "kubernetes_persistent_volume_claim" "home" {
  metadata {
    name      = "coder-${data.coder_workspace.me.id}-home"
    namespace = var.namespace
    labels = {
      "app.kubernetes.io/name"     = "coder-pvc"
      "app.kubernetes.io/instance" = "coder-pvc-${data.coder_workspace.me.id}"
      "app.kubernetes.io/part-of"  = "coder"
      "com.coder.resource"         = "true"
      "com.coder.workspace.id"     = data.coder_workspace.me.id
      "com.coder.workspace.name"   = data.coder_workspace.me.name
      "com.coder.user.id"          = data.coder_workspace_owner.me.id
      "com.coder.user.username"    = data.coder_workspace_owner.me.name
    }
  }
  wait_until_bound = false
  spec {
    access_modes = ["ReadWriteOnce"]
    resources {
      requests = {
        storage = "${data.coder_parameter.home_disk_size.value}Gi"
      }
    }
  }
}

resource "kubernetes_deployment" "main" {
  count      = data.coder_workspace.me.start_count
  depends_on = [kubernetes_persistent_volume_claim.home]

  wait_for_rollout = false

  metadata {
    name      = "coder-${data.coder_workspace_owner.me.name}-${data.coder_workspace.me.name}"
    namespace = var.namespace
    labels = {
      "app.kubernetes.io/name"     = "coder-workspace"
      "app.kubernetes.io/instance" = "coder-workspace-${data.coder_workspace.me.id}"
      "app.kubernetes.io/part-of"  = "coder"
      "com.coder.resource"         = "true"
      "com.coder.workspace.id"     = data.coder_workspace.me.id
      "com.coder.workspace.name"   = data.coder_workspace.me.name
      "com.coder.user.id"          = data.coder_workspace_owner.me.id
      "com.coder.user.username"    = data.coder_workspace_owner.me.name
    }
  }

  spec {
    replicas = 1
    strategy {
      type = "Recreate"
    }
    selector {
      match_labels = {
        "app.kubernetes.io/instance" = "coder-workspace-${data.coder_workspace.me.id}"
      }
    }

    template {
      metadata {
        labels = {
          "app.kubernetes.io/name"     = "coder-workspace"
          "app.kubernetes.io/instance" = "coder-workspace-${data.coder_workspace.me.id}"
          "app.kubernetes.io/part-of"  = "coder"
          "com.coder.resource"         = "true"
          "com.coder.workspace.id"     = data.coder_workspace.me.id
          "com.coder.workspace.name"   = data.coder_workspace.me.name
          "com.coder.user.id"          = data.coder_workspace_owner.me.id
          "com.coder.user.username"    = data.coder_workspace_owner.me.name
        }
      }

      spec {
        security_context {
          run_as_user     = 1000
          run_as_group    = 1000
          fs_group        = 1000
          run_as_non_root = true
          seccomp_profile {
            type = "RuntimeDefault"
          }
        }

        automount_service_account_token = false
        enable_service_links            = false

        # USER WORKSPACE CONTAINER — rootless, no caps, no escalation.
        container {
          name              = "dev"
          image             = var.workspace_image
          image_pull_policy = "Always"
          command           = ["sh", "-c", coder_agent.main.init_script]

          security_context {
            run_as_user                = 1000
            run_as_group               = 1000
            run_as_non_root            = true
            privileged                 = false
            allow_privilege_escalation = false
            capabilities {
              drop = ["ALL"]
            }
          }

          env {
            name  = "CODER_AGENT_TOKEN"
            value = coder_agent.main.token
          }
          env {
            name  = "DOCKER_HOST"
            value = "tcp://127.0.0.1:2375"
          }
          env {
            name  = "KUBECONFIG"
            value = "/home/coder/.kube/config"
          }
          env {
            name  = "MINIKUBE_HOME"
            value = "/home/coder/.minikube"
          }

          dynamic "env" {
            for_each = local.ca_enabled ? ["SSL_CERT_FILE", "CURL_CA_BUNDLE"] : []
            content {
              name  = env.value
              value = local.ca_path
            }
          }

          resources {
            requests = {
              "cpu"    = "${data.coder_parameter.cpu.value}"
              "memory" = "${data.coder_parameter.memory.value}Gi"
            }
            limits = {
              "cpu"    = "${data.coder_parameter.cpu.value}"
              "memory" = "${data.coder_parameter.memory.value}Gi"
            }
          }

          volume_mount {
            mount_path = "/home/coder"
            name       = "home"
            read_only  = false
          }
          volume_mount {
            mount_path = "/tmp"
            name       = "tmp"
          }

          dynamic "volume_mount" {
            for_each = local.ca_enabled ? [1] : []
            content {
              name       = "coder-ca"
              mount_path = local.ca_path
              sub_path   = "ca-bundle.crt"
              read_only  = true
            }
          }
        }

        # DOCKER-IN-DOCKER SIDECAR — minikube's container runtime.
        container {
          name              = "dind"
          image             = var.dind_image
          image_pull_policy = "IfNotPresent"

          args = [
            "dockerd",
            "--host=tcp://127.0.0.1:2375",
            "--tls=false",
            "--storage-driver=overlay2",
          ]

          env {
            name  = "DOCKER_TLS_CERTDIR"
            value = ""
          }

          security_context {
            run_as_user  = 0
            run_as_group = 0
            privileged   = true
          }

          resources {
            requests = {
              "cpu"    = "${data.coder_parameter.minikube_cpus.value}"
              "memory" = "${data.coder_parameter.minikube_memory.value}Mi"
            }
            limits = {
              "cpu"    = "${data.coder_parameter.minikube_cpus.value + 1}"
              "memory" = "${data.coder_parameter.minikube_memory.value + 1024}Mi"
            }
          }

          liveness_probe {
            exec {
              command = ["docker", "-H", "tcp://127.0.0.1:2375", "info"]
            }
            initial_delay_seconds = 20
            period_seconds        = 30
            timeout_seconds       = 10
            failure_threshold     = 3
          }

          volume_mount {
            mount_path = "/var/lib/docker"
            name       = "docker-graph"
          }
        }

        volume {
          name = "home"
          persistent_volume_claim {
            claim_name = kubernetes_persistent_volume_claim.home.metadata[0].name
            read_only  = false
          }
        }

        volume {
          name = "tmp"
          empty_dir {
            size_limit = "2Gi"
          }
        }

        volume {
          name = "docker-graph"
          empty_dir {
            size_limit = "40Gi"
          }
        }

        dynamic "volume" {
          for_each = local.ca_enabled ? [1] : []
          content {
            name = "coder-ca"
            config_map {
              name     = var.ca_bundle_configmap
              optional = false
            }
          }
        }

        affinity {
          pod_anti_affinity {
            preferred_during_scheduling_ignored_during_execution {
              weight = 1
              pod_affinity_term {
                topology_key = "kubernetes.io/hostname"
                label_selector {
                  match_expressions {
                    key      = "app.kubernetes.io/name"
                    operator = "In"
                    values   = ["coder-workspace"]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

resource "coder_metadata" "workspace_info" {
  count       = data.coder_workspace.me.start_count
  resource_id = kubernetes_deployment.main[0].id

  item {
    key   = "namespace"
    value = var.namespace
  }
  item {
    key   = "run_as_user"
    value = "1000 (no sudo, no capabilities, no_new_privs)"
  }
  item {
    key   = "kubectl"
    value = var.kubectl_version
  }
  item {
    key   = "k9s"
    value = var.k9s_version
  }
  item {
    key   = "minikube"
    value = "${var.minikube_version} (docker driver via dind sidecar)"
  }
}
TFEOF

cat >"${TEMPLATE_DIR}/README.md" <<EOF
# ${TEMPLATE_NAME}

Rootless Kubernetes workspace (UID 1000, no sudo, no capabilities, no privilege
escalation) with an in-pod minikube cluster backed by a Docker-in-Docker sidecar.

Click the **minikube** button to open a terminal with \`kubectl\` and \`k9s\`
already pointed at the cluster.
EOF

log "Pushing template to Coder"
coder templates push "$TEMPLATE_NAME" \
 --directory "$TEMPLATE_DIR" \
 --variable "namespace=${NAMESPACE}" \
 --variable "ca_bundle_configmap=coder-ca-bundle" \
 --message "Installed by install-coder-minikube.sh on $(date -u +%Y-%m-%dT%H:%M:%SZ)" \
 --yes
ok "template '${TEMPLATE_NAME}' pushed"

# ----------------------------------------------------------------------------
# 7. Smoke test: create, verify no-sudo, and delete a workspace (optional)
# ----------------------------------------------------------------------------
if [[ "${SMOKE_TEST:-true}" == "true" ]]; then
 log "Running smoke test workspace (set SMOKE_TEST=false to skip)"
 WS="smoke-$(date +%s)"
 coder create "$WS" --template "$TEMPLATE_NAME" --yes >/dev/null
 for i in $(seq 1 60); do
  STATUS=$(coder list --output json 2>/dev/null | grep -A5 "\"name\": \"$WS\"" | grep -o '"status": "[^"]*"' | head -n1 | cut -d'"' -f4 || true)
  [[ "$STATUS" == "running" ]] && break
  sleep 5
 done
 # Prove sudo is impossible inside the workspace
 if coder ssh "$WS" -- 'sudo -n true' >/dev/null 2>&1; then
  die "SMOKE TEST FAILED: sudo succeeded inside the workspace"
 else
  ok "sudo is blocked inside workspace (expected)"
 fi
 coder ssh "$WS" -- 'kubectl config current-context' | grep -q minikube && ok "kubectl context = minikube" || warn "kubectl context not yet minikube (startup may still be running)"
 coder delete "$WS" --yes >/dev/null
 ok "smoke test workspace removed"
fi

