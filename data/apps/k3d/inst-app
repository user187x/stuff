#!/usr/bin/env bash

# Exit immediately if any command fails
set -e

DOMAIN_SUFFIX="xxx.local"
GATEWAY_NAME="traefik-gateway"

TRAEFIK_NS="traefik"
PODINFO_NS="podinfo"

TLS_WILDCARD_SECRET="wildcard-tls-cert"

TLS_CRT="pki/tls.crt"
TLS_KEY="pki/tls.key"
TLS_CA="pki/ca.crt"

CRD_FILE="lib/manifest.yaml"

echo "=========================================================="
echo "🚀 Bootstrapping Gateway API (v1.6.0) with Traefik"
echo "=========================================================="

# Ensure the required TLS assets are present before we start modifying the cluster.
echo "Validating local TLS certificates..."

for file in "${TLS_CRT}" "${TLS_KEY}" "${TLS_CA}"; do
 if [[ ! -f "$file" ]]; then
  echo "❌ Error: Required file '$file' not found in current directory."
  echo "Please generate or place the wildcard certs here and try again."
  exit 1
 fi
done
echo "✅ Certificates found."
echo ""

# Install Gateway API CRDs
API_VERSION="1.6.0"
DOWNLOAD_URL="https://github.com/kubernetes-sigs/gateway-api/releases/download/v${API_VERSION}/standard-install.yaml"

echo "Installing Kubernetes Gateway API CRDs (v1.6.0)..."

if [[ -z "${CRD_FILE}" ]]; then
 kubectl apply -f "${DOWNLOAD_URL}"
else
 kubectl apply -f "${CRD_FILE}"
fi

echo
echo "✅ Gateway API CRDs installed."
echo ""

# The TLS secret must live in the exact same namespace as the Gateway resource
echo "Setting up namespaces and TLS Secret..."

kubectl create namespace "${TRAEFIK_NS}" --dry-run=client -o yaml | kubectl apply -f -
kubectl create namespace "${PODINFO_NS}" --dry-run=client -o yaml | kubectl apply -f -

kubectl create secret tls "${TLS_WILDCARD_SECRET}" \
 --namespace "${TRAEFIK_NS}" \
 --cert="${TLS_CRT}" \
 --key="${TLS_KEY}" \
 --dry-run=client -o yaml | kubectl apply -f -

echo
echo "✅ Secrets and Namespaces provisioned."
echo

# Install Traefik & expose the 'traefik' svc port (9000)
echo "Installing Traefik Ingress Controller..."

helm repo add traefik https://helm.traefik.io/traefik >/dev/null 2>&1
helm repo update >/dev/null 2>&1

cat <<EOF >traefik-values.yaml
providers:
  kubernetesGateway:
    enabled: true
ports:
  web:
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    port: 443
  traefik:
    port: 9000
    expose: 
      default: true
additionalArguments:
  - "--api.dashboard=true"
  - "--api.insecure=true"
EOF

helm upgrade --install traefik traefik/traefik \
 --namespace "${TRAEFIK_NS}" \
 --values traefik-values.yaml \
 --wait

echo
echo "✅ Traefik installed and configured."
echo

# Create the Gateway
# The Gateway represents the physical/logical load balancer. We bind it to
# the 'traefik' GatewayClass and configure it to listen on 443, terminating
# TLS using our secret. Crucially, we allow routes from 'All' namespaces so
# developers can define HTTPRoutes in their own application namespaces.

GATEWAY_CLASS_NAME="traefik"
GATEWAY_CONTROLLER_NAME="traefik.io/gateway-controller"

echo "Provisioning the Gateway resource..."

# Add the GatewayClass
cat <<EOF | kubectl apply -f -
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: ${GATEWAY_CLASS_NAME}
spec:
  controllerName: ${GATEWAY_CONTROLLER_NAME}
EOF

echo
echo "✅ GatewayClass created."
echo

# Add the Gateway
cat <<EOF | kubectl apply -f -
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: "${GATEWAY_NAME}"
  namespace: ${TRAEFIK_NS}
spec:
  gatewayClassName: ${GATEWAY_CLASS_NAME}
  listeners:
  - name: https
    port: 443
    protocol: HTTPS
    allowedRoutes:
      namespaces:
        from: All
    tls:
      mode: Terminate
      certificateRefs:
      - name: ${TLS_WILDCARD_SECRET}
        kind: Secret
EOF

echo
echo "✅ Gateway resource provisioned."
echo

echo "Deploying Podinfo application..."

helm repo add podinfo https://stefanprodan.github.io/podinfo >/dev/null 2>&1 || true
helm repo update >/dev/null 2>&1

helm upgrade --install podinfo podinfo/podinfo \
 --namespace "${PODINFO_NS}" \
 --set ui.color="#81a1c1" \
 --wait

echo
echo "✅ Podinfo deployed."
echo

# Wire up the HTTPRoutes
# HTTPRoutes attach to a 'parentRef' (our Gateway). Traffic coming into the
# Gateway on port 443 is evaluated against the 'hostnames' in these routes,
# and then forwarded to the respective backend services.
# -----------------------------------------------------------------------------
echo "Configuring HTTPRoutes for Dashboard and App..."

echo
echo "Createing HTTPRoute for Traefik Dashboard...."
echo

TRAEFIK_HTTPROUTE_NAME="traefik-route"
TRAEFIK_DASHBOARD_POD_PORT="9000"
TRAEFIK_DASHBOARD_POD_NAME="traefik"

cat <<EOF | kubectl apply -f -
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${TRAEFIK_HTTPROUTE_NAME}
  namespace: ${TRAEFIK_NS}
spec:
  parentRefs:
  - name: ${GATEWAY_NAME}
    namespace: ${TRAEFIK_NS}
  hostnames:
  - traefik.${DOMAIN_SUFFIX}
  rules:
  - backendRefs:
    - name: ${TRAEFIK_DASHBOARD_POD_NAME}
      port: ${TRAEFIK_DASHBOARD_POD_PORT}
EOF

echo
echo "Createing HTTPRoute for PodInfo Dashboard...."
echo

PODINFO_HTTPROUTE_NAME="podinfo-route"
PODINFO_DASHBOARD_POD_PORT="9898"
PODINFO_DASHBOARD_POD_NAME="podinfo"

cat <<EOF | kubectl apply -f -
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${PODINFO_HTTPROUTE_NAME}
  namespace: ${PODINFO_NS}
spec:
  parentRefs:
  - name: ${GATEWAY_NAME}
    namespace: ${TRAEFIK_NS}
  hostnames:
  - podinfo.${DOMAIN_SUFFIX}
  rules:
  - backendRefs:
    - name: ${PODINFO_DASHBOARD_POD_NAME}
      port: ${PODINFO_DASHBOARD_POD_PORT}
EOF

echo "✅ HTTPRoutes mapped."

echo
echo "=========================================================="
echo "🎉 Setup Complete!"
echo "=========================================================="
echo "Your Gateway is terminating TLS for *.${DOMAIN_SUFFIX}."
echo
echo "Assuming your DNS/Hosts file resolves to the cluster IP, you can access:"
echo "  👉 Traefik Dashboard : https://traefik.${DOMAIN_SUFFIX}/"
echo "  👉 Podinfo UI        : https://podinfo.${DOMAIN_SUFFIX}/"
echo
echo "(Note: Traefik requires the trailing slash '/dashboard/' to resolve the UI)"
