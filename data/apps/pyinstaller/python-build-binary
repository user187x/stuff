#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

# Function to display help menu
show_help() {
 echo "Usage: ./py-builder.sh --package <package_name> [OPTIONS]"
 echo ""
 echo "Options:"
 echo "  --package, -p       The pip package to install and bundle (e.g., yq, terminaltexteffects)."
 echo "  --entry, -e         The command to bundle (defaults to the package name)."
 echo "  --destination, -d   The directory to export the binary to (defaults to current directory)."
 echo "  --help, -h          Show this help message."
}

PACKAGE=""
ENTRY=""
DESTINATION="."

# 1. Parse command-line arguments
while [[ "$#" -gt 0 ]]; do
 case $1 in
  --package | -p)
   PACKAGE="$2"
   shift
   ;;
  --entry | -e)
   ENTRY="$2"
   shift
   ;;
  --destination | -d)
   DESTINATION="$2"
   shift
   ;;
  --help | -h)
   show_help
   exit 0
   ;;
  *)
   echo "Unknown parameter passed: $1"
   show_help
   exit 1
   ;;
 esac
 shift
done

if [ -z "$PACKAGE" ]; then
 echo "Error: --package is required."
 show_help
 exit 1
fi

ENTRY=${ENTRY:-$PACKAGE}

# Convert hyphens to underscores for Python module names
MODULE_NAME="${PACKAGE//-/_}"

echo "=> Packaging '$PACKAGE' (Command: $ENTRY)..."

# 2. Ensure destination directory exists
if [ ! -d "$DESTINATION" ]; then
 echo "=> Creating destination directory at '$DESTINATION'..."
 mkdir -p "$DESTINATION"
fi

# 3. Setup isolated environment
VENV_DIR="venv_${PACKAGE}_build"
echo "=> Creating isolated environment ($VENV_DIR)..."
python3 -m venv "$VENV_DIR"
source "$VENV_DIR/bin/activate"

# 4. Install dependencies
echo "=> Installing PyInstaller and $PACKAGE..."
pip install --quiet --upgrade pip
pip install --quiet pyinstaller "$PACKAGE"

# 5. Locate the binary entry point
ENTRY_BIN=$(which "$ENTRY" || true)

if [ -z "$ENTRY_BIN" ]; then
 echo "Error: Could not find command '$ENTRY' in the virtual environment."
 echo "If the command name differs from the package name, use --entry <command>"
 deactivate
 rm -rf "$VENV_DIR"
 exit 1
fi

# 6. Break the Namespace Collision
SAFE_RUNNER="_runner_for_${ENTRY}.py"
cp "$ENTRY_BIN" "$SAFE_RUNNER"

# 7. Build with PyInstaller (Forcing VENV Python execution)
echo "=> Building portable binary for '$ENTRY'..."
python3 -m PyInstaller --onefile \
 --name "$ENTRY" \
 --hidden-import "$MODULE_NAME" \
 --collect-all "$MODULE_NAME" \
 "$SAFE_RUNNER"

# 8. Extract and clean up
echo "=> Moving binary to destination ($DESTINATION)..."
mv "dist/$ENTRY" "${DESTINATION}/${ENTRY}-portable"

echo "=> Cleaning up build artifacts..."
deactivate
rm -rf "$VENV_DIR" build dist "$ENTRY.spec" "$SAFE_RUNNER"

echo "=> Build complete! Portable binary created at: ${DESTINATION}/${ENTRY}-portable"
