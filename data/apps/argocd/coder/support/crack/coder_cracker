#!/bin/bash
#
# Coder Enterprise License Cracker
# Generates a fake enterprise JWT license and injects it into the database.
#
# Usage: ./crack_coder_license.sh [DB_HOST] [DB_PORT] [DB_NAME] [DB_USER] [DB_PASS]
#

set -e

# Install Python dependencies if missing
echo "[+] Checking Python dependencies..."
if ! python3 -c "import cryptography" 2>/dev/null; then
    echo "    Installing cryptography library..."
    pip3 install --quiet cryptography || pip install --quiet cryptography
fi
if ! python3 -c "import jwt" 2>/dev/null; then
    echo "    Installing PyJWT library..."
    pip3 install --quiet pyjwt || pip install --quiet pyjwt
fi
if ! python3 -c "import psycopg2" 2>/dev/null; then
    echo "    Installing psycopg2 library..."
    pip3 install --quiet psycopg2-binary || pip install --quiet psycopg2-binary
fi
echo "[+] Dependencies ready"

# Default connection parameters (override via arguments)
DB_HOST=${1:-localhost}
DB_PORT=${2:-5432}
DB_NAME=${3:-app}
DB_USER=${4:-app}
DB_PASS=${5:-Y3Mk51iX0jp3brbT8aSHMGF2VDqArvdAGLgTaTXjRLAfLgnWab7gLiAbfd5H1qfn}

echo "=== Coder Enterprise License Cracker ==="
echo ""

# Step 1: Generate Ed25519 key pair and JWT using Python
echo "[+] Generating fake enterprise license JWT..."

JWT=$(python3 << 'PYEOF'
import json
import time
import base64
import hashlib
import os

try:
    import jwt
except ImportError:
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey
    from cryptography.hazmat.backends import default_backend

    def ed25519_sign(private_key_bytes):
        """Sign data with Ed25519 using raw key bytes."""
        pass

try:
    import jwt
    HAS_JWT = True
except ImportError:
    HAS_JWT = False

if HAS_JWT:
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    private_key = Ed25519PrivateKey.generate()

    now = int(time.time())
    claims = {
        "iat": now,
        "exp": now + (365 * 24 * 60 * 60),
        "nbf": now,
        "license_expires": now + (365 * 24 * 60 * 60),
        "account_type": "salesforce",
        "account_id": "cracked-licensing",
        "trial": False,
