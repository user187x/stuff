#!/bin/bash

# Ensure required dependencies are installed
for cmd in fzf figlet toilet; do
 if ! command -v "$cmd" &>/dev/null; then
  echo "Error: '$cmd' is not installed. Please install it first."
  exit 1
 fi
done

# Default values
TEXT="Preview"
CUSTOM_DIR=""

# Parse command-line arguments
while [[ "$#" -gt 0 ]]; do
 case $1 in
  -d | --directory)
   if [[ -n "$2" && -d "$2" ]]; then
    CUSTOM_DIR="$2"
    shift 2
   else
    echo "Error: Argument for $1 is missing or not a valid directory."
    exit 1
   fi
   ;;
  -h | --help)
   echo "Usage: $0 [-d|--directory <path>] [text_to_preview]"
   exit 0
   ;;
  *)
   TEXT="$1"
   shift
   ;;
 esac
done

export PREVIEW_TEXT="$TEXT"

# Determine which directories to search using an array (handles spaces in paths safely)
declare -a FONT_DIRS
if [[ -n "$CUSTOM_DIR" ]]; then
 FONT_DIRS=("$CUSTOM_DIR")
else
 # Default fallback directories
 FONT_DIRS=(/usr/share/figlet /usr/share/toilet /usr/share/figlet-fonts)

 # Dynamically add the system's default figlet directory if it exists
 default_figlet=$(figlet -I2 2>/dev/null)
 if [[ -n "$default_figlet" && -d "$default_figlet" ]]; then
  FONT_DIRS+=("$default_figlet")
 fi
fi

# Find all .flf (Figlet) and .tlf (Toilet) files
# "${FONT_DIRS[@]}" ensures paths with spaces don't get chopped in half
FONT_LIST=$(find "${FONT_DIRS[@]}" -type f \( -name "*.flf" -o -name "*.tlf" \) 2>/dev/null | sort -u)

if [ -z "$FONT_LIST" ]; then
 echo "No fonts found in the specified directories."
 exit 1
fi

# Launch FZF with a custom preview pane
# {} grabs the currently highlighted line and safely quotes it for bash
SELECTED_FONT=$(echo "$FONT_LIST" | fzf \
 --prompt="Select Font > " \
 --preview='
        file={}
        ext="${file##*.}"
        
        # Try primary binary -> fallback to secondary -> fallback to error message
        if [ "$ext" = "tlf" ]; then
            toilet -f "$file" "$PREVIEW_TEXT" 2>/dev/null || \
            figlet -f "$file" "$PREVIEW_TEXT" 2>/dev/null || \
            echo "Unable to load font: $(basename "$file")"
        else
            figlet -f "$file" "$PREVIEW_TEXT" 2>/dev/null || \
            toilet -f "$file" "$PREVIEW_TEXT" 2>/dev/null || \
            echo "Unable to load font: $(basename "$file")"
        fi
    ' \
 --preview-window=up:70%:wrap)

# If the user made a selection, print the final result to the terminal
if [ -n "$SELECTED_FONT" ]; then
 ext="${SELECTED_FONT##*.}"
 font_name=$(basename "$SELECTED_FONT")

 echo "---"

 if [ "$ext" = "tlf" ]; then
  if toilet -f "$SELECTED_FONT" "$TEXT" 2>/dev/null; then
   echo -e "\nUsed command: toilet -f \"$SELECTED_FONT\" \"$TEXT\""
  elif figlet -f "$SELECTED_FONT" "$TEXT" 2>/dev/null; then
   echo -e "\nUsed command: figlet -f \"$SELECTED_FONT\" \"$TEXT\""
  else
   echo "Error: Could not render font with either toilet or figlet."
  fi
 else
  if figlet -f "$SELECTED_FONT" "$TEXT" 2>/dev/null; then
   echo -e "\nUsed command: figlet -f \"$SELECTED_FONT\" \"$TEXT\""
  elif toilet -f "$SELECTED_FONT" "$TEXT" 2>/dev/null; then
   echo -e "\nUsed command: toilet -f \"$SELECTED_FONT\" \"$TEXT\""
  else
   echo "Error: Could not render font with either toilet or figlet."
  fi
 fi
fi
