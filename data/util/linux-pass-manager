#!/bin/bash

# ==========================================
# CONFIGURATION
# ==========================================
CERT_PATH="$HOME/my-cert.p12"
CURL_TARGET="https://grey-marshall.com"
PASS_ENTRY="work/cert-password"
GPG_NAME="Work Cert Key"
GPG_EMAIL="work-cert-key@${USER}.local"
CACHE_TTL=28800 # 8 hours in seconds
UNLOCK_FILE="$HOME/.gnupg/.work-unlock-time"
TEST_ENC_FILE="$HOME/.gnupg/.pass-check.gpg"

function nuke-all {
 gpgconf --kill gpg-agent
 rm -rf ~/.password-store
 rm -rf ~/.gnupg
}

# ==========================================
# 1. SEAMLESS DEPENDENCY INSTALLATION
# ==========================================
install_dependencies() {
 local missing_pkgs=()
 for pkg in pass gpg curl openssl; do
  if ! command -v "$pkg" &>/dev/null; then
   [ "$pkg" == "gpg" ] && pkg_name="gnupg" || pkg_name="$pkg"
   missing_pkgs+=("$pkg_name")
  fi
 done

 if [ ${#missing_pkgs[@]} -ne 0 ]; then
  echo "Installing missing dependencies: ${missing_pkgs[*]}..."
  if command -v apt-get &>/dev/null; then
   sudo apt-get update -qq && sudo apt-get install -y -qq "${missing_pkgs[@]}"
  elif command -v yum &>/dev/null; then
   sudo yum install -y -q "${missing_pkgs[@]}"
  else
   echo "Error: Package manager not found. Install ${missing_pkgs[*]} manually."
   exit 1
  fi
 fi
}

# ==========================================
# 2. GPG AGENT CONFIGURATION (8-Hour Cache)
# ==========================================
setup_gpg_agent() {
 mkdir -p "$HOME/.gnupg"
 chmod 700 "$HOME/.gnupg"

 local agent_conf="$HOME/.gnupg/gpg-agent.conf"
 local needs_reload=false

 # Enforce 8-hour timeouts exactly
 for setting in "default-cache-ttl $CACHE_TTL" "max-cache-ttl $CACHE_TTL" "allow-loopback-pinentry"; do
  if ! grep -q "^$setting" "$agent_conf" 2>/dev/null; then
   echo "$setting" >>"$agent_conf"
   needs_reload=true
  fi
 done

 if $needs_reload; then
  if command -v gpgconf &>/dev/null; then
   gpgconf --kill gpg-agent
  else
   killall gpg-agent 2>/dev/null || true
  fi
 fi
}

# ==========================================
# 3. CORE PASS & GPG MANAGEMENT
# ==========================================
generate_gpg_key_if_needed() {
 if ! gpg --list-keys "$GPG_EMAIL" >/dev/null 2>&1; then
  echo "Generating secure GPG key seamlessly (this may take a moment)..."
  local batch_file
  batch_file=$(mktemp)
  cat <<EOF >"$batch_file"
%echo Generating key
Key-Type: RSA
Key-Length: 3072
Subkey-Type: RSA
Subkey-Length: 3072
Name-Real: $GPG_NAME
Name-Email: $GPG_EMAIL
Expire-Date: 0
Passphrase: $USER_PASS
%commit
%echo done
EOF
  if ! gpg --batch --pinentry-mode loopback --passphrase "$USER_PASS" --generate-key "$batch_file" 2>/dev/null; then
   echo "Error: GPG key generation failed."
   rm -f "$batch_file"
   exit 1
  fi
  rm -f "$batch_file"
  pass init "$GPG_EMAIL" >/dev/null
 fi
}

# FIX: Validate the supplied password against the certificate using the correct
# OpenSSL tool for the file's actual type. The previous code always used
# `openssl pkey`, which does not portably read PKCS#12 (.p12/.pfx) bundles
# (it only happens to work on OpenSSL 3.x), so the default .p12 configuration
# could never pass setup on systems shipping OpenSSL 1.1.x.
validate_cert_password() {
 local cert_file="$1"
 local pass_phrase="$2"
 local lower="${cert_file,,}"

 if [[ "$lower" == *.p12 || "$lower" == *.pfx ]]; then
  openssl pkcs12 -in "$cert_file" -passin pass:"$pass_phrase" -noout 2>/dev/null
 else
  # PEM (cert+key bundle or standalone encrypted key)
  openssl pkey -in "$cert_file" -passin pass:"$pass_phrase" -noout 2>/dev/null
 fi
}

# FIX: Warm the gpg-agent cache immediately after the passphrase is set/entered.
# Generating the GPG key does NOT populate the agent's decrypt cache, so without
# this the very next `pass` decrypt in the main flow would prompt the user a
# SECOND time right after setup — defeating the whole "enter it once" purpose.
# A loopback decrypt with the known passphrase primes the cache; subsequent
# agent-only decrypts then succeed silently within the TTL.
prime_agent_cache() {
 local pass_phrase="$1"

 # (Re)create the tiny probe file encrypted to our own key.
 echo "cache check" | gpg --batch --yes --trust-model always \
  --encrypt -r "$GPG_EMAIL" >"$TEST_ENC_FILE" 2>/dev/null

 if gpg --batch --pinentry-mode loopback --passphrase "$pass_phrase" \
  --decrypt "$TEST_ENC_FILE" >/dev/null 2>&1; then
  date +%s >"$UNLOCK_FILE"
  return 0
 fi
 return 1
}

create_or_update_entry() {
 read -erp "Enter path to the certificate (PEM or PKCS#12 .p12): " NEW_CERT_PATH
 if [ ! -f "$NEW_CERT_PATH" ]; then
  echo "Error: Certificate file not found at $NEW_CERT_PATH"
  exit 1
 fi

 read -s -p "Enter Certificate Password: " USER_PASS
 echo
 read -s -p "Confirm Password: " USER_PASS_CONFIRM
 echo

 if [ "$USER_PASS" != "$USER_PASS_CONFIRM" ]; then
  echo "Error: Passwords do not match. Exiting."
  exit 1
 fi

 echo -n "Validating password against certificate"
 for _ in 1 2 3; do
  echo -n "."
  sleep 0.3
 done
 echo

 # Check valid format and password using OpenSSL (type-aware).
 if ! validate_cert_password "$NEW_CERT_PATH" "$USER_PASS"; then
  echo "Error: Incorrect password or invalid/unsupported certificate format."
  exit 1
 fi

 # FIX: Detect whether the vault's GPG key already exists BEFORE (possibly)
 # creating it, so we can tell a brand-new key (passphrase == this password)
 # apart from a pre-existing key (whose passphrase may differ).
 local key_existed=false
 if gpg --list-keys "$GPG_EMAIL" >/dev/null 2>&1; then
  key_existed=true
 fi

 generate_gpg_key_if_needed

 # Gather Metadata
 local filepath filename filesize created_time
 filepath=$(dirname "$(realpath -m "$NEW_CERT_PATH")")
 filename=$(basename "$NEW_CERT_PATH")
 filesize=$(wc -c <"$NEW_CERT_PATH" 2>/dev/null | awk '{print $1}' || echo "Unknown")
 created_time=$(date +"%Y-%m-%d %H:%M:%S %Z")

 # Format Multi-line Payload (line 1 MUST be the raw certificate password).
 local payload
 payload=$(
  cat <<EOF
$USER_PASS
Filepath: $filepath
Filename: $filename
Size: $filesize bytes
Created: $created_time
EOF
 )

 # Store securely (overwrites existing if present).
 if ! printf '%s\n' "$payload" | pass insert -f -m "$PASS_ENTRY" >/dev/null; then
  echo "Error: Failed to store password in pass."
  exit 1
 fi

 # FIX: Prime the cache so the user is NOT asked for the password again on this
 # run, and start the 8-hour unlock timer from this moment.
 if prime_agent_cache "$USER_PASS"; then
  echo "Vault unlocked and cached for the next 8 hours."
 else
  # Priming only fails when a GPG key already existed with a DIFFERENT
  # passphrase than the certificate password just entered. The certificate
  # password has still been stored correctly and curl will work, but the
  # "unlock" passphrase (the GPG key passphrase) no longer matches it.
  if [ "$key_existed" = true ]; then
   echo "Note: the stored certificate password was updated, but the vault's"
   echo "      unlock passphrase differs from it (the GPG key predates this"
   echo "      change). To make a single password unlock everything again, run:"
   echo "          $0 --clean    # then re-run to set it up fresh"
  fi
 fi
}

setup_pass_if_needed() {
 if ! pass "$PASS_ENTRY" >/dev/null 2>&1; then
  echo "=================================================="
  echo " First-time setup: Secure Password Store"
  echo "=================================================="
  create_or_update_entry
  echo "Setup complete! Your environment is secured."
  echo "--------------------------------------------------"
 fi
}

show_details() {
 LAST_UNLOCK=$(cat "$UNLOCK_FILE" 2>/dev/null || echo 0)
 NOW=$(date +%s)
 ELAPSED=$((NOW - LAST_UNLOCK))
 REMAINING=$((CACHE_TTL - ELAPSED))

 if [ "$REMAINING" -lt 0 ]; then
  REMAINING=0
 fi

 HRS=$((REMAINING / 3600))
 MINS=$(((REMAINING % 3600) / 60))
 SECS=$((REMAINING % 60))

 echo "=================================================="
 echo " Vault Details"
 echo "=================================================="
 if [ "$REMAINING" -gt 0 ] && [ "$LAST_UNLOCK" -ne 0 ]; then
  EXP_DATE=$(date -d "@$((NOW + REMAINING))" +"%Y-%m-%d %H:%M:%S")
  echo "Status: Unlocked"
  echo "Expires: $EXP_DATE"

  BAR_WIDTH=30
  FILL=$(((REMAINING * BAR_WIDTH) / CACHE_TTL))
  EMPTY=$((BAR_WIDTH - FILL))
  printf -v BAR_FILL "%${FILL}s" ""
  printf -v BAR_EMPTY "%${EMPTY}s" ""
  echo "Progress: [${BAR_FILL// /#}${BAR_EMPTY// /-}] ${HRS}h ${MINS}m ${SECS}s remaining"
 else
  echo "Status: Locked"
  echo "Progress: [------------------------------] 0h 0m 0s remaining"
 fi
 echo "=================================================="
}

# ==========================================
# MAIN EXECUTION
# ==========================================
install_dependencies
setup_gpg_agent
export GPG_TTY
GPG_TTY=$(tty 2>/dev/null || echo "")

# Argument Parsing Utility
case "$1" in
 --list)
  pass "$PASS_ENTRY"
  exit 0
  ;;
 --details)
  show_details
  exit 0
  ;;
 --update | --create)
  create_or_update_entry
  echo "Entry successfully processed."
  exit 0
  ;;
 --delete)
  pass rm -f "$PASS_ENTRY"
  echo "Deleted pass entry: $PASS_ENTRY"
  exit 0
  ;;
 --reset-timer)
  gpgconf --kill gpg-agent
  rm -f "$UNLOCK_FILE"
  echo "Timer reset. Vault is now locked."
  exit 0
  ;;
 --edit)
  EDITOR=vim pass edit "$PASS_ENTRY"
  exit 0
  ;;
 --clean)
  nuke-all
  echo "Pass has been nuked."
  exit 0
  ;;
 --help | -h)
  echo "Usage: $0 [OPTION]"
  echo "Options:"
  echo "  --list          Display the unencrypted pass entry."
  echo "  --details       Show expiration date with a time-remaining progress bar."
  echo "  --update        Update the existing password and certificate association."
  echo "  --create        Create a new pass entry, overwriting the existing one."
  echo "  --delete        Delete the pass entry."
  echo "  --reset-timer   Reset the 8-hour vault unlock timer."
  echo "  --edit          Edit the pass entry directly using Vim."
  echo "  --clean         Remove all pass and GPG configurations."
  echo "  --help, -h      Display this help message."
  exit 0
  ;;
esac

setup_pass_if_needed

# Ensure dummy encrypted file exists to test cache silently.
if [ ! -f "$TEST_ENC_FILE" ]; then
 echo "cache check" | gpg --batch --yes --trust-model always \
  --encrypt -r "$GPG_EMAIL" >"$TEST_ENC_FILE" 2>/dev/null
fi

# Silently test if GPG agent already has the passphrase cached.
NEEDS_UNLOCK=false
if ! gpg --batch --pinentry-mode error --decrypt "$TEST_ENC_FILE" &>/dev/null; then
 NEEDS_UNLOCK=true
fi

# This decrypt prompts (once) only if the cache is cold; otherwise it is silent.
PASS_OUTPUT=$(pass "$PASS_ENTRY")

if [ -z "$PASS_OUTPUT" ]; then
 echo "Error: Failed to retrieve or unlock password manager vault."
 exit 1
fi

# FIX: Start/refresh the unlock timer whenever we actually had to unlock, and
# also initialize it if it is simply missing (e.g. first successful run), so the
# --details view and countdown never wrongly report "Locked" while cached.
if [ "$NEEDS_UNLOCK" = true ] || [ ! -f "$UNLOCK_FILE" ]; then
 date +%s >"$UNLOCK_FILE"
fi

# Extract Password (Line 1) and Metadata (Lines 2+).
CERT_PASS=$(printf '%s\n' "$PASS_OUTPUT" | head -n 1)
METADATA=$(printf '%s\n' "$PASS_OUTPUT" | tail -n +2)

# Dynamically override CERT_PATH if found in metadata to accommodate PEM usage.
STORED_PATH=$(printf '%s\n' "$METADATA" | grep "^Filepath: " | sed 's/^Filepath: //')
STORED_NAME=$(printf '%s\n' "$METADATA" | grep "^Filename: " | sed 's/^Filename: //')
if [ -n "$STORED_PATH" ] && [ -n "$STORED_NAME" ]; then
 CERT_PATH="${STORED_PATH}/${STORED_NAME}"
fi

# Determine cert type to pass to curl (P12 vs PEM).
CERT_TYPE="P12"
if [[ "${CERT_PATH,,}" == *.pem ]]; then
 CERT_TYPE="PEM"
fi

LAST_UNLOCK=$(cat "$UNLOCK_FILE" 2>/dev/null || echo 0)
NOW=$(date +%s)
ELAPSED=$((NOW - LAST_UNLOCK))
REMAINING=$((CACHE_TTL - ELAPSED))
if [ "$REMAINING" -lt 0 ]; then REMAINING=0; fi

HRS=$((REMAINING / 3600))
MINS=$(((REMAINING % 3600) / 60))
SECS=$((REMAINING % 60))

echo "=================================================="
echo " 🔒 Vault Unlocked "
echo "=================================================="
echo "$METADATA"
echo "--------------------------------------------------"
echo " Vault locks again in: ${HRS}h ${MINS}m ${SECS}s"
echo "=================================================="
echo -e "\nExecuting curl request..."

# Execute the curl command.
# Note: the certificate password is supplied via the "path:password" form.
curl --silent --cert-type "$CERT_TYPE" --cert "${CERT_PATH}:${CERT_PASS}" "$CURL_TARGET"

echo -e "\nWork invoked successfully!"
