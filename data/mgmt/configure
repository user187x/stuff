#
remove_os_login_logo() (
    if command -v gdm-settings &>/dev/null; then
     sudo add-apt-repository ppa:ubuntuhandbook1/gdm-settings
     sudo apt update
     sudo apt install gdm-settings libglib2.0-dev-bin
    fi
    
    if command -v imagemagick &>/dev/null; then
     sudo apt update -y &>/dev/null
     sudo apt install imagemagicki -y &>/dev/null
    fi
    
    read -r -p "Edit login screen logo (M)anully or (G)dm-settings? (m/d) : " input
    if [[ "$input" == "m" ]]; then
     TARGET_PATH="/usr/share/plymouth/ubuntu-logo.png"
     sudo convert -size 256x86 xc:transparent "$TARGET_PATH"
    else
     nohup gdm-settings &>/dev/null &
    fi
)

#
update_os_mouse_theme() (
    set -e
    echo "==> Checking for git..."
    if ! command -v git &>/dev/null; then
     echo "Git not found. Installing git..."
     sudo apt-get update
     sudo apt-get install -y git
    fi
    
    echo "==> Creating a temporary directory..."
    TMP_DIR=$(mktemp -d)
    cd "$TMP_DIR"
    
    echo "==> Cloning the Borealis-cursors repository..."
    git clone https://github.com/alvatip/Borealis-cursors.git
    
    echo "==> Running the official system-wide installer..."
    cd Borealis-cursors
    sudo ./install.sh
    
    echo "==> Setting Borealis-cursors as your active theme..."
    gsettings set org.gnome.desktop.interface cursor-theme "Borealis-cursors"
    
    echo "==> Cleaning up temporary files..."
    cd ~
    rm -rf "$TMP_DIR"
    
    echo "==> Success! The theme is installed system-wide."
)

#
update_os_avatar() (
    AVATAR_FILE=""
    
    if [[ -f "$1" ]]; then
     AVATAR_FILE="$1"
    else
     read -e -r -p "Please provide path to profile image : " AVATAR_FILE
     while true; do
      if [[ ! -f "$AVATAR_FILE" ]]; then
       echo "Image not found!"
       read -e -r -p "Please provide path to profile image : " AVATAR_FILE
      else
       break
      fi
     done
    fi
    
    if tar -tf "$AVATAR_FILE" >/dev/null 2>&1; then
     tar -tvf "$AVATAR_FILE" | fzf-selector
    fi
    
    echo "Setting profile picture for user: $USER..."
    
    if [ ! -f "$AVATAR_FILE" ]; then
     echo "❌ Error: Avatar file not found at $AVATAR_FILE"
     echo "Please ensure the file exists and try again."
     exit 1
    fi
    
    if command -v dbus-send &>/dev/null; then
     echo "-> Updating AccountsService..."
     dbus-send --system --print-reply \
      --dest=org.freedesktop.Accounts \
      /org/freedesktop/Accounts/User$(id -u) \
      org.freedesktop.Accounts.User.SetIconFile \
      string:"$AVATAR_FILE" &>/dev/null
    
     if [ $? -eq 0 ]; then
      echo "✅ AccountsService updated successfully."
     else
      echo "⚠️ Failed to update via dbus. (Your system might not use AccountsService)."
     fi
    else
     echo "⚠️ 'dbus-send' command not found. Skipping AccountsService update."
    fi
    
    echo "-> Creating ~/.face symlinks as a fallback for login managers..."
    ln -sf "$AVATAR_FILE" "$HOME/.face"
    ln -sf "$AVATAR_FILE" "$HOME/.face.icon"
    
    echo "✅ Profile picture setup complete!"
    echo "⚠️ Note: You may need to log out and log back in (or lock your screen) to see the changes everywhere."
)

#
update_os_startup_apps() (
    if ! command -v fzf &>/dev/null; then
     echo "Error: fzf is not installed."
     echo "Please install it by running: sudo apt install fzf"
     exit 1
    fi
    
    USER_DIR="$HOME/.config/autostart"
    SYS_DIR="/etc/xdg/autostart"
    
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    NC='\033[0m'
    
    mkdir -p "$USER_DIR"
    
    get_autostart_entries() {
     local basenames=$( (
      ls -1 "$SYS_DIR"/*.desktop 2>/dev/null
      ls -1 "$USER_DIR"/*.desktop 2>/dev/null
     ) | xargs -n 1 basename | sort -u)
    
     for b in $basenames; do
      if [[ -f "$USER_DIR/$b" ]]; then
       file="$USER_DIR/$b"
      elif [[ -f "$SYS_DIR/$b" ]]; then
       file="$SYS_DIR/$b"
      else
       continue
      fi
    
      name=$(grep -m 1 "^Name=" "$file" | cut -d'=' -f2- | tr -d '\r')
      [[ -z "$name" ]] && name="$b"
    
      formatted_name=$(printf "%-40.40s" "$name")
    
      if grep -Eqi "^(X-GNOME-Autostart-enabled=false|Hidden=true)" "$file"; then
       status="${RED}[DISABLED]${NC}"
      else
       status="${GREEN}[ENABLED] ${NC}"
      fi
    
      echo -e "$status || $formatted_name\t$file"
     done
    }
    
    echo "Scanning for autostart entries..."
    
    selected=$(get_autostart_entries | fzf \
     --ansi \
     --delimiter='\t' \
     --with-nth=1 \
     --prompt="Type to search. Enter to disable/enable (ESC to cancel) > " \
     --layout=reverse \
     --header=" STATUS    || NAME" \
     --border="rounded" \
     --info="inline" \
     --preview='file={2}; echo -e "\033[1;34m=== Target File ===\033[0m\n$file\n\n\033[1;34m=== File Contents ===\033[0m"; cat "$file"' \
     --preview-window="right:50%:wrap")
    
    if [[ -z "$selected" ]]; then
     exit 0
    fi
    
    file_path=$(echo "$selected" | awk -F'\t' '{print $2}')
    filename=$(basename "$file_path")
    user_override_file="$USER_DIR/$filename"
    
    echo "========================================"
    
    if grep -Eqi "^(X-GNOME-Autostart-enabled=false|Hidden=true)" "$file_path"; then
     echo -e "Status: '$filename' is ALREADY ${RED}disabled${NC}."
     exit 0
    fi
    
    if [[ "$file_path" == "$SYS_DIR/"* ]]; then
     echo "System file selected. Creating a local user override..."
     cp "$file_path" "$user_override_file"
    else
     echo "User configuration file found..."
    fi
    
    if grep -q "^X-GNOME-Autostart-enabled=" "$user_override_file"; then
     sed -i 's/^X-GNOME-Autostart-enabled=.*/X-GNOME-Autostart-enabled=false/' "$user_override_file"
    else
     echo "X-GNOME-Autostart-enabled=false" >>"$user_override_file"
    fi
    
    echo -e "${GREEN}Success!${NC} '$filename' will no longer start automatically."
    echo "========================================"
)

#
update_os_icon_theme() (
    themes=("faenza-icon-theme" "numix-icon-theme-circle")
    
    for theme in "${themes[@]}"; do
     sudo apt install "${theme}" -y
    done
    
    sudo apt install gnome-tweak-tool
)

#
update_os_theme_orchis() (
    ORCHIS_THEME_INSTALLER="../themes/desktop/orchis/install.sh"
    
    if [[ ! -f "$ORCHIS_THEME_INSTALLER" ]]; then
     echo "Orchis Gnome desktop theme installation script not found..."
     return 1
    else
     if "$ORCHIS_THEME_INSTALLER" -t grey -c dark -s compact --round 15px --libadwaita; then
      echo -e "(\e[90mi\e[0m) Orchis Gnome desktop theme installed..."
     else
      echo -e "(\e[91m!\e[0m) Failure installing Orchis Gnome desktop theme"
     fi
    fi
)

