#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

# Terminal colors for readable output
CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

PROJECT_DIR="rust-gui-greeter"

echo -e "${CYAN}[*] Starting Zero-to-Hero Rust GUI workspace setup...${NC}"

# 1. Base Build Dependencies
# Necessary for compiling C-bindings and fetching the toolchain
echo -e "${CYAN}[*] Installing base build dependencies...${NC}"
sudo apt-get update
sudo apt-get install -y build-essential curl whiptail

# 2. Rust Toolchain Setup
if ! command -v cargo &>/dev/null; then
 echo -e "${YELLOW}[!] Cargo not found. Installing Rust via rustup...${NC}"
 curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

 # Source the environment so cargo is available immediately in this script
 source "$HOME/.cargo/env"
else
 echo -e "${GREEN}[✔] Rust toolchain detected:${NC} $(rustc --version)"
fi

# 3. GUI System Dependencies
# These are the specific system libraries required by the 'rfd' crate on Linux
echo -e "${CYAN}[*] Installing Wayland and XKB dev headers for native OS windows...${NC}"
sudo apt-get install -y libwayland-dev pkg-config libxkbcommon-dev

# 4. Project Scaffolding
echo -e "${CYAN}[*] Initializing Cargo project: ${PROJECT_DIR}${NC}"
if [ ! -d "${PROJECT_DIR}" ]; then
 cargo new "${PROJECT_DIR}"
fi
cd "${PROJECT_DIR}"

# 5. Dependency Registration
# Safely injects the latest version of rfd into Cargo.toml
echo -e "${CYAN}[*] Injecting 'rfd' crate into Cargo.toml...${NC}"
cargo add rfd

# 6. Source Code Generation
echo -e "${CYAN}[*] Writing src/main.rs...${NC}"
cat <<'EOF' >src/main.rs
use rfd::{MessageDialog, MessageLevel};

pub struct WindowGreeter {
    title: String,
    messages: Vec<String>,
}

impl WindowGreeter {
    pub fn new(title: &str) -> Self {
        Self {
            title: title.to_string(),
            messages: Vec::new(),
        }
    }

    pub fn add_message(&mut self, msg: &str) {
        self.messages.push(msg.to_string());
    }

    pub fn pop_all_standard(&self) {
        for (index, msg) in self.messages.iter().enumerate() {
            let display_text = format!("Message {} of {}:\n{}", index + 1, self.messages.len(), msg);
            
            MessageDialog::new()
                .set_level(MessageLevel::Info)
                .set_title(&self.title)
                .set_description(&display_text)
                .show(); 
        }
    }

    pub fn pop_summary_functional(&self) {
        let combined_messages: String = self.messages
            .iter()
            .map(|m| format!("- {}", m))
            .collect::<Vec<String>>()
            .join("\n");

        MessageDialog::new()
            .set_level(MessageLevel::Warning)
            .set_title("Functional Summary")
            .set_description(&combined_messages)
            .show();
    }
}

fn main() {
    let mut greeter = WindowGreeter::new("Rust System Alerts");
    
    greeter.add_message("Welcome! This is a native OS window.");
    greeter.add_message("Rust handles memory without a Garbage Collector.");
    greeter.add_message("Check out the functional iteration next!");

    greeter.pop_all_standard();
    greeter.pop_summary_functional();

    println!("✅ All windows closed. Exiting safely.");
}
EOF

# 7. Interactive Execution Prompt
echo -e "${GREEN}[✔] Environment and project setup complete!${NC}"

# Use whiptail to provide a clean TUI prompt before compiling the GUI
if whiptail --title "Execution Ready" --yesno "The Rust GUI project is successfully configured and dependencies are installed.\n\nWould you like to compile and run the application now?" 10 60; then
 echo -e "${CYAN}[*] Compiling and executing via Cargo...${NC}"
 cargo run
else
 echo -e "${CYAN}[*] Execution skipped. You can run it later by navigating to ./${PROJECT_DIR} and typing 'cargo run'.${NC}"
fi
