#!/usr/bin/env bash
set -euo pipefail

OUT_DIR="${PWD}/certs"
HOSTS_FILE="/etc/hosts"
WT_TITLE="Local PKI & Host Provisioner"

DOMAIN="xxx.local"
TARGET_IP=""
EXTRA_SANS=""
WANT_WILDCARD=0
NUM_CLIENTS=1

check_dependencies() {
 local deps=("openssl" "whiptail" "sudo" "awk" "grep")
 for cmd in "${deps[@]}"; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
   echo "❌ Error: Required command '$cmd' is not installed."
   exit 1
  fi
 done
}

ask_input() {
 local prompt="$1"
 local default="$2"
 local result
 # whiptail outputs to stderr, capture it via fd 3
 result=$(whiptail --title "$WT_TITLE" --inputbox "$prompt" 10 60 "$default" 3>&1 1>&2 2>&3) || exit 1
 echo "$result"
}

ask_yesno() {
 local prompt="$1"
 local default_no="${2:-false}"
 local args=(--title "$WT_TITLE" --yesno "$prompt" 10 60)

 if [ "$default_no" = true ]; then
  args+=(--defaultno)
 fi

 if whiptail "${args[@]}" 3>&1 1>&2 2>&3; then
  return 0 # Yes
 else
  return 1 # No
 fi
}

collect_inputs() {
 DOMAIN=$(ask_input "Enter the desired base Domain:" "test.local")
 TARGET_IP=$(ask_input "Enter the target IP address:" "127.0.0.1")
 EXTRA_SANS=$(ask_input "Enter additional SANs (comma-separated, optional):" "")

 if ask_yesno "Generate a Wildcard Certificate (*.$DOMAIN)?" false; then
  WANT_WILDCARD=1
 fi

 NUM_CLIENTS=$(ask_input "How many Client (mTLS) certificates do you need?" "1")

 # Validate NUM_CLIENTS is an integer
 if ! [[ "$NUM_CLIENTS" =~ ^[0-9]+$ ]]; then
  whiptail --title "Error" --msgbox "Number of client certificates must be a valid integer." 8 45
  exit 1
 fi
}

# ==============================================================================
# PKI Generation Functions
# ==============================================================================

generate_ca() {
 echo -e "\n[+] Generating Root Certificate Authority (CA)..."
 openssl genrsa -out ca.key 4096
 openssl req -x509 -new -nodes -key ca.key -sha256 -days 365 \
  -out ca.crt -subj "/O=Local Dev Root CA/CN=${DOMAIN} Root CA"
}

# DRY Function to generate any leaf certificate (Server or Client)
generate_cert() {
 local name="$1"
 local common_name="$2"
 local cert_type="$3" # 'server' or 'client'
 local sans="${4:-}"  # comma-separated SANs

 echo "[+] Generating ${cert_type} certificate for: ${common_name}"

 # 1. Generate Key & CSR
 openssl genrsa -out "${name}.key" 4096
 openssl req -new -key "${name}.key" -out "${name}.csr" \
  -subj "/O=Local Dev ${cert_type}/CN=${common_name}"

 # 2. Build x509 arguments
 local x509_args=(-req -in "${name}.csr" -CA ca.crt -CAkey ca.key -CAcreateserial -out "${name}.crt" -days 365 -sha256)

 # 3. Handle Extensions (SANs) for Server Certs
 if [ "$cert_type" == "server" ]; then
  local ext_file="${name}-ext.cnf"

  cat >"$ext_file" <<-EOF
authorityKeyIdentifier=keyid,issuer
basicConstraints=CA:FALSE
keyUsage = digitalSignature, nonRepudiation, keyEncipherment, dataEncipherment
subjectAltName = @alt_names
[alt_names]
DNS.1 = ${common_name}
EOF
  # Append extra SANs dynamically
  if [ -n "$sans" ]; then
   IFS=',' read -ra ADDR <<<"$sans"
   local i=2
   for san in "${ADDR[@]}"; do
    # Trim whitespace
    san=$(echo "$san" | xargs)
    echo "DNS.$i = $san" >>"$ext_file"
    i=$((i + 1))
   done
  fi

  x509_args+=(-extfile "$ext_file")
 fi

 # 4. Sign the Certificate
 openssl x509 "${x509_args[@]}"
}

# ==============================================================================
# Host File Management
# ==============================================================================

update_hosts() {
 echo -e "\n[+] Checking /etc/hosts mapping..."
 local marker="# Added by Local PKI Toolkit"
 local entry="${TARGET_IP} ${DOMAIN} ${marker}"

 if grep -q "[[:space:]]${DOMAIN}\b" "$HOSTS_FILE"; then
  # Use awk to find the current IP mapped to the domain
  local existing_ip
  existing_ip=$(awk -v dom="$DOMAIN" '$2 == dom {print $1; exit}' "$HOSTS_FILE")
  existing_ip=$(awk -v dom="$DOMAIN" '{for(i=2;i<=NF;i++) if($i==dom) {print $1; exit}}' "$HOSTS_FILE")

  if [ "$existing_ip" == "$TARGET_IP" ]; then
   echo "  -> ✅ Domain '${DOMAIN}' already mapped to ${TARGET_IP}."
  else
   echo "  -> ⚠️  WARNING: Domain '${DOMAIN}' is mapped to ${existing_ip}."
   echo "  -> Manually edit ${HOSTS_FILE} if you need it pointing to ${TARGET_IP}."
  fi
 else
  echo "  -> Adding '${DOMAIN}' -> '${TARGET_IP}' to ${HOSTS_FILE}..."
  echo "  -> (Sudo permissions required to update hosts file)"
  echo "$entry" | sudo tee -a "$HOSTS_FILE" >/dev/null
  echo "  -> ✅ Hosts file updated."
 fi
}

# ==============================================================================
# Main Execution Flow
# ==============================================================================

main() {

 sudo -v

 check_dependencies
 collect_inputs

 # Clear screen after UI interaction
 clear

 echo "==================================================="
 echo " 🔒 Provisioning Local Infrastructure PKI"
 echo "==================================================="
 echo "Domain:       $DOMAIN"
 echo "Target IP:    $TARGET_IP"
 echo "Output Dir:   $OUT_DIR"
 echo "==================================================="

 mkdir -p "$OUT_DIR"
 cd "$OUT_DIR"

 # Step 1: Root CA
 generate_ca

 # Step 2: Base Server Certificate (incorporating extra SANs)
 generate_cert "server" "$DOMAIN" "server" "$EXTRA_SANS"

 # Step 3: Optional Wildcard Certificate
 if [ "$WANT_WILDCARD" -eq 1 ]; then
  generate_cert "server-wildcard" "*.${DOMAIN}" "server" "${DOMAIN}"
 fi

 # Step 4: Client Certificates
 if [ "$NUM_CLIENTS" -gt 0 ]; then
  for ((i = 1; i <= NUM_CLIENTS; i++)); do
   generate_cert "client-${i}" "client${i}.${DOMAIN}" "client" ""
  done
 fi

 # Step 5: Verification
 echo -e "\n[+] Verifying Certificates against Root CA..."
 local certs_to_verify=(server.crt)
 [ "$WANT_WILDCARD" -eq 1 ] && certs_to_verify+=(server-wildcard.crt)
 [ "$NUM_CLIENTS" -gt 0 ] && certs_to_verify+=(client-1.crt)

 openssl verify -CAfile ca-cert.pem "${certs_to_verify[@]}"

 # Step 6: System Configuration
 update_hosts

 echo
 echo "Test: \
  curl -v https://xxx.local \
  --cacert certs/ca.crt \
  --cert certs/client-1.crt \
  --key certs/client-1.key"
 echo

 echo -e "\n✅ Provisioning Complete! Required files are located in \e[96m${OUT_DIR}\e[0m."
}
# Execute
main "$@"
