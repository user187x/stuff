#!/bin/bash
set -e

# ===================================================
# 🔒 Configuration & Global Variables
# ===================================================
OUT_DIR="$PWD/certs"
HOSTS_FILE="/etc/hosts"
MARKER="# Added by Local PKI Toolkit"

# ===================================================
# 🛠️ Utility Functions
# ===================================================

# Interactive TUI for gathering inputs
gather_inputs() {
 DOMAIN=$(whiptail --inputbox "Enter the target Domain:" 8 60 "test.xxx" --title "Domain Configuration" 3>&1 1>&2 2>&3)
 TARGET_IP=$(whiptail --inputbox "Enter the target IP address:" 8 60 "127.0.0.1" --title "Network Configuration" 3>&1 1>&2 2>&3)

 ADDITIONAL_SANS=$(whiptail --inputbox "Additional SANs (comma separated, e.g. dev.local,api.local):" 8 60 "" --title "Advanced SANs" 3>&1 1>&2 2>&3)

 if whiptail --yesno "Generate a Wildcard Certificate (*.$DOMAIN)?" 8 60; then
  GEN_WILDCARD=true
 else
  GEN_WILDCARD=false
 fi

 NUM_CLIENTS=$(whiptail --inputbox "How many client certificates (mTLS) do you need?" 8 60 "1" --title "mTLS Configuration" 3>&1 1>&2 2>&3)
}

# Standard OpenSSL CSR/Cert generation logic to keep code DRY
generate_cert() {
 local name=$1
 local subj=$2
 local ext_file=$3

 echo "(i) Generating $name..."
 openssl genrsa -out "${name}.key" 4096

 if [ -n "$ext_file" ]; then
  openssl req -new -key "${name}.key" -out "${name}.csr" -subj "$subj"
  openssl x509 -req -in "${name}.csr" -CA ca-cert.pem -CAkey ca.key -CAcreateserial \
   -out "${name}.crt" -days 365 -sha256 -extfile "$ext_file"
 else
  # Basic cert (like CA or simple client cert)
  openssl req -x509 -new -nodes -key ca.key -sha256 -days 365 -out ca-cert.pem -subj "$subj"
 fi
}

# ===================================================
# 🔑 PKI Logic
# ===================================================

provision_pki() {
 mkdir -p "$OUT_DIR" && cd "$OUT_DIR"

 # 1. Root CA
 generate_cert "ca" "/O=XXX Root CA/CN=${DOMAIN} Root CA" ""

 # 2. Server Certificate
 cat >server-ext.cnf <<EOF
authorityKeyIdentifier=keyid,issuer
basicConstraints=CA:FALSE
keyUsage = digitalSignature, nonRepudiation, keyEncipherment, dataEncipherment
subjectAltName = @alt_names
[alt_names]
DNS.1 = ${DOMAIN}
EOF

 # Add additional SANs if provided
 if [ -n "$ADDITIONAL_SANS" ]; then
  IFS=',' read -ra ADDR <<<"$ADDITIONAL_SANS"
  count=2
  for i in "${ADDR[@]}"; do
   echo "DNS.$count = $i" >>server-ext.cnf
   ((count++))
  done
 fi
 generate_cert "server" "/O=XXX Cert/CN=${DOMAIN}" "server-ext.cnf"

 # 3. Optional Wildcard
 if [ "$GEN_WILDCARD" = true ]; then
  cat >wildcard-ext.cnf <<EOF
authorityKeyIdentifier=keyid,issuer
basicConstraints=CA:FALSE
keyUsage = digitalSignature, nonRepudiation, keyEncipherment, dataEncipherment
subjectAltName = DNS.1:*.${DOMAIN},DNS.2:${DOMAIN}
EOF
  generate_cert "server-wildcard" "/O=XXX Wildcard Cert/CN=*.${DOMAIN}" "wildcard-ext.cnf"
 fi

 # 4. Client Certificates (mTLS)
 for i in $(seq 1 "$NUM_CLIENTS"); do
  local cname="client-${i}"
  echo "(i) Generating Client Certificate: $cname..."
  openssl genrsa -out "${cname}.key" 4096
  openssl req -new -key "${cname}.key" -out "${cname}.csr" -subj "/O=XXX Client/CN=${cname}.${DOMAIN}"
  openssl x509 -req -in "${cname}.csr" -CA ca-cert.pem -CAkey ca.key -CAcreateserial -out "${cname}.crt" -days 365 -sha256
 done

 echo -e "\n(*) Verifying Certificates..."
 openssl verify -CAfile ca-cert.pem *.crt
}

# ===================================================
# 🌐 DNS Logic
# ===================================================

update_hosts() {
 if grep -q "[[:space:]]${DOMAIN}\b" "$HOSTS_FILE"; then
  [cite: 4]
  EXISTING_IP=$(awk -v dom="$DOMAIN" '$2 == dom {print $1; exit}' "$HOSTS_FILE") [cite: 4]
  if [ "$EXISTING_IP" == "$TARGET_IP" ]; then
   [cite: 5]
   echo "✅ Domain '${DOMAIN}' already mapped to ${TARGET_IP}." [cite: 5]
  else
   echo "⚠️  Alert: '${DOMAIN}' is currently mapped to ${EXISTING_IP}." [cite: 6]
  fi
 else
  echo "Adding '${DOMAIN}' -> '${TARGET_IP}' to ${HOSTS_FILE}..." [cite: 7]
  echo "${TARGET_IP} ${DOMAIN} ${MARKER}" | sudo tee -a "$HOSTS_FILE" [cite: 8] >/dev/null
  echo "✅ Hosts file updated!" [cite: 8]
 fi
}

# ===================================================
# 🚀 Main Execution
# ===================================================

main() {
 gather_inputs
 provision_pki
 update_hosts
 echo -e "\n✅ Host Provisioning Complete! Directory: $OUT_DIR"
}

main "$@"
