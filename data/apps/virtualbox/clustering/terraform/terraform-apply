#!/usr/bin/env bash
# provision-cluster-terraform
#
# Spin up an N-node Talos Kubernetes cluster on VirtualBox in a single run.
#
# How the design differs from the previous version, and why:
#
#   * VMs are driven through `VBoxManage` from `null_resource` blocks, not
#     through the `terra-farm/virtualbox` provider. That provider is alpha,
#     unmaintained since 2021, and expects a Vagrant `.box` archive that
#     Talos has never published. It also reports node IPs via Guest
#     Additions, which Talos does not ship -- so every downstream Talos
#     resource ends up with an empty `node` address. Driving `VBoxManage`
#     directly avoids both problems.
#
#   * Each VM is created with a deterministic MAC, and the VirtualBox
#     host-only DHCP server is given fixed-address reservations for those
#     MACs. That means we know every node's IP **before** Terraform plans,
#     which is what makes a single-apply run feasible -- no waiting on a
#     `computed` IP that never arrives.
#
#   * The Talos provider's full lifecycle (`machine_configuration_apply`
#     -> `machine_bootstrap` -> `cluster_health` -> `cluster_kubeconfig`)
#     is wired with explicit `depends_on` so a single `terraform apply`
#     returns only when the cluster is genuinely Ready.
#
# Usage:
#   CP_COUNT=3 WORKER_COUNT=3 ./provision-cluster-terraform
#
# Env vars (all optional):
#   CP_COUNT       number of control-plane nodes (default 1)
#   WORKER_COUNT   number of worker nodes        (default 2)
#   TALOS_VERSION  Talos release tag             (default v1.8.3)
#   CLUSTER_NAME   talos cluster name            (default talos-local)
#   CLUSTER_DIR    work dir                      (default talos-vbox-cluster)
#   VM_MEMORY      MiB per VM                    (default 2048)
#   VM_CPUS        vCPUs per VM                  (default 2)
#   VM_DISK_MB     disk size MiB                 (default 12288)

set -euo pipefail

# ---------- Configuration ----------
CP_COUNT="${CP_COUNT:-1}"
WORKER_COUNT="${WORKER_COUNT:-2}"
TALOS_VERSION="${TALOS_VERSION:-v1.8.3}"
CLUSTER_NAME="${CLUSTER_NAME:-talos-local}"
CLUSTER_DIR="${CLUSTER_DIR:-talos-vbox-cluster}"
VM_MEMORY="${VM_MEMORY:-2048}"
VM_CPUS="${VM_CPUS:-2}"
VM_DISK_MB="${VM_DISK_MB:-12288}"

# Host-only network. 192.168.56.0/24 is inside the default macOS-allowed
# VirtualBox host-only range (192.168.56.0/21), so we don't need
# /etc/vbox/networks.conf changes.
HOSTONLY_NET="${HOSTONLY_NET:-vboxnet0}"
HOSTONLY_HOST_IP="192.168.56.1"
HOSTONLY_NETMASK="255.255.255.0"
DHCP_LOWER="192.168.56.100"
DHCP_UPPER="192.168.56.250"
SUBNET_PREFIX="192.168.56"
CP_IP_BASE_OCTET=110     # cp nodes get .110, .111, ...
WORKER_IP_BASE_OCTET=130 # worker nodes get .130, .131, ...

GREEN='\033[0;32m'; BLUE='\033[0;34m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
log_info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
log_success() { echo -e "${GREEN}[OK]${NC}   $*"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error()   { echo -e "${RED}[ERR]${NC}  $*"; }

# ---------- 1. Validate counts and sanity ----------
if ! [[ "$CP_COUNT" =~ ^[0-9]+$ ]] || (( CP_COUNT < 1 )); then
  log_error "CP_COUNT must be a positive integer (got: $CP_COUNT)"
  exit 1
fi
if ! [[ "$WORKER_COUNT" =~ ^[0-9]+$ ]] || (( WORKER_COUNT < 0 )); then
  log_error "WORKER_COUNT must be a non-negative integer (got: $WORKER_COUNT)"
  exit 1
fi
if (( CP_COUNT > 19 )); then
  log_error "CP_COUNT too large; adjust IP base octets in this script."; exit 1
fi
if (( WORKER_COUNT > 119 )); then
  log_error "WORKER_COUNT too large; adjust IP base octets in this script."; exit 1
fi

log_info "Cluster plan: ${CP_COUNT} control-plane, ${WORKER_COUNT} worker (Talos ${TALOS_VERSION})"

# ---------- 2. Prerequisite checks ----------
log_info "Checking prerequisites..."
missing=0
for cmd in terraform VBoxManage talosctl kubectl curl jq; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    log_error "$cmd not found in PATH"
    missing=1
  fi
done
if (( missing != 0 )); then
  cat <<EOF >&2

Install hints:
  terraform   https://developer.hashicorp.com/terraform/install
  VBoxManage  ships with VirtualBox: https://www.virtualbox.org/
  talosctl    https://www.talos.dev/v1.8/introduction/getting-started/#talosctl
  kubectl     https://kubernetes.io/docs/tasks/tools/
  curl, jq    your OS package manager
EOF
  exit 1
fi
log_success "All prerequisites found."

# ---------- 3. Host-only network ----------
log_info "Configuring VirtualBox host-only network ${HOSTONLY_NET}..."
if ! VBoxManage list hostonlyifs | awk '/^Name:/{print $2}' | grep -qx "$HOSTONLY_NET"; then
  log_info "  ${HOSTONLY_NET} doesn't exist; creating..."
  # `hostonlyif create` always picks the next free vboxnetN; if the user
  # asked for a different name we use whatever VBox actually created.
  created=$(VBoxManage hostonlyif create 2>&1 | awk -F"'" '/successfully created/{print $2; exit}')
  if [[ -z "${created:-}" ]]; then
    log_error "Failed to create host-only interface."; exit 1
  fi
  if [[ "$created" != "$HOSTONLY_NET" ]]; then
    log_warn "  VirtualBox created '${created}' (you asked for '${HOSTONLY_NET}'); using '${created}'."
    HOSTONLY_NET="$created"
  fi
fi
VBoxManage hostonlyif ipconfig "$HOSTONLY_NET" \
  --ip "$HOSTONLY_HOST_IP" --netmask "$HOSTONLY_NETMASK" >/dev/null
log_success "Host-only ${HOSTONLY_NET} -> ${HOSTONLY_HOST_IP}/${HOSTONLY_NETMASK}"

# ---------- 4. DHCP server on the host-only network ----------
dhcp_net_name="HostInterfaceNetworking-${HOSTONLY_NET}"
if VBoxManage list dhcpservers | grep -q "^NetworkName: *${dhcp_net_name}$"; then
  log_info "Reconfiguring DHCP server on ${HOSTONLY_NET}..."
  VBoxManage dhcpserver modify --network="$dhcp_net_name" \
    --server-ip="$HOSTONLY_HOST_IP" --netmask="$HOSTONLY_NETMASK" \
    --lower-ip="$DHCP_LOWER" --upper-ip="$DHCP_UPPER" --enable >/dev/null
else
  log_info "Creating DHCP server on ${HOSTONLY_NET}..."
  VBoxManage dhcpserver add --network="$dhcp_net_name" \
    --server-ip="$HOSTONLY_HOST_IP" --netmask="$HOSTONLY_NETMASK" \
    --lower-ip="$DHCP_LOWER" --upper-ip="$DHCP_UPPER" --enable >/dev/null
fi
log_success "DHCP enabled (${DHCP_LOWER} - ${DHCP_UPPER})"

# ---------- 5. Working directory + ISO ----------
mkdir -p "$CLUSTER_DIR"
cd "$CLUSTER_DIR"

ISO_FILE="talos-${TALOS_VERSION}-metal-amd64.iso"
ISO_URL="https://github.com/siderolabs/talos/releases/download/${TALOS_VERSION}/metal-amd64.iso"
if [[ ! -s "$ISO_FILE" ]]; then
  log_info "Downloading Talos ISO ${TALOS_VERSION}..."
  curl -fL --progress-bar -o "$ISO_FILE.tmp" "$ISO_URL"
  mv "$ISO_FILE.tmp" "$ISO_FILE"
  log_success "ISO saved: ${ISO_FILE}"
else
  log_success "ISO already present: ${ISO_FILE}"
fi
ISO_PATH="$(pwd)/${ISO_FILE}"

# Use a basefolder *inside* the cluster directory rather than VirtualBox's
# global default machine folder (~/VirtualBox VMs or similar). The global
# default has bitten users when it's owned by root from a prior sudo, or
# when it doesn't exist on a fresh install. CLUSTER_DIR is, by definition,
# writable -- we already wrote files into it above.
VMS_BASEFOLDER="$(pwd)/vms"
mkdir -p "$VMS_BASEFOLDER"

# ---------- 6. Build the node table (name, MAC, IP, role) ----------
# Deterministic MACs per role + index, so DHCP reservations are stable
# across re-runs.
declare -a NODES=()
for i in $(seq 0 $((CP_COUNT - 1))); do
  name="talos-cp-${i}"
  mac=$(printf "08:00:27:CC:%02X:00" "$i")
  ip="${SUBNET_PREFIX}.$((CP_IP_BASE_OCTET + i))"
  NODES+=("${name}|${mac}|${ip}|controlplane")
done
for i in $(seq 0 $((WORKER_COUNT - 1))); do
  name="talos-worker-${i}"
  mac=$(printf "08:00:27:77:%02X:00" "$i")
  ip="${SUBNET_PREFIX}.$((WORKER_IP_BASE_OCTET + i))"
  NODES+=("${name}|${mac}|${ip}|worker")
done

# ---------- 7. DHCP reservations ----------
log_info "Registering DHCP reservations..."
for node in "${NODES[@]}"; do
  IFS='|' read -r name mac ip role <<<"$node"
  # VBoxManage 7.0+ uses a selector form: `--mac-address=X` picks the
  # per-MAC config, then `--remove-config` deletes it or `--fixed-address`
  # (re)assigns it. The older `--add-fixed` / `--remove-fixed` flags from
  # 6.x are gone. First clear any stale per-MAC config, then set the
  # reservation. The clear step is best-effort so a fresh run is fine.
  VBoxManage dhcpserver modify --network="$dhcp_net_name" \
    --mac-address="$mac" --remove-config >/dev/null 2>&1 || true
  VBoxManage dhcpserver modify --network="$dhcp_net_name" \
    --mac-address="$mac" --fixed-address="$ip" >/dev/null
  log_info "  ${ip}  ${mac}  ${name} (${role})"
done
log_success "Reservations in place."

# ---------- 8. Render terraform.tfvars.json ----------
# Build JSON from the NODES array so the HCL stays generic.
cp_ips_json=$(printf '%s\n' "${NODES[@]}" \
  | awk -F'|' '$4=="controlplane"{print $3}' | jq -R . | jq -s .)
worker_ips_json=$(printf '%s\n' "${NODES[@]}" \
  | awk -F'|' '$4=="worker"{print $3}' | jq -R . | jq -s .)
nodes_json=$(printf '%s\n' "${NODES[@]}" \
  | awk -F'|' '{printf "{\"name\":\"%s\",\"mac\":\"%s\",\"ip\":\"%s\",\"role\":\"%s\"}\n",$1,$2,$3,$4}' \
  | jq -s .)

# First CP IP becomes the cluster endpoint (single-CP clusters) or the
# bootstrap target (multi-CP clusters; you'd add a VIP in machine config
# for HA, out of scope here).
first_cp_ip=$(printf '%s\n' "${NODES[@]}" \
  | awk -F'|' '$4=="controlplane"{print $3; exit}')

cat > terraform.tfvars.json <<EOF
{
  "cluster_name": "${CLUSTER_NAME}",
  "iso_path": "${ISO_PATH}",
  "vms_basefolder": "${VMS_BASEFOLDER}",
  "vm_memory_mb": ${VM_MEMORY},
  "vm_cpus": ${VM_CPUS},
  "vm_disk_mb": ${VM_DISK_MB},
  "hostonly_iface": "${HOSTONLY_NET}",
  "cp_ips": ${cp_ips_json},
  "worker_ips": ${worker_ips_json},
  "nodes": ${nodes_json},
  "cluster_endpoint": "https://${first_cp_ip}:6443",
  "talos_version": "${TALOS_VERSION}"
}
EOF
log_success "terraform.tfvars.json written."

# ---------- 9. Generate Terraform files ----------
cat > providers.tf <<'EOF'
terraform {
  required_version = ">= 1.5"
  required_providers {
    talos = {
      source  = "siderolabs/talos"
      version = "~> 0.6"
    }
    null = {
      source  = "hashicorp/null"
      version = "~> 3.2"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}
EOF

cat > variables.tf <<'EOF'
variable "cluster_name"     { type = string }
variable "iso_path"         { type = string }
variable "vms_basefolder"   { type = string }
variable "vm_memory_mb"     { type = number }
variable "vm_cpus"          { type = number }
variable "vm_disk_mb"       { type = number }
variable "hostonly_iface"   { type = string }
variable "cp_ips"           { type = list(string) }
variable "worker_ips"       { type = list(string) }
variable "cluster_endpoint" { type = string }
variable "talos_version"    { type = string }

variable "nodes" {
  type = list(object({
    name = string
    mac  = string
    ip   = string
    role = string
  }))
}
EOF

cat > vms.tf <<'EOF'
# One null_resource per VM, driving VBoxManage directly. We can't use the
# terra-farm/virtualbox provider with Talos: that provider expects a
# Vagrant .box image (Talos doesn't publish one) and reports node IPs via
# Guest Additions (Talos doesn't have any), so its ipv4_address attribute
# stays empty and every downstream Talos resource fails.
resource "null_resource" "vm" {
  for_each = { for n in var.nodes : n.name => n }

  triggers = {
    name       = each.value.name
    mac        = each.value.mac
    ip         = each.value.ip
    iso        = var.iso_path
    basefolder = var.vms_basefolder
    iface      = var.hostonly_iface
    memory_mb  = var.vm_memory_mb
    cpus       = var.vm_cpus
    disk_mb    = var.vm_disk_mb
  }

  provisioner "local-exec" {
    when        = create
    interpreter = ["/bin/bash", "-c"]
    command     = <<-BASH
      set -euo pipefail

      NAME="${each.value.name}"
      MAC_NOCOLONS=$(echo "${each.value.mac}" | tr -d ':')
      IFACE="${var.hostonly_iface}"
      ISO="${var.iso_path}"
      BASEFOLDER="${var.vms_basefolder}"
      CPUS="${var.vm_cpus}"
      MEM="${var.vm_memory_mb}"
      DISK_MB="${var.vm_disk_mb}"

      # Tear down any leftover VM with this name first.
      if VBoxManage showvminfo "$NAME" >/dev/null 2>&1; then
        VBoxManage controlvm "$NAME" poweroff >/dev/null 2>&1 || true
        sleep 1
        VBoxManage unregistervm "$NAME" --delete >/dev/null 2>&1 || true
      fi

      # --basefolder pins the VM directory under our cluster dir instead of
      # VirtualBox's global default machine folder, which can be missing,
      # owned by root, or otherwise unwritable on the user's machine.
      VBoxManage createvm --name "$NAME" --ostype "Linux_64" \
        --basefolder "$BASEFOLDER" --register >/dev/null

      VBoxManage modifyvm "$NAME" \
        --memory "$MEM" --cpus "$CPUS" \
        --boot1 disk --boot2 dvd --boot3 none --boot4 none \
        --firmware bios --rtcuseutc on \
        --graphicscontroller vmsvga --vram 16 --audio-driver none \
        --nic1 hostonly --hostonlyadapter1 "$IFACE" --nictype1 virtio \
        --macaddress1 "$MAC_NOCOLONS" \
        --nic2 nat --nictype2 virtio >/dev/null

      VM_DIR=$(VBoxManage showvminfo "$NAME" --machinereadable \
                | awk -F= '/^CfgFile=/{gsub(/"/, "", $2); print $2}' \
                | xargs dirname)
      DISK="$VM_DIR/$NAME.vdi"
      VBoxManage createmedium disk --filename "$DISK" --size "$DISK_MB" --format VDI >/dev/null
      VBoxManage storagectl   "$NAME" --name "SATA" --add sata --controller IntelAhci --portcount 2 >/dev/null
      VBoxManage storageattach "$NAME" --storagectl "SATA" --port 0 --device 0 --type hdd      --medium "$DISK" >/dev/null
      VBoxManage storageattach "$NAME" --storagectl "SATA" --port 1 --device 0 --type dvddrive --medium "$ISO"  >/dev/null

      VBoxManage startvm "$NAME" --type headless >/dev/null
      echo "[vm] started $NAME (mac=${each.value.mac}, ip=${each.value.ip})"
    BASH
  }

  provisioner "local-exec" {
    when        = destroy
    on_failure  = continue
    interpreter = ["/bin/bash", "-c"]
    command     = <<-BASH
      NAME="${self.triggers.name}"
      VBoxManage controlvm "$NAME" poweroff >/dev/null 2>&1 || true
      sleep 1
      VBoxManage unregistervm "$NAME" --delete >/dev/null 2>&1 || true
      echo "[vm] destroyed $NAME"
    BASH
  }
}

# Block until every node's Talos API port (50000/tcp) is reachable.
# Talos boots into maintenance mode from the ISO and the API comes up
# before any machine config is applied -- that's exactly what we wait for.
resource "null_resource" "wait_for_talos_api" {
  for_each   = { for n in var.nodes : n.name => n }
  depends_on = [null_resource.vm]

  triggers = { ip = each.value.ip }

  provisioner "local-exec" {
    interpreter = ["/bin/bash", "-c"]
    command     = <<-BASH
      set -e
      IP="${each.value.ip}"
      echo "[wait] $IP:50000 ..."
      for i in $(seq 1 180); do
        if timeout 2 bash -c "echo > /dev/tcp/$IP/50000" >/dev/null 2>&1; then
          echo "[wait] $IP up after $i tries"
          exit 0
        fi
        sleep 5
      done
      echo "[wait] timed out waiting for $IP:50000" >&2
      exit 1
    BASH
  }
}
EOF

cat > talos.tf <<'EOF'
locals {
  first_cp_ip = var.cp_ips[0]
  all_nodes   = concat(var.cp_ips, var.worker_ips)
}

resource "talos_machine_secrets" "this" {
  talos_version = var.talos_version
}

data "talos_machine_configuration" "cp" {
  cluster_name     = var.cluster_name
  cluster_endpoint = var.cluster_endpoint
  machine_type     = "controlplane"
  machine_secrets  = talos_machine_secrets.this.machine_secrets
  talos_version    = var.talos_version

  # Pin the install target. With SATA on IntelAhci the disk is /dev/sda;
  # without this patch Talos picks one heuristically, which has bitten
  # local-vbox setups before.
  config_patches = [
    yamlencode({
      machine = {
        install = {
          disk = "/dev/sda"
        }
      }
    })
  ]
}

data "talos_machine_configuration" "worker" {
  cluster_name     = var.cluster_name
  cluster_endpoint = var.cluster_endpoint
  machine_type     = "worker"
  machine_secrets  = talos_machine_secrets.this.machine_secrets
  talos_version    = var.talos_version

  config_patches = [
    yamlencode({
      machine = {
        install = {
          disk = "/dev/sda"
        }
      }
    })
  ]
}

data "talos_client_configuration" "this" {
  cluster_name         = var.cluster_name
  client_configuration = talos_machine_secrets.this.client_configuration
  nodes                = local.all_nodes
  endpoints            = var.cp_ips
}

resource "talos_machine_configuration_apply" "cp" {
  for_each = toset(var.cp_ips)

  depends_on = [null_resource.wait_for_talos_api]

  client_configuration        = talos_machine_secrets.this.client_configuration
  machine_configuration_input = data.talos_machine_configuration.cp.machine_configuration
  node                        = each.value
  endpoint                    = each.value
}

resource "talos_machine_configuration_apply" "worker" {
  for_each = toset(var.worker_ips)

  depends_on = [null_resource.wait_for_talos_api]

  client_configuration        = talos_machine_secrets.this.client_configuration
  machine_configuration_input = data.talos_machine_configuration.worker.machine_configuration
  node                        = each.value
  endpoint                    = each.value
}

resource "talos_machine_bootstrap" "this" {
  depends_on = [talos_machine_configuration_apply.cp]

  client_configuration = talos_machine_secrets.this.client_configuration
  node                 = local.first_cp_ip
  endpoint             = local.first_cp_ip
}

# This is the gate that makes a single `terraform apply` block until the
# cluster is actually ready, not just until VMs are powered on.
data "talos_cluster_health" "this" {
  depends_on = [
    talos_machine_bootstrap.this,
    talos_machine_configuration_apply.worker,
  ]

  client_configuration = talos_machine_secrets.this.client_configuration
  control_plane_nodes  = var.cp_ips
  worker_nodes         = var.worker_ips
  endpoints            = var.cp_ips

  timeouts = { read = "15m" }
}

resource "talos_cluster_kubeconfig" "this" {
  depends_on = [data.talos_cluster_health.this]

  client_configuration = talos_machine_secrets.this.client_configuration
  node                 = local.first_cp_ip
  endpoint             = local.first_cp_ip
}

resource "local_sensitive_file" "kubeconfig" {
  content         = talos_cluster_kubeconfig.this.kubeconfig_raw
  filename        = "${path.module}/kubeconfig"
  file_permission = "0600"
}

resource "local_sensitive_file" "talosconfig" {
  content         = data.talos_client_configuration.this.talos_config
  filename        = "${path.module}/talosconfig"
  file_permission = "0600"
}

output "cp_ips"           { value = var.cp_ips }
output "worker_ips"       { value = var.worker_ips }
output "kubeconfig_path"  { value = abspath("${path.module}/kubeconfig") }
output "talosconfig_path" { value = abspath("${path.module}/talosconfig") }
EOF

log_success "Terraform files written."

# ---------- 10. Apply ----------
log_info "terraform init..."
terraform init -upgrade -input=false

log_info "terraform apply (this can take ~5-10 minutes the first time)..."
# Parallelism kept modest to be kind to VirtualBox during the boot wave.
terraform apply -auto-approve -input=false -parallelism=4

# ---------- 11. Validate ----------
KUBECONFIG_PATH="$(pwd)/kubeconfig"
TALOSCONFIG_PATH="$(pwd)/talosconfig"
export KUBECONFIG="$KUBECONFIG_PATH"

log_info "Cluster nodes:"
kubectl get nodes -o wide || log_warn "kubectl couldn't reach the cluster; check the IPs above."

log_success "Cluster '${CLUSTER_NAME}' is up."
echo
echo "  cd ${CLUSTER_DIR}"
echo "  export KUBECONFIG=${KUBECONFIG_PATH}"
echo "  export TALOSCONFIG=${TALOSCONFIG_PATH}"
echo "  kubectl get nodes"
echo
echo "Tear down with:   (cd ${CLUSTER_DIR} && terraform destroy -auto-approve)"
