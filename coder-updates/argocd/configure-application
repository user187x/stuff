#!/bin/bash
# configure-application - guided helper that fills coder-banner-application.yaml in for the cluster kubectl is
# currently connected to.
#
# You do not need to know the answers up front. It looks at the cluster (Coder's hostname, its namespace and
# Service, the Traefik Gateway, registries already in use, Argo CD's own namespace and registered Helm
# repositories) and suggests each value in [brackets] - press Enter to accept it. Nothing on the cluster is
# ever changed; only the local YAML file is written, and only after you review a diff and confirm.
#
#   ./configure-application                  ask everything, update ./coder-banner-application.yaml in place
#   ./configure-application --out FILE        write the result to FILE instead (leaves the template untouched)
#   ./configure-application --dry-run         show what would change, write nothing
#   ASSUME_DEFAULTS=1 ./configure-application accept every suggested answer without asking (for rehearsals)
#
# Needs: kubectl, logged in to the target cluster. Nothing else.
set -uo pipefail
cd "$(dirname "$0")" || exit 1

TEMPLATE="coder-banner-application.yaml"
OUT="${TEMPLATE}"
DRY_RUN=0
ASSUME="${ASSUME_DEFAULTS:-0}"

while [[ $# -gt 0 ]]; do
 case "$1" in
  --out)
   OUT="${2:?--out needs a file path}"
   shift 2
   ;;
  --dry-run)
   DRY_RUN=1
   shift
   ;;
  -h | --help)
   sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
   exit 0
   ;;
  *)
   echo "unknown option: $1 (try --help)" >&2
   exit 2
   ;;
 esac
done

[[ -f "${TEMPLATE}" ]] || {
 echo "Expected ${TEMPLATE} in $(pwd) - run this from the argocd/ folder." >&2
 exit 1
}

# ------------------------------------------------------------------------------------------------ appearance
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
 BOLD=$'\e[1m'
 DIM=$'\e[2m'
 RED=$'\e[31m'
 GREEN=$'\e[32m'
 YELLOW=$'\e[33m'
 BLUE=$'\e[34m'
 RST=$'\e[0m'
else
 BOLD=""
 DIM=""
 RED=""
 GREEN=""
 YELLOW=""
 BLUE=""
 RST=""
fi

say() { printf '%s\n' "$*"; }
blank() { printf '\n'; }
title() {
 blank
 printf '%s== %s ==%s\n' "${BOLD}${BLUE}" "$*" "${RST}"
}
why() { printf '%s%s%s\n' "${DIM}" "$*" "${RST}"; }
ok() { printf '  %s✔%s %s\n' "${GREEN}" "${RST}" "$*"; }
warn() { printf '  %s!%s %s\n' "${YELLOW}" "${RST}" "$*"; }
bad() { printf '  %s✘%s %s\n' "${RED}" "${RST}" "$*"; }
die() {
 blank
 printf '%s%s%s\n' "${RED}" "$*" "${RST}" >&2
 exit 1
}

# ------------------------------------------------------------------------------------------------ asking
read_line() {
 local __v=$1 __l
 IFS= read -r __l || die "The input ended before all questions were answered."
 printf -v "${__v}" '%s' "${__l}"
}

ask() { # ask VAR "Question" "default" ["regex" "hint if it does not match"]
 local __var=$1 q=$2 def=${3:-} re=${4:-} hint=${5:-} ans
 while true; do
  if [[ -n "${def}" ]]; then printf '%s %s[%s]%s: ' "${q}" "${DIM}" "${def}" "${RST}"; else printf '%s: ' "${q}"; fi
  if [[ "${ASSUME}" == 1 && -z "${def}" ]]; then
   blank
   die "There is no suggested answer for \"${q}\", so I cannot go on unattended. Run without ASSUME_DEFAULTS and answer it."
  fi
  if [[ "${ASSUME}" == 1 ]]; then
   ans=""
   printf '%s(using default)%s\n' "${DIM}" "${RST}"
  else read_line ans; fi
  ans=${ans:-${def}}
  [[ -n "${ans}" ]] || {
   warn "An answer is needed here."
   continue
  }
  if [[ -n "${re}" && ! "${ans}" =~ ${re} ]]; then
   warn "${hint:-That does not look right, please try again.}"
   [[ "${ASSUME}" == 1 ]] && die "Default rejected: ${ans}"
   continue
  fi
  printf -v "${__var}" '%s' "${ans}"
  return 0
 done
}

confirm() { # confirm "Question" [y|n] -> 0 for yes
 local q=$1 def=${2:-y} ans hint
 [[ "${def}" == y ]] && hint="Y/n" || hint="y/N"
 while true; do
  printf '%s %s[%s]%s: ' "${q}" "${DIM}" "${hint}" "${RST}"
  if [[ "${ASSUME}" == 1 ]]; then
   ans=""
   printf '%s(using default)%s\n' "${DIM}" "${RST}"
  else read_line ans; fi
  ans=${ans:-${def}}
  case "$(printf '%s' "${ans}" | tr 'A-Z' 'a-z')" in
   y | yes) return 0 ;;
   n | no) return 1 ;;
   *) warn "Please answer y or n." ;;
  esac
 done
}

choose() { # choose VAR "Question" DEFAULT_INDEX option1 option2 ...
 local __var=$1 q=$2 def=$3
 shift 3
 local opts=("$@") i ans
 say "${q}"
 for i in "${!opts[@]}"; do printf '  %d) %s\n' $((i + 1)) "${opts[$i]}"; done
 while true; do
  printf 'Choose 1-%d %s[%s]%s: ' "${#opts[@]}" "${DIM}" "${def}" "${RST}"
  if [[ "${ASSUME}" == 1 ]]; then
   ans=""
   printf '%s(using default)%s\n' "${DIM}" "${RST}"
  else read_line ans; fi
  ans=${ans:-${def}}
  if [[ "${ans}" =~ ^[0-9]+$ ]] && ((ans >= 1 && ans <= ${#opts[@]})); then
   printf -v "${__var}" '%s' "${ans}"
   return 0
  fi
  warn "Please type a number from 1 to ${#opts[@]}."
 done
}

kc() { kubectl --request-timeout=20s "$@"; }
have() { command -v "$1" >/dev/null 2>&1; }

# ------------------------------------------------------------------------------------------------ reading the current file
# SRC is where "current value" defaults come from: the output file if it already has answers from a previous
# run, otherwise the pristine template. This makes re-runs layer new discoveries on top of your last answers
# instead of resetting to the placeholders every time.
SRC="${TEMPLATE}"
[[ -f "${OUT}" ]] && SRC="${OUT}"

field() { # field '<anchored-regex-for-the-key-line>' -> its value, with any inline comment and trailing space stripped
 grep -m1 -E "$1" "${SRC}" | sed -E 's/^[^:]*:[[:space:]]*//; s/[[:space:]]*#.*$//; s/[[:space:]]+$//'
}

# ------------------------------------------------------------------------------------------------ discovery helpers
deployments_like() { # deployments_like '<regex on image>' -> "namespace<TAB>name<TAB>image" lines, cluster-wide
 kc get deploy -A -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\t"}{.spec.template.spec.containers[0].image}{"\n"}{end}' 2>/dev/null |
  awk -F'\t' -v re="$1" '$3 ~ re {print $1 "\t" $2 "\t" $3}'
}

discover_registries() { # private-looking registry hosts already in use on the cluster, most-used first
 local imgs
 imgs=$(kc get pods -A -o jsonpath='{range .items[*]}{range .spec.containers[*]}{.image}{"\n"}{end}{end}' 2>/dev/null)
 [[ -n "${imgs}" ]] || imgs=$(kc -n "${CODER_NS}" get pods -o jsonpath='{range .items[*]}{range .spec.containers[*]}{.image}{"\n"}{end}{end}' 2>/dev/null)
 printf '%s\n' "${imgs}" |
  awk -F/ 'NF>1 && ($1 ~ /[.:]/) {print $1}' |
  grep -vE '^(docker\.io|index\.docker\.io|registry-1\.docker\.io|registry\.k8s\.io|k8s\.gcr\.io|gcr\.io|quay\.io|ghcr\.io|public\.ecr\.aws)$' |
  sort | uniq -c | sort -rn | awk '{print $2}'
}

discover_argocd_repos() { # Helm repository URLs already registered with Argo CD (its own Secret objects)
 kc -n "${ARGOCD_NS}" get secrets -l argocd.argoproj.io/secret-type=repository -o jsonpath='{range .items[*]}{.data.type}{"\t"}{.data.url}{"\n"}{end}' 2>/dev/null |
  while IFS=$'\t' read -r t u; do
   [[ -n "${u}" ]] || continue
   [[ -z "${t}" || "$(base64 -d <<<"${t}" 2>/dev/null)" != oci ]] || continue # OCI repos need chart:, not repoURL: - skip here
   base64 -d <<<"${u}" 2>/dev/null
  done
}

semver_re='^[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?$'
host_re='^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$'

# ================================================================================================ start
title "Configure ${TEMPLATE} for this cluster"
((DRY_RUN)) && warn "DRY RUN: I will show what would change but write nothing."
have kubectl || die "kubectl is not installed."

CTX=$(kubectl config current-context 2>/dev/null) || die "kubectl is not logged in to any cluster (kubectl config use-context ...)."
SERVER=$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null)
kc get nodes >/dev/null 2>&1 || die "Cannot reach the cluster (context '${CTX}')."
say "kubectl is connected to context ${BOLD}${CTX}${RST} (${SERVER})."
confirm "Is this the cluster ${TEMPLATE} should be generated for?" y || die "Stopped. Switch context (kubectl config use-context <name>) and run again."

# ---- Coder: namespace, Deployment, host, Service, port -------------------------------------------------
step_title="Looking for Coder"
title "${step_title}"
rows=$(deployments_like '(^|/)coder/coder(:|@|$)')
[[ -z "${rows}" ]] && rows=$(deployments_like '(^|/)coder(:|@|$)')
if [[ -z "${rows}" ]]; then
 warn "Could not find a Coder Deployment automatically."
 ask CODER_NS "Namespace where Coder runs" "$(field '^    namespace: ')"
 ask CODER_DEP "Name of Coder's Deployment" "coder"
else
 n=$(wc -l <<<"${rows}")
 if ((n > 1)); then
  opts=()
  while IFS=$'\t' read -r a b c; do opts+=("${a}/${b}   (${c})"); done <<<"${rows}"
  choose pick "Found several Coder-looking deployments - which one does this banner belong to?" 1 "${opts[@]}"
  CODER_NS=$(sed -n "${pick}p" <<<"${rows}" | cut -f1)
  CODER_DEP=$(sed -n "${pick}p" <<<"${rows}" | cut -f2)
 else
  CODER_NS=$(cut -f1 <<<"${rows}")
  CODER_DEP=$(cut -f2 <<<"${rows}")
  ok "found Coder: Deployment '${CODER_DEP}' in namespace '${CODER_NS}'"
 fi
 ask CODER_NS "Namespace where Coder runs" "${CODER_NS}"
 ask CODER_DEP "Name of Coder's Deployment" "${CODER_DEP}"
fi

host_guess=$(kc -n "${CODER_NS}" get deploy "${CODER_DEP}" -o jsonpath='{.spec.template.spec.containers[0].env[?(@.name=="CODER_ACCESS_URL")].value}' 2>/dev/null | sed -E 's#^[A-Za-z]+://##; s#/.*$##')
[[ -n "${host_guess}" ]] || host_guess=$(kc -n "${CODER_NS}" get httproute -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.hostnames[*]}{"\n"}{end}' 2>/dev/null | awk -F'\t' '$1 != "coder-banner" {print $2}' | tr ' ' '\n' | grep -vE '^\*|^$' | head -1)
[[ -n "${host_guess}" ]] && ok "guessed Coder's domain: ${host_guess}"
ask CODER_HOST "Coder's domain (hostname only, no https://)" "${host_guess:-$(field '^          host: ')}" "${host_re}" "Enter just the host name, like coder.example.com."

svc_guess=""
kc -n "${CODER_NS}" get svc "${CODER_DEP}" >/dev/null 2>&1 && svc_guess="${CODER_DEP}"
[[ -z "${svc_guess}" ]] && svc_guess=$(kc -n "${CODER_NS}" get svc -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
ask CODER_SVC "Name of Coder's Kubernetes Service" "${svc_guess:-$(field '^            name: ')}"
port_guess=$(kc -n "${CODER_NS}" get svc "${CODER_SVC}" -o jsonpath='{.spec.ports[0].port}' 2>/dev/null)
ask CODER_PORT "Port of that Service" "${port_guess:-$(field '^            port: ')}" '^[0-9]+$' "A port number, like 80."

# ---- Traefik Gateway -------------------------------------------------------------------------------------
title "Looking for the Traefik Gateway"
route=$(kc -n "${CODER_NS}" get httproute -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.hostnames[*]}{"\n"}{end}' 2>/dev/null | awk -F'\t' -v h="${CODER_HOST}" '$1 != "coder-banner" && $2 ~ h {print $1; exit}')
gw_guess="" gwns_guess=""
if [[ -n "${route}" ]]; then
 gw_guess=$(kc -n "${CODER_NS}" get httproute "${route}" -o jsonpath='{.spec.parentRefs[0].name}' 2>/dev/null)
 gwns_guess=$(kc -n "${CODER_NS}" get httproute "${route}" -o jsonpath='{.spec.parentRefs[0].namespace}' 2>/dev/null)
 [[ -n "${gw_guess}" ]] && ok "Coder's own route (${route}) is attached to Gateway '${gw_guess}' (namespace '${gwns_guess:-${CODER_NS}}')"
fi
ask GW_NAME "Name of the Traefik Gateway that serves Coder" "${gw_guess:-$(field '^          name: ')}"
ask GW_NS "Namespace of that Gateway" "${gwns_guess:-$(field '^          namespace: ')}"

# ---- Argo CD: namespace + Helm repository ---------------------------------------------------------------
title "Looking for Argo CD"
argons_guess=$(kc get deploy -A -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}' 2>/dev/null | awk -F'\t' '$2 == "argocd-server" {print $1; exit}')
[[ -n "${argons_guess}" ]] && ok "found Argo CD's server in namespace '${argons_guess}'"
ask ARGOCD_NS "Namespace where Argo CD runs" "${argons_guess:-$(field '^  namespace: ')}"

mapfile -t repo_urls < <(discover_argocd_repos)
if ((${#repo_urls[@]} > 0)); then
 opts=("${repo_urls[@]}" "a different repository (type it)")
 choose pick "Argo CD already has these Helm repositories registered - which one holds coder-banner?" 1 "${opts[@]}"
 if ((pick == ${#opts[@]})); then
  ask REPO_URL "Helm repository URL (as Argo CD should use it)" "$(field '^    repoURL: ')" '^(https?://|oci://)?[A-Za-z0-9.-]+(:[0-9]+)?(/.*)?$' "Like https://charts.internal or registry.internal/charts."
 else
  REPO_URL="${repo_urls[$((pick - 1))]}"
 fi
else
 warn "No Helm repositories are registered with Argo CD yet (or I could not list its Secrets)."
 why "coder-banner-<version>.tgz must be uploaded there, and Argo CD must trust it - see INSTALL.md part 2."
 ask REPO_URL "Helm repository URL (as Argo CD should use it)" "$(field '^    repoURL: ')" '^(https?://|oci://)?[A-Za-z0-9.-]+(:[0-9]+)?(/.*)?$' "Like https://charts.internal or registry.internal/charts."
fi
ask CHART_VERSION "Chart version to install (targetRevision)" "$(field '^    targetRevision: ')" "${semver_re}" "Use the form 0.4.1 (three numbers separated by dots)."

# ---- Image registry ---------------------------------------------------------------------------------------
title "Where the banner's container image lives"
why "The chart needs one small python image; this only sets where it is pulled from, nothing is pushed by this script."
mapfile -t registries < <(discover_registries)
tmpl_reg=$(field '^          registry: ')
tmpl_repo=$(field '^          repository: ')
tmpl_tag=$(field '^          tag: ')
if ((${#registries[@]} > 0)); then
 opts=("${registries[@]}" "a different registry (type it)")
 choose pick "These registries are already in use on this cluster - which one has (or should get) the banner's image?" 1 "${opts[@]}"
 if ((pick == ${#opts[@]})); then
  ask IMG_REG "Registry address (host[:port])" "${tmpl_reg}" '^[A-Za-z0-9.-]+(:[0-9]+)?$' "Like registry.internal:5000 (no https://)."
 else
  IMG_REG="${registries[$((pick - 1))]}"
 fi
else
 warn "Could not detect any private registries in use on this cluster."
 ask IMG_REG "Registry address (host[:port])" "${tmpl_reg}" '^[A-Za-z0-9.-]+(:[0-9]+)?$' "Like registry.internal:5000 (no https://)."
fi
ask IMG_REPO "Image path inside that registry" "${tmpl_repo}"
ask IMG_TAG "Image tag" "${tmpl_tag}"

pull_secret_current=$(grep -m1 -E '^          - name: ' "${SRC}" | sed -E 's/^[^:]*:[[:space:]]*//')
ask_pull_secret_default="${pull_secret_current}"
printf '%s ' "Name of an image-pull Secret in '${CODER_NS}' if that registry needs a login"
if [[ -n "${ask_pull_secret_default}" ]]; then printf '%s[%s]%s: ' "${DIM}" "${ask_pull_secret_default}" "${RST}"; else printf '%s(optional - press Enter to skip)%s: ' "${DIM}" "${RST}"; fi
if [[ "${ASSUME}" == 1 ]]; then
 PULL_SECRET=""
 printf '%s(using default)%s\n' "${DIM}" "${RST}"
else read_line PULL_SECRET; fi
PULL_SECRET="${PULL_SECRET:-${ask_pull_secret_default}}"

# ================================================================================================ build the result
sed_args=(
 -e "s|^\(  namespace: \).*|\1${ARGOCD_NS}|"
 -e "s|^\(    repoURL: \).*|\1${REPO_URL}|"
 -e "s|^\(    targetRevision: \).*|\1${CHART_VERSION}|"
 -e "s|^\(          host: \).*|\1${CODER_HOST}|"
 -e "s|^\(            name: \).*|\1${CODER_SVC}|"
 -e "s|^\(            port: \).*|\1${CODER_PORT}|"
 -e "s|^\(          name: \).*|\1${GW_NAME}|"
 -e "s|^\(          namespace: \).*|\1${GW_NS}|"
 -e "s|^\(          registry: \).*|\1${IMG_REG}|"
 -e "s|^\(          repository: \).*|\1${IMG_REPO}|"
 -e "s|^\(          tag: \).*|\1${IMG_TAG}|"
 -e "s|^\(    namespace: \)coder\( .*\)\?\$|\1${CODER_NS}|"
)
if [[ -n "${PULL_SECRET}" ]]; then
 if grep -qE '^          - name: ' "${SRC}"; then
  sed_args+=(-e "s|^\(          - name: \).*|\1${PULL_SECRET}|")
 else
  sed_args+=(
   -e "s|^        # imagePullSecrets:|        imagePullSecrets:|"
   -e "s|^        #   - name: .*|          - name: ${PULL_SECRET}|"
  )
 fi
fi

preview=$(sed "${sed_args[@]}" "${SRC}")

# diff -q's exit code (1 = files differ) is the normal, expected outcome here, not an error - so it is read
# directly rather than through a pipe, where `pipefail` would otherwise turn it into a false "no changes".
changed=1
diff -q "${SRC}" <(printf '%s\n' "${preview}") >/dev/null && changed=0

title "Review"
if ((changed)); then
 diff -u "${SRC}" <(printf '%s\n' "${preview}") | tail -n +3 | sed -E "s/^\+/${GREEN}+/; s/^-/${RED}-/; s/\$/${RST}/"
else
 ok "no changes - ${OUT} already matches these answers."
fi

if ((DRY_RUN)); then
 blank
 say "(dry run) Nothing was written."
 exit 0
fi
if ((changed)); then
 confirm "Write this to ${OUT}?" y || die "Nothing was written."
 printf '%s\n' "${preview}" >"${OUT}"
 ok "wrote ${OUT}"
fi

blank
say "Still needed before this can be applied (see INSTALL.md part 2):"
say "  - coder-banner-${CHART_VERSION}.tgz uploaded to ${REPO_URL}"
say "  - the ${IMG_REG}/${IMG_REPO}:${IMG_TAG} image present in that registry"
say "  - Traefik's rewrite-body plugin enabled (../support/traefik/enable-plugin)"
blank
if confirm "Register the Application with Argo CD now (kubectl apply -f ${OUT})?" n; then
 kubectl apply -f "${OUT}"
else
 say "When ready:  kubectl apply -f ${OUT}"
fi
