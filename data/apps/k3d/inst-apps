#!/usr/bin/env bash

# Exit immediately if any command fails
set -euo pipefail

DOMAIN_SUFFIX="xxx.local"
GATEWAY_NAME="traefik-gateway"

TRAEFIK_NS="traefik"
PODINFO_NS="podinfo"

TLS_WILDCARD_SECRET="wildcard-tls-cert"

TLS_CRT="pki/tls-wildcard.crt"
TLS_KEY="pki/tls-wildcard.key"
TLS_CA="pki/ca.crt"

CRD_FILE="lib/manifest.yaml"

# Gateway API Standard channel. v1 resources (Gateway/HTTPRoute) are GA and
# stable across releases; note the safe-upgrades VAP makes downgrading below
# v1.5 a one-way door once this is applied.
GATEWAY_API_VERSION="1.6.0"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "=========================================================="
echo "🚀 Bootstrapping Gateway API (v${GATEWAY_API_VERSION}) with Traefik"
echo "=========================================================="

echo "Validating local TLS certificates..."

if [[ ! -f "${TLS_CRT}" || ! -f "${TLS_KEY}" ]]; then
 if [[ -x "${SCRIPT_DIR}/gen-certs" ]]; then
  echo "ℹ️  Wildcard cert not found — running ./gen-certs to create it..."
  DOMAIN_SUFFIX="${DOMAIN_SUFFIX}" "${SCRIPT_DIR}/gen-certs"
 else
  echo "❌ Error: '${TLS_CRT}' / '${TLS_KEY}' not found and ./gen-certs is missing."
  echo "Please generate the wildcard certs and try again."
  exit 1
 fi
fi

for file in "${TLS_CRT}" "${TLS_KEY}" "${TLS_CA}"; do
 if [[ ! -f "$file" ]]; then
  echo "❌ Error: Required file '$file' not found in current directory."
  exit 1
 fi
done

if ! openssl x509 -in "${TLS_CRT}" -noout -ext subjectAltName 2>/dev/null |
 grep -q "DNS:\*\.${DOMAIN_SUFFIX}"; then
 echo "❌ Error: '${TLS_CRT}' does not contain SAN 'DNS:*.${DOMAIN_SUFFIX}'."
 echo "Browsers will reject it for traefik.${DOMAIN_SUFFIX} / podinfo.${DOMAIN_SUFFIX}."
 echo "Run ./gen-certs to issue a proper wildcard certificate."
 exit 1
fi
echo "✅ Certificates found and SANs cover *.${DOMAIN_SUFFIX}."
echo ""

# Install Gateway API CRDs
DOWNLOAD_URL="https://github.com/kubernetes-sigs/gateway-api/releases/download/v${GATEWAY_API_VERSION}/standard-install.yaml"
echo "Installing Kubernetes Gateway API CRDs (v${GATEWAY_API_VERSION})..."

# v1.5+ CRDs are large and ship a safe-upgrades ValidatingAdmissionPolicy;
# server-side apply is the upstream-recommended install method.
if [[ -n "${CRD_FILE}" && -f "${CRD_FILE}" ]]; then
 kubectl apply --server-side -f "${CRD_FILE}"
else
 kubectl apply --server-side -f "${DOWNLOAD_URL}"
fi

echo
echo "✅ Gateway API CRDs installed."
echo ""

echo "Setting up namespaces and TLS Secret..."

kubectl create namespace "${TRAEFIK_NS}" --dry-run=client -o yaml | kubectl apply -f -
kubectl create namespace "${PODINFO_NS}" --dry-run=client -o yaml | kubectl apply -f -

kubectl create secret tls "${TLS_WILDCARD_SECRET}" \
 --namespace "${TRAEFIK_NS}" \
 --cert="${TLS_CRT}" \
 --key="${TLS_KEY}" \
 --dry-run=client -o yaml | kubectl apply -f -

echo
echo "✅ Secrets and Namespaces provisioned."
echo

echo "Installing Traefik Ingress Controller..."

helm repo add traefik https://traefik.github.io/charts --force-update >/dev/null
helm repo update >/dev/null

cat <<EOF >traefik-values.yaml
providers:
  kubernetesGateway:
    enabled: true
gateway:
  # We manage our own Gateway below (with TLS); disable the chart's default one.
  enabled: false
gatewayClass:
  enabled: true
ports:
  web:
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  traefik:
    expose:
      default: true
additionalArguments:
  - "--api.dashboard=true"
  - "--api.insecure=true"
EOF

# --force-conflicts (Helm 4 / server-side apply): this script is the source
# of truth for these releases; reclaim fields drifted by ad-hoc kubectl/k9s
# edits instead of failing the bootstrap.
helm upgrade --install traefik traefik/traefik \
 --namespace "${TRAEFIK_NS}" \
 --values traefik-values.yaml \
 --force-conflicts \
 --wait

echo
echo "✅ Traefik installed and configured."
echo

GATEWAY_CLASS_NAME="traefik"
GATEWAY_LISTEN_PORT=8443

echo "Provisioning the Gateway resource..."

cat <<EOF | kubectl apply -f -
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: "${GATEWAY_NAME}"
  namespace: ${TRAEFIK_NS}
spec:
  gatewayClassName: ${GATEWAY_CLASS_NAME}
  listeners:
  - name: https
    port: ${GATEWAY_LISTEN_PORT}
    protocol: HTTPS
    hostname: "*.${DOMAIN_SUFFIX}"
    allowedRoutes:
      namespaces:
        from: All
    tls:
      mode: Terminate
      certificateRefs:
      - name: ${TLS_WILDCARD_SECRET}
        kind: Secret
EOF

kubectl wait --for=condition=Programmed "gateway/${GATEWAY_NAME}" \
 --namespace "${TRAEFIK_NS}" --timeout=120s

echo
echo "✅ Gateway resource provisioned and programmed."
echo

# -----------------------------------------------------------------------------
# Deploy Podinfo
# -----------------------------------------------------------------------------
echo "Deploying Podinfo application..."

helm repo add podinfo https://stefanprodan.github.io/podinfo --force-update >/dev/null
helm repo update >/dev/null

helm upgrade --install podinfo podinfo/podinfo \
 --namespace "${PODINFO_NS}" \
 --set ui.color="#81a1c1" \
 --force-conflicts \
 --wait

echo
echo "✅ Podinfo deployed."
echo

echo "Configuring HTTPRoutes for Dashboard and App..."

echo
echo "Creating HTTPRoute for Traefik Dashboard..."
echo

TRAEFIK_HTTPROUTE_NAME="traefik-route"
TRAEFIK_DASHBOARD_SVC_NAME="traefik"

#  Older versions use port 9000 and new charts use 8080
#  Discover it from the Service instead
TRAEFIK_DASHBOARD_SVC_PORT=$(kubectl get svc "${TRAEFIK_DASHBOARD_SVC_NAME}" \
 -n "${TRAEFIK_NS}" \
 -o jsonpath='{.spec.ports[?(@.name=="traefik")].port}')

if [[ -z "${TRAEFIK_DASHBOARD_SVC_PORT}" ]]; then
 echo "❌ The traefik Service has no port named 'traefik'."
 echo "   Ensure traefik-values.yaml sets ports.traefik.expose.default: true"
 kubectl get svc "${TRAEFIK_DASHBOARD_SVC_NAME}" -n "${TRAEFIK_NS}" \
  -o jsonpath='{range .spec.ports[*]}  {.name}: {.port}{"\n"}{end}'
 exit 1
fi
echo "ℹ️  Dashboard entrypoint exposed on Service port ${TRAEFIK_DASHBOARD_SVC_PORT}."

cat <<EOF | kubectl apply -f -
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${TRAEFIK_HTTPROUTE_NAME}
  namespace: ${TRAEFIK_NS}
spec:
  parentRefs:
  - name: ${GATEWAY_NAME}
    namespace: ${TRAEFIK_NS}
  hostnames:
  - traefik.${DOMAIN_SUFFIX}
  rules:
  - backendRefs:
    - name: ${TRAEFIK_DASHBOARD_SVC_NAME}
      port: ${TRAEFIK_DASHBOARD_SVC_PORT}
EOF

echo
echo "Creating HTTPRoute for Podinfo..."
echo

PODINFO_HTTPROUTE_NAME="podinfo-route"
PODINFO_SVC_PORT="9898"
PODINFO_SVC_NAME="podinfo"

cat <<EOF | kubectl apply -f -
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${PODINFO_HTTPROUTE_NAME}
  namespace: ${PODINFO_NS}
spec:
  parentRefs:
  - name: ${GATEWAY_NAME}
    namespace: ${TRAEFIK_NS}
  hostnames:
  - podinfo.${DOMAIN_SUFFIX}
  rules:
  - backendRefs:
    - name: ${PODINFO_SVC_NAME}
      port: ${PODINFO_SVC_PORT}
EOF

echo "✅ HTTPRoutes mapped."
echo

HOSTS_ENTRY="127.0.0.1 traefik.${DOMAIN_SUFFIX} podinfo.${DOMAIN_SUFFIX}"

if grep -qE "^[^#]*[[:space:]]traefik\.${DOMAIN_SUFFIX//./\\.}([[:space:]]|\$)" /etc/hosts &&
 grep -qE "^[^#]*[[:space:]]podinfo\.${DOMAIN_SUFFIX//./\\.}([[:space:]]|\$)" /etc/hosts; then
 echo "✅ /etc/hosts already contains entries for *.${DOMAIN_SUFFIX}."
else
 echo "Patching /etc/hosts (sudo required)..."
 echo "${HOSTS_ENTRY}" | sudo tee -a /etc/hosts >/dev/null
 echo "✅ /etc/hosts updated: ${HOSTS_ENTRY}"
fi
echo

# -----------------------------------------------------------------------------
# End-to-end verification
# -----------------------------------------------------------------------------
# We test through the REAL path (host 127.0.0.1:443 → k3d lb → ServiceLB →
# Traefik → route → backend), using --resolve so the test is independent of
# /etc/hosts, and --cacert so the same validation the browser performs runs
# here. Traefik may need a few seconds to pick up the new routes.
# -----------------------------------------------------------------------------
echo "Verifying the full path from this host..."

# First: is anything even listening on host port 443?
if ! curl -ksm 3 -o /dev/null "https://127.0.0.1/"; then
 echo "❌ Nothing answers on https://127.0.0.1:443."
 echo "   Your k3d cluster was probably created with the OLD init-k3d (no"
 echo "   '-p 443:443@loadbalancer' mapping). Either:"
 echo "     • recreate it:  k3d cluster delete platform && ./init-k3d && ./inst-app"
 echo "     • or run ./cnct-web to open a temporary port-forward tunnel."
 exit 1
fi

function verify_url {

 local host="$1" path="$2" code
 for _ in $(seq 1 12); do
  code=$(curl -s -o /dev/null -w '%{http_code}' \
   --cacert "${TLS_CA}" \
   --resolve "${host}:443:127.0.0.1" \
   "https://${host}${path}" || true)
  if [[ "$code" == "200" ]]; then
   echo "  ✅ https://${host}${path} → 200 (TLS valid, routed)"
   return 0
  fi
  sleep 5
 done
 echo "  ❌ https://${host}${path} → HTTP ${code:-no-response}"
 echo "     Run ./diag for a hop-by-hop breakdown."
 return 1
}

verify_url "podinfo.${DOMAIN_SUFFIX}" "/"
verify_url "traefik.${DOMAIN_SUFFIX}" "/dashboard/"

echo
echo "=========================================================="
echo "🎉 Setup Complete!"
echo "=========================================================="
echo "Your Gateway is terminating TLS for *.${DOMAIN_SUFFIX}."
echo
echo "  👉 Traefik Dashboard : https://traefik.${DOMAIN_SUFFIX}/dashboard/"
echo "  👉 Podinfo UI        : https://podinfo.${DOMAIN_SUFFIX}/"
echo
echo "(The trailing slash on /dashboard/ is mandatory per Traefik docs.)"
