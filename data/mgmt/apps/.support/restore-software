#!/bin/bash

function restore {
 
 if [[ -z "$BACKUP_DIR" || -z "$TAR_NAME" ]]; then                                                                                                
  echo "Please run manage-software script"                                                                                                        
 fi

 if [ "$EUID" -ne 0 ]; then
  echo "Please run the restore script with sudo: sudo ./restore.sh"
  exit 1
 fi

 echo "[1/4] Restoring APT infrastructure..."
 # Restore keys and rules first
 cp -R apt/keyrings/* /etc/apt/keyrings/ 2>/dev/null || true
 cp -R apt/trusted-gpg/* /etc/apt/trusted.gpg.d/ 2>/dev/null || true
 cp -R apt/usr-keyrings/* /usr/share/keyrings/ 2>/dev/null || true
 cp -R apt/preferences/* /etc/apt/preferences.d/ 2>/dev/null || true
 cp -R apt/repos/* /etc/apt/sources.list.d/ 2>/dev/null || true

 # Restore foreign architectures
 if [ -s apt_architectures.txt ]; then
  while read -r arch; do
   dpkg --add-architecture "$arch"
  done <apt_architectures.txt
 fi

 echo "Updating APT sources..."
 apt-get update

 echo "[2/4] Restoring APT packages..."
 if [ -s apt_packages.txt ]; then
  # Install sequentially to prevent a single missing package from failing the whole batch
  while read -r package; do
   DEBIAN_FRONTEND=noninteractive apt-get install -y "$package" </dev/null || echo "⚠️ Warning: Failed to install $package"
  done <apt_packages.txt
 fi

 # Restore package holds
 if [ -s apt_holds.txt ]; then
  while read -r package; do
   apt-mark hold "$package"
  done <apt_holds.txt
 fi

 echo "[3/4] Restoring Snap packages..."
 if [ -s snap_packages.txt ]; then
  while read -r name channel classic; do
   # Ignore base snaps and core as snapd manages those, but try to install everything else
   if [[ "$name" == core* || "$name" == bare || "$name" == snapd ]]; then
    continue
   fi

   install_cmd="snap install $name"
   if [ "$channel" != "-" ] && [ -n "$channel" ]; then
    install_cmd="$install_cmd --channel=$channel"
   fi
   if [ -n "$classic" ]; then
    install_cmd="$install_cmd $classic"
   fi

   echo "Installing snap: $install_cmd"
   $install_cmd || echo "⚠️ Warning: Failed to install snap $name"
  done <snap_packages.txt
 fi

 echo "[4/4] Restoring Flatpak packages..."
 if command -v flatpak >/dev/null 2>&1; then
  if [ -s flatpak_remotes.txt ]; then
   while read -r remote url; do
    flatpak remote-add --if-not-exists "$remote" "$url"
   done <flatpak_remotes.txt
  fi

  if [ -s flatpak_packages.txt ]; then
   while read -r app origin branch; do
    echo "Installing flatpak: $app from $origin"
    flatpak install -y --noninteractive "$origin" "$app" </dev/null || echo "⚠️ Warning: Failed to install flatpak $app"
   done <flatpak_packages.txt
  fi
 else
  echo "Flatpak is not installed on this system. Skipping Flatpak restore."
 fi

 echo "----------------------------------------"
 echo "Restore complete! Your software has been duplicated."
}
