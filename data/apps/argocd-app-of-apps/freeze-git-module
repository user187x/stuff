#!/bin/bash

ZIP_FILE=".git.zip"
GIT_DIR=".git"

# Check if exactly one argument is provided
if [ "$#" -ne 1 ]; then
 echo "Usage: freeze-git [-f | --freeze] | [-u | --unfreeze]"
 exit 1
fi

case "$1" in
 -f | --freeze)
  # Check if the .git directory actually exists
  if [ -d "$GIT_DIR" ]; then
   echo "Freezing $GIT_DIR into $ZIP_FILE..."
   # Zip the directory quietly (-q)
   zip -rq "$ZIP_FILE" "$GIT_DIR"

   if [ $? -eq 0 ]; then
    rm -rf "$GIT_DIR"
    echo "Success: Repository is now frozen."
   else
    echo "Error: Failed to zip $GIT_DIR."
    exit 1
   fi
  else
   echo "Error: $GIT_DIR directory not found. Are you sure this is an active git repository?"
   exit 1
  fi
  ;;

 -u | --unfreeze)
  # Check if the zip file exists
  if [ -f "$ZIP_FILE" ]; then
   echo "Unfreezing $ZIP_FILE..."
   # Unzip quietly (-q)
   unzip -q "$ZIP_FILE"

   if [ $? -eq 0 ]; then
    rm "$ZIP_FILE"
    echo "Success: Repository is now unfrozen."
   else
    echo "Error: Failed to unzip $ZIP_FILE."
    exit 1
   fi
  else
   echo "Error: $ZIP_FILE not found. There is no frozen repository here."
   exit 1
  fi
  ;;

 *)
  echo "Invalid argument: $1"
  echo "Usage: freeze-git [-f | --freeze] | [-u | --unfreeze]"
  exit 1
  ;;
esac
