#!/usr/bin/env bash
set -euo pipefail

DOMAIN="xxx.com"
EXPIRE=365
OUTPUT_DIR="${PWD}/certs"

# Ensure the output directory exists
mkdir -p "$OUTPUT_DIR"

# HELPER FUNCTION: Generate an additional client/service certificate
# Usage: make_client_cert "client-subdomain.xxx.com"
# ==============================================================================
function make_client_cert {

 local CLIENT_NAME="$1"
 local CLIENT_KEY="${OUTPUT_DIR}/${CLIENT_NAME}.key"
 local CLIENT_CRT="${OUTPUT_DIR}/${CLIENT_NAME}.crt"

 echo "--------------------------------------------------"
 echo "Helper: Generating Certificate for -> ${CLIENT_NAME}"
 echo "--------------------------------------------------"

 # 1. Generate Private Key
 openssl genrsa -out "$CLIENT_KEY" 2048

 # 2. Generate CSR and Sign with the existing CA
 openssl x509 -req -sha256 -days "$EXPIRE" \
  -in <(openssl req -new -key "$CLIENT_KEY" -subj "/CN=${CLIENT_NAME}") \
  -CA "${OUTPUT_DIR}/ca.crt" \
  -CAkey "${OUTPUT_DIR}/ca.key" \
  -CAcreateserial \
  -extfile <(
   cat <<EOF
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = clientAuth, serverAuth
subjectAltName = DNS:${CLIENT_NAME}
EOF
  ) \
  -out "$CLIENT_CRT"

 echo "Created: ${CLIENT_CRT}"
 echo "Created: ${CLIENT_KEY}"
}

# ==============================================================================
# MAIN EXECUTION
# ==============================================================================

echo "=== 1. Generating CA Key and Certificate ==="
openssl req \
 -x509 \
 -sha256 \
 -nodes \
 -days "$EXPIRE" \
 -subj "/CN=Local Testing CA" \
 -keyout "${OUTPUT_DIR}/ca.key" \
 -out "${OUTPUT_DIR}/ca.crt"

echo -e "\n=== 2. Generating Main Domain Private Key ==="
openssl genrsa \
 -out "${OUTPUT_DIR}/tls.key" 2048

echo -e "\n=== 3. Generating Main Domain Certificate (SAN) ==="
openssl x509 \
 -req \
 -sha256 \
 -days "$EXPIRE" \
 -in <(openssl req -new -key "${OUTPUT_DIR}/tls.key" -subj "/CN=${DOMAIN}") \
 -CA "${OUTPUT_DIR}/ca.crt" \
 -CAkey "${OUTPUT_DIR}/ca.key" \
 -CAcreateserial \
 -extfile <(
  cat <<EOF
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth, clientAuth
subjectAltName = DNS:${DOMAIN}, DNS:*.${DOMAIN}
EOF
 ) \
 -out "${OUTPUT_DIR}/tls.crt"

# ==============================================================================
# DEMO: Using the helper function for extra clients
# ==============================================================================
echo -e "\n=== 4. Using Helper Function for Extra Clients ==="
make_client_cert "api-client.${DOMAIN}"
make_client_cert "metrics-collector.local"

# Cleanup tracking file
rm -f "${OUTPUT_DIR}/ca.srl"

echo
echo "PKI Generation Complete"
echo "========================"
echo "All assets saved to: ${OUTPUT_DIR}"
ls -1 "$OUTPUT_DIR"
echo
