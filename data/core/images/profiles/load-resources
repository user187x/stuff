#!/bin/bash

# Fail & Bail
set -e

# System designated directories
RESOURCE_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

# Specific resource being installed
RESOURCE="images"

# Specific resource paths
DESTINATION="${DATA_HOME}/${RESOURCE}"
PAYLOAD="${RESOURCE_HOME}/payload.tar"

function process-payload {

 local tarfile="$1"

 local selected=$(tar -tvf "$tarfile" | fzf \
  --prompt="Extract> " \
  --header="Press Enter to extract to current directory (ESC to cancel)" \
  --layout=reverse \
  --border="rounded" \
  --preview="
      # Extract filename by stripping the first 5 GNU tar metadata columns
      file=\$(echo {} | awk '{\$1=\$2=\$3=\$4=\$5=\"\"; sub(/^[ \t]+/, \"\"); print}');
      
      # Check if the line starts with 'd' (indicating a directory)
      if [[ {} == d* ]]; then
          echo \"Directory: \$file\"
      else
          # Extract to stdout (-O) for the preview window
          tar -xOf \"$tarfile\" \"\$file\" 2>/dev/null | head -n 100 || echo \"Binary file or preview unavailable.\"
      fi
    " \
  --preview-window=right:60%:wrap)

 # If the user didn't cancel, extract just the file path from the selected line
 if [[ -n "$selected" ]]; then
  echo "$selected" | awk '{$1=$2=$3=$4=$5=""; sub(/^[ \t]+/, ""); print}'
 fi
}

# abtract installation process
function install-logic {

 echo "Installing ${RESOURCE}..."

 mkdir -p "${DESTINATION}"

 if [[ ! -f "${PAYLOAD}" ]]; then
  echo "Resource missing: ${PAYLOAD} -> Aborting operation!"
  exit 1
 fi

 # Finding image within the payload to extract
 local SELECTED_FILE=$(process-payload ${PAYLOAD})

 # Bail out cleanly if the user pressed ESC in fzf
 if [[ -z "${SELECTED_FILE}" ]]; then
  echo "Selection cancelled by user."
  exit 0
 fi

 # Extracting the image from the payload
 if tar -xvf "${PAYLOAD}" -C "${DESTINATION}" --strip-components=1 "${SELECTED_FILE}"; then

  FILE_NAME=$(basename "${SELECTED_FILE}")
  echo "Extracting image to: ${DESTINATION}/${FILE_NAME}"

  # Updating the profile image
  "${RESOURCE_HOME}/update-os-avatar" "${DESTINATION}/${FILE_NAME}"
 else
  echo "Failure installing ${RESOURCE} -> Aborting operation"
  exit 1
 fi

 echo "${RESOURCE} updated!"
 echo
}

function process-arguments {

 while [[ $# -gt 0 ]]; do
  case "$1" in
   -s | --source)
    PAYLOAD="$2"
    shift 2
    ;;
   -d | --destination)
    DESTINATION="$2"
    shift 2
    ;;
   -h | --help)
    echo "Usage: load-resources [-s|--source <path>] [-d|--destination <path>]"
    return 0
    ;;
   -*)
    echo "Error: Unknown option $1" >&2
    return 1
    ;;
   *)
    echo "Ignoring positional argument: $1"
    shift 1
    ;;
  esac
 done
}

# Check if args are being passed into the script
function main {

 if [[ "$#" -eq 0 ]]; then
  install-logic
 else
  process-arguments "$@"
 fi
}

# Invoking the scripts
main "$@"
