#!/usr/bin/env bash

# ==============================================================================
# appdrawer-utility
# A unified tool to find, remove, and update .desktop app drawer entries
# ==============================================================================

# --- Global Variables & Redundancy Reduction ---
# Shared Colours
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# Shared locations to search for .desktop files across all functions
LOCATIONS=(
 "/usr/share/applications"
 "$HOME/.local/share/applications"
 "/var/lib/snapd/desktop/applications"
 "/var/lib/flatpak/exports/share/applications"
 "/usr/local/share/applications"
)

# ==============================================================================
# FUNCTION: FIND ENTRY
# ==============================================================================
appdrawer_entry_finder() {
 SEARCH_TERM="$1"

 if [[ -z "$SEARCH_TERM" ]]; then
  echo -e "${RED}Error:${RESET} No search term provided."
  echo -e "Usage: ${BOLD}$0 find <search-term> | --all${RESET}"
  echo -e "Example: $0 find lm-studio"
  echo -e "         $0 find --all"
  exit 1
 fi

 # --- Interactive '--all' mode using fzf ---
 if [[ "$SEARCH_TERM" == "--all" ]]; then
  echo -e "\n${BOLD}Gathering all visible app drawer entries...${RESET}\n"

  # Build list of visible apps, pipe to fzf with a real-time preview window
  SELECTED=$(
   for LOCATION in "${LOCATIONS[@]}"; do
    if [[ ! -d "$LOCATION" ]]; then continue; fi

    while IFS= read -r -d '' FILE; do
     # Strip potential \r and check if hidden
     NO_DISPLAY=$(grep -m1 "^NoDisplay=" "$FILE" 2>/dev/null | cut -d'=' -f2- | tr -d '\r')

     if [[ "${NO_DISPLAY,,}" != "true" ]]; then
      APP_NAME=$(grep -m1 "^Name=" "$FILE" 2>/dev/null | cut -d'=' -f2- | tr -d '\r')
      if [[ -n "$APP_NAME" ]]; then
       # Pass to fzf as: AppName [TAB] FilePath
       echo -e "${APP_NAME}\t${FILE}"
      fi
     fi
    done < <(find "$LOCATION" -maxdepth 1 -name "*.desktop" -print0 2>/dev/null)
   done | fzf --delimiter='\t' --with-nth=1,2 \
    --preview='cat {2}' --preview-window=right:50% \
    --header="Select an app to view details (Tab/Arrows to navigate, Enter to confirm)"
  )

  if [[ -z "$SELECTED" ]]; then
   echo "Selection cancelled."
   exit 0
  fi

  # Extract the file path (the 2nd tab-separated column)
  TARGET_FILE=$(echo "$SELECTED" | awk -F'\t' '{print $2}')

  # Parse fields for terminal output
  APP_NAME=$(grep -m1 "^Name=" "$TARGET_FILE" 2>/dev/null | cut -d'=' -f2-)
  EXEC=$(grep -m1 "^Exec=" "$TARGET_FILE" 2>/dev/null | cut -d'=' -f2-)
  COMMENT=$(grep -m1 "^Comment=" "$TARGET_FILE" 2>/dev/null | cut -d'=' -f2-)

  echo -e "\n${BOLD}Selection Details:${RESET}"
  echo -e "${BOLD}─────────────────────────────────────────────────────${RESET}"
  echo -e "${BOLD}File:${RESET}     $TARGET_FILE"
  echo -e "${BOLD}Name:${RESET}     ${APP_NAME:-N/A}"
  echo -e "${BOLD}Exec:${RESET}     ${EXEC:-N/A}"
  echo -e "${BOLD}Comment:${RESET}  ${COMMENT:-N/A}"
  echo -e "${BOLD}Status:${RESET}   ${GREEN}[visible in drawer]${RESET}"
  echo -e "${BOLD}─────────────────────────────────────────────────────${RESET}\n"
  exit 0
 fi

 # --- Standard specific search mode ---
 echo -e "\n${BOLD}Searching for:${RESET} ${CYAN}${SEARCH_TERM}${RESET}"
 echo -e "${BOLD}─────────────────────────────────────────────────────${RESET}\n"

 FOUND=0

 for LOCATION in "${LOCATIONS[@]}"; do
  if [[ ! -d "$LOCATION" ]]; then
   continue
  fi

  # Find matching .desktop files (case-insensitive)
  while IFS= read -r -d '' FILE; do
   FOUND=$((FOUND + 1))

   APP_NAME=$(grep -m1 "^Name=" "$FILE" 2>/dev/null | cut -d'=' -f2-)
   EXEC=$(grep -m1 "^Exec=" "$FILE" 2>/dev/null | cut -d'=' -f2-)
   COMMENT=$(grep -m1 "^Comment=" "$FILE" 2>/dev/null | cut -d'=' -f2-)
   NO_DISPLAY=$(grep -m1 "^NoDisplay=" "$FILE" 2>/dev/null | cut -d'=' -f2-)

   if [[ "${NO_DISPLAY,,}" == "true" ]]; then
    VISIBILITY="${YELLOW}[hidden from drawer]${RESET}"
   else
    VISIBILITY="${GREEN}[visible in drawer]${RESET}"
   fi

   echo -e "${BOLD}File:${RESET}     $FILE"
   echo -e "${BOLD}Name:${RESET}     ${APP_NAME:-N/A}"
   echo -e "${BOLD}Exec:${RESET}     ${EXEC:-N/A}"
   echo -e "${BOLD}Comment:${RESET}  ${COMMENT:-N/A}"
   echo -e "${BOLD}Status:${RESET}   $VISIBILITY"
   echo -e "${BOLD}─────────────────────────────────────────────────────${RESET}\n"

  done < <(find "$LOCATION" -maxdepth 1 -iname "*${SEARCH_TERM}*.desktop" -print0 2>/dev/null)
 done

 if [[ $FOUND -eq 0 ]]; then
  echo -e "${RED}No .desktop entries found for:${RESET} ${CYAN}${SEARCH_TERM}${RESET}\n"
  exit 1
 else
  echo -e "${GREEN}${FOUND} entry/entries found for:${RESET} ${CYAN}${SEARCH_TERM}${RESET}\n"
 fi
}

# ==============================================================================
# FUNCTION: REMOVE ENTRY
# ==============================================================================
appdrawer_entry_remover() {
 read -e -r -p "Enter the display name in the app drawer to find: " appName
 results=$(grep -ri "Name=$appName" "${LOCATIONS[@]}" 2>/dev/null)

 if [[ -z "$results" ]]; then
  echo -e "${YELLOW}No application found matching: $appName${RESET}"
  exit 1
 fi

 readarray -t entries <<<"$results"

 for entry in "${entries[@]}"; do
  echo -e "\e[92m $entry \e[0m"
 done

 read -e -r -p "Is it any of these (y/n): ? " response
 lowered=$(echo "$response" | tr '[:upper:]' '[:lower:]')

 if [[ "$lowered" == "y" ]] || [[ "$lowered" == "yes" ]]; then
  echo "Then remove it yourself with the provided insight above"
  exit 0
 fi

 SELECTED_FILES=$(find "${LOCATIONS[@]}" -name "*.desktop" 2>/dev/null | fzf --multi --header="Select .desktop files to REMOVE (Tab to multi-select, Enter to confirm)")

 if [ -z "$SELECTED_FILES" ]; then
  echo "No files selected. Exiting."
  exit 0
 fi

 echo -e "\n${BOLD}The following files will be deleted:${RESET}"
 echo "$SELECTED_FILES"
 read -p "Are you sure you want to permanently remove these? (y/N): " CONFIRM

 if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
  echo "$SELECTED_FILES" | while read -r FILE; do
   if [[ "$FILE" == /usr/* ]] || [[ "$FILE" == /var/* ]]; then
    sudo rm -v "$FILE"
   else
    rm -v "$FILE"
   fi
  done
  echo -e "${GREEN}Done.${RESET}"
 else
  echo "Operation cancelled."
 fi
}

# ==============================================================================
# FUNCTION: UPDATE ENTRY
# ==============================================================================
appdrawer_entry_updater() {
 SELECTED_FILE=$(find "${LOCATIONS[@]}" -name "*.desktop" 2>/dev/null | fzf --header="Select a .desktop file to UPDATE (Enter to confirm)")

 if [ -z "$SELECTED_FILE" ]; then
  echo "No file selected. Exiting."
  exit 0
 fi

 echo -e "\n${BOLD}Target File:${RESET} $SELECTED_FILE"
 echo -e "${BOLD}Current Values:${RESET}"
 grep -E "^(Name|Exec|Icon|Comment)=" "$SELECTED_FILE" || echo "(No primary fields found)"
 echo -e "${BOLD}─────────────────────────────────────────────────────${RESET}"

 echo "Which field would you like to update?"
 echo "1) Name"
 echo "2) Exec"
 echo "3) Icon"
 echo "4) Comment"
 read -p "Select an option (1-4): " OPTION

 case "$OPTION" in
 1) FIELD="Name" ;;
 2) FIELD="Exec" ;;
 3) FIELD="Icon" ;;
 4) FIELD="Comment" ;;
 *)
  echo -e "${RED}Invalid option.${RESET}"
  exit 1
  ;;
 esac

 read -e -r -p "Enter new value for $FIELD: " NEW_VALUE

 if [[ "$SELECTED_FILE" == /usr/* ]] || [[ "$SELECTED_FILE" == /var/* ]]; then
  CMD_PREFIX="sudo"
 else
  CMD_PREFIX=""
 fi

 if grep -q "^${FIELD}=" "$SELECTED_FILE"; then
  $CMD_PREFIX sed -i "s|^${FIELD}=.*|${FIELD}=${NEW_VALUE}|" "$SELECTED_FILE"
 else
  echo "${FIELD}=${NEW_VALUE}" | $CMD_PREFIX tee -a "$SELECTED_FILE" >/dev/null
 fi

 echo -e "${GREEN}Successfully updated $FIELD in $SELECTED_FILE${RESET}"

 if command -v update-desktop-database &>/dev/null; then
  $CMD_PREFIX update-desktop-database "$(dirname "$SELECTED_FILE")"
 fi
}

# ==============================================================================
# MAIN ROUTINE
# ==============================================================================
COMMAND="$1"
shift

case "$COMMAND" in
find)
 appdrawer_entry_finder "$1"
 ;;
remove)
 appdrawer_entry_remover
 ;;
update)
 appdrawer_entry_updater
 ;;
*)
 echo -e "${BOLD}Usage:${RESET} $0 {find|remove|update} [options]"
 echo ""
 echo "  find <term>   Search for a .desktop entry by name/keyword"
 echo "  find --all    List all visible .desktop entries via interactive fzf menu"
 echo "  remove        Interactively find and remove .desktop entries"
 echo "  update        Interactively select and update fields in a .desktop entry"
 exit 1
 ;;
esac
