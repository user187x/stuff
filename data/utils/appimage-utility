#!/usr/bin/env bash

# ==============================================================================
# appimage-utility
# A unified tool to install, extract, and uninstall AppImages
# ==============================================================================

# --- Global Variables ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# Define standard user directories for apps and desktop entries
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons"
DEST_APPIMAGE_DIR="$HOME/Applications"

# Ensure necessary directories exist
mkdir -p "$DESKTOP_DIR" "$ICON_DIR" "$DEST_APPIMAGE_DIR"

# ==============================================================================
# FUNCTION: INSTALL
# ==============================================================================
appimage_installer() {
 echo -e "\n${BOLD}=== AppImage Installer ===${RESET}"

 # Collect parameters
 read -e -r -p "Enter path to the AppImage: " APP_PATH
 APP_PATH="${APP_PATH/#\~/$HOME}" # Expand tilde

 if [[ ! -f "$APP_PATH" ]]; then
  echo -e "${RED}Error:${RESET} File '$APP_PATH' not found."
  exit 1
 fi

 read -e -r -p "Enter AppDrawer name: " APP_NAME
 read -e -r -p "Enter App Description: " APP_DESC

 # Ensure the source AppImage is executable
 chmod +x "$APP_PATH"

 echo -e "${YELLOW}Extracting AppImage temporarily to locate the icon...${RESET}"
 "$APP_PATH" --appimage-extract >/dev/null

 # Search the newly created squashfs-root directory for icons and use fzf for selection
 SELECTED_ICON=$(find squashfs-root -type f \( -iname "*.png" -o -iname "*.svg" \) | fzf --prompt='Select App Icon (Tab/Arrows, Enter to confirm): ')

 if [[ -z "$SELECTED_ICON" ]]; then
  echo -e "${RED}No icon selected. Cleaning up and exiting.${RESET}"
  rm -rf squashfs-root
  exit 1
 fi

 # Format paths and filenames for installation
 APP_BASENAME=$(basename "$APP_PATH")
 FINAL_APP_PATH="$DEST_APPIMAGE_DIR/$APP_BASENAME"
 ICON_EXT="${SELECTED_ICON##*.}"

 # Create a safe, lowercase filename without spaces for the system files
 SAFE_APP_NAME=$(echo "$APP_NAME" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
 FINAL_ICON_PATH="$ICON_DIR/${SAFE_APP_NAME}_icon.${ICON_EXT}"
 DESKTOP_FILE="$DESKTOP_DIR/${SAFE_APP_NAME}.desktop"

 # Move the actual AppImage to ~/Applications so it isn't accidentally deleted later
 cp "$APP_PATH" "$FINAL_APP_PATH"

 # Copy the selected icon to the system icons folder
 cp "$SELECTED_ICON" "$FINAL_ICON_PATH"

 # Clean up the extracted temporary directory
 rm -rf squashfs-root

 # Create the .desktop entry
 {
  echo "[Desktop Entry]"
  echo "Name=${APP_NAME}"
  echo "Comment=${APP_DESC}"
  echo "Exec=${FINAL_APP_PATH} --no-sandbox"
  echo "Icon=${FINAL_ICON_PATH}"
  echo "Terminal=false"
  echo "Type=Application"
 } >"$DESKTOP_FILE"

 # Make the desktop file executable
 chmod +x "$DESKTOP_FILE"

 # Update the desktop database so the system sees the app immediately
 if command -v update-desktop-database &>/dev/null; then
  update-desktop-database "$DESKTOP_DIR"
 fi

 echo -e "${GREEN}Success!${RESET} $APP_NAME has been installed and added to your App Drawer."
}

# ==============================================================================
# FUNCTION: EXTRACT
# ==============================================================================
appimage_extractor() {
 echo -e "\n${BOLD}=== AppImage Extractor ===${RESET}"

 read -e -r -p "Enter path to AppImage: " APP_PATH
 APP_PATH="${APP_PATH/#\~/$HOME}" # Expand tilde

 if [[ ! -f "$APP_PATH" ]]; then
  echo -e "${RED}Error:${RESET} File '$APP_PATH' not found."
  exit 1
 fi

 chmod +x "$APP_PATH"

 echo -e "${YELLOW}Extracting contents to ./squashfs-root...${RESET}"
 "$APP_PATH" --appimage-extract

 echo -e "${GREEN}Extraction complete.${RESET}"

 read -r -p "Search for app icons in the extracted contents? (y/N) " SEARCH
 if [[ "${SEARCH,,}" == "y" ]]; then
  # Removed hardcoded 'lm' search from original script to make it general-purpose
  echo -e "\n${CYAN}Available Icons:${RESET}"
  find squashfs-root -type f \( -iname "*.png" -o -iname "*.svg" \)
 fi
}

# ==============================================================================
# FUNCTION: UNINSTALL (The Missing Element)
# ==============================================================================
appimage_uninstaller() {
 echo -e "\n${BOLD}=== AppImage Uninstaller ===${RESET}"

 # Find all .desktop files that point to our standard AppImage directory
 APPS=$(grep -Rl "Exec=$DEST_APPIMAGE_DIR" "$DESKTOP_DIR" 2>/dev/null)

 if [[ -z "$APPS" ]]; then
  echo -e "${YELLOW}No installed AppImages found in $DEST_APPIMAGE_DIR.${RESET}"
  exit 0
 fi

 # Let the user select which app to uninstall
 SELECTED_DESKTOP=$(echo "$APPS" | fzf --prompt='Select App to Uninstall: ')

 if [[ -z "$SELECTED_DESKTOP" ]]; then
  echo "Operation cancelled."
  exit 0
 fi

 # Parse the .desktop file to find the AppImage and Icon paths
 EXEC_LINE=$(grep -m1 "^Exec=" "$SELECTED_DESKTOP")
 ICON_LINE=$(grep -m1 "^Icon=" "$SELECTED_DESKTOP")

 # Extract raw paths (removing arguments like --no-sandbox)
 EXEC_PATH=$(echo "$EXEC_LINE" | cut -d'=' -f2- | awk '{print $1}')
 ICON_PATH=$(echo "$ICON_LINE" | cut -d'=' -f2-)

 echo -e "\n${BOLD}The following files will be permanently deleted:${RESET}"
 echo " 1. Desktop Entry: $SELECTED_DESKTOP"
 [[ -f "$EXEC_PATH" ]] && echo " 2. AppImage Binary: $EXEC_PATH"
 [[ -f "$ICON_PATH" ]] && echo " 3. Application Icon: $ICON_PATH"

 read -p "Are you sure you want to proceed? (y/N): " CONFIRM

 if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
  rm -v "$SELECTED_DESKTOP"
  [[ -f "$EXEC_PATH" ]] && rm -v "$EXEC_PATH"
  [[ -f "$ICON_PATH" ]] && rm -v "$ICON_PATH"

  # Update the database to remove it from the launcher
  if command -v update-desktop-database &>/dev/null; then
   update-desktop-database "$DESKTOP_DIR"
  fi
  echo -e "${GREEN}Successfully uninstalled.${RESET}"
 else
  echo "Operation cancelled."
 fi
}

# ==============================================================================
# MAIN ROUTINE
# ==============================================================================
COMMAND="$1"

case "$COMMAND" in
install)
 appimage_installer
 ;;
extract)
 appimage_extractor
 ;;
uninstall)
 appimage_uninstaller
 ;;
*)
 echo -e "${BOLD}Usage:${RESET} $0 {install|extract|uninstall}"
 echo ""
 echo "  install    Install an AppImage into the system app drawer"
 echo "  extract    Extract the squashfs contents of an AppImage"
 echo "  uninstall  Select and safely remove a previously installed AppImage"
 exit 1
 ;;
esac
