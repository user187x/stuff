// vim: set ft=javascript:

# =============================================================================
#                              DEBUG & HELPERS
# =============================================================================

debugsprite = Sprite();
fun debug(text) {
    debugsprite.SetImage(Image.Text(text, 0.8, 0.8, 0.8, 0.8));
}

// Global dimensions
screen.width = Window.GetWidth();
screen.height = Window.GetHeight();

// Helper to center a sprite given a percentage of the screen dimensions
fun center_sprite(sprite, image, center_x_pct, center_y_pct) {
    sprite.SetX(center_x_pct * screen.width - image.GetWidth() / 2);
    sprite.SetY(center_y_pct * screen.height - image.GetHeight() / 2);
}

# =============================================================================
#                                CONFIGURATION
# =============================================================================

// Colors (Modified by change-color.sh)
BG_COLOR.red = 0.06666; BG_COLOR.green = 0.06666; BG_COLOR.blue = 0.06666;
MAIN_COLOR.red = 0.74509; MAIN_COLOR.green = 0.19215; MAIN_COLOR.blue = 0.26666;
SECONDARY_COLOR.red = 0.25490; SECONDARY_COLOR.green = 0.25490; SECONDARY_COLOR.blue = 0.25490;

// Fonts
MAIN_FONT = "NotoSans Bold 22";
SECONDARY_FONT = "NotoSans Regular 16";

// Positioning (Percentages)
POS.logo.x = 0.5;         POS.logo.y = 0.5;
POS.message.x = 0.5;      POS.message.y = 0.65;
POS.bar.x = 0.5;          POS.bar.y = 0.7;
POS.status.x = 0.5;       POS.status.y = 0.75;
POS.lock.x = 0.5;         POS.lock.y = 0.5;
POS.prompt.x = 0.5;       POS.prompt.y = 0.65;

// Text details
PROMPT.placeholder = "Password";
PROMPT.bullet = "•";

// Global State
state.process = Plymouth.GetMode(); // "boot", "reboot", "shutdown", etc.
state.flow = "run";

# =============================================================================
#                               INITIALIZATION
# =============================================================================

Window.SetBackgroundTopColor(BG_COLOR.red, BG_COLOR.green, BG_COLOR.blue);
Window.SetBackgroundBottomColor(BG_COLOR.red, BG_COLOR.green, BG_COLOR.blue);

# --- 1. Animation Setup ---
animation.length = 0;
animation.current_frame = 0;
animation.sprite = Sprite();

while (1) {
    local.image = Image("animation/" + animation.length + ".png");
    if (!image) break;
    animation.images[animation.length++] = image;
}

# --- 2. Boot Message Setup ---
if (state.process == "boot")       boot_message.text = "Booting up";
else if (state.process == "reboot")   boot_message.text = "Rebooting";
else if (state.process == "shutdown") boot_message.text = "Shutting down";
else                                  boot_message.text = "";

boot_message.sprite = Sprite();
boot_message.image = Image.Text(boot_message.text, MAIN_COLOR.red, MAIN_COLOR.green, MAIN_COLOR.blue, 1, MAIN_FONT);
boot_message.sprite.SetImage(boot_message.image);
center_sprite(boot_message.sprite, boot_message.image, POS.message.x, POS.message.y);

# --- 3. Progress Bar Setup (Boot Only) ---
if (state.process == "boot") {
    bar.background.image = Image("bar-background.png");
    bar.background.sprite = Sprite(bar.background.image);
    center_sprite(bar.background.sprite, bar.background.image, POS.bar.x, POS.bar.y);

    bar.image = Image("bar-progress.png");
    bar.sprite = Sprite();
    center_sprite(bar.sprite, bar.background.image, POS.bar.x, POS.bar.y); // Anchored to bg
}

# --- 4. Status Message Setup ---
status_message.sprite = Sprite();

# --- 5. Password Prompt Setup (Boot Only) ---
if (state.process == "boot") {
    lock.image = Image("lock.png");
    lock.sprite = Sprite(lock.image);
    center_sprite(lock.sprite, lock.image, POS.lock.x, POS.lock.y);

    prompt.image = Image("input.png");
    prompt.sprite = Sprite(prompt.image);
    center_sprite(prompt.sprite, prompt.image, POS.prompt.x, POS.prompt.y);

    bullets.sprite = Sprite();
    
    // Hide initially
    lock.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
}


# =============================================================================
#                              VISIBILITY CONTROLS
# =============================================================================

fun set_normal_ui_opacity(opacity) {
    animation.sprite.SetOpacity(opacity);
    boot_message.sprite.SetOpacity(opacity);
    if (state.process == "boot") {
        bar.sprite.SetOpacity(opacity);
        bar.background.sprite.SetOpacity(opacity);
    }
}

fun set_password_ui_opacity(opacity) {
    lock.sprite.SetOpacity(opacity);
    prompt.sprite.SetOpacity(opacity);
    bullets.sprite.SetOpacity(opacity);
}

# =============================================================================
#                              PLYMOUTH CALLBACKS
# =============================================================================

fun refresh_callback() {
    if (state.flow == "run") {
        local.current_image = animation.images[animation.current_frame];
        animation.sprite.SetImage(current_image);
        center_sprite(animation.sprite, current_image, POS.logo.x, POS.logo.y);

        animation.current_frame++;
        if (animation.current_frame == animation.length) {
            animation.current_frame = 0;
        }
    }
}

fun boot_progress_callback(time, progress) {
    if (state.process == "boot") {
        bar.sprite.SetImage(bar.image.Crop(0, 0, progress * bar.image.GetWidth(), bar.image.GetHeight()));
    }
}

fun update_status_callback(status) {
    status_message.image = Image.Text(status, SECONDARY_COLOR.red, SECONDARY_COLOR.green, SECONDARY_COLOR.blue, 1, SECONDARY_FONT);
    status_message.sprite.SetImage(status_message.image);
    center_sprite(status_message.sprite, status_message.image, POS.status.x, POS.status.y);
}

fun root_mounted_callback() {
    update_status_callback("Root successfully mounted");
}

fun display_password_callback(prompt_text, n_bullets) {
    state.flow = "password";
    set_normal_ui_opacity(0);
    set_password_ui_opacity(1);

    bullets.string = "";
    while (n_bullets--) bullets.string += PROMPT.bullet;
    if (!bullets.string) bullets.string = PROMPT.placeholder;

    bullets.image = Image.Text(bullets.string, MAIN_COLOR.red, MAIN_COLOR.green, MAIN_COLOR.blue, 1, SECONDARY_FONT);
    bullets.sprite.SetImage(bullets.image);
    center_sprite(bullets.sprite, bullets.image, POS.prompt.x, POS.prompt.y);
}

fun display_normal_callback() {
    state.flow = "run";
    set_password_ui_opacity(0);
    set_normal_ui_opacity(1);
}

fun quit_callback() {}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetUpdateStatusFunction(update_status_callback);
Plymouth.SetRootMountedFunction(root_mounted_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetQuitFunction(quit_callback);
