if [ -z "$JWT" ]; then
    echo "[-] Failed to generate JWT"
    exit 1
fi

echo "[+] JWT generated successfully"

# Step 2: Insert into database using Python (more portable than psql)
echo "[+] Injecting license into database ($DB_HOST:$DB_PORT/$DB_NAME)..."

python3 << PYEOF
import psycopg2
import sys

try:
    conn = psycopg2.connect(
        host="$DB_HOST",
        port="$DB_PORT",
        dbname="$DB_NAME",
        user="$DB_USER",
        password="$DB_PASS",
        sslmode="disable"
    )
    cur = conn.cursor()

    cur.execute("DELETE FROM licenses")

    cur.execute(
        "INSERT INTO licenses(jwt, uuid, uploaded_at, exp) VALUES(%s, '00000000-0000-0000-0000-000000000001', NOW(), NOW() + INTERVAL '365 days')",
        ("$JWT",)
    )
    conn.commit()
    cur.close()
    conn.close()
except Exception as e:
    print(f"Error: {e}")
    sys.exit(1)
