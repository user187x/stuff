#!/bin/bash
set -e

echo "==================================================="
echo " ☸️ Kubernetes PKI Secrets & App Provisioner"
echo "==================================================="

# 1. Gather Global Inputs
read -p " (?) Enter the base domain name (e.g., test.xxx): " DOMAIN
if [ -z "$DOMAIN" ]; then
 echo "Error: Domain cannot be empty."
 exit 1
fi

CERT_DIR="$PWD/certs"
if [ ! -d "$CERT_DIR" ]; then
 echo "Error: Directory $CERT_DIR does not exist. Please run cert-host-provision.sh first."
 exit 1
fi

read -p " (?) Enter the target Kubernetes namespace (default: default): " NAMESPACE
NAMESPACE=${NAMESPACE:-default}
SAFE_NAME="${DOMAIN//./-}"

# 2. Upsert Kubernetes Secrets
echo -e "\n--- [ Provisioning Secrets in '${NAMESPACE}' ] ---"
kubectl create namespace "${NAMESPACE}" >/dev/null 2>&1 || true

echo "[1/4] Upserting Server TLS Secret..."
kubectl create secret tls "${SAFE_NAME}-tls" --cert="${CERT_DIR}/server.crt" --key="${CERT_DIR}/server.key" --namespace="${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

echo "[2/4] Upserting Wildcard TLS Secret..."
kubectl create secret tls "${SAFE_NAME}-wildcard-tls" --cert="${CERT_DIR}/server-wildcard.crt" --key="${CERT_DIR}/server-wildcard.key" --namespace="${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

echo "[3/4] Upserting Certificate Authority (CA) Secret..."
kubectl create secret generic "${SAFE_NAME}-ca" --from-file=ca.crt="${CERT_DIR}/ca-cert.pem" --namespace="${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

echo "[4/4] Upserting Client TLS Secret..."
kubectl create secret tls "${SAFE_NAME}-client-tls" --cert="${CERT_DIR}/client.crt" --key="${CERT_DIR}/client.key" --namespace="${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -
echo "✅ Secrets Provisioned."

# 3. Application / Ingress Router Configuration
echo -e "\n==================================================="
echo " 🚀 Application Routing Configuration"
echo "==================================================="
echo "Select the application/ingress you wish to configure for ${DOMAIN}:"
echo "  1) Traefik (Legacy Opinionated Install)"
echo "  2) ArgoCD (Example Extension)"
echo "  3) Harbor (Example Extension)"
echo "  4) Skip / Secrets Only"
read -p "Select an option [1-4]: " APP_CHOICE

case $APP_CHOICE in
1)
 echo -e "\n--- [ Deploying Traefik ] ---"
 read -p "Enter the target Kubernetes Service name to route traffic to: " TARGET_SVC
 if [ -z "$TARGET_SVC" ]; then
  echo "Error: Target service name cannot be empty."
  exit 1
 fi

 read -p "Enter the target Kubernetes Service port (e.g., 80, 8080): " TARGET_PORT
 if [ -z "$TARGET_PORT" ]; then
  echo "Error: Target port cannot be empty."
  exit 1
 fi

 echo "Adding Traefik Helm repository..."
 helm repo add traefik https://helm.traefik.io/traefik >/dev/null 2>&1
 helm repo update >/dev/null

 echo "Installing/Upgrading Traefik via Helm..."
 helm upgrade --install traefik traefik/traefik \
  --namespace="${NAMESPACE}" \
  --set providers.kubernetesIngress.publishedService.enabled=true \
  --wait

 echo "Applying Traefik Ingress resource..."
 cat <<EOF | kubectl apply -f -
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ${SAFE_NAME}-ingress
  namespace: ${NAMESPACE}
  annotations:
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  ingressClassName: traefik
  tls:
  - hosts:
    - ${DOMAIN}
    secretName: ${SAFE_NAME}-tls
  rules:
  - host: ${DOMAIN}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: ${TARGET_SVC}
            port:
              number: ${TARGET_PORT}
EOF
 echo "✅ Traefik Ingress successfully deployed!"
 ;;

2)
 echo -e "\n--- [ Deploying ArgoCD ] ---"
 echo "To implement: Add ArgoCD helm upgrade command here."
 echo "To implement: Apply an Ingress or IngressRoute referencing secretName: ${SAFE_NAME}-tls"
 # TODO Example: helm upgrade --install argocd argo/argo-cd ...
 ;;

3)
 echo -e "\n--- [ Deploying Harbor ] ---"
 echo "To implement: Add Harbor helm upgrade command here."
 echo "To implement: Pass the ${SAFE_NAME}-tls secret into the harbor helm values file."
 # TODO Example: helm upgrade --install argocd argo/argo-cd ...
 ;;

4 | *)
 echo -e "\nSkipping application configuration. Secrets are ready to be consumed by your workloads."
 ;;
esac

echo -e "\n==================================================="
echo " ✅ Kubernetes Provisioning Complete!"
echo "==================================================="
