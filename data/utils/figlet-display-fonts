#!/bin/bash

# Ensure required dependencies are installed
for cmd in fzf figlet toilet; do
 if ! command -v "$cmd" &>/dev/null; then
  echo -e "\e[1;31mError: '$cmd' is not installed. Please install it first.\e[0m"
  exit 1
 fi
done

# Default values
TEXT="Preview"
CUSTOM_DIR=""

# Parse command-line arguments
while [[ "$#" -gt 0 ]]; do
 case $1 in
  -d | --directory)
   if [[ -n "$2" && -d "$2" ]]; then
    CUSTOM_DIR="$2"
    shift 2
   else
    echo -e "\e[1;31mError: Argument for $1 is missing or not a valid directory.\e[0m"
    exit 1
   fi
   ;;
  -h | --help)
   echo "Usage: $0 [-d|--directory <path>] [text_to_preview]"
   exit 0
   ;;
  *)
   TEXT="$1"
   shift
   ;;
 esac
done

export PREVIEW_TEXT="$TEXT"

# Determine which directories to search using an array
declare -a FONT_DIRS
if [[ -n "$CUSTOM_DIR" ]]; then
 FONT_DIRS=("$CUSTOM_DIR")
else
 # Default fallback directories
 FONT_DIRS=(/usr/share/figlet /usr/share/toilet /usr/share/figlet-fonts)

 # Dynamically add the system's default figlet directory if it exists
 default_figlet=$(figlet -I2 2>/dev/null)
 if [[ -n "$default_figlet" && -d "$default_figlet" ]]; then
  FONT_DIRS+=("$default_figlet")
 fi
fi

# Find all .flf (Figlet) and .tlf (Toilet) files
FONT_LIST=$(find "${FONT_DIRS[@]}" -type f \( -name "*.flf" -o -name "*.tlf" \) 2>/dev/null | sort -u)

if [ -z "$FONT_LIST" ]; then
 echo -e "\e[1;33mNo fonts found in the specified directories.\e[0m"
 exit 1
fi

# Launch FZF with TUI styling and a custom preview rendering function
SELECTED_FONT=$(echo "$FONT_LIST" | fzf \
 --layout=reverse \
 --border=rounded \
 --margin=1,2 \
 --padding=1 \
 --prompt="✨ Font: " \
 --pointer="▶" \
 --marker="✓" \
 --color="hl:yellow,hl+:yellow:reverse,pointer:cyan,info:magenta,prompt:green,border:blue" \
 --preview='
        file={}
        ext="${file##*.}"
        
        # Function to test rendering and print the header if successful
        try_render() {
            local engine="$1"
            local output
            
            # If the engine successfully generates the text, print header + text
            if output=$("$engine" -f "$file" "$PREVIEW_TEXT" 2>/dev/null); then
                echo -e "\e[1;34m╭──────────────────────────────────────────╮\e[0m"
                if [ "$engine" = "toilet" ]; then
                    echo -e "\e[1;34m│\e[0m  Engine: \e[1;36mTOILET\e[0m                          \e[1;34m│\e[0m"
                else
                    echo -e "\e[1;34m│\e[0m  Engine: \e[1;33mFIGLET\e[0m                          \e[1;34m│\e[0m"
                fi
                echo -e "\e[1;34m╰──────────────────────────────────────────╯\e[0m\n"
                
                echo "$output"
                return 0
            fi
            return 1
        }

        # Attempt primary engine based on extension, fallback to secondary
        if [ "$ext" = "tlf" ]; then
            try_render "toilet" || try_render "figlet" || echo -e "\e[1;31m[!] Unable to load font: $(basename "$file")\e[0m"
        else
            try_render "figlet" || try_render "toilet" || echo -e "\e[1;31m[!] Unable to load font: $(basename "$file")\e[0m"
        fi
    ' \
 --preview-window=up:70%:wrap:border-bottom)

# If the user made a selection, print the final result to the terminal
if [ -n "$SELECTED_FONT" ]; then
 ext="${SELECTED_FONT##*.}"
 font_name=$(basename "$SELECTED_FONT")

 echo -e "\n\e[1;34m══════════════════════════════════════════════════════\e[0m\n"

 if [ "$ext" = "tlf" ]; then
  if toilet -f "$SELECTED_FONT" "$TEXT" 2>/dev/null; then
   echo -e "\n\e[1;32m✓ Success\e[0m \e[2m(Command: toilet -f \"$font_name\" \"$TEXT\")\e[0m\n"
  elif figlet -f "$SELECTED_FONT" "$TEXT" 2>/dev/null; then
   echo -e "\n\e[1;32m✓ Success (Fallback)\e[0m \e[2m(Command: figlet -f \"$font_name\" \"$TEXT\")\e[0m\n"
  else
   echo -e "\e[1;31mError: Could not render font with either toilet or figlet.\e[0m"
  fi
 else
  if figlet -f "$SELECTED_FONT" "$TEXT" 2>/dev/null; then
   echo -e "\n\e[1;32m✓ Success\e[0m \e[2m(Command: figlet -f \"$font_name\" \"$TEXT\")\e[0m\n"
  elif toilet -f "$SELECTED_FONT" "$TEXT" 2>/dev/null; then
   echo -e "\n\e[1;32m✓ Success (Fallback)\e[0m \e[2m(Command: toilet -f \"$font_name\" \"$TEXT\")\e[0m\n"
  else
   echo -e "\e[1;31mError: Could not render font with either toilet or figlet.\e[0m"
  fi
 fi
fi
