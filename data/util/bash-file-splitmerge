#!/usr/bin/env bash

ACTION="$1"
TARGET="$2"

if [[ -z "$ACTION" || -z "$TARGET" ]]; then
 echo "Usage:"
 echo "  $0 --split <file>"
 echo "  $0 --combine <directory>"
 exit 1
fi

if [[ "$ACTION" == "--split" || "$ACTION" == "-s" ]]; then
 CHUNK_SIZE="45M"

 FILE="$TARGET"
 DIR_NAME="${FILE}-parts"
 BASE_NAME="$(basename "$FILE")"
 MANIFEST_FILE="$DIR_NAME/.manifest"

 mkdir -p "$DIR_NAME"

 FILE_SHA=$(sha256sum "$FILE" | awk '{print $1}')
 FILE_SIZE=$(wc -c <"$FILE" | awk '{print $1}')
 TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

 split -b "$CHUNK_SIZE" -a 4 -d "$FILE" "$DIR_NAME/${BASE_NAME}.part"
 PART_COUNT=$(ls -1q "$DIR_NAME"/*.part* | wc -l | awk '{print $1}')

 cat <<EOF >"$MANIFEST_FILE"
ORIGINAL_FILE=$FILE
ORIGINAL_SIZE=$FILE_SIZE
ORIGINAL_SHA256=$FILE_SHA
TOTAL_PARTS=$PART_COUNT
SPLIT_TIMESTAMP=$TIMESTAMP
EOF
 echo "Success! '$FILE' split into $PART_COUNT parts."

elif [[ "$ACTION" == "--combine" || "$ACTION" == "-c" ]]; then
 DIR_NAME="${TARGET%/}"
 MANIFEST_FILE="$DIR_NAME/.manifest"

 if [[ ! -f "$MANIFEST_FILE" ]]; then
  echo "⚠️ Warning: No .manifest found in '$DIR_NAME'. Skipping."
  exit 1
 fi

 ORIGINAL_FILE=$(grep "^ORIGINAL_FILE=" "$MANIFEST_FILE" | cut -d'=' -f2-)
 EXPECTED_SHA=$(grep "^ORIGINAL_SHA256=" "$MANIFEST_FILE" | cut -d'=' -f2)
 EXPECTED_SIZE=$(grep "^ORIGINAL_SIZE=" "$MANIFEST_FILE" | cut -d'=' -f2)
 EXPECTED_PARTS=$(grep "^TOTAL_PARTS=" "$MANIFEST_FILE" | cut -d'=' -f2)

 ACTUAL_PARTS=$(ls -1q "$DIR_NAME"/*.part* 2>/dev/null | wc -l | awk '{print $1}')

 if [[ "$ACTUAL_PARTS" != "$EXPECTED_PARTS" ]]; then
  echo "❌ Error: Part count mismatch for '$ORIGINAL_FILE' (Expected: $EXPECTED_PARTS, Found: $ACTUAL_PARTS)."
  exit 1
 fi

 echo "Combining $EXPECTED_PARTS parts for '$ORIGINAL_FILE'..."
 cat "$DIR_NAME"/*.part* >"$ORIGINAL_FILE"

 NEW_SIZE=$(wc -c <"$ORIGINAL_FILE" | awk '{print $1}')
 NEW_SHA=$(sha256sum "$ORIGINAL_FILE" | awk '{print $1}')

 if [[ "$EXPECTED_SHA" == "$NEW_SHA" && "$EXPECTED_SIZE" == "$NEW_SIZE" ]]; then
  echo "✅ '$ORIGINAL_FILE' successfully restored!"
 else
  echo "❌ Error: Integrity check FAILED for '$ORIGINAL_FILE'."
  rm -f "$ORIGINAL_FILE"
  exit 1
 fi
else
 echo "Unknown action: $ACTION"
 exit 1
fi
