#!/usr/bin/env bash
# =============================================================================
#  desktop-zero-to-hero.sh
#
#  Zero-to-hero installer for a web-accessible Linux DESKTOP inside any
#  Coder workspace, Kubernetes pod, or plain Linux container/VM.
#
#  Mirrors the spirit of Coder's filebrowser doc -- a single binary that
#  serves itself over HTTP -- but for a full graphical desktop.
#
#    coder/filebrowser  : web file manager,  one process,  one port
#    this script (Kasm) : web XFCE desktop,  one process,  one port
#
#  KasmVNC (https://github.com/kasmtech/KasmVNC) bundles in ONE package:
#     - X server (Xvnc)
#     - websocket bridge
#     - HTTPS web server
#     - modernized noVNC web client (built in)
#  No noVNC sidecar, no nginx proxy, no Xvfb juggling. Install, start, browse.
#
#  Tested base images: ubuntu:22.04, ubuntu:24.04, debian:12,
#                      rockylinux:9, fedora:40, alpine:3.21
#
#  USAGE
#  -----
#     # As root, in a fresh container:
#     curl -fsSL <url-to-this-script> | bash
#
#     # Or with overrides:
#     VNC_PASSWORD='hunter2' DESKTOP=mate ./desktop-zero-to-hero.sh
#
#  ENV TUNABLES
#  ------------
#     VNC_USER         web username                     (default: kasm_user)
#     VNC_PASSWORD     web password                     (default: password)
#     VNC_PORT         single TCP port for everything   (default: 6901)
#     VNC_DISPLAY      X DISPLAY number                 (default: 1)
#     VNC_RESOLUTION   initial WxH                      (default: 1280x720)
#     KASMVNC_VERSION  pinned KasmVNC release           (default: 1.4.0)
#     DESKTOP          xfce | mate | lxde | lxqt        (default: xfce)
#     SKIP_INSTALL     1 = skip apt/dnf, just (re)start (default: unset)
# =============================================================================

set -euo pipefail

# ---------------- defaults --------------------------------------------------
VNC_USER="${VNC_USER:-kasm_user}"
VNC_PASSWORD="${VNC_PASSWORD:-password}"
VNC_PORT="${VNC_PORT:-6901}"
VNC_DISPLAY="${VNC_DISPLAY:-1}"
VNC_RESOLUTION="${VNC_RESOLUTION:-1280x720}"
KASMVNC_VERSION="${KASMVNC_VERSION:-1.4.0}"
DESKTOP="${DESKTOP:-xfce}"
SKIP_INSTALL="${SKIP_INSTALL:-}"

# ---------------- pretty printing -------------------------------------------
c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_b=$'\033[1;34m'; c_x=$'\033[0m'
log()  { printf '%s[+]%s %s\n' "$c_g" "$c_x" "$*"; }
info() { printf '%s[i]%s %s\n' "$c_b" "$c_x" "$*"; }
warn() { printf '%s[!]%s %s\n' "$c_y" "$c_x" "$*"; }
die()  { printf '%s[x]%s %s\n' "$c_r" "$c_x" "$*" >&2; exit 1; }

# ---------------- platform detection ----------------------------------------
detect_platform() {
    [ -r /etc/os-release ] || die "/etc/os-release not found; cannot detect distro."
    # shellcheck disable=SC1091
    . /etc/os-release
    OS_ID="${ID:-}"
    OS_LIKE="${ID_LIKE:-}"
    OS_VER="${VERSION_ID:-}"
    OS_CODENAME="${VERSION_CODENAME:-${UBUNTU_CODENAME:-}}"

    case "$(uname -m)" in
        x86_64|amd64)  ARCH=amd64; RPM_ARCH=x86_64;  APK_ARCH=x86_64  ;;
        aarch64|arm64) ARCH=arm64; RPM_ARCH=aarch64; APK_ARCH=aarch64 ;;
        *) die "Unsupported CPU arch: $(uname -m)" ;;
    esac

    SUDO=""
    if [ "$(id -u)" -ne 0 ]; then
        command -v sudo >/dev/null 2>&1 || die "must run as root or have sudo"
        SUDO="sudo"
    fi

    # Family: debian | rhel | alpine
    case "$OS_ID" in
        ubuntu|debian|kali|linuxmint|pop|raspbian) FAMILY=debian ;;
        fedora|rhel|rocky|almalinux|ol|oraclelinux|centos) FAMILY=rhel ;;
        alpine) FAMILY=alpine ;;
        *)
            case "$OS_LIKE" in
                *debian*|*ubuntu*) FAMILY=debian ;;
                *rhel*|*fedora*)   FAMILY=rhel   ;;
                *) die "Unsupported distro: $OS_ID (ID_LIKE='$OS_LIKE')" ;;
            esac
            ;;
    esac

    log "Platform: ${PRETTY_NAME:-$OS_ID $OS_VER} | family=$FAMILY | arch=$ARCH"
}

# ---------------- KasmVNC asset URL discovery -------------------------------
#
# Asset names on the GitHub release page look like:
#   kasmvncserver_bookworm_1.4.0_amd64.deb     (Debian 12)
#   kasmvncserver_jammy_1.4.0_arm64.deb        (Ubuntu 22.04)
#   kasmvncserver_oracle_9_1.4.0_x86_64.rpm    (RHEL/Rocky/Alma 9, Oracle 9)
#   kasmvncserver_fedora_40_1.4.0_x86_64.rpm
#   kasmvncserver_alpine_321_1.4.0_x86_64.apk  (Alpine 3.21)
#
# Naming is occasionally adjusted between releases, so we ask the GitHub
# release API to enumerate assets and grep for ones that match our platform.
# That makes this script robust against minor renames.

pick_asset_url() {
    local pattern="$1"
    local api="https://api.github.com/repos/kasmtech/KasmVNC/releases/tags/v${KASMVNC_VERSION}"
    local urls
    urls="$(curl -fsSL "$api" | grep -oE '"browser_download_url":[[:space:]]*"[^"]+"' \
            | sed -E 's/.*"(https:[^"]+)".*/\1/')" \
        || die "could not query KasmVNC release list at $api"
    # First match wins -- patterns below are tight enough to be unambiguous.
    echo "$urls" | grep -Ei "$pattern" | head -n1
}

# ---------------- install: Debian / Ubuntu ----------------------------------
install_debian() {
    export DEBIAN_FRONTEND=noninteractive
    log "apt-get update + base packages"
    $SUDO apt-get update -qq
    $SUDO apt-get install -y --no-install-recommends \
        ca-certificates curl xauth ssl-cert sudo procps libnss-wrapper \
        dbus-x11 locales tzdata
    case "$DESKTOP" in
        xfce) $SUDO apt-get install -y --no-install-recommends \
                xfce4 xfce4-terminal xfce4-goodies ;;
        mate) $SUDO apt-get install -y --no-install-recommends \
                mate-desktop-environment-core mate-terminal ;;
        lxde) $SUDO apt-get install -y --no-install-recommends \
                lxde-core lxterminal ;;
        lxqt) $SUDO apt-get install -y --no-install-recommends \
                lxqt-core qterminal ;;
        *) die "Unknown DESKTOP=$DESKTOP" ;;
    esac

    local cn="$OS_CODENAME"
    [ -n "$cn" ] || cn="bookworm"
    local pat="kasmvncserver_${cn}_${KASMVNC_VERSION}_${ARCH}\\.deb$"
    local url; url="$(pick_asset_url "$pat" || true)"
    if [ -z "$url" ]; then
        warn "no exact deb for codename '$cn'; falling back to any ${ARCH}.deb"
        url="$(pick_asset_url "_${KASMVNC_VERSION}_${ARCH}\\.deb$" || true)"
    fi
    [ -n "$url" ] || die "could not find a KasmVNC .deb for $cn/$ARCH at v$KASMVNC_VERSION"

    local tmp; tmp="$(mktemp -d)"
    log "Downloading $(basename "$url")"
    curl -fL --retry 3 -o "$tmp/kasm.deb" "$url"
    log "Installing KasmVNC"
    $SUDO apt-get install -y "$tmp/kasm.deb"
    rm -rf "$tmp"
}

# ---------------- install: RHEL / Fedora ------------------------------------
install_rhel() {
    log "dnf install base packages + desktop"
    $SUDO dnf install -y --setopt=install_weak_deps=False \
        curl ca-certificates xorg-x11-xauth procps-ng dbus-x11 sudo \
        glibc-langpack-en tzdata || true
    $SUDO dnf install -y epel-release || true
    case "$DESKTOP" in
        xfce) $SUDO dnf groupinstall -y "Xfce" 2>/dev/null \
              || $SUDO dnf install -y @xfce-desktop-environment ;;
        mate) $SUDO dnf groupinstall -y "MATE Desktop" 2>/dev/null \
              || $SUDO dnf install -y @mate-desktop ;;
        lxde) $SUDO dnf groupinstall -y "LXDE Desktop" 2>/dev/null \
              || $SUDO dnf install -y @lxde-desktop ;;
        lxqt) $SUDO dnf groupinstall -y "LXQt Desktop" 2>/dev/null \
              || $SUDO dnf install -y @lxqt-desktop ;;
        *) die "Unknown DESKTOP=$DESKTOP" ;;
    esac

    local tag major="${OS_VER%%.*}"
    case "$OS_ID" in
        fedora)                              tag="fedora_${OS_VER}" ;;
        rocky|almalinux|rhel|centos|ol|oraclelinux) tag="oracle_${major}" ;;
        *) tag="oracle_${major}" ;;
    esac
    local pat="kasmvncserver_${tag}_${KASMVNC_VERSION}_${RPM_ARCH}\\.rpm$"
    local url; url="$(pick_asset_url "$pat" || true)"
    if [ -z "$url" ]; then
        warn "no exact rpm for tag '$tag'; falling back to any ${RPM_ARCH}.rpm"
        url="$(pick_asset_url "_${KASMVNC_VERSION}_${RPM_ARCH}\\.rpm$" || true)"
    fi
    [ -n "$url" ] || die "could not find a KasmVNC .rpm for $tag/$RPM_ARCH at v$KASMVNC_VERSION"
    log "Installing KasmVNC from $url"
    $SUDO dnf install -y "$url"
}

# ---------------- install: Alpine -------------------------------------------
install_alpine() {
    $SUDO apk update
    $SUDO apk add --no-cache curl ca-certificates xauth procps sudo \
        dbus-x11 tzdata
    case "$DESKTOP" in
        xfce) $SUDO apk add --no-cache xfce4 xfce4-terminal ;;
        lxqt) $SUDO apk add --no-cache lxqt qterminal ;;
        *) warn "Alpine: defaulting to xfce4 (DESKTOP=$DESKTOP not packaged)"; \
           $SUDO apk add --no-cache xfce4 xfce4-terminal; DESKTOP=xfce ;;
    esac

    # Alpine codename in asset names looks like alpine_321 for 3.21.x
    local short="${OS_VER//./}"; short="${short:0:3}"
    local pat="kasmvncserver_alpine_${short}_${KASMVNC_VERSION}_${APK_ARCH}\\.apk$"
    local url; url="$(pick_asset_url "$pat" || true)"
    if [ -z "$url" ]; then
        warn "no exact apk for alpine_${short}; falling back to any ${APK_ARCH}.apk"
        url="$(pick_asset_url "_${KASMVNC_VERSION}_${APK_ARCH}\\.apk$" || true)"
    fi
    [ -n "$url" ] || die "could not find a KasmVNC .apk for alpine_${short}/${APK_ARCH}"
    local tmp; tmp="$(mktemp -d)"
    log "Downloading $(basename "$url")"
    curl -fL --retry 3 -o "$tmp/kasm.apk" "$url"
    $SUDO apk add --allow-untrusted "$tmp/kasm.apk"
    rm -rf "$tmp"
}

install_kasm() {
    [ -n "$SKIP_INSTALL" ] && { info "SKIP_INSTALL set; skipping package install"; return; }
    case "$FAMILY" in
        debian) install_debian ;;
        rhel)   install_rhel   ;;
        alpine) install_alpine ;;
    esac
    command -v vncserver >/dev/null 2>&1 \
        || die "vncserver missing after install -- something went wrong"
    log "KasmVNC installed: $(vncserver -version 2>&1 | head -n1 || echo unknown)"
}

# ---------------- configure -------------------------------------------------
configure_kasm() {
    local home; home="$(getent passwd "$(id -un)" | cut -d: -f6)"
    [ -d "$home" ] || die "could not resolve home directory"
    mkdir -p "$home/.vnc"

    # User-level kasmvnc.yaml: plain HTTP, single port, no client TLS.
    # If you want HTTPS, drop `require_ssl: false` and KasmVNC self-signs.
    local w="${VNC_RESOLUTION%x*}" h="${VNC_RESOLUTION#*x}"
    cat > "$home/.vnc/kasmvnc.yaml" <<EOF
network:
  protocol: http
  websocket_port: ${VNC_PORT}
  ssl:
    require_ssl: false
desktop:
  resolution:
    width: ${w}
    height: ${h}
  allow_resize: true
runtime_configuration:
  allow_client_to_override_kasm_server_settings: true
EOF

    # Pre-seed the kasmvnc password so first run is not interactive.
    log "Provisioning KasmVNC user '$VNC_USER'"
    printf '%s\n%s\n' "$VNC_PASSWORD" "$VNC_PASSWORD" \
        | vncpasswd -u "$VNC_USER" -w -o >/dev/null

    # xstartup picks the desktop session.
    case "$DESKTOP" in
        xfce) printf '#!/bin/sh\nexec dbus-launch --exit-with-session startxfce4\n' \
                > "$home/.vnc/xstartup" ;;
        mate) printf '#!/bin/sh\nexec dbus-launch --exit-with-session mate-session\n' \
                > "$home/.vnc/xstartup" ;;
        lxde) printf '#!/bin/sh\nexec dbus-launch --exit-with-session startlxde\n' \
                > "$home/.vnc/xstartup" ;;
        lxqt) printf '#!/bin/sh\nexec dbus-launch --exit-with-session startlxqt\n' \
                > "$home/.vnc/xstartup" ;;
    esac
    chmod +x "$home/.vnc/xstartup"
}

# ---------------- start -----------------------------------------------------
start_kasm() {
    log "Starting KasmVNC on display :${VNC_DISPLAY} (port ${VNC_PORT})"
    vncserver -kill ":${VNC_DISPLAY}" >/dev/null 2>&1 || true
    # -select-de tells KasmVNC which desktop to launch; it overrides xstartup.
    vncserver ":${VNC_DISPLAY}" \
        -select-de "${DESKTOP}" \
        -websocketPort "${VNC_PORT}" \
        -geometry "${VNC_RESOLUTION}" \
        -depth 24

    # Wait for the listener to come up so the script's exit means "ready".
    local _i
    for _i in $(seq 1 30); do
        if (echo > "/dev/tcp/127.0.0.1/${VNC_PORT}") >/dev/null 2>&1; then
            log "Port ${VNC_PORT} is accepting connections."
            return
        fi
        sleep 1
    done
    warn "port ${VNC_PORT} did not open within 30s; check ~/.vnc/*.log"
}

# ---------------- summary ---------------------------------------------------
print_summary() {
    cat <<EOF

──────────────────────────────────────────────────────────────────────────
${c_g} Web desktop is running.${c_x}

   URL  : http://<pod-ip-or-host>:${VNC_PORT}
   user : ${VNC_USER}
   pass : ${VNC_PASSWORD}

   Logs : ~/.vnc/*.log
   Stop : vncserver -kill :${VNC_DISPLAY}
   Start: vncserver  :${VNC_DISPLAY} -select-de ${DESKTOP} \\
                     -websocketPort ${VNC_PORT} -geometry ${VNC_RESOLUTION}

──────────────────────────────────────────────────────────────────────────
 Coder template snippet (drop in main.tf next to your coder_agent):

   resource "coder_app" "desktop" {
     agent_id     = coder_agent.main.id
     slug         = "desktop"
     display_name = "Desktop"
     icon         = "/icon/desktop.svg"
     url          = "http://localhost:${VNC_PORT}"
     subdomain    = true                # required: full-screen iframe
     share        = "owner"
     healthcheck {
       url       = "http://localhost:${VNC_PORT}"
       interval  = 5
       threshold = 6
     }
   }

 Kubernetes service snippet (if you expose the pod directly):

   apiVersion: v1
   kind: Service
   metadata: { name: desktop }
   spec:
     selector: { app: workspace }
     ports:
       - name: web
         port: ${VNC_PORT}
         targetPort: ${VNC_PORT}
──────────────────────────────────────────────────────────────────────────
EOF
}

main() {
    detect_platform
    install_kasm
    configure_kasm
    start_kasm
    print_summary
}
main "$@"
