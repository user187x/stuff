#!/bin/bash

set -e

# Define the Ghidra installation path so the MCP server knows where to look
export GHIDRA_DIR="/opt/ghidra"

function install_mcp_server {
 echo "Installing system prerequisites..."
 sudo apt update && sudo apt install -y openjdk-21-jdk maven python3 python3-pip curl jq unzip git

 echo "Installing 'uv' for safe Python dependency management..."
 curl -LsSf https://astral.sh/uv/install.sh | sh
 export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

 echo "Cloning Ghidra MCP repository..."
 if [ ! -d "ghidra-mcp" ]; then
  git clone https://github.com/bethington/ghidra-mcp.git
 fi
 cd ghidra-mcp

 echo "Building plugin and deploying to Ghidra profile..."
 python3 -m tools.setup ensure-prereqs --ghidra-path "$GHIDRA_DIR"
 python3 -m tools.setup build
 python3 -m tools.setup deploy --ghidra-path "$GHIDRA_DIR"

 echo "========================================================"
 echo "Starting Streamable HTTP Bridge..."
 echo "MCP URL: http://127.0.0.1:8081/mcp"
 echo "========================================================"
 # Note: This will block the terminal as it runs the server
 uv run bridge-mcp-ghidra --transport streamable-http --mcp-host 127.0.0.1 --mcp-port 8081
}

function install_ghidra {
 DOWNLOAD_URL=$(curl -s https://api.github.com/repos/NationalSecurityAgency/ghidra/releases/latest | grep "browser_download_url" | grep ".zip" | cut -d '"' -f 4)

 # 1. Download the zip archive to the /tmp directory
 curl -L "$DOWNLOAD_URL" -o /tmp/ghidra.zip

 # 2. Extract the contents of the zip file into /opt
 sudo unzip -q /tmp/ghidra.zip -d /opt

 # 3. Remove any existing Ghidra installation at /opt/ghidra to prevent conflicts
 sudo rm -rf /opt/ghidra

 # 4. Rename the extracted version-specific directory to a static path
 sudo mv /opt/ghidra_* /opt/ghidra

 # Grant user ownership so plugins can be deployed without sudo
 sudo chown -R $USER:$USER /opt/ghidra

 # 5. Create a global symbolic link to make the 'ghidra' command executable from anywhere
 sudo ln -sf /opt/ghidra/ghidraRun /usr/local/bin/ghidra

 # 6. Clean up the temporary download file
 rm /tmp/ghidra.zip
}

# Run the Ghidra installation
install_ghidra

# Prompt the user to install the MCP server
read -rp "Install ghidra-mcp-server? (y/n) : " input
if [[ "$input" == "y" ]]; then
 install_mcp_server
fi
