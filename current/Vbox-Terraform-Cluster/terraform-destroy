#!/usr/bin/env bash
# terraform-destroy
#
# Tear down everything terraform-apply created:
#   1. `terraform destroy` (kills VMs via the destroy provisioner in main.tf)
#   2. Sweep up any VMs Terraform missed (matching talos-cp-* / talos-worker-*)
#   3. Clear our DHCP reservations
#
# Safe to re-run.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

HOSTONLY_NET="${HOSTONLY_NET:-vboxnet0}"
DHCP_NET_NAME="HostInterfaceNetworking-${HOSTONLY_NET}"

GREEN='\033[0;32m'; BLUE='\033[0;34m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
log_success() { echo -e "${GREEN}[OK]${NC}   $*"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }

# ---------- 1. terraform destroy ----------
if [[ -f terraform.tfstate ]] || [[ -d .terraform ]]; then
  log_info "Running terraform destroy..."
  terraform destroy -auto-approve || log_warn "terraform destroy reported errors; continuing to manual sweep."
else
  log_warn "No terraform state found; skipping terraform destroy."
fi

# ---------- 2. Manual VM sweep ----------
# Catches VMs Terraform doesn't know about (e.g. left over from a crashed
# apply). Matches the deterministic naming scheme from terraform-apply.
log_info "Sweeping for stray VMs (talos-cp-*, talos-worker-*)..."
stray=$(VBoxManage list vms 2>/dev/null \
        | awk -F'"' '{print $2}' \
        | grep -E '^talos-(cp|worker)-[0-9]+$' || true)
if [[ -n "$stray" ]]; then
  while IFS= read -r vm; do
    log_info "  removing $vm"
    VBoxManage controlvm "$vm" poweroff >/dev/null 2>&1 || true
    sleep 1
    VBoxManage unregistervm "$vm" --delete >/dev/null 2>&1 || true
  done <<<"$stray"
else
  log_info "  no stray VMs."
fi

# ---------- 3. DHCP reservations ----------
# Best-effort: remove fixed-address entries for the MAC ranges this
# project uses (08:00:27:CC:**:00 for CP, 08:00:27:77:**:00 for worker).
if VBoxManage list dhcpservers 2>/dev/null | grep -q "^NetworkName: *${DHCP_NET_NAME}$"; then
  log_info "Clearing DHCP reservations on ${HOSTONLY_NET}..."
  for prefix in CC 77; do
    for i in $(seq 0 31); do
      mac=$(printf "08:00:27:%s:%02X:00" "$prefix" "$i")
      VBoxManage dhcpserver modify --network="$DHCP_NET_NAME" \
        --mac-address="$mac" --remove-config >/dev/null 2>&1 || true
    done
  done
fi

# ---------- 4. Local artifacts ----------
rm -f kubeconfig talosconfig terraform.tfvars.json
log_info "Removed kubeconfig, talosconfig, terraform.tfvars.json."

log_success "Cluster torn down."
echo
echo "Note: the host-only interface (${HOSTONLY_NET}) and DHCP server are"
echo "left in place since they're harmless and other projects may use them."
echo "To remove them yourself:"
echo "  VBoxManage dhcpserver remove --network=${DHCP_NET_NAME}"
echo "  VBoxManage hostonlyif remove ${HOSTONLY_NET}"
