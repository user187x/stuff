#!/usr/bin/env bash

VERSION="1.0.0"
CONFIG_DIR="${CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cert-manager}"
CONFIG_FILE="$CONFIG_DIR/config"
INFO_DIR="$CONFIG_DIR/entries"
INSTALL_DIR="$HOME/.local/bin"
PASS_PREFIX="${PASS_PREFIX:-cert-manager}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/cert-manager-$(id -u)"
STORE_DIR="${PASSWORD_STORE_DIR:-$HOME/.password-store}"

# Runtime Configurable (persisted in $CONFIG_FILE)
DEFAULT_TIMEOUT="8h"
DEFAULT_ENTRY=""
PURGE_GPG_CACHE="yes"

if [[ -t 1 ]]; then
 COLOR_R=$'\e[31m' COLOR_G=$'\e[32m' COLOR_Y=$'\e[33m' COLOR_B=$'\e[34m'
 COLOR_C=$'\e[36m' COLOR_D=$'\e[2m' COLOR_BO=$'\e[1m' COLOR_N=$'\e[0m'
else
 COLOR_R="" COLOR_G="" COLOR_Y="" COLOR_B="" COLOR_C="" COLOR_D="" COLOR_BO="" COLOR_N=""
fi

function install-system {

 local THIS_PATH
 THIS_PATH=$(realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null || readlink -f "${BASH_SOURCE[0]:-$0}")

 if [[ -z "$THIS_PATH" || ! -f "$THIS_PATH" ]]; then
  echo "Error: Could not determine the source script path." >&2
  return 1
 fi

 local script_name
 script_name=$(basename "$THIS_PATH")
 local target_path="$INSTALL_DIR/$script_name"

 echo "Starting installation of '$script_name'..."

 # Ensure the target directory exists
 if [[ ! -d "$INSTALL_DIR" ]]; then
  echo "Creating target directory at $INSTALL_DIR..."
  mkdir -p "$INSTALL_DIR" || {
   echo "Error: Failed to create directory $INSTALL_DIR." >&2
   return 1
  }
 fi

 # Check if it's already running from the target path to prevent overwriting itself during normal use
 if [[ "$THIS_PATH" == "$target_path" ]]; then
  echo "Script is already installed and running from $target_path. No action needed."
  return 0
 fi

 # Copy the script to the target directory
 echo "Copying to $target_path..."
 if cp "$THIS_PATH" "$target_path"; then
  # Ensure the installed script is executable
  chmod +x "$target_path"
  echo "Successfully installed '$script_name' to $INSTALL_DIR."

  # Check if the target directory is currently in the user's PATH
  if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
   echo ""
   echo "Warning: $INSTALL_DIR is not currently in your \$PATH."
   echo "To use this script globally, add the following line to your ~/.bashrc, ~/.zshrc, or ~/.profile:"
   echo "    export PATH=\"$INSTALL_DIR:\$PATH\""
  fi
 else
  echo "Error: Failed to copy the script to $INSTALL_DIR." >&2
  return 1
 fi
}

function ok { printf '%s✔%s %s\n' "$COLOR_G" "$COLOR_N" "$*"; }
function info { printf '%s•%s %s\n' "$COLOR_B" "$COLOR_N" "$*"; }
function warn { printf '%s!%s %s\n' "$COLOR_Y" "$COLOR_N" "$*" >&2; }
function err { printf '%s✘ %s%s\n' "$COLOR_R" "$*" "$COLOR_N" >&2; }

function load_config {

 DEFAULT_TIMEOUT="8h"
 DEFAULT_ENTRY=""
 PURGE_GPG_CACHE="yes"
 [[ -f "$CONFIG_FILE" ]] || return 0
 local k v
 while IFS='=' read -r k v; do
  case "$k" in
   default_timeout) DEFAULT_TIMEOUT="$v" ;;
   default_entry) DEFAULT_ENTRY="$v" ;;
   purge_gpg_cache) PURGE_GPG_CACHE="$v" ;;
  esac
 done <"$CONFIG_FILE"
}

function save_config {

 mkdir -p "$CONFIG_DIR" && chmod 700 "$CONFIG_DIR"
 printf 'default_timeout=%s\ndefault_entry=%s\npurge_gpg_cache=%s\n' \
  "$DEFAULT_TIMEOUT" "$DEFAULT_ENTRY" "$PURGE_GPG_CACHE" >"$CONFIG_FILE"
 chmod 600 "$CONFIG_FILE"
}

function info_file { printf '%s/%s.info' "$INFO_DIR" "$1"; }

function info_get {
 local f
 f=$(info_file "$1")
 [[ -f $f ]] && grep -m1 "^$2=" "$f" | cut -d= -f2-
}

function info_set {
 local f tmp
 f=$(info_file "$1")
 mkdir -p "$INFO_DIR"
 chmod 700 "$INFO_DIR"
 tmp=$(mktemp) || return 1
 [[ -f $f ]] && grep -v "^$2=" "$f" >"$tmp"
 printf '%s=%s\n' "$2" "$3" >>"$tmp"
 mv "$tmp" "$f" && chmod 600 "$f"
}

function entry_path { printf '%s/%s' "$PASS_PREFIX" "$1"; }
function entry_exists { [[ -f "$STORE_DIR/$PASS_PREFIX/$1.gpg" ]]; }
function entries { ls "$STORE_DIR/$PASS_PREFIX" 2>/dev/null | sed -n 's/\.gpg$//p'; }
function rt { printf '%s/%s.%s' "$RUNTIME_DIR" "$1" "$2"; } # name kind
function now { date +%s; }
function fmt_ts { date -d "@$1" '+%Y-%m-%d %H:%M:%S %Z'; }
function human_size { numfmt --to=iec-i --suffix=B "$1" 2>/dev/null || printf '%s B' "$1"; }

function parse_duration {
 local s="${1,,}" total=0 n u
 [[ -z "$s" ]] && return 1
 if [[ "$s" =~ ^[0-9]+$ ]]; then
  echo $((s * 3600))
  return 0
 fi
 while [[ -n "$s" ]]; do
  [[ "$s" =~ ^([0-9]+)([dhms]) ]] || return 1
  n=${BASH_REMATCH[1]}
  u=${BASH_REMATCH[2]}
  case $u in
   d) total=$((total + n * 86400)) ;;
   h) total=$((total + n * 3600)) ;;
   m) total=$((total + n * 60)) ;;
   s) total=$((total + n)) ;;
  esac
  s=${s#"${BASH_REMATCH[0]}"}
 done
 ((total > 0)) || return 1
 echo "$total"
}

function fmt_dur {
 local t=$1 d h m s out=""
 ((t < 0)) && t=0
 d=$((t / 86400))
 h=$((t % 86400 / 3600))
 m=$((t % 3600 / 60))
 s=$((t % 60))
 ((d)) && out+="${d}d "
 ((d || h)) && out+="${h}h "
 ((d || h || m)) && out+="${m}m "
 out+="${s}s"
 printf '%s' "$out"
}

function fmt_clock {
 local t=$1
 ((t < 0)) && t=0
 printf '%02d:%02d:%02d' $((t / 3600)) $((t % 3600 / 60)) $((t % 60))
}

function bar {
 local rem=$1 tot=$2 w=${3:-40} pct filled empty col
 ((tot <= 0)) && tot=1
 ((rem < 0)) && rem=0
 pct=$((rem * 100 / tot))
 ((pct > 100)) && pct=100
 filled=$((w * pct / 100))
 empty=$((w - filled))
 if ((pct > 50)); then
  col=$G
 elif ((pct > 20)); then
  col=$Y
 else col=$R; fi
 printf '%s[%s' "$D" "$N"
 printf '%s' "$col"
 printf '%*s' "$filled" '' | tr ' ' '█'
 printf '%s' "$D"
 printf '%*s' "$empty" '' | tr ' ' '░'
 printf '%s]%s %3d%%' "$D" "$N" "$pct"
}

function ensure_deps {

 [[ -n "${DEPS_OK:-}" ]] && return 0
 local missing=() sudo=""
 command -v pass >/dev/null 2>&1 || missing+=(pass)
 command -v gpg >/dev/null 2>&1 || missing+=(gnupg)
 command -v openssl >/dev/null 2>&1 || missing+=(openssl)
 command -v curl >/dev/null 2>&1 || missing+=(curl)

 if ((${#missing[@]})); then
  warn "Missing packages: ${missing[*]} — installing with apt-get"
  if ! command -v apt-get >/dev/null 2>&1; then
   err "apt-get not available. Please install manually: ${missing[*]}"
   return 1
  fi
  [[ $EUID -ne 0 ]] && sudo=sudo
  $sudo apt-get update -qq && $sudo apt-get install -y -qq "${missing[@]}" ||
   {
    err "Package installation failed"
    return 1
   }
  ok "Installed: ${missing[*]}"
 fi

 if ! gpg --list-secret-keys --with-colons 2>/dev/null | grep -q '^sec'; then
  warn "No GPG secret key found — pass needs one to encrypt certificate entries."
  local ans gname gmail
  read -rp "Generate a GPG key now? [Y/n] " ans
  if [[ ! $ans =~ ^[Nn] ]]; then
   read -rp "  Real name : " gname
   read -rp "  Email     : " gmail
   gpg --quick-generate-key "$gname <$gmail>" default default 0 ||
    {
     err "GPG key generation failed"
     return 1
    }
   ok "GPG key created"
  else
   err "Cannot continue without a GPG key"
   return 1
  fi
 fi

 if [[ ! -f "$STORE_DIR/.gpg-id" ]]; then
  local fpr
  fpr=$(gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '/^fpr/{print $10; exit}')
  info "Initialising password store with GPG key $fpr"
  pass init "$fpr" >/dev/null || {
   err "pass init failed"
   return 1
  }
 fi

 mkdir -p "$CONFIG_DIR" "$INFO_DIR" "$RUNTIME_DIR"
 chmod 700 "$CONFIG_DIR" "$INFO_DIR" "$RUNTIME_DIR"
 DEPS_OK=1
}

function kill_timer {

 local pid
 pid=$(grep -m1 '^timer_pid=' "$(rt "$1" meta)" 2>/dev/null | cut -d= -f2)
 [[ -n $pid ]] && kill "$pid" 2>/dev/null
 return 0
}

function spawn_timer {

 local name=$1 secs=$2 info
 info=$(info_file "$name")
 (
  nohup bash -c '
      sleep "$1"
      rm -f "$2/$3.pw" "$2/$3.pem" "$2/$3.meta"
      if [ -f "$4" ]; then
        grep -v "^last_locked=" "$4" > "$4.tmp" 2>/dev/null
        printf "last_locked=%s (auto)\n" "$(date -Is)" >> "$4.tmp"
        mv "$4.tmp" "$4"
      fi' _ "$secs" "$RUNTIME_DIR" "$name" "$info" >/dev/null 2>&1 &
  echo $!
 )
}

function wipe_runtime {

 local f
 for f in pw pem meta; do
  f=$(rt "$1" "$f")
  [[ -f $f ]] && { command -v shred >/dev/null && shred -u "$f" 2>/dev/null || rm -f "$f"; }
 done
}

function meta_get { grep -m1 "^$2=" "$(rt "$1" meta)" 2>/dev/null | cut -d= -f2; }

function is_unlocked {
 local name=$1 exp
 [[ -f "$(rt "$name" meta)" && -f "$(rt "$name" pw)" ]] || return 1
 exp=$(meta_get "$name" expires_at)
 if [[ -z $exp ]] || (($(now) >= exp)); then
  kill_timer "$name"
  wipe_runtime "$name"
  info_set "$name" last_locked "$(date -Is) (auto)"
  return 1
 fi
 return 0
}

function require_unlocked {
 is_unlocked "$1" && return 0
 err "'$1' is locked. Run:  cert-manager unlock $1 [duration]"
 return 1
}

function add {

 local name=$1 pem=$2 pw pw2 created sha
 [[ -z $name || -z $pem ]] && {
  err "usage: cert-manager add <name> <file.pem>"
  return 1
 }
 [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || {
  err "name may only contain letters, digits, . _ -"
  return 1
 }
 [[ -r $pem ]] || {
  err "cannot read '$pem'"
  return 1
 }
 grep -q 'BEGIN CERTIFICATE' "$pem" || {
  err "'$pem' contains no certificate"
  return 1
 }
 grep -q 'PRIVATE KEY' "$pem" || warn "'$pem' contains no private key — curl will need a separate key"

 if entry_exists "$name"; then
  local ans
  read -rp "Entry '$name' already exists. Overwrite? [y/N] " ans
  [[ $ans =~ ^[Yy] ]] || return 1
 fi

 read -rsp "Password for the private key in $pem: " pw
 echo
 read -rsp "Confirm password: " pw2
 echo
 [[ $pw == "$pw2" ]] || {
  err "passwords do not match"
  return 1
 }

 if grep -q 'PRIVATE KEY' "$pem"; then
  if ! openssl pkey -in "$pem" -passin fd:3 -noout 3<<<"$pw" 2>/dev/null; then
   err "that password does not unlock the private key in $pem"
   return 1
  fi
  ok "Password verified against private key"
 fi

 created=$(date -Is)
 sha=$(sha256sum "$pem" | cut -d' ' -f1)
 {
  printf '%s\n' "$pw"
  printf 'created: %s\nsource: %s\nsha256: %s\n' "$created" "$(readlink -f "$pem")" "$sha"
  cat "$pem"
 } | pass insert -m -f "$(entry_path "$name")" >/dev/null ||
  {
   err "pass insert failed"
   unset pw pw2
   return 1
  }
 unset pw pw2

 local subj iss nb na algo bits enc cnt

 subj=$(openssl x509 -in "$pem" -noout -subject 2>/dev/null | sed 's/^subject= *//')
 iss=$(openssl x509 -in "$pem" -noout -issuer 2>/dev/null | sed 's/^issuer= *//')
 nb=$(openssl x509 -in "$pem" -noout -startdate 2>/dev/null | cut -d= -f2)
 na=$(openssl x509 -in "$pem" -noout -enddate 2>/dev/null | cut -d= -f2)
 algo=$(openssl x509 -in "$pem" -noout -text 2>/dev/null | awk -F': ' '/Public Key Algorithm/{print $2; exit}')
 bits=$(openssl x509 -in "$pem" -noout -text 2>/dev/null | grep -oE '\(([0-9]+) bit\)' | head -1 | tr -d '()')
 cnt=$(grep -c 'BEGIN CERTIFICATE' "$pem")

 if grep -q 'BEGIN ENCRYPTED PRIVATE KEY' "$pem"; then
  enc="PKCS#8 encrypted"
 elif grep -q 'Proc-Type: 4,ENCRYPTED' "$pem"; then
  enc="legacy PEM encrypted"
 elif grep -q 'PRIVATE KEY' "$pem"; then
  enc="UNENCRYPTED"
 else enc="none (no key)"; fi

 info_set "$name" name "$name"
 info_set "$name" created "$created"
 info_set "$name" source "$(readlink -f "$pem")"
 info_set "$name" size "$(stat -c %s "$pem")"
 info_set "$name" sha256 "$sha"
 info_set "$name" cert_count "$cnt"
 info_set "$name" subject "$subj"
 info_set "$name" issuer "$iss"
 info_set "$name" not_before "$nb"
 info_set "$name" not_after "$na"
 info_set "$name" key_algo "${algo:-unknown}"
 info_set "$name" key_bits "${bits:-?}"
 info_set "$name" key_enc "$enc"

 if [[ -z $DEFAULT_ENTRY ]]; then
  DEFAULT_ENTRY=$name
  save_config
 fi
 ok "Stored certificate + password in pass entry $(entry_path "$name")"
 [[ $enc == UNENCRYPTED ]] && warn "Note: the private key in the PEM is not encrypted."
 info "Unlock with:  cert-manager unlock $name [duration]   (default $DEFAULT_TIMEOUT)"
}

function unlock {
 local name=$1 dur=${2:-$DEFAULT_TIMEOUT} secs content pw pem now exp tpid
 entry_exists "$name" || {
  err "no entry '$name' (see: cert-manager list)"
  return 1
 }
 secs=$(parse_duration "$dur") || {
  err "bad duration '$dur' (e.g. 8h, 90m, 1h30m, 2d)"
  return 1
 }

 content=$(pass show "$(entry_path "$name")") ||
  {
   err "could not decrypt entry (wrong GPG passphrase / cancelled)"
   return 1
  }
 pw=${content%%$'\n'*}
 pem=$(printf '%s\n' "$content" | sed -n '/^-----BEGIN/,$p')
 unset content

 kill_timer "$name"
 mkdir -p "$RUNTIME_DIR"
 chmod 700 "$RUNTIME_DIR"
 printf '%s' "$pw" >"$(rt "$name" pw)"
 chmod 600 "$(rt "$name" pw)"
 printf '%s\n' "$pem" >"$(rt "$name" pem)"
 chmod 600 "$(rt "$name" pem)"
 unset pw pem

 now=$(now)
 exp=$((now + secs))
 tpid=$(spawn_timer "$name" "$secs")
 printf 'unlocked_at=%s\nexpires_at=%s\nduration=%s\ntimer_pid=%s\n' \
  "$now" "$exp" "$secs" "$tpid" >"$(rt "$name" meta)"
 chmod 600 "$(rt "$name" meta)"
 info_set "$name" last_unlocked "$(date -Is)"

 ok "Unlocked '$name' for $(fmt_dur "$secs")  →  relocks at $(fmt_ts "$exp")"
 info "Use:  cert-manager curl <args>   |   cert-manager password   |   cert-manager env"
}

function lock {
 local names=() n
 if [[ $1 == --all ]]; then mapfile -t names < <(entries); else names=("$1"); fi
 for n in "${names[@]}"; do
  if [[ -f "$(rt "$n" meta)" ]]; then
   kill_timer "$n"
   wipe_runtime "$n"
   info_set "$n" last_locked "$(date -Is) (manual)"
   ok "Locked '$n'"
  else
   info "'$n' is already locked"
  fi
 done
 if [[ $PURGE_GPG_CACHE == yes ]] && command -v gpg-connect-agent >/dev/null 2>&1; then
  gpg-connect-agent reloadagent /bye >/dev/null 2>&1 && info "gpg-agent passphrase cache cleared"
 fi
}

function extend {
 local name=$1 dur=$2 secs exp new_secs meta
 require_unlocked "$name" || return 1
 secs=$(parse_duration "${dur:-1h}") || {
  err "bad duration '$dur'"
  return 1
 }
 exp=$(meta_get "$name" expires_at)
 exp=$((exp + secs))
 new_secs=$((exp - $(now)))
 kill_timer "$name"
 meta=$(rt "$name" meta)
 sed -i "s/^expires_at=.*/expires_at=$exp/; s/^timer_pid=.*/timer_pid=$(spawn_timer "$name" "$new_secs")/" "$meta"
 ok "Extended '$name' by $(fmt_dur "$secs")  →  relocks at $(fmt_ts "$exp")"
}

function status {
 local name=$1 f state now unl exp dur rem
 entry_exists "$name" || {
  err "no entry '$name'"
  return 1
 }
 f=$(info_file "$name")
 printf '\n%s%sCertificate entry: %s%s%s\n' "$BO" "$C" "$name" "$N" \
  "$([[ $name == "$DEFAULT_ENTRY" ]] && printf '  %s(default)%s' "$D" "$N")"
 printf '%s────────────────────────────────────────────────────────%s\n' "$D" "$N"

 if is_unlocked "$name"; then
  now=$(now)
  unl=$(meta_get "$name" unlocked_at)
  exp=$(meta_get "$name" expires_at)
  dur=$(meta_get "$name" duration)
  rem=$((exp - now))
  printf '  %-16s %sUNLOCKED%s\n' "State:" "$G$BO" "$N"
  printf '  %-16s %s\n' "Unlocked at:" "$(fmt_ts "$unl")"
  printf '  %-16s %s\n' "Relocks at:" "$(fmt_ts "$exp")"
  printf '  %-16s %s\n' "Unlock window:" "$(fmt_dur "$dur")"
  printf '  %-16s %s%s%s   ' "Remaining:" "$BO" "$(fmt_dur "$rem")" "$N"
  bar "$rem" "$dur" 30
  printf '\n'
  printf '  %-16s %s\n' "Runtime files:" "$RUNTIME_DIR/$name.{pw,pem}"
 else
  printf '  %-16s %sLOCKED%s\n' "State:" "$R$BO" "$N"
 fi
 printf '  %-16s %s\n' "Created:" "$(info_get "$name" created)"
 printf '  %-16s %s\n' "Last unlocked:" "$(info_get "$name" last_unlocked || true)"
 printf '  %-16s %s\n' "Last locked:" "$(info_get "$name" last_locked || true)"
 printf '  %-16s %s\n' "pass entry:" "$(entry_path "$name")  ($(human_size "$(stat -c %s "$STORE_DIR/$PASS_PREFIX/$name.gpg")") gpg-encrypted)"

 printf '\n%s%sFile / certificate details%s\n' "$BO" "$C" "$N"
 printf '%s────────────────────────────────────────────────────────%s\n' "$D" "$N"
 local src size
 src=$(info_get "$name" source)
 size=$(info_get "$name" size)
 printf '  %-16s %s%s\n' "Source file:" "$src" "$([[ -e $src ]] || printf '  %s(no longer present)%s' "$D" "$N")"
 printf '  %-16s %s (%s bytes)\n' "PEM size:" "$(human_size "$size")" "$size"
 printf '  %-16s %s\n' "SHA-256:" "$(info_get "$name" sha256)"
 printf '  %-16s %s\n' "Certificates:" "$(info_get "$name" cert_count) in chain"
 printf '  %-16s %s\n' "Subject:" "$(info_get "$name" subject)"
 printf '  %-16s %s\n' "Issuer:" "$(info_get "$name" issuer)"
 printf '  %-16s %s\n' "Valid from:" "$(info_get "$name" not_before)"
 local na na_epoch days
 na=$(info_get "$name" not_after)
 na_epoch=$(date -d "$na" +%s 2>/dev/null)
 if [[ -n $na_epoch ]]; then
  days=$(((na_epoch - $(now)) / 86400))
  if ((days < 0)); then
   printf '  %-16s %s  %sEXPIRED%s\n' "Valid until:" "$na" "$R" "$N"
  elif ((days < 30)); then
   printf '  %-16s %s  %s(%d days left)%s\n' "Valid until:" "$na" "$Y" "$days" "$N"
  else printf '  %-16s %s  %s(%d days left)%s\n' "Valid until:" "$na" "$D" "$days" "$N"; fi
 else
  printf '  %-16s %s\n' "Valid until:" "$na"
 fi
 printf '  %-16s %s %s\n' "Key type:" "$(info_get "$name" key_algo)" "$(info_get "$name" key_bits)"
 printf '  %-16s %s\n' "Key encryption:" "$(info_get "$name" key_enc)"
 printf '\n%sTip:%s cert-manager remaining %s   → live countdown\n\n' "$D" "$N" "$name"
}

function countdown {

 local name=$1 exp dur rem now key width first=1 old_trap int=0
 require_unlocked "$name" || return 1
 exp=$(meta_get "$name" expires_at)
 dur=$(meta_get "$name" duration)

 old_trap=$(trap -p INT)
 trap 'int=1' INT
 tput civis 2>/dev/null
 printf '%s%s⏱  %s%s  %s— relocks at %s   (q or Ctrl-C to quit)%s\n' \
  "$BO" "$C" "$name" "$N" "$D" "$(fmt_ts "$exp")" "$N"

 while :; do
  now=$(now)
  rem=$((exp - now))
  width=$(($(tput cols 2>/dev/null || echo 80) - 20))
  ((width > 60)) && width=60
  ((width < 10)) && width=10
  ((first)) || printf '\e[2A'
  first=0
  printf '\r\e[K   %s%s%s  remaining   %s(%s)%s\n' "$BO" "$(fmt_clock "$rem")" "$N" "$D" "$(fmt_dur "$rem")" "$N"
  printf '\r\e[K   '
  bar "$rem" "$dur" "$width"
  printf '\n'
  if ((rem <= 0)) || [[ ! -f "$(rt "$name" meta)" ]]; then
   printf '\n%s%s'\''%s'\'' has relocked.%s\n' "$R" "$BO" "$name" "$N"
   break
  fi
  key=""
  read -rsn1 -t 1 key
  ((int)) && break
  [[ $key == q || $key == Q ]] && break
  # expiry may move if `extend` runs elsewhere
  exp=$(meta_get "$name" expires_at)
  dur=$(meta_get "$name" duration)
  [[ -z $exp ]] && {
   printf '\n%s%s'\''%s'\'' has relocked.%s\n' "$R" "$BO" "$name" "$N"
   break
  }
 done
 tput cnorm 2>/dev/null
 if [[ -n $old_trap ]]; then eval "$old_trap"; else trap - INT; fi
 return 0
}

function export {

 local name=$1 out="" cert_only=0 decrypt=0 content pem pw
 shift
 while (($#)); do
  case $1 in
   --cert-only) cert_only=1 ;;
   --decrypt-key) decrypt=1 ;;
   *) out=$1 ;;
  esac
  shift
 done
 entry_exists "$name" || {
  err "no entry '$name'"
  return 1
 }
 out=${out:-./$name.pem}

 if is_unlocked "$name"; then
  pem=$(<"$(rt "$name" pem)")
  pw=$(<"$(rt "$name" pw)")
 else
  info "'$name' is locked — decrypting via pass (GPG passphrase required)"
  content=$(pass show "$(entry_path "$name")") || {
   err "decrypt failed"
   return 1
  }
  pw=${content%%$'\n'*}
  pem=$(printf '%s\n' "$content" | sed -n '/^-----BEGIN/,$p')
  unset content
 fi

 [[ -e $out ]] && {
  local ans
  read -rp "'$out' exists. Overwrite? [y/N] " ans
  [[ $ans =~ ^[Yy] ]] || return 1
 }
 : >"$out" && chmod 600 "$out" || {
  err "cannot write $out"
  return 1
 }

 if ((cert_only)); then
  printf '%s\n' "$pem" | sed -n '/BEGIN CERTIFICATE/,/END CERTIFICATE/p' >"$out"
  ok "Exported certificate chain (no key) → $out"
 elif ((decrypt)); then
  warn "Writing UNENCRYPTED private key to $out — protect this file!"
  printf '%s\n' "$pem" | sed -n '/BEGIN CERTIFICATE/,/END CERTIFICATE/p' >"$out"
  printf '%s\n' "$pem" | openssl pkey -passin fd:3 3<<<"$pw" >>"$out" ||
   {
    err "key decryption failed"
    return 1
   }
  ok "Exported certificate + decrypted key → $out"
 else
  printf '%s\n' "$pem" >"$out"
  ok "Exported PEM (certificate + password-protected key) → $out"
 fi
 unset pem pw
}

password() {
 local name=$1
 require_unlocked "$name" || return 1
 if [[ $2 == --copy ]]; then
  if command -v wl-copy >/dev/null 2>&1; then
   wl-copy <"$(rt "$name" pw)"
  elif command -v xclip >/dev/null 2>&1; then
   xclip -selection clipboard <"$(rt "$name" pw)"
  else
   err "no clipboard tool (wl-copy/xclip)"
   return 1
  fi
  ok "Password copied to clipboard"
 else
  cat "$(rt "$name" pw)"
  echo
 fi
}

curl() {
 local name=$1
 shift
 require_unlocked "$name" || return 1
 curl --cert "$(rt "$name" pem)" --key "$(rt "$name" pem)" \
  --pass "$(<"$(rt "$name" pw)")" "$@"
}

env() {
 local name=$1
 require_unlocked "$name" || return 1
 if [[ $2 == --print ]]; then
  printf 'export CERT_FILE=%q\nexport CERT_PASS=%q\n' "$(rt "$name" pem)" "$(<"$(rt "$name" pw)")"
  return 0
 fi
 export CERT_FILE
 CERT_FILE=$(rt "$name" pem)
 export CERT_PASS
 CERT_PASS=$(<"$(rt "$name" pw)")
 ok "Exported CERT_FILE and CERT_PASS  →  curl --cert \"\$CERT_FILE\" --pass \"\$CERT_PASS\" ..."
}
unenv() {
 unset CERT_FILE CERT_PASS
 ok "Cleared CERT_FILE / CERT_PASS"
}

list() {
 local n state rem
 mapfile -t all < <(entries)
 ((${#all[@]})) || {
  info "no entries yet — add one:  cert-manager add <name> <file.pem>"
  return 0
 }
 printf '%s%-20s %-10s %-22s %s%s\n' "$BO" "NAME" "STATE" "REMAINING" "SUBJECT" "$N"
 for n in "${all[@]}"; do
  if is_unlocked "$n"; then
   rem=$(($(meta_get "$n" expires_at) - $(now)))
   state="${G}unlocked${N}"
   rem=$(fmt_dur "$rem")
  else
   state="${R}locked  ${N}"
   rem="-"
  fi
  printf '%-20s %b   %-22s %s%s\n' "$n$([[ $n == "$DEFAULT_ENTRY" ]] && printf ' *')" "$state" "$rem" \
   "$(info_get "$n" subject | cut -c1-50)" ""
 done
 printf '%s(* = default entry;  timeout default: %s)%s\n' "$D" "$DEFAULT_TIMEOUT" "$N"
}

remove() {
 local name=$1 ans
 entry_exists "$name" || {
  err "no entry '$name'"
  return 1
 }
 read -rp "Permanently delete pass entry '$name' and its metadata? [y/N] " ans
 [[ $ans =~ ^[Yy] ]] || return 1
 kill_timer "$name"
 wipe_runtime "$name"
 pass rm -f "$(entry_path "$name")" >/dev/null && rm -f "$(info_file "$name")"
 [[ $DEFAULT_ENTRY == "$name" ]] && {
  DEFAULT_ENTRY=""
  save_config
 }
 ok "Removed '$name'"
}

help() {
 cat <<EOF
${BO}cert-manager${N} v$VERSION — timed unlock for password-protected TLS client certs

${BO}Usage:${N}  cert-manager [-e <entry>] <command> [args]
  install                     installs self into users '\$HOME/.local/bin/s'

${BO}Setup / entries${N}
  setup                       ensure pass, gpg, openssl, curl are installed & initialised
  add <name> <file.pem>       store PEM (cert + encrypted key) AND its password in pass
  list                        list entries and their lock state
  use <name>                  set the default entry
  remove <name>               delete an entry
  timeout [duration]          show or set the default unlock window (default 8h)

${BO}Lock control${N}
  unlock [name] [duration]    decrypt once (gpg), keep usable for <duration> (default: timeout)
  lock   [name|--all]         relock now (wipes runtime secrets, clears gpg-agent cache)
  extend [name] [duration]    push the relock time out (default +1h)
  status [name]               lock details (locked/unlocked, created, remaining, file & cert info)
  remaining [name]            live countdown clock with progress bar (q to quit)

${BO}Using the cert (while unlocked, no prompts)${N}
  curl <curl args...>         curl with --cert/--key/--pass injected automatically
  password [--copy]           print (or copy) the key password
  env [--print]               export CERT_FILE / CERT_PASS into this shell
  unenv                       clear those variables
  export [name] [out] [--cert-only|--decrypt-key]   write the PEM to a file

${BO}Durations:${N} 8h, 45m, 1h30m, 2d, 90s   (bare number = hours)
${BO}Env:${N}       ENTRY=<name> selects an entry; PASSWORD_STORE_DIR honoured

Examples:
  cert-manager add prod-client ~/certs/client.pem
  cert-manager unlock                       # 8h
  cert-manager unlock prod-client 30m
  cert-manager curl -s https://api.internal/health
  cert-manager remaining
  cert-manager lock
EOF
}

cert-manager() {
 local entry="" cmd
 load_config
 while [[ $1 == -e || $1 == --entry ]]; do
  entry=$2
  shift 2
 done
 cmd=${1:-help}
 shift 2>/dev/null

 case $cmd in help | -h | --help)
  help
  return 0
  ;;
 version | -v)
  echo "cert-manager $VERSION"
  return 0
  ;;
 esac
 ensure_deps || return 1

 case $cmd in
  setup)
   ok "All dependencies present, pass store initialised. Ready."
   return 0
   ;;
  add)
   add "$@"
   return $?
   ;;
  list | ls)
   list
   return $?
   ;;
  use)
   [[ -z $1 ]] && {
    err "usage: cert-manager use <name>"
    return 1
   }
   entry_exists "$1" || {
    err "no entry '$1'"
    return 1
   }
   DEFAULT_ENTRY=$1
   save_config
   ok "Default entry → $1"
   return 0
   ;;
  remove | rm)
   remove "$1"
   return $?
   ;;
  timeout)
   if [[ -z $1 ]]; then
    echo "default unlock window: $DEFAULT_TIMEOUT ($(fmt_dur "$(parse_duration "$DEFAULT_TIMEOUT")"))"
    return 0
   fi
   parse_duration "$1" >/dev/null || {
    err "bad duration '$1'"
    return 1
   }
   DEFAULT_TIMEOUT=$1
   save_config
   ok "Default unlock window → $1"
   return 0
   ;;
  lock) if [[ $1 == --all ]]; then
   lock --all
   return $?
  fi ;;
 esac

 local -a all
 if [[ -z $entry ]]; then
  if [[ -n ${ENTRY:-} ]]; then
   entry=$ENTRY
  elif [[ -n $1 ]] && entry_exists "$1" && [[ $cmd != curl ]]; then
   entry=$1
   shift
  elif [[ -n $DEFAULT_ENTRY ]]; then
   entry=$DEFAULT_ENTRY
  else
   mapfile -t all < <(entries)
   ((${#all[@]} == 1)) && entry=${all[0]}
  fi
 fi
 if [[ -z $entry ]]; then
  err "no entry selected. Add one (cert-manager add <name> <file.pem>) or pass -e <name>"
  return 1
 fi
 entry_exists "$entry" || {
  err "no entry '$entry' (cert-manager list)"
  return 1
 }

 case $cmd in
  install) install-system "$entry" "$@" ;;
  unlock) unlock "$entry" "$@" ;;
  lock) lock "$entry" ;;
  extend) extend "$entry" "$@" ;;
  status | show | info) status "$entry" ;;
  remaining | time | countdown | watch) countdown "$entry" ;;
  export) export "$entry" "$@" ;;
  password | pass | pw) password "$entry" "$@" ;;
  curl) curl "$entry" "$@" ;;
  env) env "$entry" "$@" ;;
  unenv) unenv ;;
  *)
   err "unknown command '$cmd'"
   help
   return 1
   ;;
 esac
}

function complete {
 local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD - 1]}
 case $prev in
  cert-manager) COMPREPLY=($(compgen -W "setup add list use remove timeout unlock lock extend status remaining export password curl env unenv help" -- "$cur")) ;;
  install | unlock | lock | extend | status | remaining | export | password | env | use | remove | -e) COMPREPLY=($(compgen -W "$(entries) --all" -- "$cur")) ;;
  add) COMPREPLY=($(compgen -f -- "$cur")) ;;
 esac
}
complete -F complete cert-manager 2>/dev/null

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
 cert-manager "$@"
 exit $?
fi
