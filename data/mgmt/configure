update_os_clock_12H() (
    echo "Setting interface to use 12 Hr format"
    gsettings set org.gnome.desktop.interface clock-format '12h'
    echo "Interface clock-format settings update complete"
)

#
remove_boot_logo() (
    TARGET_FILE="/usr/share/plymouth/ubuntu-logo.png"
    BACKUP_FILE="${TARGET_FILE}.bak"
    TRANSPARENT_PNG_B64="iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
    
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    NC='\033[0m'
    
    log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
    log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
    log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
    
    check_root() {
     if [ "$EUID" -ne 0 ]; then
      log_error "Please run as root (use sudo)."
      exit 1
     fi
    }
    
    restore_logo() {
     log_info "Restoring original logo..."
     if [ -f "$BACKUP_FILE" ]; then
      cp "$BACKUP_FILE" "$TARGET_FILE"
      log_info "Original logo restored from backup."
      update_ramfs
     else
      log_error "No backup file found at $BACKUP_FILE. Cannot restore."
      exit 1
     fi
    }
    
    update_ramfs() {
     log_info "Updating initramfs (this may take a moment)..."
     update-initramfs -u
     if [ $? -eq 0 ]; then
      log_info "Success! Reboot your system to see changes."
     else
      log_error "Failed to update initramfs."
      exit 1
     fi
    }
    
    apply_patch() {
     if [ ! -f "$TARGET_FILE" ]; then
      log_error "Target file not found: $TARGET_FILE"
      log_error "Your version of Ubuntu might store the logo elsewhere."
      exit 1
     fi
    
     if [ ! -f "$BACKUP_FILE" ]; then
      log_info "Creating backup of original logo..."
      cp "$TARGET_FILE" "$BACKUP_FILE"
     else
      log_warn "Backup already exists. Skipping backup to preserve original."
     fi
    
     log_info "Generating transparent replacement logo..."
     echo "$TRANSPARENT_PNG_B64" | base64 --decode >/tmp/transparent_logo_temp.png
    
     log_info "Overwriting current logo..."
     mv /tmp/transparent_logo_temp.png "$TARGET_FILE"
    
     update_ramfs
    }
    
    check_root
    
    if [ "$1" == "--restore" ]; then
     restore_logo
    else
     echo "=========================================="
     echo "  Ubuntu Login Logo Remover (Zero-to-Hero)"
     echo "=========================================="
     apply_patch
    fi
)

#
update_os_startup_sound() (
    read -e -r -p "Enter path to audio file: " AUDIO_FILE
    
    AUDIO_FILE="${AUDIO_FILE/#\~/$HOME}"
    if [ ! -f "$AUDIO_FILE" ]; then
     echo "Error: File '$AUDIO_FILE' not found."
     exit 1
    fi
    
    if ! command -v ffmpeg >/dev/null 2>&1; then
     echo "Installing audio conversion software (ffmpeg)..."
     sudo apt update >/dev/null 2>&1
     if ! sudo apt install -y ffmpeg >/dev/null 2>&1; then
      echo "Error: Failure installing ffmpeg. Aborting..."
      exit 1
     fi
    fi
    
    SOUND_DIR="$HOME/.local/share/sounds/Yaru/stereo"
    mkdir -p "$SOUND_DIR"
    TARGET_FILE="$SOUND_DIR/desktop-login.ogg"
    
    echo "Converting '${AUDIO_FILE}' to system startup sound format..."
    
    if ! ffmpeg -y -i "$AUDIO_FILE" -c:a libvorbis "$TARGET_FILE" >/dev/null 2>&1; then
     echo "Error: Failed to convert audio file."
     exit 1
    fi
    
    if ! command -v paplay >/dev/null 2>&1; then
     echo "Installing pulseaudio-utils..."
     if ! sudo apt install -y pulseaudio-utils >/dev/null 2>&1; then
      echo "Error: Failed to install pulseaudio-utils. Aborting..."
      exit 1
     fi
    fi
    
    AUTOSTART_DIR="$HOME/.config/autostart"
    mkdir -p "$AUTOSTART_DIR"
    AUTOSTART_FILE="$AUTOSTART_DIR/startup-sound.desktop"
    
    cat >"$AUTOSTART_FILE" <<EOF
[Desktop Entry]
Type=Application
Name=Startup Sound
Comment=Plays a custom sound at login
Exec=paplay "$TARGET_FILE"
Terminal=false
X-GNOME-Autostart-enabled=true
NoDisplay=true
EOF
    
    echo "Enabling gsettings to allow sound events..."
    gsettings set org.gnome.desktop.sound event-sounds true
    
    echo "Testing new startup sound..."
    paplay "$TARGET_FILE"
    echo "Startup sound updated successfully! It will play the next time you log in."
    echo "To undo: rm '$AUTOSTART_FILE' '$TARGET_FILE'"
)

#
enable_touchpad_twofinger() (
    echo "Installing xserver synaptic inputs"
    sudo apt install xserver-xorg-input-synaptics
    
    echo "Setting up touch-pad settings to enable two-finger scrolling"
    synclient VertTwoFingerScroll=1
    
    echo "Enabeling gnome two-finger-scrolling"
    gsettings set org.gnome.desktop.peripherals.touchpad two-finger-scrolling-enabled true
    
    read -r -p "Log out now? (y/n) : " response
    
    if [[ "$response" == "y" ]]; then
     sudo pkill -u $USER
    else
     echo "Logout for changes to take effect"
    fi
)

#
update_os_alert_sound() (
    THEME_DIR="/usr/share/sounds/custom"
    STEREO_DIR="$THEME_DIR/stereo"
    THEME_FILE="$THEME_DIR/index.theme"
    SOURCE_SOUND="/usr/share/sounds/gnome/default/alerts/hum.ogg"
    DEST_SOUND="$STEREO_DIR/bell.oga"
    
    echo "🎵 Starting the Custom Sound Theme Setup..."
    
    echo "Creating directory structure in /usr/share/sounds..."
    sudo mkdir -p "$STEREO_DIR"
    
    echo "Creating theme configuration file..."
    sudo tee "$THEME_FILE" >/dev/null <<EOF
[Sound Theme]
Name=custom
Directories=stereo
    
[stereo]
OutputProfile=stereo
EOF
    
    echo "Copying the 'hum' sound file..."
    if [ -f "$SOURCE_SOUND" ]; then
     sudo cp "$SOURCE_SOUND" "$DEST_SOUND"
    else
     echo "❌ Error: Source sound $SOURCE_SOUND not found."
     echo "Are you sure you are using standard Ubuntu with the GNOME desktop?"
     exit 1
    fi
    
    echo "Applying the custom sound theme to your GNOME profile..."
    gsettings set org.gnome.desktop.sound theme-name custom
    
    echo "✅ Success! The 'hum' alert sound has been set."
    echo "Note: You may need to log out and log back in for changes to take full effect."
)

