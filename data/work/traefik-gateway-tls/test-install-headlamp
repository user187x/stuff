#!/bin/bash

# Fail on error, unassigned variables, and pipe failures
set -eou pipefail

echo -e "\n📦 Adding Headlamp Helm repository..."
helm repo add headlamp https://headlamp-k8s.github.io/headlamp/ || true
helm repo update

echo -e "\n🚀 Installing Headlamp..."
helm upgrade --install headlamp headlamp/headlamp \
 --namespace headlamp \
 --create-namespace \
 --set service.type=ClusterIP

echo -e "\n🛣️  Creating HTTPRoute for Traefik..."
cat <<EOF | kubectl apply -f -
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: headlamp-route
  namespace: headlamp
spec:
  parentRefs:
  - name: traefik-gateway
    namespace: traefik
    sectionName: websecure
  hostnames:
  - "headlamp.xxx.local"
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /
    backendRefs:
    - name: headlamp
      port: 80
EOF

echo -e "\n🔐 Warming up sudo credentials for Minikube tunnel..."

# This prompts you cleanly in the foreground and caches the auth
sudo -v

echo -e "\n🚇 Starting Minikube tunnel in the background..."
# Run in background and suppress standard output, keeping error output if it crashes
minikube tunnel >/dev/null 2>&1 &
TUNNEL_PID=$!

echo -e "\n⏳ Waiting for Traefik LoadBalancer External-IP to provision..."
# Loop until the JSON path returns a value for the IP
while [ -z "$(kubectl get svc traefik -n traefik -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null)" ]; do
 sleep 2
 echo -n "."
done
echo

# Extract the dynamically assigned IP
TRAEFIK_IP=$(kubectl get svc traefik -n traefik -o jsonpath='{.status.loadBalancer.ingress[0].ip}')
echo -e "✅ Traefik External-IP acquired: \e[92m${TRAEFIK_IP}\e[0m"

echo -e "\n📝 Updating /etc/hosts..."
# Remove any existing headlamp.local entries to prevent bloat on re-runs
sudo sed -i '/headlamp.xxx.local/d' /etc/hosts
# Append the new IP mapping
echo "${TRAEFIK_IP} headlamp.xxx.local" | sudo tee -a /etc/hosts >/dev/null

echo -e "\n🎉 Success! You can now access Headlamp at http://headlamp.xxx.local"
echo -e "🛑 To stop the background tunnel later, run: \e[91mkill $TUNNEL_PID\e[0m"
