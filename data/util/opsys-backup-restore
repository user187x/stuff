#!/bin/bash

# Configuration
BACKUP_DIR="${HOME}/devbox-backup-$(date +%F)"
ARCHIVE_NAME="devbox-env-backup.tar.gz"

backup_env() {
 echo "🚀 Starting backup to $BACKUP_DIR..."
 mkdir -p "$BACKUP_DIR"

 # 1. GNOME Desktop State & Extensions
 echo "   -> Dumping dconf (GNOME tweaks, keybinds, touchpad, extension settings)..."
 dconf dump / >"$BACKUP_DIR/dconf-settings.ini"
 gnome-extensions list >"$BACKUP_DIR/gnome-extensions.txt"

 # 2. Package Managers
 echo "   -> Exporting package lists..."
 # Using showmanual to avoid dragging in orphaned dependencies
 apt-mark showmanual >"$BACKUP_DIR/apt-packages.txt"
 snap list | awk 'NR>1 {print $1}' >"$BACKUP_DIR/snap-packages.txt"
 flatpak list --app --columns=application >"$BACKUP_DIR/flatpak-packages.txt"

 # Check for pipx (modern Ubuntu standard) or fallback to pip
 if command -v pipx &>/dev/null; then
  pipx list --short >"$BACKUP_DIR/pipx-packages.txt"
 else
  pip3 freeze --user >"$BACKUP_DIR/pip-packages.txt" 2>/dev/null || true
 fi

 # 3. Dotfiles & Local Context (Terminals, Editors, Fonts)
 echo "   -> Archiving dotfiles..."
 # Add or remove specific paths here depending on your workflow
 tar -czf "$BACKUP_DIR/dotfiles.tar.gz" -C "$HOME" \
  .bashrc .profile .vimrc .tmux.conf .gitconfig \
  .config/kitty .config/nvim .config/dconf \
  .local/share/fonts .local/share/gnome-shell/extensions 2>/dev/null || true

 # 4. Bundle Payload
 echo "   -> Creating final archive..."
 tar -czf "$ARCHIVE_NAME" -C "$(dirname "$BACKUP_DIR")" "$(basename "$BACKUP_DIR")"
 rm -rf "$BACKUP_DIR" # Cleanup uncompressed directory

 echo "✅ Backup complete! Payload saved as: $ARCHIVE_NAME"
 echo "⚠️  CRITICAL: Move $ARCHIVE_NAME to a USB or cloud drive before wiping your disk!"
}

restore_env() {
 if [ ! -f "$ARCHIVE_NAME" ]; then
  echo "❌ Error: $ARCHIVE_NAME not found in the current directory."
  exit 1
 fi

 echo "🚀 Extracting archive..."
 tar -xzf "$ARCHIVE_NAME"
 EXTRACTED_DIR=$(tar -tf "$ARCHIVE_NAME" | head -1 | cut -f1 -d"/")

 # 1. Restore Dotfiles First
 echo "   -> Restoring dotfiles..."
 tar -xzf "$EXTRACTED_DIR/dotfiles.tar.gz" -C "$HOME"

 # 2. Repopulate System Packages
 echo "   -> Restoring APT packages (This will take a while)..."
 sudo apt update
 # xargs -a is safer for handling long package lists safely
 xargs -a "$EXTRACTED_DIR/apt-packages.txt" sudo apt install -y --no-install-recommends || echo "⚠️ Some APT packages failed to install. Check for deprecated packages."

 echo "   -> Restoring Snap packages..."
 cat "$EXTRACTED_DIR/snap-packages.txt" | xargs -I {} sudo snap install {}

 echo "   -> Restoring Flatpak packages..."
 cat "$EXTRACTED_DIR/flatpak-packages.txt" | xargs -I {} flatpak install -y flathub {}

 echo "   -> Restoring Python packages..."
 if [ -f "$EXTRACTED_DIR/pipx-packages.txt" ]; then
  cat "$EXTRACTED_DIR/pipx-packages.txt" | cut -d' ' -f1 | xargs -I {} pipx install {}
 elif [ -f "$EXTRACTED_DIR/pip-packages.txt" ]; then
  pip3 install --user -r "$EXTRACTED_DIR/pip-packages.txt" || echo "⚠️ Pip restore failed (Consider pipx on newer Ubuntu)."
 fi

 # 3. Restore GNOME State
 echo "   -> Restoring GNOME settings..."
 dconf load / <"$EXTRACTED_DIR/dconf-settings.ini"

 echo "✅ Restore complete! A full system reboot is highly recommended to apply all desktop changes."
}

case "$1" in
 backup-current-env)
  backup_env
  ;;
 restore-dev-env)
  restore_env
  ;;
 *)
  echo "Usage: $0 {backup-current-env|restore-dev-env}"
  exit 1
  ;;
esac
